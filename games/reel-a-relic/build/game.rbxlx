	["Goblin Shark"] = {
		Family = "Shark",
		Length = 4.4,
		Height = 1.05,
		Width = 0.7,
		Tail = "Shark",
		Dorsal = "SharkFin",
		Pectoral = "Long",
		Extras = { "GoblinSnout" },
	},
	["Colossal Squid"] = { Family = "Squid", Length = 3.0, Height = 1.3, Width = 0.95 },
	Megalodon = {
		Family = "Shark",
		Length = 6.0,
		Height = 1.7,
		Width = 1.1,
		Tail = "Shark",
		Dorsal = "SharkFin",
		Pectoral = "Long",
		Extras = { "Fangs" },
	},
}

-- The decorations (landmark and vista fish) have no species. A good generic
-- fish is the right answer there, not a crash and not a default Anchovy.
local FALLBACK: Profile = { Length = 2.8, Height = 1.6, Width = 0.85, Tail = "Fork", Dorsal = "Standard" }

-- Used by tests/check-models.py to prove every species in the config has a
-- shape, so adding a fish and forgetting its silhouette cannot ship quietly.
function FishShape.HasProfile(name: string): boolean
	return PROFILES[name] ~= nil
end

--------------------------------------------------------------------------------

-- Nose points +X, so a camera on +Z sees the fish side-on — the only angle a
-- fish is recognisable from.
function FishShape.Build(options: Options): Model
	local model = Instance.new("Model")
	model.Name = options.Name or "Fish"

	local scale = options.Scale or 1
	local rng = Random.new(options.Seed or 5)
	local color = options.Color
	local profile = (if options.Name then PROFILES[options.Name] else nil) or FALLBACK

	local ctx: Ctx = {
		Model = model,
		Body = nil,
		Color = color,
		Fin = finColor(color),
		Material = if options.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		L = (profile.Length or 2.8) * scale,
		H = (profile.Height or 1.6) * scale,
		W = (profile.Width or 0.85) * scale,
		Scale = scale,
		Rng = rng,
	}

	-- Each branch calls its own builder rather than selecting one and calling it
	-- afterwards: Luau will not call a union of identically-shaped function
	-- types, and this reads better anyway.
	local family = profile.Family
	local body: Part
	if family == "Serpent" then
		body = buildSerpent(ctx, profile)
	elseif family == "Ray" then
		body = buildRay(ctx, profile)
	elseif family == "Seahorse" then
		body = buildSeahorse(ctx, profile)
	elseif family == "Squid" then
		body = buildSquid(ctx, profile)
	elseif family == "Octopus" then
		body = buildOctopus(ctx, profile)
	elseif family == "Isopod" then
		body = buildIsopod(ctx, profile)
	elseif family == "Flatfish" then
		body = buildFlatfish(ctx, profile)
	elseif family == "Hatchet" then
		body = buildHatchet(ctx, profile)
	elseif family == "Angler" then
		body = buildAngler(ctx, profile)
	else
		-- "Shark" is the generic fish with shark fittings, so it lands here too.
		body = buildGeneric(ctx, profile)
	end

	if options.Glow and options.Glow > 0 then
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = options.Glow
		light.Brightness = 0.7
		light.Shadows = false
		light.Parent = body
	end
	if options.Sparkle then
		local glints = Instance.new("ParticleEmitter")
		glints.Color = ColorSequence.new(color)
		-- NOT 1. Fully additive glints stack past white and draw over solid
		-- geometry, which is what turned the bay into a blown-out smear.
		glints.LightEmission = 0.3
		glints.Size = NumberSequence.new(0.3 * scale, 0)
		glints.Transparency = NumberSequence.new(0.1, 1)
		glints.Lifetime = NumberRange.new(0.7, 1.5)
		glints.Rate = 7
		glints.Speed = NumberRange.new(0.5, 1.6)
		glints.SpreadAngle = Vector2.new(60, 60)
		glints.Parent = body
	end

	model.PrimaryPart = body
	-- Pivot at the model's own CENTROID, not the origin. Species are no longer
	-- one shape built symmetrically around zero: a squid is mostly tentacles out
	-- front and an eel trails a long way behind. With the pivot left at the
	-- origin those spin in the reveal card by ORBITING the middle of the frame
	-- instead of turning on the spot, and PivotTo elsewhere puts them down
	-- off-target by half their own length.
	local box = model:GetBoundingBox()
	model.WorldPivot = CFrame.new(box.Position)
	return model
end

return FishShape
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

function Format.Number(value: number): string
	if value ~= value or value == math.huge then
		return "0"
	end
	local magnitude = 1
	local scaled = value
	while math.abs(scaled) >= 1000 and magnitude < #SUFFIXES do
		scaled /= 1000
		magnitude += 1
	end
	if magnitude == 1 then
		return tostring(math.floor(scaled + 0.5))
	end
	local text = string.format("%.2f%s", scaled, SUFFIXES[magnitude])
	text = string.gsub(text, "%.00", "")
	return text
end

function Format.Percent(value: number): string
	if value >= 10 then
		return string.format("%.1f%%", value)
	elseif value >= 0.1 then
		return string.format("%.2f%%", value)
	end
	return string.format("%.3f%%", value)
end

function Format.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return string.format("%d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
	end
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return string.format("%dh %dm", seconds // 3600, (seconds % 3600) // 60)
	elseif seconds >= 60 then
		return string.format("%dm", seconds // 60)
	end
	return string.format("%ds", seconds)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">RarityMath</string>
          <string name="Source"><![CDATA[--!strict
-- Single source of truth for every random roll AND for the odds the player sees.
-- The compliance odds panel (May 2026 paid-random-items rules: exact percentages,
-- summing to 100, updating live with luck boosts) renders straight from these
-- functions, so displayed odds can never drift from actual odds.

local Crystals = require(script.Parent.Config.Crystals)
local Balance = require(script.Parent.Config.Balance)

local RarityMath = {}

export type OddsEntry = { Name: string, Tier: string, Chance: number, Color: Color3 }

local function tierIndex(tier: string): number
	for i, name in Crystals.Tiers do
		if name == tier then
			return i
		end
	end
	return 1
end

-- Effective luck = gamepass (2x) * active event * layer creep. Multiplies the
-- weight of Rare+ bases, then everything renormalizes to 100%.
function RarityMath.EffectiveLuck(passLuck: number, eventLuck: number, layer: number): number
	local layerLuck = 1 + Balance.LayerLuckBonus * (math.max(layer, 1) - 1)
	return passLuck * eventLuck * layerLuck
end

-- `kind` picks the pool: "Fish" is what a cast can bring up, "Relic" is what is
-- inside a chest. They are separate draws with separate odds — a chest cannot
-- give you a mackerel and a cast cannot give you a crown — and each pool
-- renormalises to 100 on its own, so the odds panel is honest about whichever
-- one the player is looking at. Defaults to Fish, the far more common question.
function RarityMath.GetBaseOdds(layer: number, luck: number, kind: string?): { OddsEntry }
	local pool = kind or Crystals.FISH
	local weighted = {}
	local total = 0
	for _, def in Crystals.Bases do
		-- A window, not a floor. Species drop OUT of the pool as you sail deeper,
		-- so an area is a different set of fish rather than the last set plus a few.
		if def.Kind == pool and def.MinLayer <= layer and layer <= def.MaxLayer then
			local weight = def.Weight
			if tierIndex(def.Tier) >= Crystals.LuckyTierThreshold then
				weight *= luck
			end
			table.insert(weighted, { Def = def, Weight = weight })
			total += weight
		end
	end
	local odds: { OddsEntry } = {}
	for _, entry in weighted do
		table.insert(odds, {
			Name = entry.Def.Name,
			Tier = entry.Def.Tier,
			Chance = entry.Weight / total * 100,
			Color = entry.Def.Color,
		})
	end
	-- Sorted by actual chance, not by config order. Luck multiplies Rare+ weights
	-- only, so at 2x luck an Emerald genuinely does out-drop a Topaz — that is
	-- luck working. Listing them in config order just made it look like a bug.
	table.sort(odds, function(a, b)
		return a.Chance > b.Chance
	end)
	return odds
end

function RarityMath.RollBase(layer: number, luck: number, rng: Random, kind: string?): string
	local odds = RarityMath.GetBaseOdds(layer, luck, kind)
	local roll = rng:NextNumber() * 100
	local cursor = 0
	for _, entry in odds do
		cursor += entry.Chance
		if roll <= cursor then
			return entry.Name
		end
	end
	return odds[#odds].Name
end

-- Mutations roll independently of base luck; the Aurora event multiplies them.
function RarityMath.GetMutationOdds(mutationMult: number): { OddsEntry }
	local odds: { OddsEntry } = {}
	local usedChance = 0
	for _, def in Crystals.Mutations do
		local chance = math.min(def.Chance * mutationMult, 100 - usedChance)
		usedChance += chance
		table.insert(odds, {
			Name = def.Name,
			Tier = "Mutation",
			Chance = chance,
			Color = def.Color or Color3.new(1, 1, 1),
		})
	end
	table.insert(odds, {
		Name = "Normal",
		Tier = "Mutation",
		Chance = 100 - usedChance,
		Color = Color3.fromRGB(200, 200, 200),
	})
	table.sort(odds, function(a, b)
		return a.Chance > b.Chance
	end)
	return odds
end

function RarityMath.RollMutation(mutationMult: number, rng: Random): string
	local odds = RarityMath.GetMutationOdds(mutationMult)
	local roll = rng:NextNumber() * 100
	local cursor = 0
	for _, entry in odds do
		cursor += entry.Chance
		if roll <= cursor then
			return entry.Name
		end
	end
	return "Normal"
end

function RarityMath.ComputeValue(baseName: string, mutationName: string, size: number, layer: number): number
	local base = Crystals.GetBase(baseName)
	if not base then
		return 0
	end
	local mutationMult = 1
	local mutation = Crystals.GetMutation(mutationName)
	if mutation then
		mutationMult = mutation.ValueMult
	end
	local layerMult = Balance.LayerValueMult ^ (math.max(layer, 1) - 1)
	return math.floor(base.Value * mutationMult * size * layerMult + 0.5)
end

-- Guaranteed Rare-or-better roll from one pool. Drives the first-session pity
-- roll and the premium shop offer — a pull that cannot disappoint.
--
-- The fallback is computed, not hard-coded. Entries drop out of the pool between
-- areas, so naming one here would eventually return something that does not
-- exist where the player is.
function RarityMath.RollRarePlus(layer: number, luck: number, rng: Random, kind: string?): string
	local pool = kind or Crystals.FISH
	for _ = 1, 40 do
		local name = RarityMath.RollBase(layer, luck, rng, pool)
		local def = Crystals.GetBase(name)
		if def and tierIndex(def.Tier) >= Crystals.LuckyTierThreshold then
			return name
		end
	end
	-- 40 misses: fall back to the rarest entry this area actually holds.
	local best: Crystals.CrystalDef? = nil
	for _, def in Crystals.BasesInLayer(layer, pool) do
		if not best or def.Weight < best.Weight then
			best = def
		end
	end
	return best and best.Name or Crystals.Bases[1].Name
end

return RarityMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RelicShape</string>
          <string name="Source"><![CDATA[--!strict
-- Relic geometry: every piece of sunken treasure built as the object it actually
-- is, from primitives, with no asset uploads.
--
-- Routing relics through CrystalShape made all eleven of them the same faceted
-- gem cluster in eleven colours. That is the exact failure the fish had before
-- FishShape — a name on a card doing all the work while the picture says
-- "generic collectible". A Rusty Anchor has to look like an anchor, or the
-- second collection is just the first one with different text.
--
-- Everything is built upright and facing +Z, because that is where the viewport
-- camera and the billboard over a player's head both look from.

local RelicShape = {}

export type Options = {
	Name: string,
	Color: Color3,
	Scale: number?,
	Seed: number?,
	Glow: number?,
	Sparkle: boolean?,
}

local GOLD = Color3.fromRGB(226, 178, 62)
local BRASS = Color3.fromRGB(198, 152, 74)
local DARK = Color3.fromRGB(48, 44, 52)

local function piece(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

-- A ring standing in the XY plane, made of short bars around a circle. Used for
-- the anchor's shackle, the astrolabe's rings and the crown's band.
local function ring(parent: Instance, center: Vector3, radius: number, thick: number, segments: number, color: Color3, material: Enum.Material)
	local chord = 2 * radius * math.sin(math.pi / segments) * 1.3
	for i = 1, segments do
		local theta = (i - 1) / segments * math.pi * 2
		piece(parent, {
			Name = "RingSeg",
			Size = Vector3.new(chord, thick, thick),
			CFrame = CFrame.new(center + Vector3.new(math.cos(theta) * radius, math.sin(theta) * radius, 0))
				* CFrame.Angles(0, 0, theta + math.pi * 0.5),
			Color = color,
			Material = material,
		})
	end
end

type Builder = (Model, Color3) -> ()

local BUILDERS: { [string]: Builder } = {}

BUILDERS["Rusty Anchor"] = function(model, color)
	piece(model, { Name = "Shank", Size = Vector3.new(0.34, 3, 0.34), Position = Vector3.new(0, 0.2, 0), Color = color, Material = Enum.Material.CorrodedMetal })
	piece(model, { Name = "Stock", Size = Vector3.new(2.2, 0.28, 0.28), Position = Vector3.new(0, 1.2, 0), Color = color, Material = Enum.Material.CorrodedMetal })
	ring(model, Vector3.new(0, 1.95, 0), 0.42, 0.2, 8, color, Enum.Material.CorrodedMetal)
	-- Flukes: two arms sweeping up and out from the bottom of the shank.
	for _, side in { -1, 1 } do
		piece(model, {
			Name = "Arm",
			Size = Vector3.new(1.5, 0.3, 0.3),
			CFrame = CFrame.new(side * 0.65, -1.15, 0) * CFrame.Angles(0, 0, side * 0.5),
			Color = color,
			Material = Enum.Material.CorrodedMetal,
		})
		piece(model, {
			Name = "Fluke",
			Size = Vector3.new(0.6, 0.62, 0.22),
			CFrame = CFrame.new(side * 1.28, -0.72, 0) * CFrame.Angles(0, 0, side * 0.9),
			Color = color,
			Material = Enum.Material.CorrodedMetal,
		})
	end
end

BUILDERS["Message in a Bottle"] = function(model, color)
	piece(model, { Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 1.25, 1.25), CFrame = CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = Enum.Material.Glass, Transparency = 0.45 })
	piece(model, { Name = "Neck", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, 0.55, 0.55), CFrame = CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = Enum.Material.Glass, Transparency = 0.45 })
	piece(model, { Name = "Cork", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.45, 0.52, 0.52), CFrame = CFrame.new(0, 1.95, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(196, 160, 108), Material = Enum.Material.Wood })
	-- The scroll inside, which is the entire reason it is a message in a bottle.
	piece(model, { Name = "Scroll", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 0.55, 0.55), CFrame = CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.rad(65)), Color = Color3.fromRGB(238, 226, 190), Material = Enum.Material.SmoothPlastic })
end

BUILDERS["Silver Doubloon"] = function(model, color)
	piece(model, { Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2.9, 2.9), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = color, Material = Enum.Material.Metal })
	ring(model, Vector3.new(0, 0, 0.16), 1.28, 0.16, 14, color:Lerp(Color3.new(1, 1, 1), 0.4), Enum.Material.Metal)
	piece(model, { Name = "Emboss", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 1.5, 1.5), CFrame = CFrame.new(0, 0, 0.2) * CFrame.Angles(0, math.rad(90), 0), Color = color:Lerp(DARK, 0.3), Material = Enum.Material.Metal })
	piece(model, { Name = "Cross", Size = Vector3.new(0.22, 1.1, 0.12), Position = Vector3.new(0, 0, 0.28), Color = color:Lerp(Color3.new(1, 1, 1), 0.5), Material = Enum.Material.Metal })
	piece(model, { Name = "CrossBar", Size = Vector3.new(0.8, 0.22, 0.12), Position = Vector3.new(0, 0.14, 0.28), Color = color:Lerp(Color3.new(1, 1, 1), 0.5), Material = Enum.Material.Metal })
end

BUILDERS["Ship's Compass"] = function(model, color)
	piece(model, { Name = "Case", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.75, 2.8, 2.8), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = color, Material = Enum.Material.Metal })
	piece(model, { Name = "Face", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 2.3, 2.3), CFrame = CFrame.new(0, 0, 0.4) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(242, 232, 206), Material = Enum.Material.SmoothPlastic })
	-- Needle: red north, white south, which is the read at a glance.
	piece(model, { Name = "NeedleN", Size = Vector3.new(0.16, 1, 0.1), CFrame = CFrame.new(0, 0.42, 0.5) * CFrame.Angles(0, 0, math.rad(24)), Color = Color3.fromRGB(214, 66, 60), Material = Enum.Material.SmoothPlastic })
	piece(model, { Name = "NeedleS", Size = Vector3.new(0.16, 1, 0.1), CFrame = CFrame.new(0, -0.42, 0.5) * CFrame.Angles(0, 0, math.rad(24)), Color = Color3.fromRGB(240, 240, 244), Material = Enum.Material.SmoothPlastic })
	piece(model, { Name = "Pin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.16, 0.3, 0.3), CFrame = CFrame.new(0, 0, 0.56) * CFrame.Angles(0, math.rad(90), 0), Color = BRASS, Material = Enum.Material.Metal })
	piece(model, { Name = "Lid", Size = Vector3.new(2.6, 0.2, 0.9), CFrame = CFrame.new(0, 1.5, -0.1) * CFrame.Angles(math.rad(-35), 0, 0), Color = color:Lerp(DARK, 0.25), Material = Enum.Material.Metal })
end

BUILDERS["Diver's Helmet"] = function(model, color)
	piece(model, { Name = "Dome", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.5, 2.6), Position = Vector3.new(0, 0.25, 0), Color = color, Material = Enum.Material.Metal })
	piece(model, { Name = "Collar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.5, 2.5), CFrame = CFrame.new(0, -1.05, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = color:Lerp(DARK, 0.25), Material = Enum.Material.Metal })
	-- Faceplate: the round window and its bolted ring, the one detail that makes
	-- a copper ball unmistakably a diving helmet.
	piece(model, { Name = "Glass", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1.5, 1.5), CFrame = CFrame.new(0, 0.3, 1.2) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(170, 220, 235), Material = Enum.Material.Glass, Transparency = 0.35 })
	ring(model, Vector3.new(0, 0.3, 1.22), 0.82, 0.2, 10, color:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.Metal)
	for i = 1, 6 do
		local theta = (i - 1) / 6 * math.pi * 2
		piece(model, { Name = "Bolt", Shape = Enum.PartType.Ball, Size = Vector3.new(0.2, 0.2, 0.2), Position = Vector3.new(math.cos(theta) * 0.82, 0.3 + math.sin(theta) * 0.82, 1.3), Color = BRASS, Material = Enum.Material.Metal })
	end
	piece(model, { Name = "Valve", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 0.4, 0.4), CFrame = CFrame.new(-1.1, 0.7, 0.3) * CFrame.Angles(0, 0, math.rad(20)), Color = BRASS, Material = Enum.Material.Metal })
end

BUILDERS["Pirate Cutlass"] = function(model, color)
	-- Blade: short segments fanned along an arc, so it curves like a cutlass
	-- instead of being a straight bar with a handle.
	for i = 1, 7 do
		local t = i / 7
		piece(model, {
			Name = "Blade" .. i,
			Size = Vector3.new(0.42 - t * 0.14, 0.52, 0.12),
			CFrame = CFrame.new(t * 0.55, -0.4 + i * 0.44, 0) * CFrame.Angles(0, 0, -t * 0.26),
			Color = color,
			Material = Enum.Material.Metal,
		})
	end
	piece(model, { Name = "Guard", Size = Vector3.new(1.5, 0.24, 0.3), Position = Vector3.new(0, -0.15, 0), Color = GOLD, Material = Enum.Material.Metal })
	piece(model, { Name = "Knuckle", Size = Vector3.new(0.24, 1.1, 0.26), CFrame = CFrame.new(0.62, -0.75, 0) * CFrame.Angles(0, 0, math.rad(-18)), Color = GOLD, Material = Enum.Material.Metal })
	piece(model, { Name = "Grip", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 0.36, 0.36), CFrame = CFrame.new(0, -0.85, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(84, 54, 40), Material = Enum.Material.Wood })
	piece(model, { Name = "Pommel", Shape = Enum.PartType.Ball, Size = Vector3.new(0.46, 0.46, 0.46), Position = Vector3.new(0, -1.5, 0), Color = GOLD, Material = Enum.Material.Metal })
end

BUILDERS["Captain's Spyglass"] = function(model, color)
	-- Three telescoping sections, each shorter and narrower than the last.
	local sections = { { len = 1.5, rad = 0.72, at = -0.9 }, { len = 1.3, rad = 0.56, at = 0.5 }, { len = 1.1, rad = 0.42, at = 1.7 } }
	for i, s in sections do
		piece(model, { Name = "Tube" .. i, Shape = Enum.PartType.Cylinder, Size = Vector3.new(s.len, s.rad * 2, s.rad * 2), CFrame = CFrame.new(0, s.at, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = color:Lerp(DARK, (i - 1) * 0.12), Material = Enum.Material.Metal })
		piece(model, { Name = "Band" .. i, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.18, s.rad * 2.2, s.rad * 2.2), CFrame = CFrame.new(0, s.at + s.len * 0.45, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = BRASS, Material = Enum.Material.Metal })
	end
	piece(model, { Name = "Grip", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.7, 1.5, 1.5), CFrame = CFrame.new(0, -0.9, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(84, 54, 40), Material = Enum.Material.Wood })
	piece(model, { Name = "Lens", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 0.7, 0.7), CFrame = CFrame.new(0, 2.28, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(180, 226, 240), Material = Enum.Material.Glass, Transparency = 0.3 })
end

BUILDERS["Golden Astrolabe"] = function(model, color)
	ring(model, Vector3.new(0, 0, 0), 1.45, 0.24, 16, color, Enum.Material.Metal)
	ring(model, Vector3.new(0, 0, 0), 1.05, 0.18, 12, color:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.Metal)
	ring(model, Vector3.new(0, 0, 0), 0.65, 0.14, 10, color:Lerp(DARK, 0.2), Enum.Material.Metal)
	piece(model, { Name = "Plate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 1.1, 1.1), CFrame = CFrame.Angles(0, math.rad(90), 0), Color = color:Lerp(DARK, 0.35), Material = Enum.Material.Metal })
	piece(model, { Name = "Rule", Size = Vector3.new(2.7, 0.16, 0.1), CFrame = CFrame.new(0, 0, 0.22) * CFrame.Angles(0, 0, math.rad(28)), Color = color:Lerp(Color3.new(1, 1, 1), 0.4), Material = Enum.Material.Metal })
	piece(model, { Name = "Hanger", Size = Vector3.new(0.2, 0.4, 0.2), Position = Vector3.new(0, 1.66, 0), Color = color, Material = Enum.Material.Metal })
	ring(model, Vector3.new(0, 2.05, 0), 0.28, 0.14, 8, color, Enum.Material.Metal)
end

BUILDERS["Mermaid's Mirror"] = function(model, color)
	ring(model, Vector3.new(0, 0.55, 0), 1.25, 0.3, 16, GOLD, Enum.Material.Metal)
	piece(model, { Name = "Glass", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.16, 2.3, 2.3), CFrame = CFrame.new(0, 0.55, 0) * CFrame.Angles(0, math.rad(90), 0), Color = color, Material = Enum.Material.Glass, Transparency = 0.25, Reflectance = 0.6 })
	piece(model, { Name = "Handle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 0.3, 0.3), CFrame = CFrame.new(0, -1.1, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = GOLD, Material = Enum.Material.Metal })
	piece(model, { Name = "Knob", Shape = Enum.PartType.Ball, Size = Vector3.new(0.44, 0.44, 0.44), Position = Vector3.new(0, -1.9, 0), Color = GOLD, Material = Enum.Material.Metal })
	for _, side in { -1, 1 } do
		piece(model, { Name = "Scroll", Size = Vector3.new(0.5, 0.24, 0.2), CFrame = CFrame.new(side * 0.6, -0.55, 0) * CFrame.Angles(0, 0, side * 0.6), Color = GOLD, Material = Enum.Material.Metal })
	end
end

BUILDERS["Sunken Crown"] = function(model, color)
	ring(model, Vector3.new(0, -0.5, 0), 1.25, 0.42, 14, color, Enum.Material.Metal)
	-- Points around the band, alternating tall and short, each capped with a gem.
	for i = 1, 8 do
		local theta = (i - 1) / 8 * math.pi * 2
		local tall = i % 2 == 1
		local height = tall and 1.15 or 0.7
		local at = Vector3.new(math.cos(theta) * 1.15, 0.1 + height * 0.5, math.sin(theta) * 1.15)
		piece(model, {
			Name = "Point",
			Size = Vector3.new(0.34, height, 0.34),
			CFrame = CFrame.new(at) * CFrame.Angles(math.cos(theta) * 0.12, 0, -math.sin(theta) * 0.12),
			Color = color,
			Material = Enum.Material.Metal,
		})
		if tall then
			piece(model, {
				Name = "Gem",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.42, 0.42, 0.42),
				Position = at + Vector3.new(0, height * 0.55, 0),
				Color = Color3.fromRGB(90, 180, 255),
				Material = Enum.Material.Neon,
			})
		end
	end
end

BUILDERS["Poseidon's Trident"] = function(model, color)
	piece(model, { Name = "Shaft", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4.2, 0.3, 0.3), CFrame = CFrame.new(0, -0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = Enum.Material.Metal })
	piece(model, { Name = "Head", Size = Vector3.new(1.9, 0.26, 0.26), Position = Vector3.new(0, 1.4, 0), Color = color, Material = Enum.Material.Metal })
	-- Three prongs: a long centre and two barbed outer ones.
	for _, x in { -0.8, 0, 0.8 } do
		local height = if x == 0 then 1.5 else 1.15
		piece(model, {
			Name = "Prong",
			Size = Vector3.new(0.22, height, 0.22),
			Position = Vector3.new(x, 1.4 + height * 0.5, 0),
			Color = color,
			Material = Enum.Material.Metal,
		})
		piece(model, {
			Name = "Tip",
			Size = Vector3.new(0.14, 0.4, 0.14),
			Position = Vector3.new(x, 1.4 + height + 0.18, 0),
			Color = color:Lerp(Color3.new(1, 1, 1), 0.5),
			Material = Enum.Material.Neon,
		})
	end
	piece(model, { Name = "Butt", Shape = Enum.PartType.Ball, Size = Vector3.new(0.42, 0.42, 0.42), Position = Vector3.new(0, -2.7, 0), Color = color, Material = Enum.Material.Metal })
end

-- Anything without its own builder: a small hoard of coins and a bar. Better an
-- honest generic pile of treasure than a gem pretending to be a spyglass, and it
-- means a new relic row can ship before its model does.
local function buildFallback(model: Model, color: Color3)
	piece(model, { Name = "Bar", Size = Vector3.new(1.8, 0.5, 0.9), Position = Vector3.new(0, -0.6, 0), Color = color, Material = Enum.Material.Metal })
	local rng = Random.new(3)
	for i = 1, 6 do
		piece(model, {
			Name = "Coin" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.16, 0.8, 0.8),
			CFrame = CFrame.new(rng:NextNumber(-0.9, 0.9), -0.1 + i * 0.14, rng:NextNumber(-0.4, 0.4))
				* CFrame.Angles(math.rad(90), 0, rng:NextNumber(-0.5, 0.5)),
			Color = color:Lerp(Color3.new(1, 1, 1), rng:NextNumber(0, 0.4)),
			Material = Enum.Material.Metal,
		})
	end
end

function RelicShape.Build(options: Options): Model
	local model = Instance.new("Model")
	model.Name = "Relic"

	-- Typed explicitly: Luau will not call a union of two identically shaped
	-- function types, so the branch has to name what it returns.
	local build: Builder = BUILDERS[options.Name] or buildFallback
	build(model, options.Color)

	local anchor = model:FindFirstChildWhichIsA("BasePart")
	if anchor then
		if options.Glow and options.Glow > 0 then
			local light = Instance.new("PointLight")
			light.Color = options.Color
			light.Range = options.Glow
			light.Brightness = 0.7
			light.Shadows = false
			light.Parent = anchor
		end
		if options.Sparkle then
			local glints = Instance.new("ParticleEmitter")
			glints.Color = ColorSequence.new(options.Color)
			glints.LightEmission = 0.3
			glints.Size = NumberSequence.new(0.3, 0)
			glints.Transparency = NumberSequence.new(0.15, 1)
			glints.Lifetime = NumberRange.new(0.6, 1.3)
			glints.Rate = 6
			glints.Speed = NumberRange.new(0.4, 1.4)
			glints.SpreadAngle = Vector2.new(70, 70)
			glints.Parent = anchor
		end
	end

	-- Scale after building, so each builder can work in whatever studs read best
	-- for its own shape and the caller still gets one consistent size knob.
	local scale = options.Scale or 1
	if scale ~= 1 then
		for _, part in model:GetChildren() do
			if part:IsA("BasePart") then
				part.Size *= scale
				part.CFrame = CFrame.new(part.Position * scale) * (part.CFrame - part.Position)
			end
		end
	end

	-- Pivot at the centroid, matching FishShape: relics are hand-built and none
	-- of them is symmetrical about the origin, so an origin pivot makes them
	-- orbit the frame when they spin and land off-target when placed.
	local box = model:GetBoundingBox()
	model.WorldPivot = CFrame.new(box.Position)
	return model
end

-- True when this relic has a hand-built model rather than the generic hoard.
function RelicShape.HasModel(name: string): boolean
	return BUILDERS[name] ~= nil
end

return RelicShape
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Creates (server) or fetches (client) all RemoteEvents/RemoteFunctions.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = {
	"StateSync", -- server -> client: sanitized profile snapshot
	"ServerEvent", -- server -> client: {Name, EndsAt} or nil when an event starts/ends
	"Notify", -- server -> client: toast messages { Text, Color? }
	"WelcomeReport", -- server -> client on join: offline earnings + streak summary
	"CrackResult", -- server -> client: crystals from a crack (drives the reveal)
	"RareFind", -- server -> all clients: someone pulled a Legendary+ (social proof)
	"RebirthFx", -- server -> client: run the Set Sail ritual
	"MineNode", -- client -> server: tapped a fishing spot (Tools swallow ClickDetector clicks)
	"ReelStart", -- server -> client: a fish is on, run the reel-in minigame
	"ReelResult", -- client -> server: how well the reel went (0..1 quality)
}

local FUNCTIONS = {
	"CrackGeode", -- (count) -> ok, err
	"SellCrystal", -- (crystalId | "all") -> ok, err
	"SocketCrystal", -- (crystalId) -> ok, err
	"UnsocketCrystal", -- (slotIndex) -> ok, err
	"CollectRacks", -- () -> coinsCollected
	"BuyUpgrade", -- ("Pickaxe"|"Backpack"|"RackSlot") -> ok, err
	"Rebirth", -- () -> ok, err
	"GetShopStock", -- () -> stock table (policy-filtered)
	"BuyShopItem", -- (itemIndex) -> ok, err
	"ToggleAutoCrack", -- () -> nowEnabled (pass owners can watch the full reveal again)
	"BuyArea", -- (areaIndex) -> ok, err  (coins; permanent, survives Set Sail)
	"TravelArea", -- (areaIndex) -> ok, err  (sail to water you already own)
}

local Remotes = {}

local function container(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
		if not folder then
			local newFolder = Instance.new("Folder")
			newFolder.Name = "Remotes"
			newFolder.Parent = ReplicatedStorage
			folder = newFolder
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

-- Both lookups are by name only, and the `::` casts are compile-time fiction —
-- so a name listed in the wrong registry hands back the wrong class and dies
-- later at `.OnServerEvent`, deep inside a service, with a message that points
-- nowhere near the actual mistake. Check the class here instead, where the name
-- and the expectation are both in view.
local function typedRemote(name: string, className: string): Instance
	local folder = container()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing then
			if not existing:IsA(className) then
				error(
					("Remote %q is a %s but was requested as a %s — it is listed in the wrong table in Remotes.luau"):format(
						name,
						existing.ClassName,
						className
					),
					3
				)
			end
			return existing
		end
		local created = Instance.new(className)
		created.Name = name
		created.Parent = folder
		return created
	end
	local remote = folder:WaitForChild(name)
	if not remote:IsA(className) then
		error(("Remote %q is a %s but was requested as a %s"):format(name, remote.ClassName, className), 3)
	end
	return remote
end

function Remotes.Event(name: string): RemoteEvent
	return typedRemote(name, "RemoteEvent") :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return typedRemote(name, "RemoteFunction") :: RemoteFunction
end

function Remotes.Init()
	for _, name in EVENTS do
		Remotes.Event(name)
	end
	for _, name in FUNCTIONS do
		Remotes.Function(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Bootstrap: build the world, wire services into a shared context, start data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local AnalyticsService = require(script.AnalyticsService)
local AreaService = require(script.AreaService)
local AutoCastService = require(script.AutoCastService)
local CrackService = require(script.CrackService)
local DataService = require(script.DataService)
local EventService = require(script.EventService)
local FlexAura = require(script.FlexAura)
local Leaderboards = require(script.Leaderboards)
local MapBuilder = require(script.MapBuilder)
local MiningService = require(script.MiningService)
local MonetizationService = require(script.MonetizationService)
local PolicyGuard = require(script.PolicyGuard)
local RackService = require(script.RackService)
local RebirthService = require(script.RebirthService)
local RodVisual = require(script.RodVisual)
local ShopService = require(script.ShopService)
local Spotlight = require(script.Spotlight)
local StreakService = require(script.StreakService)
local UpgradeService = require(script.UpgradeService)

Remotes.Init()
local map = MapBuilder.Build()

local ctx: any = {
	Data = DataService,
	Crack = CrackService,
	Mining = MiningService,
	Areas = AreaService,
	Racks = RackService,
	Rebirth = RebirthService,
	Shop = ShopService,
	Events = EventService,
	Streak = StreakService,
	Upgrades = UpgradeService,
	Monetization = MonetizationService,
	Policy = PolicyGuard,
	RodVis = RodVisual,
	Analytics = AnalyticsService,
	Flex = FlexAura,
	Spotlight = Spotlight,
}

-- Called by DataService once a profile is loaded (before the first StateSync).
ctx.OnProfileLoaded = function(player: Player, data: any)
	MonetizationService.PreloadPasses(player, data)
	FlexAura.Apply(player, data)
	local streakReport = StreakService.HandleJoin(player, data)
	local offline = RackService.OfflineSummary(player, data)
	-- Give the client a moment to boot its UI, then show the welcome moment.
	task.delay(2, function()
		if player.Parent then
			Remotes.Event("WelcomeReport"):FireClient(player, {
				Streak = streakReport,
				Offline = offline,
			})
		end
	end)
end

ctx.OnProfileReleasing = function(player: Player, data: any)
	Leaderboards.Save(player, data)
end

AnalyticsService.Init(ctx)
PolicyGuard.Init(ctx)
EventService.Init(ctx)
MonetizationService.Init(ctx)
CrackService.Init(ctx)
RackService.Init(ctx)
RebirthService.Init(ctx)
UpgradeService.Init(ctx)
ShopService.Init(ctx)
StreakService.Init(ctx)
MiningService.Init(ctx, map.Nodes)
AreaService.SetOrigins(map.Origins)
AreaService.Init(ctx)
AutoCastService.Init(ctx) -- after MiningService: it drives casts through it
RodVisual.Init(ctx)
Leaderboards.Init(ctx, map.BoardRebirths, map.BoardRarest)
DataService.Init(ctx)

print("[ReelARelic] Server ready.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">AnalyticsService</string>
          <string name="Source"><![CDATA[--!strict
-- Fail-safe wrapper over Roblox AnalyticsService. The onboarding funnel
-- (FirstGeode -> FirstCrack -> FirstRare -> FirstSocket -> FirstRebirth) is
-- the go/no-go dashboard for ad spend — and each first-time step now pays a
-- small coin reward so the on-screen objectives feel like a tutorial quest.

local RobloxAnalytics = game:GetService("AnalyticsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local AnalyticsService = {}

local ctx: any = nil

local STEP_REWARDS = { 50, 100, 150, 250, 500 }

function AnalyticsService.FunnelStep(player: Player, data: any, step: number, stepName: string)
	if data.Funnel[stepName] then
		return
	end
	data.Funnel[stepName] = true
	pcall(function()
		RobloxAnalytics:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
	local reward = STEP_REWARDS[step]
	if reward and ctx then
		ctx.Data.AddCoins(player, reward, false)
		Remotes.Event("Notify"):FireClient(player, {
			Text = "Objective complete!  +" .. reward .. " coins",
			Color = Color3.fromRGB(120, 255, 200),
		})
	end
end

function AnalyticsService.LogCustom(player: Player, eventName: string, value: number?)
	pcall(function()
		RobloxAnalytics:LogCustomEvent(player, eventName, value or 1)
	end)
end

function AnalyticsService.Init(serviceCtx: any)
	ctx = serviceCtx
end

return AnalyticsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">AreaService</string>
          <string name="Source"><![CDATA[--!strict
-- Areas: five separate stretches of water, bought once with coins and sailed
-- between from the Dock Master at the home port.
--
-- This is the game's progression spine. Rebirth ("Set Sail") still exists and
-- still grants the permanent coin multiplier, but it no longer decides what you
-- can catch — and, critically, it does NOT take areas back. Content you bought
-- stays bought. That separation is what makes an area worth saving for: a goal
-- you can lose is a threat, not a goal.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)
local Spotlight = require(script.Parent.Spotlight)

local AreaService = {}

local AREA_COLOR = Color3.fromRGB(120, 200, 255)

local ctx: any = nil
local origins: { Vector3 } = {}

-- Below this and you are out of the world. The sea floor is at -6.4 and the
-- terrain block bottoms out around -16, so -60 is unambiguously "fell through"
-- while still being far above Roblox's own destroy height.
local VOID_Y = -60

-- Where each area's dock is, filled in by MapBuilder at startup.
function AreaService.SetOrigins(list: { Vector3 })
	origins = list
end

function AreaService.Cost(index: number): number
	return Balance.AreaCosts[index] or math.huge
end

local function teleport(player: Player, index: number): boolean
	local origin = origins[index]
	local character = player.Character
	if not origin or not character then
		return false
	end
	-- Land on the dock, a few studs back from the water, facing the spots.
	character:PivotTo(CFrame.new(origin + Vector3.new(0, 4, 12)))
	return true
end

function AreaService.Travel(player: Player, index: number): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	if index < 1 or index > Balance.MaxLayer then
		return false, "No such area."
	end
	if index > data.AreaUnlocked then
		return false, "You haven't bought that area yet."
	end
	if not teleport(player, index) then
		return false, "Couldn't find your boat."
	end
	data.AreaCurrent = index
	ctx.Data.MarkDirty(player)
	Remotes.Event("Notify"):FireClient(player, {
		Text = "Now fishing: " .. Balance.LayerNames[index],
		Color = AREA_COLOR,
	})
	return true, nil
end

function AreaService.Buy(player: Player, index: number): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	if index < 1 or index > Balance.MaxLayer then
		return false, "No such area."
	end
	if index <= data.AreaUnlocked then
		return false, "You already own that area."
	end
	-- Strictly one at a time. Letting a rich player skip straight to the Abyss
	-- would delete three areas of content they paid nothing to see.
	if index ~= data.AreaUnlocked + 1 then
		return false, "Unlock " .. Balance.LayerNames[data.AreaUnlocked + 1] .. " first."
	end
	local cost = AreaService.Cost(index)
	if data.Coins < cost then
		return false, ("Need %d coins to reach %s."):format(cost, Balance.LayerNames[index])
	end
	data.Coins -= cost
	data.AreaUnlocked = index
	ctx.Data.MarkDirty(player)
	ctx.Analytics.FunnelStep(player, data, 4, "FirstArea")

	-- Buying new water is the biggest single thing a player does with coins in
	-- this game. It gets the room's attention, and it is true: they really did.
	Spotlight.Pillar(player, AREA_COLOR)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.Event("Notify"):FireClient(other, {
				Text = ("%s just opened up %s!"):format(player.DisplayName, Balance.LayerNames[index]),
				Color = AREA_COLOR,
			})
		end
	end
	AreaService.Travel(player, index)
	return true, nil
end

function AreaService.Init(serviceCtx: any)
	ctx = serviceCtx

	-- THE SAFETY NET. Invisible walls fence each area's patch of sea, but walls
	-- can be clipped through and the water is swimmable — and a player who ends
	-- up under the world would otherwise fall until Roblox destroyed them and
	-- respawned them at the HOME dock, however far they had sailed.
	--
	-- So: catch them well above that, and put them back on the dock of the area
	-- they are actually in. Cheap (one pass a second over the player list, the
	-- same shape as the Leaderboards loop) and it fails safe — an unknown area
	-- falls back to home rather than doing nothing.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and (root :: BasePart).Position.Y < VOID_Y then
					local data = ctx.Data.Get(player)
					local area = if data then math.clamp(data.AreaCurrent or 1, 1, Balance.MaxLayer) else 1
					if not teleport(player, area) then
						teleport(player, 1)
					end
				end
			end
		end
	end)

	Remotes.Function("BuyArea").OnServerInvoke = function(player, index)
		if typeof(index) ~= "number" then
			return false, "Bad request."
		end
		return AreaService.Buy(player, math.floor(index))
	end

	Remotes.Function("TravelArea").OnServerInvoke = function(player, index)
		if typeof(index) ~= "number" then
			return false, "Bad request."
		end
		return AreaService.Travel(player, math.floor(index))
	end

	-- Put returning players back where they left off. Their character does not
	-- exist yet at profile-load time, so this waits for the spawn.
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(function()
				local data = ctx.Data.Get(player)
				if data and data.AreaCurrent > 1 then
					teleport(player, math.clamp(data.AreaCurrent, 1, data.AreaUnlocked))
				end
			end)
		end)
	end)
end

return AreaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">AutoCastService</string>
          <string name="Source"><![CDATA[--!strict
-- Everything server-side about the Auto-Cast pass.
--
-- The fishing itself is not here, and that is the design: Auto-Cast is a HOLD,
-- not an auto-clicker. The client repeats the same MineNode report a click sends
-- while the button is down, so MiningService cannot tell the difference and does
-- not need to — the bite delay, the 1.2s strike window, one-angler-per-buoy,
-- area gating and hold capacity all apply identically. Nothing fishes on your
-- behalf while you stand still, and it can never out-fish a person, because the
-- wait is the mechanic and the wait is untouched.
--
-- What is left is telling a new owner how it works, once, and offering it to the
-- person it is actually for.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Monetization = require(Shared.Config.Monetization)
local Remotes = require(Shared.Remotes)

local AutoCastService = {}

local ctx: any = nil

-- A pass whose whole benefit is an input change has to say so, or it reads as
-- broken: you buy it, nothing visibly happens, and you keep clicking.
local function maybeTip(player: Player)
	local data = ctx.Data.Get(player)
	if not data or data.Funnel.AutoCastTip then
		return
	end
	if not ctx.Monetization.OwnsPass(player, "AutoCast") then
		return
	end
	data.Funnel.AutoCastTip = true
	ctx.Data.MarkDirty(player)
	Remotes.Event("Notify"):FireClient(player, {
		Text = "Auto-Cast is on — hold the button on a buoy and it casts and strikes for you.",
		Color = Color3.fromRGB(120, 255, 200),
	})
end

-- Offered once, to someone who has already clicked through a few hundred casts
-- and knows exactly what the pass is removing.
local function maybeOffer(player: Player)
	local data = ctx.Data.Get(player)
	if not data or data.Funnel.AutoCastOffer then
		return
	end
	if data.Stats.GeodesMined < Balance.AutoCastOfferAfterCatches then
		return
	end
	if Monetization.PassIdByKey("AutoCast") == 0 then
		return -- pass not created yet; don't advertise something unbuyable
	end
	if ctx.Monetization.OwnsPass(player, "AutoCast") then
		data.Funnel.AutoCastOffer = true
		ctx.Data.MarkDirty(player)
		return
	end
	data.Funnel.AutoCastOffer = true
	ctx.Data.MarkDirty(player)
	Remotes.Event("Notify"):FireClient(player, {
		Text = ("%d casts by hand. Auto-Cast lets you just hold — see the Store."):format(data.Stats.GeodesMined),
		Color = Color3.fromRGB(255, 210, 90),
	})
end

function AutoCastService.Init(serviceCtx: any)
	ctx = serviceCtx

	task.spawn(function()
		while true do
			task.wait(20)
			for _, player in Players:GetPlayers() do
				maybeTip(player)
				maybeOffer(player)
			end
		end
	end)
end

return AutoCastService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CrackService</string>
          <string name="Source"><![CDATA[--!strict
-- Everything that turns a roll into a fish in your hold.
--
-- Two ways in, one set of maths. A fish on the line calls LandFish and goes
-- straight to the hold. A chest is opened at the station through Crack, which
-- rolls guaranteed Rare-or-better with the full reveal animation, the odds panel
-- and the policy gating — the ceremony a chest has to earn.
--
-- All rolls go through shared RarityMath so the client odds panel is provably
-- the same math. Includes the first-session pity roll.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Crystals = require(Shared.Config.Crystals)
local RarityMath = require(Shared.RarityMath)
local Remotes = require(Shared.Remotes)
local Spotlight = require(script.Parent.Spotlight)

local CrackService = {}

export type CrackedCrystal = {
	Id: string,
	Base: string,
	Mut: string,
	Size: number,
	Layer: number,
	Value: number,
	Tier: string,
	New: boolean,
	Pity: boolean?,
	Weight: number,
	Best: boolean?, -- heaviest of this species this player has ever landed
	Color: Color3?,
}

local ctx: any = nil
local rng = Random.new()

-- Mutations that earn a server-wide callout even on a lower-tier base: a
-- Celestial Quartz is a better story than a plain Opal.
local LOUD_MUTATIONS: { [string]: boolean } = { Abyssal = true, Moonlit = true }

-- Every roll path must record a personal best the same way, or a crystal can be
-- announced server-wide and still never become the flex aura, the leaderboard
-- entry, or the name on the "rarest find" board. Shop, streak and starter-pack
-- grants all diverged from the crack path before this was hoisted out.
local function recordRarest(player: Player, data: any, baseName: string, mutName: string, value: number)
	if value <= data.Stats.RarestValue then
		return
	end
	data.Stats.RarestValue = value
	data.Stats.RarestName = (mutName ~= "Normal" and (mutName .. " ") or "") .. baseName
	ctx.Flex.Set(player, baseName, mutName, value)
end

-- Exposed because the shop grants fish without going through any roll here.
CrackService.RecordRarest = recordRarest

-- Personal bests by weight, keyed by species name alone. This is the treadmill
-- that never finishes and never inflates: a 14.2 lb bass is beaten only by a
-- heavier bass, it costs nothing to chase, and unlike a value record it survives
-- every Set Sail. Returns true when this catch is a new best.
local function recordWeight(data: any, baseName: string, weight: number): boolean
	local best = data.BestWeight[baseName]
	if best and weight <= best then
		return false
	end
	data.BestWeight[baseName] = weight
	-- Not a "best" the first time you catch a species — you had nothing to beat.
	return best ~= nil
end

local function tierRank(tier: string): number
	for i, name in Crystals.Tiers do
		if name == tier then
			return i
		end
	end
	return 1
end

-- Social proof: broadcast anything genuinely rare. Nothing here is fabricated —
-- the callout fires only on rolls that actually cleared the bar.
local function announceRare(player: Player, crystal: CrackedCrystal)
	local rank = tierRank(crystal.Tier)
	if rank < 5 and not LOUD_MUTATIONS[crystal.Mut] then
		return
	end
	local color = Crystals.TierColors[crystal.Tier] or Color3.fromRGB(255, 210, 90)
	local mutation = Crystals.GetMutation(crystal.Mut)
	if mutation and mutation.Color and LOUD_MUTATIONS[crystal.Mut] then
		color = mutation.Color
	end
	local label = (crystal.Mut ~= "Normal" and (crystal.Mut .. " ") or "") .. crystal.Base
	Remotes.Event("RareFind"):FireAllClients({
		-- UserId, not just the name: DisplayNames are not unique, and matching on
		-- one made a stranger's Mythic render as "YOU FOUND" on someone else's
		-- screen — fabricated first-person social proof.
		UserId = player.UserId,
		Player = player.DisplayName,
		Label = label,
		Tier = crystal.Tier,
		Rank = rank,
		Color = color,
		Value = crystal.Value,
	})
	Spotlight.Pillar(player, color)
end

-- One roll, used by both paths. `kind` is the whole difference between them: a
-- cast draws from the FISH pool, a chest draws from the RELIC pool. Same auras,
-- same value maths, same reveal — completely different thing in your hands.
local function rollOne(player: Player, data: any, kind: string): CrackedCrystal
	local layer = ctx.Data.Layer(data)
	local luck = ctx.Data.LuckMult(player, data)
	local event = ctx.Events.Current()

	local baseName
	local pity = false
	-- The first-session pity roll applies to CHESTS, where the disappointment
	-- would land hardest: a player who carried their first three chests all the
	-- way back to the station deserves to have opened something.
	if kind == Crystals.RELIC then
		data.PityCracks += 1
		if not data.RareGiven and data.PityCracks >= Balance.PityForcedRareCrack then
			baseName = RarityMath.RollRarePlus(layer, luck, rng, kind)
			data.RareGiven = true
			pity = true
		else
			baseName = RarityMath.RollBase(layer, luck, rng, kind)
		end
	else
		baseName = RarityMath.RollBase(layer, luck, rng, kind)
	end
	local mutName = RarityMath.RollMutation(event.MutationMult, rng)
	local size = 0.9 + rng:NextNumber() * 0.3

	local id = tostring(data.NextCrystalId)
	data.NextCrystalId += 1
	local crystal = { Base = baseName, Mut = mutName, Size = size, Layer = layer }
	data.Crystals[id] = crystal
	data.Stats.GeodesCracked += 1

	local key = Crystals.IndexKey(baseName, mutName)
	local isNew = not data.Collection[key]
	if isNew then
		data.Collection[key] = true
		data.CollectionCount += 1
	end

	local value = ctx.Data.CrystalValue(data, crystal)
	recordRarest(player, data, baseName, mutName, value)
	local weight = Crystals.WeightOf(baseName, size)
	local best = recordWeight(data, baseName, weight)

	local def = Crystals.GetBase(baseName)
	return {
		Id = id,
		Base = baseName,
		Mut = mutName,
		Size = size,
		Layer = layer,
		Value = value,
		Tier = def and def.Tier or "Common",
		New = isNew,
		-- The first-session guaranteed Rare+ did not beat any odds, so the card
		-- must not claim it did. Same reasoning for a chest: it says CHEST, not
		-- "against the odds".
		Pity = pity,
		Weight = weight,
		Best = best,
		Color = def and def.Color or nil,
	}
end

-- A fish on the line. No opening step, no ceremony beyond the splash and the
-- weight on the billboard — that restraint is what keeps the chest special.
function CrackService.LandFish(player: Player): CrackedCrystal?
	local data = ctx.Data.Get(player)
	if not data then
		return nil
	end
	local result = rollOne(player, data, Crystals.FISH)
	ctx.Data.MarkDirty(player)
	if result.Best then
		Remotes.Event("Notify"):FireClient(player, {
			Text = ("NEW PERSONAL BEST!  %s — %.1f lb"):format(result.Base, result.Weight),
			Color = Color3.fromRGB(255, 210, 90),
		})
	end
	announceRare(player, result)
	return result
end

-- Manual crack from the Crack Station UI. count is clamped by passes.
function CrackService.Crack(player: Player, count: number?): ({ CrackedCrystal }?, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return nil, "Loading..."
	end
	local wanted = math.clamp(tonumber(count) or 1, 1, 3)
	if wanted > 1 and not ctx.Monetization.OwnsPass(player, "TripleCrack") then
		wanted = 1
	end
	wanted = math.min(wanted, data.Geodes)
	if wanted < 1 then
		return nil, "No chests! Fish one up first."
	end
	data.Geodes -= wanted
	local results = {}
	for _ = 1, wanted do
		-- A chest holds a RELIC, never a fish. That is what makes carrying one
		-- home worth the walk: it is the only way to get the other collection.
		table.insert(results, rollOne(player, data, Crystals.RELIC))
	end
	ctx.Data.MarkDirty(player)
	ctx.Analytics.FunnelStep(player, data, 2, "FirstCrack")
	for _, crystal in results do
		if Crystals.TierColors[crystal.Tier] and (crystal.Tier ~= "Common" and crystal.Tier ~= "Uncommon") then
			ctx.Analytics.FunnelStep(player, data, 3, "FirstRare")
			break
		end
	end
	-- Let the reveal animation land before the server-wide callout
	task.delay(2.4, function()
		if player.Parent then
			for _, crystal in results do
				announceRare(player, crystal)
			end
		end
	end)
	return results, nil
end

-- Auto-Crack gamepass: crack immediately as geodes are mined; result goes to a
-- lightweight client toast instead of the full reveal.
function CrackService.AutoCrack(player: Player)
	local data = ctx.Data.Get(player)
	if not data or data.Geodes < 1 then
		return
	end
	data.Geodes -= 1
	local result = rollOne(player, data, Crystals.RELIC)
	ctx.Data.MarkDirty(player)
	Remotes.Event("CrackResult"):FireClient(player, { result }, true)
	announceRare(player, result)
end

-- Deterministic grant used by the Starter Pack (guaranteed Sunken Crown, no RNG).
function CrackService.GrantFixedCrystal(player: Player, baseName: string, size: number): CrackedCrystal?
	local data = ctx.Data.Get(player)
	if not data then
		return nil
	end
	local layer = ctx.Data.Layer(data)
	local id = tostring(data.NextCrystalId)
	data.NextCrystalId += 1
	local crystal = { Base = baseName, Mut = "Normal", Size = size, Layer = layer }
	data.Crystals[id] = crystal
	local key = Crystals.IndexKey(baseName, "Normal")
	local isNew = not data.Collection[key]
	if isNew then
		data.Collection[key] = true
		data.CollectionCount += 1
	end
	local value = ctx.Data.CrystalValue(data, crystal)
	recordRarest(player, data, baseName, "Normal", value)
	local weight = Crystals.WeightOf(baseName, size)
	local best = recordWeight(data, baseName, weight)
	ctx.Data.MarkDirty(player)
	local def = Crystals.GetBase(baseName)
	return {
		Id = id,
		Base = baseName,
		Mut = "Normal",
		Size = size,
		Layer = layer,
		Value = value,
		Tier = def and def.Tier or "Rare",
		New = isNew,
		Weight = weight,
		Best = best,
		Color = def and def.Color or nil,
	}
end

-- Premium shop geode: rolls with boosted luck, granted straight to inventory.
function CrackService.RollWithLuck(player: Player, luckMult: number): CrackedCrystal?
	local data = ctx.Data.Get(player)
	if not data then
		return nil
	end
	local layer = ctx.Data.Layer(data)
	local passLuck = ctx.Data.LuckMult(player, data)
	local luck = passLuck * luckMult
	local event = ctx.Events.Current()
	local baseName = RarityMath.RollBase(layer, luck, rng)
	local mutName = RarityMath.RollMutation(event.MutationMult, rng)
	local size = 0.9 + rng:NextNumber() * 0.3
	local id = tostring(data.NextCrystalId)
	data.NextCrystalId += 1
	local crystal = { Base = baseName, Mut = mutName, Size = size, Layer = layer }
	data.Crystals[id] = crystal
	data.Stats.GeodesCracked += 1
	local key = Crystals.IndexKey(baseName, mutName)
	local isNew = not data.Collection[key]
	if isNew then
		data.Collection[key] = true
		data.CollectionCount += 1
	end
	local value = ctx.Data.CrystalValue(data, crystal)
	recordRarest(player, data, baseName, mutName, value)
	local weight = Crystals.WeightOf(baseName, size)
	local best = recordWeight(data, baseName, weight)
	ctx.Data.MarkDirty(player)
	local def = Crystals.GetBase(baseName)
	local result: CrackedCrystal = {
		Id = id,
		Base = baseName,
		Mut = mutName,
		Size = size,
		Layer = layer,
		Value = value,
		Tier = def and def.Tier or "Common",
		New = isNew,
		Weight = weight,
		Best = best,
		Color = def and def.Color or nil,
	}
	announceRare(player, result)
	return result
end

function CrackService.SellCrystal(player: Player, idOrAll: string): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	local socketed: { [string]: boolean } = {}
	for _, rack in data.Racks do
		socketed[rack.CrystalId] = true
	end
	local total = 0
	if idOrAll == "all" then
		for id, crystal in data.Crystals do
			if not socketed[id] then
				total += ctx.Data.CrystalValue(data, crystal)
				data.Crystals[id] = nil
			end
		end
	else
		local crystal = data.Crystals[idOrAll]
		if not crystal then
			return false, "Fish not found."
		end
		if socketed[idOrAll] then
			return false, "Remove it from the aquarium first."
		end
		total = ctx.Data.CrystalValue(data, crystal)
		data.Crystals[idOrAll] = nil
	end
	if total <= 0 then
		return false, "Nothing to sell."
	end
	ctx.Data.AddCoins(player, total, true)
	return true, nil
end

function CrackService.Init(serviceCtx: any)
	ctx = serviceCtx
	Remotes.Function("CrackGeode").OnServerInvoke = function(player, count)
		return CrackService.Crack(player, count :: any)
	end
	Remotes.Function("SellCrystal").OnServerInvoke = function(player, idOrAll)
		if typeof(idOrAll) ~= "string" then
			return false, "Bad request."
		end
		return CrackService.SellCrystal(player, idOrAll)
	end
	Remotes.Function("ToggleAutoCrack").OnServerInvoke = function(player)
		local data = ctx.Data.Get(player)
		if not data then
			return false
		end
		data.Settings.AutoCrack = data.Settings.AutoCrack == false
		ctx.Data.MarkDirty(player)
		return data.Settings.AutoCrack
	end
end

return CrackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- Player profiles (ProfileStore, session-locked) + the StateSync snapshot loop.
-- Every other service reads/writes profiles through here and calls MarkDirty.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FilmMode = require(script.Parent.FilmMode)
local ProfileStore = require(script.Parent.Packages.ProfileStore)
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Crystals = require(Shared.Config.Crystals)
local RarityMath = require(Shared.RarityMath)
local Remotes = require(Shared.Remotes)

local TEMPLATE = {
	Coins = 0,
	TotalCoinsEarned = 0,
	Geodes = 0,
	Crystals = {} :: { [string]: { Base: string, Mut: string, Size: number, Layer: number } },
	NextCrystalId = 1,
	Racks = {} :: { [string]: { CrystalId: string, LastTick: number } },
	RackSlots = Balance.BaseRackSlots,
	Pickaxe = 1,
	Backpack = 1,
	Rebirths = 0,
	-- Areas: bought once with coins, kept through every Set Sail. `AreaUnlocked`
	-- is the furthest you own, `AreaCurrent` is where your line is in the water.
	AreaUnlocked = 1,
	AreaCurrent = 1,
	-- Heaviest fish ever landed, keyed by species NAME ONLY — not species|aura.
	-- Anglers track "biggest bass", not "biggest shiny bass", and a best that
	-- splits six ways per species stops being a record anyone recognises.
	BestWeight = {} :: { [string]: number },
	Collection = {} :: { [string]: boolean },
	CollectionCount = 0,
	Streak = { Count = 0, LastDay = 0, Best = 0 },
	Boosts = { Coins2xUntil = 0 },
	Purchases = {} :: { string },
	OwnedPasses = {} :: { [string]: boolean },
	StarterPackOwned = false,
	Stats = { GeodesMined = 0, GeodesCracked = 0, RarestValue = 0, RarestName = "" },
	Funnel = {} :: { [string]: boolean },
	PityCracks = 0,
	RareGiven = false,
	Settings = { AutoCrack = true },
	ShopSalt = 0,
	ShopWindow = { Seed = 0, Bought = {} :: { [string]: number } },
	LastSeen = 0,
}

export type Profile = typeof(TEMPLATE)

local DataService = {}
DataService.Template = TEMPLATE

local PlayerStore = ProfileStore.New("PlayerData_v1", TEMPLATE)
local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}
local lastPush: { [Player]: number } = {}

local ctx: any = nil -- service registry, set in Init

function DataService.Get(player: Player): Profile?
	local profile = profiles[player]
	return profile and profile.Data or nil
end

function DataService.GetRaw(player: Player): any
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

-- The one seam between "areas" and everything downstream. Value scaling, luck
-- creep, species gating, shop costs and the UI all read a content tier through
-- this function; changing what it returns moved the whole game from
-- rebirth-gated depth to coin-bought areas without touching a single call site.
--
-- The internal name stays `Layer` on purpose. This codebase already keeps
-- engine-side names through a re-theme — `Crystals` holds fish, `CrackService`
-- opens chests — and renaming ~50 call sites across a dozen files to say `Area`
-- would be a large diff that changes no behaviour and hides the ones that do.
function DataService.Layer(data: Profile): number
	return math.clamp(data.AreaCurrent, 1, Balance.MaxLayer)
end

-- What is on your boat: fish you have not sold plus chests you have not opened.
-- One number with one meaning, gated by one upgrade, and the reason to sail home.
function DataService.HoldCount(data: Profile): number
	local socketed: { [string]: boolean } = {}
	for _, rack in data.Racks do
		socketed[rack.CrystalId] = true
	end
	local held = data.Geodes
	for id in data.Crystals do
		if not socketed[id] then
			held += 1
		end
	end
	return held
end

function DataService.CoinMult(player: Player, data: Profile): number
	local mult = 1 + Balance.RebirthCoinBonus * data.Rebirths
	if ctx.Monetization.OwnsPass(player, "Coins2x") then
		mult *= 2
	end
	if ctx.Monetization.OwnsPass(player, "Vip") then
		mult *= 1 + Balance.VipCoinBonus
	end
	if data.Boosts.Coins2xUntil > os.time() then
		mult *= 2
	end
	return mult
end

function DataService.LuckMult(player: Player, data: Profile): number
	local passLuck = if ctx.Monetization.OwnsPass(player, "Luck2x") then 2 else 1
	local event = ctx.Events.Current()
	return RarityMath.EffectiveLuck(passLuck, event.LuckMult, DataService.Layer(data))
end

function DataService.AddCoins(player: Player, amount: number, applyMult: boolean?)
	local data = DataService.Get(player)
	if not data or amount <= 0 then
		return
	end
	local granted = amount
	if applyMult then
		granted = math.floor(amount * DataService.CoinMult(player, data) + 0.5)
	end
	data.Coins += granted
	data.TotalCoinsEarned += granted
	DataService.MarkDirty(player)
end

function DataService.CrystalValue(data: Profile, crystal: { Base: string, Mut: string, Size: number, Layer: number }): number
	return RarityMath.ComputeValue(crystal.Base, crystal.Mut, crystal.Size, crystal.Layer)
end

function DataService.BackpackCapacity(data: Profile): number
	local tier = Balance.Backpack(data.Backpack)
	return tier.Capacity
end

function DataService.RebirthCost(data: Profile): number
	return math.floor(Balance.RebirthBaseCost * Balance.RebirthCostGrowth ^ data.Rebirths)
end

-- Sanitized snapshot pushed to the owning client (drives all UI).
local function buildSnapshot(player: Player, data: Profile): { [string]: any }
	local layer = DataService.Layer(data)
	local event = ctx.Events.Current()
	local crystals = {}
	for id, crystal in data.Crystals do
		crystals[id] = {
			Base = crystal.Base,
			Mut = crystal.Mut,
			Size = crystal.Size,
			Layer = crystal.Layer,
			Value = DataService.CrystalValue(data, crystal),
		}
	end
	local now = os.time()
	local racks = {}
	for slot, rack in data.Racks do
		local crystal = data.Crystals[rack.CrystalId]
		if crystal then
			racks[slot] = {
				CrystalId = rack.CrystalId,
				Pending = ctx.Racks.PendingCoins(player, data, rack),
				Elapsed = now - rack.LastTick,
			}
		end
	end
	local passes = {}
	for key in require(Shared.Config.Monetization).Gamepasses :: any do
		passes[key] = ctx.Monetization.OwnsPass(player, key)
	end
	local pickaxe = Balance.Pickaxe(data.Pickaxe)
	local nextPickaxe = Balance.Pickaxe(data.Pickaxe + 1)
	local backpack = Balance.Backpack(data.Backpack)
	local nextBackpack = Balance.Backpack(data.Backpack + 1)
	-- Species counts per area drive the "8 / 12 in Kelp Forest" line. An area you
	-- can actually finish is a far better reason to keep casting than a single
	-- global counter that only ever creeps.
	local areas = {}
	for index = 1, Balance.MaxLayer do
		local species = Crystals.BasesInLayer(index, Crystals.FISH)
		local caught = 0
		for _, def in species do
			for _, mut in Crystals.MutationNames do
				if data.Collection[Crystals.IndexKey(def.Name, mut)] then
					caught += 1
					break -- one tick per species; auras are the Index's job
				end
			end
		end
		areas[index] = {
			Name = Balance.LayerNames[index],
			Cost = Balance.AreaCosts[index] or 0,
			Unlocked = index <= data.AreaUnlocked,
			Species = #species,
			Caught = caught,
		}
	end
	return {
		Coins = data.Coins,
		Geodes = data.Geodes,
		Hold = DataService.HoldCount(data),
		BackpackCapacity = backpack.Capacity,
		Areas = areas,
		AreaUnlocked = data.AreaUnlocked,
		AreaCurrent = data.AreaCurrent,
		BestWeight = data.BestWeight,
		Pickaxe = { Level = data.Pickaxe, Name = pickaxe.Name, Damage = pickaxe.Damage },
		NextPickaxe = nextPickaxe and { Name = nextPickaxe.Name, Damage = nextPickaxe.Damage, Cost = nextPickaxe.Cost } or nil,
		Backpack = { Level = data.Backpack, Name = backpack.Name },
		NextBackpack = nextBackpack and { Name = nextBackpack.Name, Capacity = nextBackpack.Capacity, Cost = nextBackpack.Cost } or nil,
		Crystals = crystals,
		Racks = racks,
		RackSlots = data.RackSlots,
		NextRackSlotCost = Balance.RackSlotCosts[data.RackSlots - Balance.BaseRackSlots + 1],
		Rebirths = data.Rebirths,
		Layer = layer,
		LayerName = Balance.LayerNames[layer],
		RebirthCost = DataService.RebirthCost(data),
		CoinMult = DataService.CoinMult(player, data),
		LuckMult = DataService.LuckMult(player, data),
		MutationMult = event.MutationMult,
		Event = event.Name and { Name = event.Name, EndsAt = event.EndsAt } or nil,
		Collection = data.Collection,
		CollectionCount = data.CollectionCount,
		TotalIndex = Crystals.TotalIndexEntries(),
		Streak = { Count = data.Streak.Count, Best = data.Streak.Best },
		Passes = passes,
		AutoCrackEnabled = data.Settings.AutoCrack ~= false,
		StarterPackOwned = data.StarterPackOwned,
		Boost2xUntil = data.Boosts.Coins2xUntil,
		Stats = data.Stats,
		Funnel = data.Funnel,
	}
end

function DataService.PushState(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	lastPush[player] = os.clock()
	dirty[player] = nil
	Remotes.Event("StateSync"):FireClient(player, buildSnapshot(player, data))
end

local function onPlayerAdded(player: Player)
	-- Film mode loads from ProfileStore's mock store: a staged endgame save
	-- for recording must never be written to the real one.
	local store = if FilmMode.Active() then PlayerStore.Mock else PlayerStore
	local profile = store:StartSessionAsync("Player_" .. player.UserId, {})
	if profile == nil then
		player:Kick("Your data is loaded on another server. Rejoin in a moment!")
		return
	end
	profile:AddUserId(player.UserId)
	profile:Reconcile()
	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		player:Kick("Data session ended. Please rejoin!")
	end)
	if not player:IsDescendantOf(Players) then
		profile:EndSession()
		return
	end
	profiles[player] = profile
	-- Studio-only, and only when Balance.FilmMode is on: hand this session an
	-- endgame save so marketing footage does not require a week of play.
	FilmMode.Apply(profile.Data)

	-- leaderstats for the Roblox player list
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = profile.Data.Rebirths
	rebirths.Parent = leaderstats
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = profile.Data.Coins
	coins.Parent = leaderstats
	leaderstats.Parent = player

	ctx.OnProfileLoaded(player, profile.Data)
	DataService.PushState(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Data.LastSeen = os.time()
		ctx.OnProfileReleasing(player, profile.Data)
		profile:EndSession()
		profiles[player] = nil
	end
	dirty[player] = nil
	lastPush[player] = nil
end

function DataService.Init(serviceCtx: any)
	ctx = serviceCtx
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- Push loop: immediately when dirty (debounced), every 2s otherwise.
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for player, profile in profiles do
			local since = now - (lastPush[player] or 0)
			if (dirty[player] and since > 0.25) or since > 2 then
				DataService.PushState(player)
				local stats = player:FindFirstChild("leaderstats")
				if stats then
					local rebirths = stats:FindFirstChild("Rebirths") :: IntValue?
					local coins = stats:FindFirstChild("Coins") :: IntValue?
					if rebirths then
						rebirths.Value = profile.Data.Rebirths
					end
					if coins then
						coins.Value = profile.Data.Coins
					end
				end
			end
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--!strict
-- Random server-wide events (Meteor Shower = luck, Aurora = mutations).
-- Procedural "limited-time feel" with zero developer intervention.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)
local FilmMode = require(script.Parent.FilmMode)

local EventService = {}

local rng = Random.new()
local current: { Name: string?, LuckMult: number, MutationMult: number, EndsAt: number, Color: Color3? } = {
	Name = nil,
	LuckMult = 1,
	MutationMult = 1,
	EndsAt = 0,
}

function EventService.Current()
	if current.Name and os.time() >= current.EndsAt then
		current = { Name = nil, LuckMult = 1, MutationMult = 1, EndsAt = 0 }
	end
	return current
end

function EventService.Init(_serviceCtx: any)
	-- Film mode fires an event every few seconds so a Feeding Frenzy take does
	-- not mean waiting six minutes between attempts.
	local interval = if FilmMode.Active() then 12 else Balance.EventCheckInterval
	local chance = if FilmMode.Active() then 1 else Balance.EventChance
	task.spawn(function()
		while true do
			task.wait(interval)
			if EventService.Current().Name == nil and rng:NextNumber() < chance then
				local def = Balance.Events[rng:NextInteger(1, #Balance.Events)]
				current = {
					Name = def.Name,
					LuckMult = def.LuckMult,
					MutationMult = def.MutationMult,
					EndsAt = os.time() + Balance.EventDuration,
					Color = def.Color,
				}
				Remotes.Event("ServerEvent"):FireAllClients({
					Name = def.Name,
					EndsAt = current.EndsAt,
					Color = def.Color,
					LuckMult = def.LuckMult,
					MutationMult = def.MutationMult,
				})
				task.delay(Balance.EventDuration, function()
					if current.Name == def.Name then
						current = { Name = nil, LuckMult = 1, MutationMult = 1, EndsAt = 0 }
						Remotes.Event("ServerEvent"):FireAllClients(nil)
					end
				end)
			end
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">FilmMode</string>
          <string name="Source"><![CDATA[--!strict
-- FILM MODE — for recording clips, never for the live game.
--
-- Marketing needs footage of things that take days to reach honestly: a maxed
-- rod, a near-complete collection, a Day 30 streak, a Feeding Frenzy on
-- demand. Editing six config files by hand before every shoot is how a wrong
-- number ends up published, so it is one switch instead:
--
--     ReplicatedStorage -> Shared -> Config -> Balance -> FilmMode = true
--
-- Two independent guards mean this can never reach players:
--   1. It only runs when RunService:IsStudio() is true.
--   2. Balance.FilmMode ships as false, and CI publishes whatever is committed.
-- Two further containments, because "Studio only" is not the same as "harmless":
--   3. The profile loads from ProfileStore's Mock store, so a staged save is
--      never written to the real one.
--   4. Leaderboards.Save returns early while film mode is on. Those are separate
--      OrderedDataStores keyed by your real UserId — without the guard, a film
--      take published an endgame score to the live boards.
-- Flip it in Studio, press Play, film, close WITHOUT saving.
--
-- What it does NOT do: change the odds panel's honesty, or fake any number the
-- UI reports. Everything below hands you a real endgame profile and lets the
-- real systems run — the footage is of the actual game, just fast-forwarded.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Crystals = require(Shared.Config.Crystals)
local RarityMath = require(Shared.RarityMath)

local FilmMode = {}

function FilmMode.Active(): boolean
	return Balance.FilmMode == true and RunService:IsStudio()
end

-- Applied to the profile right after it loads, before the first StateSync.
function FilmMode.Apply(data: any)
	if not FilmMode.Active() then
		return
	end

	data.Coins = 5_000_000
	data.Geodes = 20 -- uncracked chests
	data.Pickaxe = #Balance.Pickaxes
	data.Backpack = #Balance.Backpacks
	data.RackSlots = Balance.MaxRackSlots
	data.Rebirths = 6
	-- Every area bought, fishing the deepest one: the drop table with the best
	-- footage in it. Areas no longer follow rebirths, so both have to be staged.
	data.AreaUnlocked = Balance.MaxLayer
	data.AreaCurrent = Balance.MaxLayer
	local layer = Balance.MaxLayer
	data.Stats.GeodesMined = 4820
	data.Stats.GeodesCracked = 4610

	-- Collection at 75%: enough to look like a real save, with the last stretch
	-- still missing so the "what am I still hunting" shot has something to show.
	local target = math.floor(Crystals.TotalIndexEntries() * 0.75)
	local filled = 0
	for _, base in Crystals.Bases do
		for _, mutation in Crystals.MutationNames do
			if filled >= target then
				break
			end
			local key = Crystals.IndexKey(base.Name, mutation)
			if not data.Collection[key] then
				data.Collection[key] = true
				filled += 1
			end
		end
	end
	data.CollectionCount = filled

	-- Streak sits at 29 with yesterday's claim, so joining rolls it to Day 30
	-- and the milestone popup fires for real.
	data.Streak.Count = 29
	data.Streak.Best = 29
	data.Streak.LastDay = (os.time() // 86400) - 1

	-- An eight-hour absence, so the welcome-back popup has a real number in it.
	data.LastSeen = os.time() - Balance.OfflineCapSeconds

	-- ...but offline earnings are computed from SOCKETED items, so an empty
	-- inventory made the welcome popup show no earnings line at all and left the
	-- racks bare on camera. Stage a spread worth showing, including one big
	-- mutated piece that becomes the flex aura over the character's head.
	local staged = {
		{ Base = Crystals.Bases[#Crystals.Bases].Name, Mut = Crystals.MutationNames[#Crystals.MutationNames], Size = 2.4 },
		{ Base = Crystals.Bases[math.max(#Crystals.Bases - 1, 1)].Name, Mut = "Normal", Size = 1.8 },
		{ Base = Crystals.Bases[math.max(#Crystals.Bases - 2, 1)].Name, Mut = "Normal", Size = 1.5 },
		{ Base = Crystals.Bases[math.max(#Crystals.Bases - 3, 1)].Name, Mut = "Normal", Size = 1.2 },
	}
	-- The record comes from the SECOND piece, not the showpiece. A rolled crystal
	-- maxes out at size 1.2, so making a rack-grown 2.4 the record would put the
	-- bar above anything a crack could beat — freezing the aura and killing the
	-- "NEW PERSONAL BEST" line, which are two of the shots this mode exists for.
	-- A Legendary record still dresses the character and still leaves headroom.
	local record = staged[2]
	data.Stats.RarestName = (record.Mut ~= "Normal" and (record.Mut .. " ") or "") .. record.Base
	data.Stats.RarestValue = RarityMath.ComputeValue(record.Base, record.Mut, record.Size, layer)

	local socketedAt = os.time() - Balance.OfflineCapSeconds
	for slot, entry in staged do
		local id = tostring(data.NextCrystalId)
		data.NextCrystalId += 1
		data.Crystals[id] = {
			Base = entry.Base,
			Mut = entry.Mut,
			Size = entry.Size,
			Layer = layer,
		}
		data.Racks[tostring(slot)] = { CrystalId = id, LastTick = socketedAt }
		-- ...and mark them found. The fill loop above deliberately leaves the
		-- rarest entries unowned, which is exactly where these are drawn from —
		-- a pan from the racks to the index would otherwise contradict itself.
		local key = Crystals.IndexKey(entry.Base, entry.Mut)
		if not data.Collection[key] then
			data.Collection[key] = true
			data.CollectionCount += 1
		end
	end

	-- Personal bests, for the Index shots. Staged from a size a real catch can
	-- beat (rolls cap at 1.2) for the same reason the value record is: a wall of
	-- unbeatable records on camera is a wall the player can never interact with.
	for _, def in Crystals.BasesInLayer(layer, Crystals.FISH) do
		if data.Collection[Crystals.IndexKey(def.Name, "Normal")] then
			data.BestWeight[def.Name] = Crystals.WeightOf(def.Name, 1.05)
		end
	end
end

return FilmMode
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">FlexAura</string>
          <string name="Source"><![CDATA[--!strict
-- Your rarest pull, floating over your head, for everyone in the server to see.
--
-- Coins are a private number. This is the public one — the reason to keep
-- cracking after the shop is bought out, and the reason a new player walking
-- past someone's Abyssal Leviathan Heart believes the drop table is real.
--
-- The server only publishes four attributes on the Player; every client builds
-- and spins the actual crystal itself (see the client FlexAura), so a lobby
-- full of showing-off costs no bandwidth.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crystals = require(Shared.Config.Crystals)

local FlexAura = {}

-- Saves store the rarest find as one display string ("Abyssal Leviathan Heart").
-- Split it back apart rather than migrating every existing profile.
function FlexAura.SplitName(name: string): (string, string)
	for _, mutation in Crystals.MutationNames do
		if mutation ~= "Normal" and string.sub(name, 1, #mutation + 1) == mutation .. " " then
			return string.sub(name, #mutation + 2), mutation
		end
	end
	return name, "Normal"
end

function FlexAura.Set(player: Player, baseName: string, mutationName: string, value: number)
	local def = Crystals.GetBase(baseName)
	if not def then
		return
	end
	local color = def.Color
	local mutation = Crystals.GetMutation(mutationName)
	if mutation and mutation.Color then
		color = def.Color:Lerp(mutation.Color, 0.45)
	end
	player:SetAttribute("FlexBase", baseName)
	player:SetAttribute("FlexMut", mutationName)
	player:SetAttribute("FlexTier", def.Tier)
	player:SetAttribute("FlexColor", color)
	player:SetAttribute("FlexValue", value)
end

-- Called once the profile is loaded, so returning players walk in wearing the
-- best thing they have ever found.
function FlexAura.Apply(player: Player, data: any)
	local name = data.Stats and data.Stats.RarestName
	if typeof(name) ~= "string" or name == "" then
		return
	end
	local base, mutation = FlexAura.SplitName(name)
	FlexAura.Set(player, base, mutation, data.Stats.RarestValue or 0)
end

return FlexAura
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Leaderboards</string>
          <string name="Source"><![CDATA[--!strict
-- Global leaderboards on physical boards: Top Recrystallizers + Rarest Finds.
-- OrderedDataStore writes on leave and every 2 minutes; boards refresh on a loop.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local FilmMode = require(script.Parent.FilmMode)

local Leaderboards = {}

local ctx: any = nil
local rebirthStore = nil :: OrderedDataStore?
local rarestStore = nil :: OrderedDataStore?
local nameCache: { [number]: string } = {}
local boardRebirths: BasePart? = nil
local boardRarest: BasePart? = nil

local function store(name: string): OrderedDataStore?
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	return ok and result or nil
end

function Leaderboards.Save(player: Player, data: any)
	-- A staged film-mode save must not reach the real boards either. The Mock
	-- ProfileStore only isolates the profile; these are separate OrderedDataStores
	-- keyed by the developer's own UserId, and both the periodic loop and the
	-- on-leave save would otherwise publish an endgame score to live players.
	if FilmMode.Active() then
		return
	end
	if rebirthStore and data.Rebirths > 0 then
		pcall(function()
			(rebirthStore :: OrderedDataStore):SetAsync(tostring(player.UserId), data.Rebirths)
		end)
	end
	if rarestStore and data.Stats.RarestValue > 0 then
		pcall(function()
			(rarestStore :: OrderedDataStore):SetAsync(tostring(player.UserId), data.Stats.RarestValue)
		end)
	end
end

local function userName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local resolved = ok and name or ("User " .. userId)
	nameCache[userId] = resolved
	return resolved
end

local function renderBoard(board: BasePart?, dataStore: OrderedDataStore?, formatValue: (number) -> string)
	if not board or not dataStore then
		return
	end
	local ok, pages = pcall(function()
		return dataStore:GetSortedAsync(false, 15)
	end)
	if not ok then
		return
	end
	local gui = board:FindFirstChild("BoardGui")
	local list = gui and gui:FindFirstChild("List")
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local top = (pages :: DataStorePages):GetCurrentPage()
	for rank, entry in top do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, 0, 0, 26)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.GothamBold
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextScaled = true
		row.TextColor3 = rank <= 3 and Color3.fromRGB(255, 210, 90) or Color3.fromRGB(220, 220, 235)
		row.LayoutOrder = rank
		row.Text = ("%d. %s — %s"):format(rank, userName(tonumber(entry.key) or 0), formatValue(entry.value))
		row.Parent = list
	end
end

function Leaderboards.Init(serviceCtx: any, rebirthsBoard: BasePart, rarestBoard: BasePart)
	ctx = serviceCtx
	boardRebirths = rebirthsBoard
	boardRarest = rarestBoard
	rebirthStore = store("LB_Rebirths_v1")
	rarestStore = store("LB_Rarest_v1")

	task.spawn(function()
		while true do
			renderBoard(boardRebirths, rebirthStore, function(value)
				return tostring(value) .. " rebirths"
			end)
			renderBoard(boardRarest, rarestStore, function(value)
				return tostring(value) .. " value"
			end)
			-- periodic saves for long sessions
			for _, player in Players:GetPlayers() do
				local data = ctx.Data.Get(player)
				if data then
					Leaderboards.Save(player, data)
				end
			end
			task.wait(150)
		end
	end)
end

return Leaderboards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the entire world procedurally so the whole game lives in code:
-- a beach with a wooden dock over real terrain water, glowing fishing spots,
-- station pads, leaderboard boards, spawn, and lighting.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Crystals = require(Shared.Config.Crystals)
local FishShape = require(Shared.FishShape)

local MapBuilder = {}

export type MapRefs = {
	Nodes: { BasePart },
	Origins: { Vector3 }, -- dock position of each area, for AreaService
	CrackPrompt: ProximityPrompt,
	RackPrompt: ProximityPrompt,
	ShopPrompt: ProximityPrompt,
	RebirthPrompt: ProximityPrompt,
	DockPrompt: ProximityPrompt,
	BoardRebirths: BasePart,
	BoardRarest: BasePart,
}

-- Each area gets its own water, sand and buoy colours. Roblox lighting and
-- terrain water tint are global, so colour is the only per-area atmosphere that
-- actually varies — which makes it worth spending here rather than on a fog
-- setting that would follow the player between areas anyway.
type AreaTheme = {
	Sand: Color3,
	Water: Color3,
	Spots: { Color3 },
	Palms: number,
	-- What GROWS in the water here. Colour alone made all five areas the same
	-- beach with a filter over it — the Kelp Forest had no kelp in it, which is
	-- the kind of thing a player notices immediately and a spec sheet never does.
	Growth: string, -- Reeds | Kelp | Coral | Vent | Bone
	-- What stands on the SHORE.
	Shore: string, -- Palm | Pine | Rock | Spire
	-- Which marker floats out on the water. The lantern on top is identical
	-- across all five (the fishing loop drives it), so only the hull changes.
	Buoy: string, -- Ring | Float | Glass | Can | Orb
	-- What the station decks and the dock are built out of.
	DeckColor: Color3,
	DeckMaterial: Enum.Material,
}

local AREA_THEMES: { AreaTheme } = {
	{ -- 1 Sunny Shallows: a bright holiday beach. Palms, pale sand, clear water.
		Sand = Color3.fromRGB(232, 214, 165),
		Water = Color3.fromRGB(120, 210, 230),
		Spots = { Color3.fromRGB(255, 200, 60), Color3.fromRGB(120, 220, 255), Color3.fromRGB(120, 255, 160) },
		Palms = 8,
		Growth = "Reeds",
		Shore = "Palm",
		Buoy = "Ring",
		DeckColor = Color3.fromRGB(210, 185, 140),
		DeckMaterial = Enum.Material.WoodPlanks,
	},
	{ -- 2 Kelp Forest: a cold northern cove. Kelp towers up THROUGH the surface
		-- and mats out into a canopy you look across, pines on a rocky shore.
		Sand = Color3.fromRGB(150, 160, 130),
		Water = Color3.fromRGB(56, 132, 110),
		Spots = { Color3.fromRGB(120, 255, 160), Color3.fromRGB(90, 200, 130), Color3.fromRGB(200, 255, 120) },
		Palms = 0,
		Growth = "Kelp",
		Shore = "Pine",
		Buoy = "Float",
		DeckColor = Color3.fromRGB(112, 92, 72),
		DeckMaterial = Enum.Material.Wood,
	},
	{ -- 3 Twilight Reef: warm and loud. Coral heads, fans, urchins.
		Sand = Color3.fromRGB(228, 196, 186),
		Water = Color3.fromRGB(90, 150, 220),
		Spots = { Color3.fromRGB(255, 150, 220), Color3.fromRGB(90, 210, 220), Color3.fromRGB(255, 120, 80) },
		Palms = 3,
		Growth = "Coral",
		Shore = "Rock",
		Buoy = "Glass",
		DeckColor = Color3.fromRGB(226, 168, 150),
		DeckMaterial = Enum.Material.Sandstone,
	},
	{ -- 4 Midnight Trench: black basalt spires and hydrothermal vents.
		Sand = Color3.fromRGB(96, 92, 116),
		Water = Color3.fromRGB(40, 60, 120),
		Spots = { Color3.fromRGB(120, 200, 255), Color3.fromRGB(180, 160, 255), Color3.fromRGB(255, 240, 120) },
		Palms = 0,
		Growth = "Vent",
		Shore = "Spire",
		Buoy = "Can",
		DeckColor = Color3.fromRGB(78, 80, 96),
		DeckMaterial = Enum.Material.DiamondPlate,
	},
	{ -- 5 The Abyss: no light that isn't alive. Bones on the floor.
		Sand = Color3.fromRGB(58, 55, 74),
		Water = Color3.fromRGB(20, 25, 60),
		Spots = { Color3.fromRGB(190, 90, 255), Color3.fromRGB(255, 70, 120), Color3.fromRGB(150, 255, 245) },
		Palms = 0,
		Growth = "Bone",
		Shore = "Spire",
		Buoy = "Orb",
		DeckColor = Color3.fromRGB(206, 200, 186),
		DeckMaterial = Enum.Material.Slate,
	},
}


local rng = Random.new(20260804)

local function part(props: { [string]: any }, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

-- Bright, sunny and readable — not blown out.
--
-- The white sheets lying across the sea were never the lights. Roblox terrain
-- water ships with WaterReflectance at 1, so it mirrors the sky, and a bright
-- sky over open water with nothing to break it up means large stretches of the
-- surface render as flat white. Turning point lights down could never have fixed
-- that, because the point lights were not doing it.
--
-- So: kill most of the reflectance and let the water be water. Exposure comes
-- down a notch on top, which pulls the whole image back from the clip point
-- rather than dimming any one thing in it.
local function setLighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 1.5
	Lighting.ExposureCompensation = -0.4
	Lighting.Ambient = Color3.fromRGB(122, 126, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(116, 128, 150)
	Lighting.FogColor = Color3.fromRGB(178, 208, 236)
	Lighting.FogEnd = 1400 -- far enough to see the next area on the horizon
	Lighting.FogStart = 260
	-- Sun glare off a mirror-flat sea is the single brightest thing on screen and
	-- it is not information. The scene keeps its own light instead.
	Lighting.EnvironmentSpecularScale = 0.35
	Lighting.EnvironmentDiffuseScale = 0.8

	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(46, 128, 168)
	terrain.WaterReflectance = 0.12
	terrain.WaterTransparency = 0.55
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Color = Color3.fromRGB(190, 214, 244)
	atmosphere.Decay = Color3.fromRGB(120, 150, 190)
	atmosphere.Haze = 1.1 -- distance haze, which is what makes a far vista read as far
	atmosphere.Glare = 0
	atmosphere.Parent = Lighting
end

local function makePalm(position: Vector3, parent: Instance)
	local trunk = part({
		Name = "PalmTrunk",
		Size = Vector3.new(1.4, 10, 1.4),
		Position = position + Vector3.new(0, 5, 0),
		Color = Color3.fromRGB(130, 95, 60),
		Material = Enum.Material.Wood,
	}, parent)
	trunk.CanCollide = false
	for i = 1, 5 do
		local angle = (i / 5) * math.pi * 2
		local frond = part({
			Name = "Frond" .. i,
			Size = Vector3.new(6, 0.4, 1.8),
			CFrame = CFrame.new(position + Vector3.new(0, 10, 0))
				* CFrame.Angles(0, angle, -0.35)
				* CFrame.new(3, 0, 0),
			Color = Color3.fromRGB(70, 170, 90),
			Material = Enum.Material.Grass,
		}, parent)
		frond.CanCollide = false
	end
end

--------------------------------------------------------------------------------
-- Station furniture. Each station reads as the thing it does — an open treasure
-- chest spilling gold, a glass aquarium on a table, a market stall of chests,
-- and a beached sailboat ready to Set Sail — instead of four identical pads.
--
-- All of it is visual only: nothing collides (players walk straight through)
-- and nothing answers queries (a cast-ray toward the water can never die on a
-- piece of furniture). Players walk up the beach from the dock (-Z), so the
-- furniture sits on the +Z half of each pad and the front stays open.
--------------------------------------------------------------------------------

-- The aquarium's glass volume, shared between the builder here and the client
-- that swims fish inside it (AquariumView reads the tagged part's own Size, so
-- this constant only has to be right in one place).
local TANK_SIZE = Vector3.new(9, 5.2, 3.6)

local WOOD = Color3.fromRGB(120, 88, 54)
local DARK_WOOD = Color3.fromRGB(92, 64, 40)
local GOLD = Color3.fromRGB(255, 200, 60)

local function deco(props: { [string]: any }, parent: Instance): Part
	local piece = part(props, parent)
	piece.CanCollide = false
	piece.CanQuery = false
	return piece
end

-- Treasure Chests: a big chest mid-open with gold light spilling out, a small
-- locked one beside it, loose coins in the sand.
local function decorateCrack(position: Vector3, _color: Color3, parent: Instance)
	deco({
		Name = "ChestBase",
		Size = Vector3.new(3.2, 1.8, 2.2),
		Position = position + Vector3.new(0, 1.4, 3.2),
		Color = WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	deco({
		Name = "ChestBand",
		Size = Vector3.new(0.3, 1.9, 2.3),
		Position = position + Vector3.new(0, 1.4, 3.2),
		Color = Color3.fromRGB(70, 70, 80),
		Material = Enum.Material.Metal,
	}, parent)
	local gold = deco({
		Name = "ChestGold",
		Size = Vector3.new(2.8, 0.5, 1.8),
		Position = position + Vector3.new(0, 2.4, 3.2),
		Color = GOLD,
		Material = Enum.Material.Neon,
	}, parent)
	local glow = Instance.new("PointLight")
	glow.Color = GOLD
	glow.Range = 12
	glow.Brightness = 0.7
	glow.Parent = gold
	deco({
		Name = "ChestLid",
		Size = Vector3.new(3.2, 0.5, 2.2),
		CFrame = CFrame.new(position + Vector3.new(0, 2.9, 4.4)) * CFrame.Angles(math.rad(-62), 0, 0),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	deco({
		Name = "SmallChest",
		Size = Vector3.new(1.8, 1.1, 1.3),
		Position = position + Vector3.new(2.7, 1.05, 1.6),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	deco({
		Name = "SmallChestLid",
		Size = Vector3.new(1.9, 0.4, 1.4),
		Position = position + Vector3.new(2.7, 1.8, 1.6),
		Color = WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	for i = 1, 3 do
		deco({
			Name = "LooseCoin" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 0.7, 0.7),
			CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-2.4, 1.4), 0.58, rng:NextNumber(0.4, 1.8)))
				* CFrame.Angles(0, 0, math.rad(90)),
			Color = GOLD,
			Material = Enum.Material.Metal,
		}, parent)
	end
end

-- Aquarium: a glass tank on a wooden table with a relic glowing inside.
local function decorateRacks(position: Vector3, _color: Color3, parent: Instance)
	for _, x in { -3.8, 3.8 } do
		deco({
			Name = "TableLeg",
			Size = Vector3.new(0.6, 1.1, 3),
			Position = position + Vector3.new(x, 0.55, 3.2),
			Color = DARK_WOOD,
			Material = Enum.Material.Wood,
		}, parent)
	end
	deco({
		Name = "AquariumTable",
		Size = Vector3.new(9.6, 0.7, 3.9),
		Position = position + Vector3.new(0, 1.45, 3.2),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	}, parent)
	-- A big tank, because the fish in it have to be legible from outside the
	-- glass. The old one was 4x2 studs with two ornaments glued in it; you could
	-- not have told eight fish apart in there, let alone watched them swim.
	local tankCenter = position + Vector3.new(0, 3.6, 3.2)
	local water = deco({
		Name = "AquariumWater",
		Size = Vector3.new(TANK_SIZE.X - 0.4, TANK_SIZE.Y - 0.5, TANK_SIZE.Z - 0.4),
		Position = tankCenter - Vector3.new(0, 0.2, 0),
		Color = Color3.fromRGB(70, 160, 235),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.62,
	}, parent)
	deco({
		Name = "AquariumGlass",
		Size = TANK_SIZE,
		Position = tankCenter,
		Color = Color3.fromRGB(170, 225, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.72,
	}, parent)
	-- The client fills this with THIS player's socketed fish — racks are per
	-- player, so the tank has to be, and a local fill costs the server nothing.
	CollectionService:AddTag(water, "AquariumTank")

	-- Gravel, plants and a bubble stream, so an empty tank still looks like a
	-- tank rather than a blue box waiting for content.
	deco({
		Name = "TankGravel",
		Size = Vector3.new(TANK_SIZE.X - 0.5, 0.4, TANK_SIZE.Z - 0.5),
		Position = tankCenter - Vector3.new(0, TANK_SIZE.Y / 2 - 0.35, 0),
		Color = Color3.fromRGB(198, 176, 140),
		Material = Enum.Material.Sand,
	}, parent)
	for i = 1, 5 do
		local height = rng:NextNumber(1.2, 2.6)
		deco({
			Name = "TankPlant" .. i,
			Size = Vector3.new(0.22, height, 0.22),
			CFrame = CFrame.new(
				tankCenter + Vector3.new(rng:NextNumber(-3, 3), -TANK_SIZE.Y / 2 + height / 2 + 0.5, rng:NextNumber(-1, 1))
			) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.25, 0.25)),
			Color = Color3.fromRGB(60, 150, 90),
			Material = Enum.Material.Grass,
		}, parent)
	end
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Color = ColorSequence.new(Color3.fromRGB(220, 245, 255))
	bubbles.Size = NumberSequence.new(0.12, 0.02)
	bubbles.Transparency = NumberSequence.new(0.4, 1)
	bubbles.Lifetime = NumberRange.new(1.4, 2.2)
	bubbles.Rate = 7
	bubbles.Speed = NumberRange.new(1.4, 2.4)
	bubbles.SpreadAngle = Vector2.new(6, 6)
	bubbles.Acceleration = Vector3.new(0, 2, 0)
	bubbles.Parent = water
end

-- Chest Shop: a market stall — counter out front, striped awning overhead,
-- chests for sale on the counter and the back shelf.
local function decorateShop(position: Vector3, color: Color3, parent: Instance)
	deco({
		Name = "ShopCounter",
		Size = Vector3.new(6, 1.2, 1.6),
		Position = position + Vector3.new(0, 1.1, 1.1),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	}, parent)
	local function miniChest(name: string, x: number, y: number, z: number)
		deco({
			Name = name,
			Size = Vector3.new(1.5, 0.9, 1.1),
			Position = position + Vector3.new(x, y, z),
			Color = DARK_WOOD,
			Material = Enum.Material.Wood,
		}, parent)
		deco({
			Name = name .. "Lid",
			Size = Vector3.new(1.6, 0.35, 1.2),
			Position = position + Vector3.new(x, y + 0.6, z),
			Color = WOOD,
			Material = Enum.Material.Wood,
		}, parent)
	end
	miniChest("CounterChestA", -1.7, 2.15, 1.1)
	miniChest("CounterChestB", 1.7, 2.15, 1.1)
	for _, x in { -2.9, 2.9 } do
		deco({
			Name = "ShopPost",
			Size = Vector3.new(0.5, 5.6, 0.5),
			Position = position + Vector3.new(x, 3.3, 4.2),
			Color = WOOD,
			Material = Enum.Material.Wood,
		}, parent)
	end
	deco({
		Name = "ShopShelf",
		Size = Vector3.new(5.8, 0.35, 1.4),
		Position = position + Vector3.new(0, 3.2, 4.2),
		Color = WOOD:Lerp(Color3.new(0, 0, 0), 0.15),
		Material = Enum.Material.WoodPlanks,
	}, parent)
	miniChest("ShelfChest", 0, 3.85, 4.2)
	for i = 1, 5 do
		deco({
			Name = "Awning" .. i,
			Size = Vector3.new(1.3, 0.2, 3.6),
			CFrame = CFrame.new(position + Vector3.new(-2.6 + (i - 1) * 1.3, 6, 2.6)) * CFrame.Angles(math.rad(14), 0, 0),
			Color = if i % 2 == 1 then color else Color3.fromRGB(240, 234, 214),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
	end
end

-- Set Sail: a beached rowboat with its mast up and sail set — ready to go.
local function decorateRebirth(position: Vector3, color: Color3, parent: Instance)
	deco({
		Name = "BoatHull",
		Size = Vector3.new(5.6, 1.3, 2.6),
		Position = position + Vector3.new(0, 1.15, 3.2),
		Color = WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	-- Angled end blocks fake the taper of a bow and stern
	for _, side in { -1, 1 } do
		deco({
			Name = "BoatBow",
			Size = Vector3.new(1.7, 1.3, 1.9),
			CFrame = CFrame.new(position + Vector3.new(side * 3.1, 1.15, 3.2)) * CFrame.Angles(0, math.rad(side * 40), 0),
			Color = WOOD,
			Material = Enum.Material.Wood,
		}, parent)
	end
	for _, z in { 2.05, 4.35 } do
		deco({
			Name = "BoatRim",
			Size = Vector3.new(5.8, 0.35, 0.4),
			Position = position + Vector3.new(0, 1.9, z),
			Color = DARK_WOOD,
			Material = Enum.Material.Wood,
		}, parent)
	end
	deco({
		Name = "BoatMast",
		Size = Vector3.new(0.35, 6, 0.35),
		Position = position + Vector3.new(0, 4.8, 3.2),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	deco({
		Name = "BoatSail",
		Size = Vector3.new(3.2, 3.4, 0.15),
		Position = position + Vector3.new(0, 5.2, 3.35),
		Color = Color3.fromRGB(240, 234, 214),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	local pennant = deco({
		Name = "BoatPennant",
		Size = Vector3.new(1.1, 0.45, 0.12),
		Position = position + Vector3.new(0.75, 7.6, 3.2),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
	}, parent)
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 10
	glow.Brightness = 0.8
	glow.Parent = pennant
end

local STATION_DECOR: { [string]: (Vector3, Color3, Instance) -> () } = {
	Crack = decorateCrack,
	Racks = decorateRacks,
	Shop = decorateShop,
	Rebirth = decorateRebirth,
}

local function makeStation(
	position: Vector3,
	title: string,
	stationKey: string,
	color: Color3,
	parent: Instance,
	theme: AreaTheme?
): ProximityPrompt
	-- Round pad with a glowing rim. The old "Ring" was an 11x11 neon SLAB laid
	-- over a square pad, which rendered as a giant glowing square on the cave
	-- floor — it read as a crack in the rock, not as a station.
	-- The deck is built out of whatever this area is made of: planks on the
	-- holiday beach, dark timber in the kelp cove, sandstone on the reef, steel
	-- plate in the trench, bone in the Abyss. A station that looks identical in
	-- all five is the same "one area in five colours" problem one level in.
	local pad = part({
		Name = title .. "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 10, 10),
		CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		Color = if theme then theme.DeckColor else Color3.fromRGB(210, 185, 140),
		Material = if theme then theme.DeckMaterial else Enum.Material.WoodPlanks,
	}, parent)
	local ring = part({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 11.5, 11.5),
		CFrame = CFrame.new(position + Vector3.new(0, -0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.15,
	}, parent)
	ring.CanCollide = false
	ring.CanQuery = false
	local decorate = STATION_DECOR[stationKey]
	if decorate then
		decorate(position, color, parent)
	end

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 16
	light.Brightness = 0.6
	light.Parent = pad

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(12, 2.4)
	billboard.StudsOffset = Vector3.new(0, 7, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 140
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = title
	label.TextColor3 = color
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Parent = billboard
	billboard.Parent = pad

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = title
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 9
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt:SetAttribute("Station", stationKey)
	prompt.Parent = pad
	return prompt
end

local function makeBoard(position: Vector3, lookAt: Vector3, title: string, parent: Instance): BasePart
	local board = part({
		Name = "Board_" .. title,
		Size = Vector3.new(14, 12, 1),
		CFrame = CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z)),
		Color = Color3.fromRGB(90, 65, 45),
		Material = Enum.Material.Wood,
	}, parent)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, 0, 0, 70)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.Text = title
	titleLabel.TextColor3 = Color3.fromRGB(255, 210, 90)
	titleLabel.TextScaled = true
	titleLabel.Parent = gui
	local list = Instance.new("Frame")
	list.Name = "List"
	list.Position = UDim2.new(0, 10, 0, 80)
	list.Size = UDim2.new(1, -20, 1, -90)
	list.BackgroundTransparency = 1
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	list.Parent = gui
	gui.Parent = board
	return board
end

--------------------------------------------------------------------------------
-- Scenery. An empty sand rectangle with twelve glowing balls on it is a test
-- level, not a place — and the areas need to look DIFFERENT from each other or
-- paying 45,000 coins to reach the next one buys you a recolour.
--
-- Everything here is decoration: no collision, no raycast queries. A cast that
-- died on a rock or a crate would be a bug the player could not see the cause of.
--------------------------------------------------------------------------------

-- Sea stacks: weathered rock pillars standing out of the water. Cheap, big, and
-- they give the horizon something to be other than empty.
local function makeSeaStack(at: Vector3, height: number, tint: Color3, parent: Instance)
	local segments = math.max(math.floor(height / 5), 2)
	for i = 1, segments do
		local t = (i - 1) / segments
		local width = (7 - t * 4) * rng:NextNumber(0.85, 1.15)
		local rock = deco({
			Name = "StackRock",
			Size = Vector3.new(width, height / segments + 1, width * rng:NextNumber(0.8, 1.2)),
			CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-1, 1), (i - 0.5) * (height / segments), rng:NextNumber(-1, 1)))
				* CFrame.Angles(rng:NextNumber(-0.08, 0.08), rng:NextNumber(0, 3), rng:NextNumber(-0.08, 0.08)),
			Color = Color3.fromRGB(96, 92, 100):Lerp(tint, 0.25),
			Material = Enum.Material.Rock,
		}, parent)
		rock.CanCollide = false
	end
end

-- A tall strand of kelp or coral, swaying is left to the client tag.
local function makeStrand(at: Vector3, height: number, color: Color3, material: Enum.Material, parent: Instance)
	local segments = math.max(math.floor(height / 3), 2)
	for i = 1, segments do
		local lean = (i / segments) * rng:NextNumber(-0.5, 0.5)
		deco({
			Name = "Strand",
			Size = Vector3.new(0.7, height / segments + 0.4, 0.35),
			CFrame = CFrame.new(at + Vector3.new(lean * 2, (i - 0.5) * (height / segments), 0))
				* CFrame.Angles(0, rng:NextNumber(0, 3), lean),
			Color = color:Lerp(Color3.new(0, 0, 0), (i / segments) * 0.2),
			Material = material,
		}, parent)
	end
end

-- Dockside clutter: a crate, a barrel and a coil of rope. Small props at human
-- scale are what make a big empty space read as somewhere people work.
local function makeDockClutter(at: Vector3, parent: Instance)
	deco({
		Name = "Crate",
		Size = Vector3.new(2.2, 2.2, 2.2),
		CFrame = CFrame.new(at) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	}, parent)
	deco({
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.4, 1.7, 1.7),
		CFrame = CFrame.new(at + Vector3.new(2.6, -0.2, 0.6)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
	}, parent)
	for i = 1, 3 do
		deco({
			Name = "Rope" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.18, 1.6 - i * 0.25, 1.6 - i * 0.25),
			CFrame = CFrame.new(at + Vector3.new(-2.4, -0.95 + i * 0.18, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(196, 176, 130),
			Material = Enum.Material.Fabric,
		}, parent)
	end
end

--------------------------------------------------------------------------------
-- Per-area set dressing.
--
-- The five areas used to differ by tint and palm count, which is why the Kelp
-- Forest had no kelp in it. Water at this scale is mostly empty, so what fills
-- it IS the area — these are the things a player actually looks at while waiting
-- for a bite, and the reason sailing somewhere new feels like somewhere new.
--
-- Everything here is CanCollide false and CanQuery false (via `deco`): a cast
-- ray must never die on scenery, and a player must never get stuck in a coral.
--------------------------------------------------------------------------------

-- Giant kelp, built the way it actually grows: a stipe anchored on the sea floor
-- running all the way UP, then matting out into a canopy of blades lying flat on
-- the surface. The canopy is the whole point — real kelp forests read from above
-- as a floating field you look across, not as poles sticking out of the sea.
--
-- (An earlier version put loose strands at random heights and they read as green
-- boxes floating in mid-air. Rooted bottom, matted top, nothing in between.)
local SEA_FLOOR = -6.4
local SURFACE = -0.2

local function makeKelpColumn(at: Vector3, color: Color3, parent: Instance)
	local lean = rng:NextNumber(-0.09, 0.09)
	local segments = 6
	local span = SURFACE - 0.45 - SEA_FLOOR
	for i = 1, segments do
		local t = (i - 0.5) / segments
		local height = span / segments
		deco({
			Name = "KelpStipe",
			Size = Vector3.new(0.42, height + 0.15, 0.42),
			CFrame = CFrame.new(
				at.X + lean * t * 6,
				SEA_FLOOR + (i - 0.5) * height,
				at.Z + lean * t * 3
			) * CFrame.Angles(0, rng:NextNumber(0, 3), lean),
			Color = color:Lerp(Color3.fromRGB(48, 40, 24), 0.45 - t * 0.3),
			Material = Enum.Material.Grass,
		}, parent)
		-- Pneumatocysts: the little gas floats that hold the blades up. Tiny, but
		-- they are what stops the stipe reading as a green stick.
		if i > 2 then
			deco({
				Name = "KelpFloat",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.5, 0.62, 0.5),
				CFrame = CFrame.new(at.X + lean * t * 6 + 0.3, SEA_FLOOR + i * height, at.Z + lean * t * 3),
				Color = color:Lerp(Color3.fromRGB(190, 200, 90), 0.4),
				Material = Enum.Material.SmoothPlastic,
			}, parent)
		end
	end

	-- The canopy: blades fanned out just under the surface.
	local blades = rng:NextInteger(4, 6)
	local top = Vector3.new(at.X + lean * 6, SURFACE - 0.28, at.Z + lean * 3)
	for i = 1, blades do
		local theta = (i / blades) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local length = rng:NextNumber(5, 9)
		deco({
			Name = "KelpBlade",
			Size = Vector3.new(length, 0.22, rng:NextNumber(0.9, 1.6)),
			CFrame = CFrame.new(top + Vector3.new(math.cos(theta) * length * 0.5, 0, math.sin(theta) * length * 0.5))
				* CFrame.Angles(0, -theta, rng:NextNumber(-0.06, 0.06)),
			Color = color:Lerp(Color3.fromRGB(30, 60, 30), rng:NextNumber(0, 0.3)),
			Material = Enum.Material.Grass,
		}, parent)
	end
end

-- A coral head: a lump with branching arms and a brain or two. Reef colour comes
-- from the area palette, so the reef is loud in the way a reef is.
local function makeCoralHead(at: Vector3, palette: { Color3 }, parent: Instance)
	local base = palette[rng:NextInteger(1, #palette)]
	deco({
		Name = "CoralBase",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(rng:NextNumber(3, 5), rng:NextNumber(1.6, 2.6), rng:NextNumber(3, 5)),
		CFrame = CFrame.new(at) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
		Color = base:Lerp(Color3.fromRGB(120, 90, 90), 0.35),
		Material = Enum.Material.Rock,
	}, parent)
	-- Branches: a staghorn cluster leaning outward.
	for i = 1, rng:NextInteger(3, 6) do
		local theta = (i / 6) * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
		local height = rng:NextNumber(1.6, 3.4)
		local tint = palette[rng:NextInteger(1, #palette)]
		deco({
			Name = "CoralBranch",
			Size = Vector3.new(0.55, height, 0.55),
			CFrame = CFrame.new(
				at + Vector3.new(math.cos(theta) * 1.5, height * 0.45, math.sin(theta) * 1.5)
			) * CFrame.Angles(math.sin(theta) * 0.3, 0, math.cos(theta) * -0.3),
			Color = tint,
			Material = Enum.Material.Sandstone,
		}, parent)
		deco({
			Name = "CoralTip",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = CFrame.new(
				at + Vector3.new(math.cos(theta) * 2.0, height * 0.95, math.sin(theta) * 2.0)
			),
			Color = tint:Lerp(Color3.new(1, 1, 1), 0.3),
			Material = Enum.Material.Sandstone,
		}, parent)
	end
	-- A brain coral beside it: round, ribbed, a different silhouette so a reef
	-- does not read as one shape repeated.
	if rng:NextNumber() < 0.6 then
		local brainAt = at + Vector3.new(rng:NextNumber(-4, 4), 0.4, rng:NextNumber(-4, 4))
		local brain = palette[rng:NextInteger(1, #palette)]
		deco({
			Name = "BrainCoral",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.0, 2.6),
			CFrame = CFrame.new(brainAt),
			Color = brain,
			Material = Enum.Material.Sandstone,
		}, parent)
		for i = 1, 4 do
			deco({
				Name = "BrainRib",
				Size = Vector3.new(2.7, 0.22, 0.3),
				CFrame = CFrame.new(brainAt + Vector3.new(0, 0.5 - i * 0.22, 0))
					* CFrame.Angles(0, i * 0.7, 0),
				Color = brain:Lerp(Color3.fromRGB(40, 30, 40), 0.4),
				Material = Enum.Material.Sandstone,
			}, parent)
		end
	end
end

-- A hydrothermal vent: a basalt chimney with heat shimmering out of the top.
-- The trench needs a reason to look alive without looking lit.
local function makeVent(at: Vector3, color: Color3, parent: Instance)
	local height = rng:NextNumber(4, 8)
	local segments = 4
	for i = 1, segments do
		local t = (i - 1) / segments
		local width = (3.2 - t * 2.0) * rng:NextNumber(0.85, 1.15)
		deco({
			Name = "VentStack",
			Size = Vector3.new(width, height / segments + 0.4, width),
			CFrame = CFrame.new(at + Vector3.new(
				rng:NextNumber(-0.4, 0.4),
				(i - 0.5) * (height / segments),
				rng:NextNumber(-0.4, 0.4)
			)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Color = Color3.fromRGB(52, 48, 60),
			Material = Enum.Material.Basalt,
		}, parent)
	end
	local mouth = deco({
		Name = "VentMouth",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.5, 0.7, 1.5),
		CFrame = CFrame.new(at + Vector3.new(0, height, 0)),
		Color = color,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
	}, parent)
	-- The plume. Particles rather than parts, because it has to move and it must
	-- never be something a cast can land on.
	local plume = Instance.new("ParticleEmitter")
	plume.Color = ColorSequence.new(color)
	plume.LightEmission = 0.25
	plume.Size = NumberSequence.new(1.4, 3.4)
	plume.Transparency = NumberSequence.new(0.55, 1)
	plume.Lifetime = NumberRange.new(1.6, 3.2)
	plume.Rate = 5
	plume.Speed = NumberRange.new(2.5, 5)
	plume.SpreadAngle = Vector2.new(12, 12)
	plume.Parent = mouth
end

-- A basalt spire: taller, thinner and sharper than a sea stack, leaning. Trench
-- and Abyss geology, so the deep areas do not just look like a dark beach.
local function makeSpire(at: Vector3, height: number, tint: Color3, parent: Instance)
	local segments = math.max(math.floor(height / 6), 3)
	local lean = rng:NextNumber(-0.12, 0.12)
	for i = 1, segments do
		local t = (i - 1) / segments
		local width = (5.5 - t * 4.4) * rng:NextNumber(0.8, 1.2)
		deco({
			Name = "Spire",
			Size = Vector3.new(width, height / segments + 1.2, width * rng:NextNumber(0.8, 1.2)),
			CFrame = CFrame.new(at + Vector3.new(
				lean * i * 1.6,
				(i - 0.5) * (height / segments),
				lean * i * 0.8
			)) * CFrame.Angles(lean * 0.4, rng:NextNumber(0, 3), lean),
			Color = Color3.fromRGB(46, 44, 58):Lerp(tint, 0.22),
			Material = Enum.Material.Basalt,
		}, parent)
	end
end

-- Something enormous died here. A spine and a cage of ribs half-buried on the
-- floor of the Abyss, which does more for "this is the deep" than any tint.
local function makeBones(at: Vector3, parent: Instance)
	local BONE = Color3.fromRGB(214, 208, 190)
	local length = rng:NextNumber(16, 26)
	local heading = rng:NextNumber(0, 3)
	local facing = CFrame.new(at) * CFrame.Angles(0, heading, 0)
	deco({
		Name = "Spine",
		Size = Vector3.new(1.1, 1.1, length),
		CFrame = facing,
		Color = BONE,
		Material = Enum.Material.Sandstone,
	}, parent)
	local ribs = 7
	for i = 1, ribs do
		local z = -length * 0.4 + (i - 1) * (length * 0.8 / (ribs - 1))
		local span = (2.6 + math.sin(i / ribs * math.pi) * 3.4)
		for _, side in { 1, -1 } do
			deco({
				Name = "Rib",
				Size = Vector3.new(0.55, span, 0.55),
				CFrame = facing
					* CFrame.new(side * span * 0.42, span * 0.3, z)
					* CFrame.Angles(0, 0, side * 0.85),
				Color = BONE,
				Material = Enum.Material.Sandstone,
			}, parent)
		end
	end
	-- The skull, at one end.
	deco({
		Name = "Skull",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3.4, 2.8, 3.0),
		CFrame = facing * CFrame.new(0, 1.0, length * 0.55),
		Color = BONE,
		Material = Enum.Material.Sandstone,
	}, parent)
end

-- A conifer, for the cold rocky shore of the Kelp Forest. Palms there were the
-- single most obviously wrong thing on the beach.
local function makePine(position: Vector3, parent: Instance)
	local height = rng:NextNumber(10, 17)
	local trunk = deco({
		Name = "PineTrunk",
		Size = Vector3.new(1.3, height, 1.3),
		Position = position + Vector3.new(0, height * 0.5, 0),
		Color = Color3.fromRGB(92, 68, 50),
		Material = Enum.Material.Wood,
	}, parent)
	trunk.CanCollide = true
	local tiers = 5
	for i = 1, tiers do
		local t = (i - 1) / tiers
		local width = (9 - t * 6.2) * rng:NextNumber(0.9, 1.1)
		deco({
			Name = "PineTier",
			Size = Vector3.new(width, height * 0.2, width),
			CFrame = CFrame.new(position + Vector3.new(0, height * (0.34 + t * 0.62), 0))
				* CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Color = Color3.fromRGB(38, 82, 56):Lerp(Color3.fromRGB(70, 130, 80), t * 0.5),
			Material = Enum.Material.Grass,
		}, parent)
	end
end

-- A spot for something that GROWS, kept clear of the fishing arc.
--
-- The arc sits at radius 32-42 around (ox, oz - 52) and carries the twelve
-- buoys. Scenery there does not block a cast — everything from `deco` has
-- CanQuery off — but a kelp column is 6 studs of green standing exactly where a
-- marker you are looking for floats, and "I can't find my buoy" is a worse
-- problem than a slightly emptier arc. So: sample, and reroll anything that
-- lands in the band. Bounded retries, because an unbounded loop in map
-- generation is a hang, not a bug.
local function growthSpot(ox: number, oz: number): Vector3
	local center = Vector2.new(ox, oz - 52)
	for _ = 1, 8 do
		local at = Vector2.new(ox + rng:NextNumber(-125, 125), oz - rng:NextNumber(14, 145))
		local distance = (at - center).Magnitude
		if distance < 24 or distance > 50 then
			return Vector3.new(at.X, 0, at.Y)
		end
	end
	-- Fell through: put it well outside the arc rather than give up on it.
	return Vector3.new(ox + rng:NextNumber(-125, 125), 0, oz - rng:NextNumber(96, 145))
end

local function scatterScenery(index: number, theme: AreaTheme, ox: number, oz: number, parent: Instance)
	-- Rock out in the water, off to both sides so it frames the fishing arc
	-- instead of standing in it. Shallow areas get rounded sea stacks; the deep
	-- ones get leaning basalt spires, because "dark beach" is not a trench.
	for i = 1, 6 do
		local side = if i % 2 == 0 then 1 else -1
		local at = Vector3.new(ox + side * rng:NextNumber(58, 120), -3, oz - rng:NextNumber(30, 130))
		if theme.Shore == "Spire" then
			makeSpire(at, rng:NextNumber(22, 46), theme.Water, parent)
		else
			makeSeaStack(at, rng:NextNumber(14, 34), theme.Water, parent)
		end
	end

	-- WHAT GROWS HERE. This is the difference between five areas and one area in
	-- five colours, and it is the first thing a player notices about a new dock.
	--
	-- Everything rooted on the sea floor (y = -6.4) — except the kelp, which is
	-- supposed to reach the surface and mat out across it, because that is what a
	-- kelp forest is and its absence was the specific complaint.
	local growth = theme.Growth
	if growth == "Kelp" then
		-- Fewer than the old strand count and much bigger: a forest is made of
		-- columns you look between, not of scattered weeds.
		for _ = 1, 16 do
			makeKelpColumn(growthSpot(ox, oz), Color3.fromRGB(74, 120, 52), parent)
		end
		-- Low understory between the columns.
		for _ = 1, 14 do
			makeStrand(
				Vector3.new(ox + rng:NextNumber(-120, 120), SEA_FLOOR, oz - rng:NextNumber(10, 140)),
				rng:NextNumber(2.5, 4.5),
				Color3.fromRGB(58, 96, 44),
				Enum.Material.Grass,
				parent
			)
		end
	elseif growth == "Coral" then
		for _ = 1, 18 do
			local at = growthSpot(ox, oz)
			makeCoralHead(Vector3.new(at.X, SEA_FLOOR + 1, at.Z), theme.Spots, parent)
		end
		-- Sea fans: thin, tall, and a completely different silhouette from the
		-- heads, which is what stops a reef reading as one shape repeated.
		for _ = 1, 12 do
			makeStrand(
				Vector3.new(ox + rng:NextNumber(-120, 120), SEA_FLOOR, oz - rng:NextNumber(10, 140)),
				rng:NextNumber(3, 5),
				theme.Spots[rng:NextInteger(1, #theme.Spots)],
				Enum.Material.Sandstone,
				parent
			)
		end
	elseif growth == "Vent" then
		for _ = 1, 9 do
			local at = growthSpot(ox, oz)
			makeVent(Vector3.new(at.X, SEA_FLOOR, at.Z), theme.Spots[rng:NextInteger(1, #theme.Spots)], parent)
		end
		for _ = 1, 16 do
			makeStrand(
				Vector3.new(ox + rng:NextNumber(-120, 120), SEA_FLOOR, oz - rng:NextNumber(10, 140)),
				rng:NextNumber(3, 5.5),
				theme.Spots[1],
				Enum.Material.Neon,
				parent
			)
		end
	elseif growth == "Bone" then
		for _ = 1, 5 do
			local at = growthSpot(ox, oz)
			makeBones(Vector3.new(at.X, SEA_FLOOR + 0.8, at.Z), parent)
		end
		for _ = 1, 6 do
			local at = growthSpot(ox, oz)
			makeVent(Vector3.new(at.X, SEA_FLOOR, at.Z), theme.Spots[rng:NextInteger(1, #theme.Spots)], parent)
		end
		for _ = 1, 18 do
			makeStrand(
				Vector3.new(ox + rng:NextNumber(-120, 120), SEA_FLOOR, oz - rng:NextNumber(10, 140)),
				rng:NextNumber(3, 5.5),
				theme.Spots[rng:NextInteger(1, #theme.Spots)],
				Enum.Material.Neon,
				parent
			)
		end
	else -- Reeds: the shallows. Ordinary green weed, kept under the waterline.
		for _ = 1, 26 do
			makeStrand(
				Vector3.new(ox + rng:NextNumber(-120, 120), SEA_FLOOR, oz - rng:NextNumber(10, 140)),
				rng:NextNumber(3, 5.5),
				Color3.fromRGB(90, 190, 120),
				Enum.Material.Grass,
				parent
			)
		end
	end

	-- Beached rocks and driftwood on the sand
	for _ = 1, 14 do
		local size = rng:NextNumber(1.6, 5)
		deco({
			Name = "ShoreRock",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size * rng:NextNumber(0.5, 0.8), size * rng:NextNumber(0.7, 1.2)),
			CFrame = CFrame.new(ox + rng:NextNumber(-120, 120), rng:NextNumber(-0.4, 0.4), oz + rng:NextNumber(15, 105))
				* CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)),
			Color = Color3.fromRGB(104, 100, 108):Lerp(theme.Sand, 0.3),
			Material = Enum.Material.Rock,
		}, parent)
	end

	-- Mooring posts down both sides of the dock, with lanterns on the deep ones
	for i = 1, 6 do
		local z = oz - 6 - i * 8
		for _, side in { -1, 1 } do
			local post = deco({
				Name = "MooringPost",
				Size = Vector3.new(0.8, 4.5, 0.8),
				Position = Vector3.new(ox + side * 8.4, 1.2, z),
				Color = DARK_WOOD,
				Material = Enum.Material.Wood,
			}, parent)
			if i % 2 == 0 then
				local lamp = deco({
					Name = "Lantern",
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(0.9, 0.9, 0.9),
					Position = post.Position + Vector3.new(0, 2.8, 0),
					Color = theme.Spots[1],
					Material = Enum.Material.Neon,
				}, parent)
				local light = Instance.new("PointLight")
				light.Color = theme.Spots[1]
				light.Range = 11
				light.Brightness = 0.55
				light.Shadows = false
				light.Parent = lamp
			end
		end
	end

	makeDockClutter(Vector3.new(ox - 11, 1.6, oz - 12), parent)
	makeDockClutter(Vector3.new(ox + 12, 1.6, oz - 30), parent)

	-- Two giant fish turning above the water. They are the landmark you can see
	-- from the previous dock, and they advertise what lives here far better than
	-- the price on the Dock Master's list does.
	--
	-- They are REAL SPECIES from this area, in that species' own colours — the
	-- two rarest ones. A generic fish in a theme colour is decoration; a
	-- twenty-stud Megalodon turning over the Abyss is the argument for buying the
	-- Abyss. Every species has its own silhouette now, so this costs one lookup.
	local headline = Crystals.BasesInLayer(index, Crystals.FISH)
	table.sort(headline, function(a, b)
		return a.Value > b.Value
	end)
	for slot, at in { Vector3.new(ox - 52, 15, oz - 62), Vector3.new(ox + 52, 15, oz - 62) } do
		local star = headline[slot]
		local trophy = FishShape.Build({
			Name = if star then star.Name else nil,
			Color = if star then star.Color else theme.Spots[1],
			Scale = rng:NextNumber(2.6, 3.2),
			Seed = math.floor(at.X * 7 + at.Z),
			Glow = 12,
			Sparkle = true,
			Neon = index >= 4,
		})
		trophy.Name = "Landmark" .. index
		trophy:PivotTo(CFrame.new(at))
		trophy.Parent = parent
		CollectionService:AddTag(trophy, "SpinCrystal")
		trophy:SetAttribute("SpinSpeed", rng:NextNumber(0.12, 0.22))
		trophy:SetAttribute("BobHeight", rng:NextNumber(1.4, 2.4))
		trophy:SetAttribute("BobSpeed", rng:NextNumber(0.4, 0.7))
	end
end

-- An actual navigation buoy: a fat float sitting in the water with a painted
-- band, a weighted skirt below the surface, a mast, and a lamp on top.
--
-- The lamp is the working part. It is what the fishing loop recolours and
-- brightens for cast and bite, so the buoy itself never changes shape — the old
-- marker was a neon ball that got resized for every state, which is why it read
-- as an abstract blob rather than as a thing floating in the sea.
--
-- Returns the FLOAT, which is the part the rest of the game treats as the spot:
-- its position is the waterline, which is where distances and the bobber want to
-- be measured from.
local RING_RADIUS = 2.7
local RING_TUBE = 1.05
local RING_SEGMENTS = 16

local function buildBuoy(
	name: string,
	position: Vector3,
	color: Color3,
	styleName: string?,
	parent: Instance
): BasePart
	local model = Instance.new("Model")
	model.Name = "Buoy"

	-- The spot the rest of the game keys on. Invisible, because the buoy it
	-- stands for is a ring with a hole in the middle — there is nothing at the
	-- centre for it to be. It still carries the area colour, which is what the
	-- lamp reads its idle and dimmed shades from.
	local float = part({
		Name = name,
		Size = Vector3.new(1, 1, 1),
		Position = position,
		Color = color,
		Transparency = 1,
	}, model)
	float.CanCollide = false
	model.PrimaryPart = float

	-- The apex is where the lantern goes, and it is the SAME height for every
	-- hull below. The fishing loop recolours and swells that lamp for cast and
	-- bite, and MiningService hard-codes its size — so the marker's silhouette is
	-- free to change per area, but the working light on top never does.
	local apex = position + Vector3.new(0, 4.5, 0)

	local function fixture(props: { [string]: any }): Part
		local piece = part(props, model)
		piece.CanCollide = false
		piece.CanQuery = false
		return piece
	end

	local METAL = Color3.fromRGB(96, 88, 78)

	local style = styleName or "Ring"
	if style == "Float" then
		-- KELP FOREST: a working crab-pot buoy. A weathered wooden barrel riding
		-- the surface with rope whipped round it and one plain timber mast. This
		-- is what actually floats over a kelp bed, and it looks like someone's job
		-- rather than someone's harbour.
		fixture({
			Name = "Barrel",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3.0, 2.5, 2.5),
			CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(150, 112, 74):Lerp(color, 0.25),
			Material = Enum.Material.Wood,
		})
		for i = 1, 2 do
			fixture({
				Name = "RopeBand",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.34, 2.66, 2.66),
				CFrame = CFrame.new(position + Vector3.new(0, -0.55 + i * 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(196, 176, 130),
				Material = Enum.Material.Fabric,
			})
		end
		fixture({
			Name = "Mast",
			Size = Vector3.new(0.42, 4.0, 0.42),
			Position = position + Vector3.new(0, 2.6, 0),
			Color = Color3.fromRGB(120, 92, 62),
			Material = Enum.Material.Wood,
		})
		-- Kelp caught round the float, because everything out here is.
		for i = 1, 3 do
			local theta = (i / 3) * math.pi * 2
			fixture({
				Name = "TangledKelp",
				Size = Vector3.new(rng:NextNumber(2.5, 4), 0.2, 0.9),
				CFrame = CFrame.new(position + Vector3.new(math.cos(theta) * 2.2, -0.5, math.sin(theta) * 2.2))
					* CFrame.Angles(0, -theta, 0.1),
				Color = Color3.fromRGB(74, 120, 52),
				Material = Enum.Material.Grass,
			})
		end
	elseif style == "Glass" then
		-- TWILIGHT REEF: a Japanese glass fishing float in a rope net, resting on
		-- a coral knob. Warm, handmade, and see-through, which is the opposite of
		-- the trench's steel and reads instantly as "reef".
		fixture({
			Name = "GlassFloat",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.6, 3.6, 3.6),
			Position = position + Vector3.new(0, 0.5, 0),
			Color = color:Lerp(Color3.fromRGB(180, 255, 235), 0.4),
			Material = Enum.Material.Glass,
			Transparency = 0.45,
		})
		-- The net: three rings and four verticals, which is enough to read as rope.
		for i = 1, 3 do
			fixture({
				Name = "NetRing",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.16, 3.7 - math.abs(i - 2) * 0.7, 3.7 - math.abs(i - 2) * 0.7),
				CFrame = CFrame.new(position + Vector3.new(0, -0.4 + i * 0.9, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(206, 186, 140),
				Material = Enum.Material.Fabric,
			})
		end
		for i = 1, 4 do
			local theta = (i / 4) * math.pi
			fixture({
				Name = "NetLine",
				Size = Vector3.new(0.16, 3.6, 0.16),
				CFrame = CFrame.new(position + Vector3.new(math.cos(theta) * 1.75, 0.5, math.sin(theta) * 1.75))
					* CFrame.Angles(0, -theta, 0),
				Color = Color3.fromRGB(206, 186, 140),
				Material = Enum.Material.Fabric,
			})
		end
		-- Coral knob under it, tying the marker to the reef it sits on.
		fixture({
			Name = "CoralKnob",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 1.4, 2.6),
			Position = position + Vector3.new(0, -1.2, 0),
			Color = color,
			Material = Enum.Material.Sandstone,
		})
		fixture({
			Name = "Mast",
			Size = Vector3.new(0.36, 2.6, 0.36),
			Position = position + Vector3.new(0, 3.4, 0),
			Color = Color3.fromRGB(150, 120, 80),
			Material = Enum.Material.Wood,
		})
	elseif style == "Can" then
		-- MIDNIGHT TRENCH: an industrial steel can buoy. Riveted drum, rim, and a
		-- caged lamp — heavy shipping hardware, moored somewhere nothing grows.
		fixture({
			Name = "Can",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3.4, 3.2, 3.2),
			CFrame = CFrame.new(position + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(88, 92, 104):Lerp(color, 0.25),
			Material = Enum.Material.DiamondPlate,
		})
		fixture({
			Name = "Rim",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 3.7, 3.7),
			CFrame = CFrame.new(position + Vector3.new(0, 1.8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(210, 140, 40),
			Material = Enum.Material.Metal,
		})
		for i = 1, 8 do
			local theta = (i / 8) * math.pi * 2
			fixture({
				Name = "Rivet",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.3, 0.3, 0.3),
				Position = position + Vector3.new(math.cos(theta) * 1.62, 0.5, math.sin(theta) * 1.62),
				Color = Color3.fromRGB(62, 64, 74),
				Material = Enum.Material.Metal,
			})
		end
		-- Cage: three uprights to the apex plus a ring, so the lamp reads as
		-- protected hardware rather than a bulb on a stick.
		for i = 1, 3 do
			local theta = (i / 3) * math.pi * 2
			fixture({
				Name = "CageBar",
				Size = Vector3.new(0.24, 3.4, 0.24),
				Position = position + Vector3.new(math.cos(theta) * 0.85, 2.6, math.sin(theta) * 0.85),
				Color = METAL,
				Material = Enum.Material.Metal,
			})
		end
		fixture({
			Name = "CageRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.22, 2.0, 2.0),
			CFrame = CFrame.new(position + Vector3.new(0, 3.6, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = METAL,
			Material = Enum.Material.Metal,
		})
	elseif style == "Orb" then
		-- THE ABYSS: nothing manufactured survives down here. A black stalk of
		-- bone with a cluster of live lights round its foot and the lantern slung
		-- out front on a curved arm — the marker itself is an anglerfish lure.
		fixture({
			Name = "Stalk",
			Size = Vector3.new(0.6, 4.4, 0.6),
			Position = position + Vector3.new(0, 1.6, 0),
			Color = Color3.fromRGB(46, 44, 58),
			Material = Enum.Material.Slate,
		})
		fixture({
			Name = "Holdfast",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.0, 1.5, 3.0),
			Position = position + Vector3.new(0, -0.3, 0),
			Color = Color3.fromRGB(38, 36, 50),
			Material = Enum.Material.Slate,
		})
		for i = 1, 6 do
			local theta = (i / 6) * math.pi * 2
			fixture({
				Name = "Bulb",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.6, 0.6, 0.6),
				Position = position
					+ Vector3.new(math.cos(theta) * 1.35, 0.35 + math.sin(theta * 2) * 0.3, math.sin(theta) * 1.35),
				Color = color,
				Material = Enum.Material.Neon,
				Transparency = 0.25,
			})
		end
		-- The lure arm, curving up and forward to the lantern.
		for i = 1, 4 do
			local t = i / 4
			fixture({
				Name = "LureArm",
				Size = Vector3.new(0.34, 0.34, 1.0),
				CFrame = CFrame.new(position + Vector3.new(0, 3.5 + t * 1.0, -t * 0.9))
					* CFrame.Angles(-0.5 + t * 0.3, 0, 0),
				Color = Color3.fromRGB(52, 50, 64),
				Material = Enum.Material.Slate,
			})
		end
	else
		-- SUNNY SHALLOWS: the classic harbour ring buoy on a tripod.
		--
		-- Roblox has no torus, and a ring is the single thing that makes a buoy
		-- read as a buoy — sixteen segments is past the point where anyone can see
		-- the seams from the dock. A cylinder's axis is its X, so each segment is
		-- turned to put that axis along the tangent of the circle at its angle.
		-- Painted in four alternating quadrants, life-ring style, rather than with
		-- a separate white band over every segment: it is the bolder read at the
		-- thirty studs you actually see these from and it costs half the parts.
		local segmentLength = 2 * RING_RADIUS * math.sin(math.pi / RING_SEGMENTS) * 1.25
		local perQuadrant = RING_SEGMENTS / 4
		for i = 1, RING_SEGMENTS do
			local theta = (i - 1) / RING_SEGMENTS * math.pi * 2
			local at = position + Vector3.new(math.cos(theta) * RING_RADIUS, 0, math.sin(theta) * RING_RADIUS)
			local white = math.floor((i - 1) / perQuadrant) % 2 == 1
			fixture({
				Name = "Ring",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(segmentLength, RING_TUBE, RING_TUBE),
				CFrame = CFrame.new(at) * CFrame.Angles(0, -theta - math.pi * 0.5, 0),
				Color = if white then Color3.fromRGB(248, 248, 250) else color,
				Material = Enum.Material.SmoothPlastic,
			})
		end
		-- Tripod: three legs leaning in from the ring to meet under the lantern.
		for i = 1, 3 do
			local theta = (i - 1) / 3 * math.pi * 2 + math.pi * 0.5
			local foot = position
				+ Vector3.new(math.cos(theta) * (RING_RADIUS - 0.35), 0.3, math.sin(theta) * (RING_RADIUS - 0.35))
			local span = (apex - foot).Magnitude
			fixture({
				Name = "Leg",
				Size = Vector3.new(0.34, 0.34, span),
				-- lookAt aims the part's -Z down its own length, so a part sized on
				-- Z stretches exactly from the foot to the apex however far that is.
				CFrame = CFrame.lookAt((foot + apex) * 0.5, apex),
				-- Tinted toward the area's colour rather than left bare metal. The
				-- silhouette should be a real buoy; the palette should still look
				-- like a game a twelve-year-old wants to be in.
				Color = METAL:Lerp(color, 0.3),
				Material = Enum.Material.Metal,
			})
		end
	end

	-- Lantern: a ribbed glass stack on a dark base with a cap, the way the light
	-- on a real channel marker is built.
	local base = part({
		Name = "LampBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 1.5, 1.5),
		CFrame = CFrame.new(apex + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(64, 60, 68),
		Material = Enum.Material.Metal,
	}, model)
	base.CanCollide = false
	base.CanQuery = false

	local lamp = part({
		Name = "Lamp",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.1, 1.25, 1.25),
		CFrame = CFrame.new(apex + Vector3.new(0, 0.95, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = Enum.Material.Neon,
	}, model)
	lamp.CanCollide = false
	lamp.CanQuery = false
	-- Ribs: three dark rings round the glass, which is what stops the lantern
	-- reading as a plain glowing pill.
	for i = 1, 3 do
		local rib = part({
			Name = "LampRib",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 1.32, 1.32),
			CFrame = CFrame.new(apex + Vector3.new(0, 0.6 + i * 0.28, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(64, 60, 68),
			Material = Enum.Material.Metal,
		}, model)
		rib.CanCollide = false
		rib.CanQuery = false
	end
	local cap = part({
		Name = "LampCap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 1.45, 1.45),
		CFrame = CFrame.new(apex + Vector3.new(0, 1.7, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(64, 60, 68),
		Material = Enum.Material.Metal,
	}, model)
	cap.CanCollide = false
	cap.CanQuery = false

	-- Modest, because there are twelve of these in a small arc and their light
	-- adds. The lantern's own neon does the "I am lit" work; this only has to
	-- put a little colour on the water around it.
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 9
	glow.Brightness = 0.5
	glow.Shadows = false
	glow.Parent = lamp

	-- Twinkle off the lantern. Costs one emitter and it is the difference between
	-- a navigation marker and something you actually want to go and click.
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Color = ColorSequence.new(color)
	sparkle.LightEmission = 0.3
	sparkle.Size = NumberSequence.new(0.35, 0)
	sparkle.Transparency = NumberSequence.new(0.2, 1)
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Rate = 4
	sparkle.Speed = NumberRange.new(0.4, 1.2)
	sparkle.SpreadAngle = Vector2.new(70, 70)
	sparkle.Parent = lamp

	-- No light pool on the water. Twelve nine-stud neon discs per area, even at
	-- 0.82 transparency, blew out into overlapping white sheets that swallowed
	-- the sea AND the ring float sitting on top of them — the buoys read as
	-- glowing puddles with legs. Neon does not dim the way a transparent surface
	-- suggests it will; it is fullbright, so transparency only thins it, and a
	-- dozen thin fullbright discs still add up to solid white.

	-- One invisible box owns the tap, the same way the mining game's geodes do.
	-- A buoy bobbing thirty studs out is a very small target on a phone; this
	-- makes it a fair one without inflating the buoy itself. It deliberately
	-- carries NO NodeIndex — the client resolves a hit on it to its parent float,
	-- and the server only knows about floats. Giving the box its own index would
	-- make the client report an instance the server has never heard of, and every
	-- tap would silently do nothing.
	local hitbox = part({
		Name = "Hitbox",
		Size = Vector3.new(9, 10, 9),
		Position = position + Vector3.new(0, 1.6, 0),
		Transparency = 1,
	}, float)
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = true

	model.Parent = parent
	return float
end

-- A VISTA: the next area, seen from this one's dock.
--
-- Five stretches of water 600 studs apart are five separate rooms, and standing
-- on the first dock the horizon was empty in every direction — which reads as
-- "this is all there is" at exactly the moment the game wants you thinking about
-- what you are saving for. The Dock Master can list the Abyss at three million
-- coins; a shape on the horizon in the Abyss's own colours is a far better
-- argument, because you found it yourself.
--
-- Deliberately far out and deliberately coarse: it is scenery to look at, not a
-- place to swim to. Nothing collides, nothing answers a raycast, and it sits
-- well past the fishing arc so it can never be mistaken for somewhere to cast.
local function buildVista(theme: AreaTheme, name: string, layer: number, ox: number, oz: number, parent: Instance)
	local at = Vector3.new(ox + rng:NextNumber(-60, 60), 0, oz - 420)

	-- An island: stacked rock in the target area's palette, big enough to read
	-- through the haze.
	for i = 1, 9 do
		local t = (i - 1) / 9
		local width = (52 - t * 40) * rng:NextNumber(0.8, 1.2)
		local rock = deco({
			Name = "VistaRock",
			Size = Vector3.new(width, 16, width * rng:NextNumber(0.7, 1.3)),
			CFrame = CFrame.new(at + Vector3.new(rng:NextNumber(-16, 16), i * 11 - 12, rng:NextNumber(-16, 16)))
				* CFrame.Angles(0, rng:NextNumber(0, 3), 0),
			Color = Color3.fromRGB(88, 86, 96):Lerp(theme.Water, 0.4),
			Material = Enum.Material.Rock,
		}, parent)
		rock.CastShadow = false
	end

	-- A beacon on top in the area's own colour, so it is identifiable at a
	-- glance and legible at night.
	local beacon = deco({
		Name = "VistaBeacon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(14, 14, 14),
		Position = at + Vector3.new(0, 104, 0),
		Color = theme.Spots[1],
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	}, parent)
	local light = Instance.new("PointLight")
	light.Color = theme.Spots[1]
	light.Range = 26
	light.Brightness = 0.5
	light.Shadows = false
	light.Parent = beacon

	-- And its name, floating above it. A landmark you can identify is a goal;
	-- an unnamed rock is set dressing.
	local sign = Instance.new("BillboardGui")
	sign.Name = "VistaName"
	sign.Size = UDim2.fromScale(46, 9)
	sign.StudsOffset = Vector3.new(0, 22, 0)
	sign.AlwaysOnTop = false
	sign.MaxDistance = 900
	sign.Parent = beacon
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = name
	label.TextColor3 = theme.Spots[1]
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Parent = sign

	-- A couple of giant fish circling it, in the water you cannot fish yet. Real
	-- species again, so what you can make out on the horizon is genuinely what
	-- swims there — the Abyss advertises itself with a Megalodon.
	local headline = Crystals.BasesInLayer(layer, Crystals.FISH)
	table.sort(headline, function(a, b)
		return a.Value > b.Value
	end)
	for i = 1, 2 do
		local star = headline[i]
		local trophy = FishShape.Build({
			Name = if star then star.Name else nil,
			Color = if star then star.Color else theme.Spots[math.min(i + 1, #theme.Spots)],
			Scale = rng:NextNumber(5, 7),
			Seed = math.floor(at.X) + i * 31,
			Neon = true,
		})
		trophy.Name = "VistaFish"
		trophy:PivotTo(
			CFrame.new(at + Vector3.new(rng:NextNumber(-80, 80), rng:NextNumber(34, 70), rng:NextNumber(-40, 40)))
				* CFrame.Angles(0, rng:NextNumber(0, 6), 0)
		)
		trophy.Parent = parent
		CollectionService:AddTag(trophy, "SpinCrystal")
		trophy:SetAttribute("SpinSpeed", rng:NextNumber(0.05, 0.1))
		trophy:SetAttribute("BobHeight", rng:NextNumber(3, 6))
		trophy:SetAttribute("BobSpeed", rng:NextNumber(0.2, 0.35))
	end
end

-- One area: its own water, its own beach, its own dock, its own twelve buoys.
-- Areas are built side by side along X rather than stitched together, because
-- travel between them is by boat (a teleport) — there is no walk to preserve, so
-- there is no reason to pay for contiguous terrain.
--
-- Returns the area's fishing spots, all tagged with an `Area` attribute so one
-- MiningService can serve every area from a single flat node list.
local function buildArea(index: number, origin: Vector3, parent: Instance): { Spots: { BasePart }, Dock: ProximityPrompt }
	local theme = AREA_THEMES[index] or AREA_THEMES[1]
	local name = Balance.LayerNames[index] or ("Area " .. index)
	local ox, oz = origin.X, origin.Z

	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(ox, -6, oz + 60), Vector3.new(280, 12, 140), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(ox, -10, oz - 70), Vector3.new(280, 12, 160), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(ox, -3.2, oz - 70), Vector3.new(280, 6, 160), Enum.Material.Water)

	part({
		Name = "Beach" .. index,
		Size = Vector3.new(240, 1, 110),
		Position = Vector3.new(ox, -0.5, oz + 62),
		Color = theme.Sand,
		Material = Enum.Material.Sand,
	}, parent)
	part({
		Name = "Dock" .. index,
		Size = Vector3.new(14, 1, 70),
		Position = Vector3.new(ox, 0.6, oz - 20),
		Color = Color3.fromRGB(160, 120, 80),
		Material = Enum.Material.WoodPlanks,
	}, parent)
	part({
		Name = "DockT" .. index,
		Size = Vector3.new(60, 1, 12),
		Position = Vector3.new(ox, 0.6, oz - 52),
		Color = Color3.fromRGB(160, 120, 80),
		Material = Enum.Material.WoodPlanks,
	}, parent)
	-- A shallow water-coloured slab under each area's spots. Terrain water is one
	-- global colour, so this is what actually makes the Abyss look like the Abyss
	-- and not like the Sunny Shallows with different fish in it.
	local tint = part({
		Name = "WaterTint" .. index,
		Size = Vector3.new(280, 0.4, 160),
		Position = Vector3.new(ox, -0.4, oz - 70),
		Color = theme.Water,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.45,
	}, parent)
	tint.CanCollide = false
	tint.CanQuery = false

	-- What stands on the shore. A palm on the Kelp Forest beach was the single
	-- most obviously wrong thing in the map: that area is a cold northern cove.
	if theme.Shore == "Pine" then
		for _ = 1, 12 do
			makePine(Vector3.new(ox + rng:NextNumber(-115, 115), 0, oz + rng:NextNumber(38, 104)), parent)
		end
	elseif theme.Shore == "Spire" then
		-- Nothing grows. Rock comes up out of the beach instead.
		for _ = 1, 9 do
			makeSpire(
				Vector3.new(ox + rng:NextNumber(-118, 118), -1, oz + rng:NextNumber(42, 104)),
				rng:NextNumber(14, 30),
				theme.Water,
				parent
			)
		end
	elseif theme.Shore == "Rock" then
		for _ = 1, 8 do
			makeSeaStack(
				Vector3.new(ox + rng:NextNumber(-115, 115), -1, oz + rng:NextNumber(42, 102)),
				rng:NextNumber(8, 18),
				theme.Sand,
				parent
			)
		end
	end
	for _ = 1, theme.Palms do
		makePalm(Vector3.new(ox + rng:NextNumber(-110, 110), 0, oz + rng:NextNumber(40, 100)), parent)
	end
	scatterScenery(index, theme, ox, oz, parent)

	-- Show this dock what comes next. The last area has nothing after it, so it
	-- gets its own colours reflected back instead of an empty horizon — the Abyss
	-- being the end of the map is the point, but "the end" should still look like
	-- somewhere rather than like the world running out.
	local nextIndex = math.min(index + 1, Balance.MaxLayer)
	local nextTheme = AREA_THEMES[nextIndex] or theme
	buildVista(nextTheme, Balance.LayerNames[nextIndex] or "", nextIndex, ox, oz, parent)

	-- An ARCH over the head of the dock, not a board across it. The first version
	-- was a solid 18x5 part standing at walking height in the middle of the only
	-- path to the water — you could not get past it to fish. Posts to either side
	-- of the dock, the board slung between them well overhead, and nothing on it
	-- collides or answers a raycast, so it can never block a walk or eat a cast.
	for _, side in { -1, 1 } do
		local post = part({
			Name = "ArchPost" .. index,
			Size = Vector3.new(0.9, 13, 0.9),
			Position = Vector3.new(ox + side * 8.6, 6.5, oz - 4),
			Color = Color3.fromRGB(90, 65, 45),
			Material = Enum.Material.Wood,
		}, parent)
		post.CanCollide = false
		post.CanQuery = false
	end
	local sign = part({
		Name = "AreaSign" .. index,
		Size = Vector3.new(18, 4, 0.6),
		CFrame = CFrame.lookAt(Vector3.new(ox, 12, oz - 4), Vector3.new(ox, 12, oz - 40)),
		Color = Color3.fromRGB(90, 65, 45),
		Material = Enum.Material.Wood,
	}, parent)
	sign.CanCollide = false
	sign.CanQuery = false
	local signGui = Instance.new("SurfaceGui")
	signGui.Face = Enum.NormalId.Front
	signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	signGui.PixelsPerStud = 40
	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.fromScale(1, 1)
	signLabel.BackgroundTransparency = 1
	signLabel.Font = Enum.Font.FredokaOne
	signLabel.Text = name
	signLabel.TextColor3 = theme.Spots[1]
	signLabel.TextScaled = true
	signLabel.Parent = signGui
	signGui.Parent = sign

	-- Fishing spots: glowing buoys floating in an arc around the dock head
	local nodes: { BasePart } = {}
	local nodeFolder = Instance.new("Folder")
	nodeFolder.Name = "Nodes" .. index
	nodeFolder.Parent = parent
	for i = 1, Balance.NodeCount do
		local angle = math.rad(180 + (i - 1) * (180 / (Balance.NodeCount - 1)))
		local radius = 32 + (i % 2) * 10
		-- Floating ON the water (top at y = -0.2), not half sunk in it. A buoy
		-- with only its cap above the surface gives a tap almost nothing to land
		-- on once terrain water is in the way.
		local position =
			Vector3.new(ox + math.cos(angle) * radius, 0.9, oz - 52 + math.sin(angle) * radius)
		local color = theme.Spots[rng:NextInteger(1, #theme.Spots)]
		local spot = buildBuoy(("Spot%d_%d"):format(index, i), position, color, theme.Buoy, nodeFolder)
		spot:SetAttribute("NodeIndex", i)
		spot:SetAttribute("Area", index)
		CollectionService:AddTag(spot, "FishingSpot")
		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = Balance.CastRange
		click.Parent = spot

		-- Buoys ride the swell. The bob runs on each client, so sixty floating
		-- markers across five areas cost the server nothing. The tag goes on the
		-- MODEL: PivotTo on a lone part leaves its mast and lamp behind, which
		-- looks like the buoy is coming apart rather than bobbing.
		local buoy = spot.Parent :: Model
		CollectionService:AddTag(buoy, "SpinCrystal")
		buoy:SetAttribute("SpinSpeed", 0)
		buoy:SetAttribute("BobHeight", rng:NextNumber(0.3, 0.55))
		buoy:SetAttribute("BobSpeed", rng:NextNumber(0.8, 1.3))
		table.insert(nodes, spot)
	end

	-- A DOCK MASTER ON EVERY DOCK. Travel used to be a one-way trip: the only
	-- Dock Master stood on the home beach, so once you sailed to the Kelp Forest
	-- the only way back was the bottom bar. Sailing somewhere should not be a
	-- thing you can strand yourself with, and the station is the place a player
	-- already looks for it. The prompt carries a Station attribute and the client
	-- opens the screen from that, so five of them cost nothing to wire.
	local dock = makeStation(
		Vector3.new(ox - 16, 0.5, oz - 8),
		"Dock Master",
		"Dock",
		Color3.fromRGB(120, 200, 255),
		parent,
		theme
	)

	-- INVISIBLE WALLS around the area's own patch of sea. Terrain runs out at
	-- 140 studs either side and the water is swimmable, so a player heading away
	-- from the dock just kept going and fell out of the world. Roblox lets you do
	-- that; an eight-year-old on a phone should not have to know it.
	--
	-- Set well outside the fishing arc (radius 42) and the vista (420 out is
	-- scenery, deliberately unreachable), so nothing you can actually interact
	-- with is behind a wall.
	local BOUND_X, BOUND_NEAR, BOUND_FAR = 138, 126, 152
	local walls: { { pos: Vector3, size: Vector3 } } = {
		{ pos = Vector3.new(ox - BOUND_X, 24, oz - 12), size = Vector3.new(2, 80, 300) },
		{ pos = Vector3.new(ox + BOUND_X, 24, oz - 12), size = Vector3.new(2, 80, 300) },
		{ pos = Vector3.new(ox, 24, oz - BOUND_FAR), size = Vector3.new(2 * BOUND_X, 80, 2) },
		{ pos = Vector3.new(ox, 24, oz + BOUND_NEAR), size = Vector3.new(2 * BOUND_X, 80, 2) },
	}
	for i, wall in walls do
		local barrier = part({
			Name = "Barrier" .. index .. "_" .. i,
			Size = wall.size,
			Position = wall.pos,
			Transparency = 1,
		}, parent)
		barrier.CanCollide = true
		-- A cast aimed past the edge of the world must not stop dead on the wall.
		barrier.CanQuery = false
		barrier.CanTouch = false
	end

	return { Spots = nodes, Dock = dock }
end

function MapBuilder.Build(): MapRefs
	setLighting()
	local map = Instance.new("Folder")
	map.Name = "GeneratedMap"

	-- Five areas along X. Stations exist once, at the home port in area 1: you
	-- sail back to sell, open and upgrade, which is what gives the trip home a
	-- purpose and keeps the whole economy in one place.
	local nodes: { BasePart } = {}
	local origins: { Vector3 } = {}
	local dockPrompts: { ProximityPrompt } = {}
	for index = 1, Balance.MaxLayer do
		local origin = Vector3.new((index - 1) * Balance.AreaSpacing, 0, 0)
		origins[index] = Vector3.new(origin.X, 1.6, -40) -- the dock, where boats land
		local area = buildArea(index, origin, map)
		for _, spot in area.Spots do
			table.insert(nodes, spot)
		end
		dockPrompts[index] = area.Dock
	end

	-- Stations on the home beach
	local crackPrompt = makeStation(Vector3.new(-34, 0.5, 30), "Treasure Chests", "Crack", Color3.fromRGB(255, 170, 40), map, AREA_THEMES[1])
	local rackPrompt = makeStation(Vector3.new(0, 0.5, 40), "Aquarium", "Racks", Color3.fromRGB(120, 255, 200), map, AREA_THEMES[1])
	local shopPrompt = makeStation(Vector3.new(34, 0.5, 30), "Chest Shop", "Shop", Color3.fromRGB(120, 170, 255), map, AREA_THEMES[1])
	local rebirthPrompt = makeStation(Vector3.new(0, 0.5, 78), "Set Sail", "Rebirth", Color3.fromRGB(255, 120, 255), map, AREA_THEMES[1])

	-- Leaderboards
	local boardRebirths = makeBoard(Vector3.new(-70, 7, 70), Vector3.new(0, 7, 20), "Top Voyagers", map)
	local boardRarest = makeBoard(Vector3.new(70, 7, 70), Vector3.new(0, 7, 20), "Rarest Finds", map)

	-- Spawn on the dock, steps from the fishing spots (first cast in seconds)
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Vector3.new(0, 1.6, -40)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Color = Color3.fromRGB(210, 185, 140)
	spawn.Material = Enum.Material.WoodPlanks
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Parent = map

	-- Friendly like prompt beside the dock spawn
	local likeSign = part({
		Name = "LikeSign",
		Size = Vector3.new(10, 4.5, 0.6),
		CFrame = CFrame.lookAt(Vector3.new(12, 4, -28), Vector3.new(0, 3, -40)),
		Color = Color3.fromRGB(90, 65, 45),
		Material = Enum.Material.Wood,
	}, map)
	local likeGui = Instance.new("SurfaceGui")
	likeGui.Face = Enum.NormalId.Front
	likeGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	likeGui.PixelsPerStud = 40
	local likeLabel = Instance.new("TextLabel")
	likeLabel.Size = UDim2.fromScale(1, 1)
	likeLabel.BackgroundTransparency = 1
	likeLabel.Font = Enum.Font.FredokaOne
	likeLabel.Text = "Enjoying the game?\nA 👍 helps small games grow!"
	likeLabel.TextColor3 = Color3.fromRGB(255, 210, 90)
	likeLabel.TextScaled = true
	likeLabel.Parent = likeGui
	likeGui.Parent = likeSign

	map.Parent = Workspace

	return {
		Nodes = nodes,
		Origins = origins,
		CrackPrompt = crackPrompt,
		RackPrompt = rackPrompt,
		ShopPrompt = shopPrompt,
		RebirthPrompt = rebirthPrompt,
		-- Every area has one; the home dock's is the one callers mean.
		DockPrompt = dockPrompts[1],
		BoardRebirths = boardRebirths,
		BoardRarest = boardRarest,
	}
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MiningService</string>
          <string name="Source"><![CDATA[--!strict
-- Fishing loop: click a buoy to cast, wait for the lamp to flash, click again to
-- land it. One angler per buoy at a time; better rods bite sooner and bring up
-- more per catch.
--
-- A bite opens the REEL-IN minigame on the angler's client (see ReelMinigame):
-- a fish darting up a bar, a bracket you steer by holding, a meter that fills
-- while you keep them together. Skill is a BONUS, never a gate — the reel always
-- lands the fish, and how well you tracked it decides how many come up. Clicking
-- too EARLY, before the bite, is the one thing that costs you: it spooks the
-- fish and pushes the bite back.
--
-- What you land is rolled here, and it is the whole shape of the game:
--   * roughly seven times in eight, a FISH — straight into your hold, no
--     opening step. This is the collectible.
--   * otherwise a CHEST — carried back to the Chest station and opened there,
--     with the reveal animation, the odds panel and the policy gating intact.
--     Every chest is a guaranteed Rare+, which is what earns it the ceremony.
--
-- Spots belong to an area. A cast only registers at spots in the water the
-- player is actually fishing, so five areas share one service and one loop.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)

local MiningService = {}

-- Seconds a hooked fish will wait for you before the line is considered
-- abandoned. Generous on purpose: nothing about being slow should cost a catch,
-- but a line nobody is ever coming back for has to free its buoy for the room.
local CLAIM_TIMEOUT = 20
-- A few studs of slack past the cast range, so shuffling on the spot or a bit of
-- position lag never yanks the line out of the water mid-fish.
local CLAIM_SLACK = 8

type SpotState = {
	OwnerUserId: number?,
	BiteAt: number?, -- os.clock() when the bite window opens
	-- os.clock() of the angler's last actual ACTION on this spot, and the only
	-- thing the idle timeout is measured from. It is deliberately not BiteAt,
	-- which the game itself moves — measuring from a deadline the game keeps
	-- pushing forward meant the claim renewed itself and never expired.
	ActedAt: number,
	Biting: boolean, -- the lamp is currently flashing; stops the flash re-firing
	HookedAt: number?, -- os.clock() the fish took the bait; nil until it does
	Resolved: boolean,
	BaseColor: Color3,
	Area: number,
}

local ctx: any = nil
local spots: { [BasePart]: SpotState } = {}
local spotsByArea: { [number]: { BasePart } } = {}
local rng = Random.new()

-- Every spot in one area, for Auto-Cast's "find me somewhere to fish" search.
MiningService.SpotsByArea = spotsByArea

local function playSound(parent: Instance, id: string, pitch: number, volume: number)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.PlaybackSpeed = pitch
	sound.Volume = volume
	sound.Parent = parent
	sound:Play()
	task.delay(2, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- Catch celebration. The label names what actually came up, because "+1 Chest!"
-- when it was a fish is the kind of small lie that makes a whole loop feel fake.
local function catchEffects(spot: BasePart, text: string, color: Color3)
	playSound(spot, "rbxasset://sounds/snap.mp3", 1 + rng:NextNumber(-0.1, 0.2), 0.7)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(160, 220, 255))
	emitter.Lifetime = NumberRange.new(0.35, 0.7)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Enabled = false
	emitter.Parent = spot
	emitter:Emit(18)
	task.delay(1.2, function()
		emitter:Destroy()
	end)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(7, 1.6)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard
	billboard.Parent = spot
	TweenService:Create(billboard, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = Vector3.new(0, 7, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.9), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1, function()
		billboard:Destroy()
	end)
end

-- The angler whose line is in this spot, if they are still here. The spot stores
-- a UserId rather than a Player so a leaver can't keep a claim alive.
local function ownerOf(state: SpotState): Player?
	return if state.OwnerUserId then Players:GetPlayerByUserId(state.OwnerUserId) else nil
end

-- Only the LAMP changes. The buoy is a physical object floating in the sea; it
-- should not swell to twice its size because a fish is interested, which is what
-- the old single-neon-ball marker did for every state change.
-- The lantern is a CYLINDER lying on its side (X is its height), so the flash
-- swells its diameter and leaves its length alone. Scaling all three axes — the
-- old values, from when the lamp was a ball — would squash it into a disc every
-- time a fish bit.
local LAMP_IDLE = Vector3.new(1.1, 1.25, 1.25)
local LAMP_BITE = Vector3.new(1.1, 2.1, 2.1)

local function lampOf(spot: BasePart): (BasePart?, PointLight?)
	local model = spot.Parent
	local lamp = model and model:FindFirstChild("Lamp")
	if lamp and lamp:IsA("BasePart") then
		return lamp, lamp:FindFirstChildOfClass("PointLight")
	end
	return nil, nil
end

local function setIdle(spot: BasePart, state: SpotState)
	local owner = ownerOf(state)
	state.OwnerUserId = nil
	state.BiteAt = nil
	state.Biting = false
	state.HookedAt = nil
	state.Resolved = true
	local lamp, light = lampOf(spot)
	if lamp then
		lamp.Color = state.BaseColor
		lamp.Size = LAMP_IDLE
	end
	if light then
		light.Color = state.BaseColor
		light.Brightness = 1.2
		light.Range = 14
	end
	if owner then
		ctx.RodVis.Reel(owner)
	end
end

local function setCast(spot: BasePart, player: Player?)
	local lamp, light = lampOf(spot)
	-- Dimmed while the line is out: the lamp going quiet is the "waiting" state,
	-- so the flash later has something to be brighter than. The float's own
	-- colour never changes, so it is the reliable source for the lamp's base.
	if lamp then
		lamp.Color = spot.Color:Lerp(Color3.new(0, 0, 0), 0.4)
		lamp.Size = LAMP_IDLE
	end
	if light then
		light.Brightness = 0.5
	end
	if player then
		-- Land the bobber just off the buoy rather than inside it, so both are
		-- visible and the buoy stays the thing you click.
		ctx.RodVis.Cast(player, spot.Position + Vector3.new(0, 0.3, 2.6))
	end
end

local function setBite(spot: BasePart, player: Player?)
	local lamp, light = lampOf(spot)
	if lamp then
		lamp.Color = Color3.fromRGB(255, 255, 255)
		TweenService:Create(lamp, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = LAMP_BITE,
		}):Play()
	end
	if light then
		light.Color = Color3.fromRGB(255, 244, 214)
		light.Brightness = 2
		light.Range = 20
	end
	-- Audible cue so the timing window works by ear as well as by eye
	playSound(spot, "rbxasset://sounds/electronicpingshort.wav", 1.4, 0.8)
	if player then
		ctx.RodVis.Bite(player)
	end
end

local function rodDamage(data: any): number
	local rod = Balance.Pickaxe(data.Pickaxe)
	return rod.Damage
end

local function biteDelay(data: any?): number
	local speedup = if data then Balance.RodBiteFactor(rodDamage(data)) else 1
	return rng:NextNumber(Balance.BiteDelayMin, Balance.BiteDelayMax) * speedup
end

-- How many fish come up on one landing. The whole part of the rod's extra-catch
-- value is guaranteed, the fraction is a roll — so upgrading always moves this
-- number, however slightly, rather than stopping dead at a cap.
local function catchCount(data: any): number
	local extra = Balance.RodExtraCatch(rodDamage(data))
	local guaranteed = math.floor(extra)
	local chance = extra - guaranteed
	local total = 1 + guaranteed
	if rng:NextNumber() < chance then
		total += 1
	end
	return total
end

-- `quality` is how much of the reel was spent with the fish in the bracket, 0..1.
local function landCatch(spot: BasePart, state: SpotState, player: Player, quality: number)
	local data = ctx.Data.Get(player)
	if not data then
		setIdle(spot, state)
		return
	end
	local space = ctx.Data.BackpackCapacity(data) - ctx.Data.HoldCount(data)
	if space <= 0 then
		Remotes.Event("Notify"):FireClient(player, {
			Text = "Boat full! Sell your catch at the Aquarium.",
			Color = Color3.fromRGB(255, 120, 120),
		})
		setIdle(spot, state)
		return
	end

	-- A good reel is worth extra fish. That is the entire reward for skill here —
	-- it buys you MORE, it never decides whether you get anything.
	local bonus = math.floor(quality * Balance.ReelMaxBonus + 0.5)
	local caught = math.min(catchCount(data) + bonus, space)

	local chests = 0
	local fish: { any } = {}
	for _ = 1, caught do
		if rng:NextNumber() < Balance.CrateChance then
			chests += 1
		else
			local result = ctx.Crack.LandFish(player)
			if result then
				table.insert(fish, result)
			end
		end
	end
	if chests > 0 then
		data.Geodes += chests
	end
	data.Stats.GeodesMined += caught
	ctx.Data.MarkDirty(player)
	ctx.Analytics.FunnelStep(player, data, 1, "FirstGeode")

	-- Name the reel, always. Even a scrappy one gets "CAUGHT!", because the
	-- player did in fact catch it and being told so is the point.
	local rating = if quality >= 0.85
		then "PERFECT REEL!"
		elseif quality >= 0.6 then "GREAT REEL!"
		elseif quality >= 0.3 then "NICE REEL!"
		else "CAUGHT!"
	catchEffects(spot, rating, if quality >= 0.6 then Color3.fromRGB(255, 240, 120) else Color3.fromRGB(200, 230, 255))
	if chests > 0 then
		catchEffects(spot, chests > 1 and ("+" .. chests .. " Chests!") or "TREASURE CHEST!", Color3.fromRGB(255, 210, 90))
		Remotes.Event("Notify"):FireClient(player, {
			Text = "A chest! Open it at the Chest station.",
			Color = Color3.fromRGB(255, 210, 90),
		})
	end
	if #fish > 0 then
		local first = fish[1]
		local label = if #fish > 1
			then ("+%d Fish!"):format(#fish)
			else ("%s  %.1f lb"):format(first.Base, first.Weight)
		catchEffects(spot, label, first.Color or Color3.fromRGB(160, 220, 255))
	end
	if caught > 1 then
		-- Late rods land five or six at a time, and calling that a "double hook"
		-- reads as a string nobody updated.
		local shout = if caught == 2 then "DOUBLE HOOK!" elseif caught <= 4 then "BIG HAUL!" else "THE WHOLE SHOAL!"
		Remotes.Event("Notify"):FireClient(player, {
			Text = ("%s  +%d on the line!"):format(shout, caught),
			Color = Color3.fromRGB(120, 255, 200),
		})
	end

	if chests > 0 and ctx.Monetization.OwnsPass(player, "AutoCrack") and data.Settings.AutoCrack ~= false then
		for _ = 1, chests do
			ctx.Crack.AutoCrack(player)
		end
	end
	setIdle(spot, state)
end

local function onSpotClicked(spot: BasePart, player: Player): boolean
	local state = spots[spot]
	local data = ctx.Data.Get(player)
	if not state or not data then
		return false
	end
	-- Your line only reaches the water you have sailed to.
	if state.Area ~= ctx.Data.Layer(data) then
		return false
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - spot.Position).Magnitude > Balance.CastRange then
		return false
	end

	if state.OwnerUserId == nil then
		-- Cast: claim the spot and schedule a bite (better rods bite sooner).
		if ctx.Data.HoldCount(data) >= ctx.Data.BackpackCapacity(data) then
			Remotes.Event("Notify"):FireClient(player, {
				Text = "Boat full! Sell your catch at the Aquarium.",
				Color = Color3.fromRGB(255, 120, 120),
			})
			return false
		end
		state.OwnerUserId = player.UserId
		state.Resolved = false
		state.Biting = false
		state.HookedAt = nil
		state.ActedAt = os.clock()
		state.BiteAt = os.clock() + biteDelay(data)
		setCast(spot, player)
		return true
	elseif state.OwnerUserId == player.UserId then
		local now = os.clock()
		-- Any click on your own line counts as being present, so the idle timeout
		-- only fires on someone who has genuinely stopped fishing.
		state.ActedAt = now
		if state.HookedAt then
			-- Fish is on and the reel-in minigame owns it from here. Clicks are
			-- the minigame's input now, so this must not resolve the catch behind
			-- its back — with Auto-Cast holding the button, that would land every
			-- fish the instant it bit and the bar would never be played.
			return true
		end
		-- Clicking before the bite used to be silently ignored, which is
		-- indistinguishable from a broken game. It spooks the fish instead: the
		-- bite gets pushed back a moment, the line twitches, and the player can
		-- see that their click did something and what it cost.
		if state.BiteAt then
			state.BiteAt += Balance.SpookDelay
			ctx.RodVis.Spook(player)
		end
	end
	-- clicking someone else's claimed spot does nothing
	return false
end

-- True when this spot is free for `player` to claim right now.
function MiningService.IsFree(spot: BasePart, player: Player): boolean
	local state = spots[spot]
	return state ~= nil and (state.OwnerUserId == nil or state.OwnerUserId == player.UserId)
end

-- Does `player` have a fish on this line right now? Auto-Cast uses it to know
-- when to reel, and gets no better information than the flashing lamp already
-- gives a human looking at the same buoy.
function MiningService.IsBiting(spot: BasePart, player: Player): boolean
	local state = spots[spot]
	return state ~= nil and state.OwnerUserId == player.UserId and state.HookedAt ~= nil
end

-- The single entry point for a cast or a strike, human or automated. Auto-Cast
-- drives this so every check, reward and effect is literally the same code.
function MiningService.TryFish(player: Player, spot: BasePart): boolean
	if not ctx or not spots[spot] then
		return false
	end
	return onSpotClicked(spot, player)
end

function MiningService.Init(serviceCtx: any, nodes: { BasePart })
	ctx = serviceCtx
	for _, spot in nodes do
		local area = (spot:GetAttribute("Area") :: number?) or 1
		spots[spot] = {
			OwnerUserId = nil,
			BiteAt = nil,
			ActedAt = 0,
			Biting = false,
			HookedAt = nil,
			Resolved = true,
			BaseColor = spot.Color,
			Area = area,
		}
		local list = spotsByArea[area]
		if not list then
			list = {}
			spotsByArea[area] = list
		end
		table.insert(list, spot)
		local click = spot:FindFirstChildOfClass("ClickDetector")
		if click then
			click.MouseClick:Connect(function(player)
				onSpotClicked(spot, player)
			end)
		end
	end
	-- Primary tap path: the equipped rod Tool swallows clicks before
	-- ClickDetectors see them, so the client raycasts its tap and reports the
	-- spot here. Same server-side validation (membership, area, distance, timing).
	Remotes.Event("MineNode").OnServerEvent:Connect(function(player, spot)
		if typeof(spot) == "Instance" and spots[spot :: any] then
			onSpotClicked(spot :: BasePart, player)
		end
	end)

	-- The reel-in runs on the client, because a bar that stutters is worse than
	-- no bar, and 60fps tracking cannot survive a round trip per frame.
	--
	-- What that means for trust, stated plainly: a modified client can report a
	-- flawless reel it did not play. The server therefore checks everything that
	-- MATTERS here — that this player really has a fish on this spot, that the
	-- spot is in their area and in range (onSpotClicked already established it,
	-- and setIdle revokes it the moment they stray) — and clamps the one thing it
	-- cannot verify to the range it was allowed to be in. The prize for lying is
	-- at most ReelMaxBonus extra common fish on a catch they had already earned,
	-- which is not worth spending server frames to prevent.
	Remotes.Event("ReelResult").OnServerEvent:Connect(function(player, payload)
		if typeof(payload) ~= "table" then
			return
		end
		local spot = payload.Node
		if typeof(spot) ~= "Instance" then
			return
		end
		local state = spots[spot :: any]
		if not state or state.OwnerUserId ~= player.UserId or not state.HookedAt then
			return -- no fish of theirs on this line; nothing to land
		end
		local quality = math.clamp(tonumber(payload.Quality) or 0, 0, 1)
		state.ActedAt = os.clock()
		landCatch(spot :: BasePart, state, player, quality)
	end)

	-- One loop drives bite flashes, missed-window recasts, and claim expiry.
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		local now = os.clock()
		for spot, state in spots do
			if state.OwnerUserId and state.BiteAt then
				local owner = Players:GetPlayerByUserId(state.OwnerUserId)
				-- Walk away and your line comes with you. Without this a cast held
				-- its buoy from anywhere on the map — including from another area —
				-- and kept auto-recasting at water the angler had long since left.
				local data = owner and ctx.Data.Get(owner)
				local character = owner and owner.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				-- Once a fish is ON, the range check stops applying. The player is
				-- looking at the reel bar, not at their feet, and releasing the
				-- spot underneath them would throw away a fight they are actively
				-- playing and never tell them why. Backing up while you fight
				-- something is also just what fishing looks like. The idle timeout
				-- still bounds it, and the reel itself times out sooner.
				local strayed = state.HookedAt == nil
					and (
						not root
						or (root.Position - spot.Position).Magnitude > Balance.CastRange + CLAIM_SLACK
						or (data ~= nil and state.Area ~= ctx.Data.Layer(data))
					)

				if not owner or strayed then
					setIdle(spot, state)
				elseif now - state.ActedAt > CLAIM_TIMEOUT then
					-- Still standing there, but has not touched it in a while.
					setIdle(spot, state)
				elseif now >= state.BiteAt and not state.Biting then
					-- The fish takes the bait, once, and then STAYS on until the
					-- player reels it in. There is no escape branch any more:
					-- losing a catch to a tenth of a second is the single most
					-- punishing thing this loop could do to an eight-year-old,
					-- and it bought nothing that the perfect-strike bonus does
					-- not buy better.
					--
					-- A flag, not a colour comparison: the buoy's own colour no
					-- longer changes on a bite (its lamp does), so the old
					-- "is it white yet" check would have re-fired the flash and
					-- its ping ten times a second.
					state.Biting = true
					state.HookedAt = now
					setBite(spot, owner)
					Remotes.Event("ReelStart"):FireClient(owner, { Node = spot, Area = state.Area })
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for spot, state in spots do
			if state.OwnerUserId == player.UserId then
				setIdle(spot, state)
			end
		end
	end)
end

return MiningService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--!strict
-- Gamepass ownership (cached + persisted) and idempotent dev-product receipts.
-- Product/pass IDs live in src/shared/Config/Monetization.luau — an ID of 0
-- means "not created yet" and that offer simply stays hidden.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Monetization = require(Shared.Config.Monetization)
local Remotes = require(Shared.Remotes)

local MonetizationService = {}

local ctx: any = nil
local passCache: { [Player]: { [string]: boolean } } = {}

function MonetizationService.OwnsPass(player: Player, key: string): boolean
	-- Friends-and-family comp: `true` comps every pass, a table comps only the
	-- listed keys. Checked before the Id gate so comps work even for passes not
	-- yet created on the platform. Nothing is persisted, so removing a UserId
	-- from the list takes the perks away again on the next server.
	local comp = Monetization.CompUserIds[player.UserId]
	if comp == true or (typeof(comp) == "table" and (comp :: { [string]: boolean })[key] == true) then
		return true
	end
	local id = Monetization.PassIdByKey(key)
	if id == 0 then
		return false
	end
	local cached = passCache[player]
	if cached and cached[key] ~= nil then
		return cached[key]
	end
	local data = ctx.Data.Get(player)
	if data and data.OwnedPasses[key] then
		return true
	end
	return false
end

function MonetizationService.PreloadPasses(player: Player, data: any)
	local cached: { [string]: boolean } = {}
	passCache[player] = cached
	for key, def in Monetization.Gamepasses :: any do
		if def.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.Id)
			end)
			if ok then
				cached[key] = owns == true
				if owns then
					data.OwnedPasses[key] = true
				end
			end
		end
	end
	ctx.Data.MarkDirty(player)
end

local PRODUCT_GRANTS: { [string]: (Player, any) -> () } = {
	StarterPack = function(player, data)
		data.StarterPackOwned = true
		data.Coins += Balance.StarterPackCoins
		data.TotalCoinsEarned += Balance.StarterPackCoins
		data.Boosts.Coins2xUntil = math.max(data.Boosts.Coins2xUntil, os.time()) + Balance.StarterPackBoostSeconds
		-- Must be a species that actually swims in area 1, where every new player
		-- starts: granting a fish from deeper water hands them a name the Index
		-- cannot look up and a fish they cannot catch again. Rare tier, so the
		-- pack still opens with something worth having.
		ctx.Crack.GrantFixedCrystal(player, "Red Snapper", 1.2)
		Remotes.Event("Notify"):FireClient(player, { Text = "Starter Pack! +2,500 coins, a Red Snapper, and 24h of 2x coins!", Color = Color3.fromRGB(255, 210, 90) })
	end,
	Coins1k = function(player, data)
		local def = Monetization.Products.Coins1k
		data.Coins += def.Coins :: number
		data.TotalCoinsEarned += def.Coins :: number
		Remotes.Event("Notify"):FireClient(player, { Text = "+" .. tostring(def.Coins) .. " coins!", Color = Color3.fromRGB(255, 210, 90) })
	end,
	Coins5k = function(player, data)
		local def = Monetization.Products.Coins5k
		data.Coins += def.Coins :: number
		data.TotalCoinsEarned += def.Coins :: number
		Remotes.Event("Notify"):FireClient(player, { Text = "+" .. tostring(def.Coins) .. " coins!", Color = Color3.fromRGB(255, 210, 90) })
	end,
	Coins12k = function(player, data)
		local def = Monetization.Products.Coins12k
		data.Coins += def.Coins :: number
		data.TotalCoinsEarned += def.Coins :: number
		Remotes.Event("Notify"):FireClient(player, { Text = "+" .. tostring(def.Coins) .. " coins!", Color = Color3.fromRGB(255, 210, 90) })
	end,
	TimeWarp = function(player, _data)
		ctx.Racks.ApplyTimeWarp(player)
	end,
	InstantRestock = function(player, _data)
		ctx.Shop.PersonalRestock(player)
	end,
	InstantRebirth = function(player, _data)
		local ok, err = ctx.Rebirth.Perform(player, true)
		if not ok and err then
			Remotes.Event("Notify"):FireClient(player, { Text = err, Color = Color3.fromRGB(255, 120, 120) })
		end
	end,
}

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = ctx.Data.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Idempotency: never double-grant a PurchaseId we already processed.
	local purchaseId = tostring(receipt.PurchaseId)
	for _, processed in data.Purchases do
		if processed == purchaseId then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	local key = Monetization.ProductKeyById(receipt.ProductId)
	local grant = key and PRODUCT_GRANTS[key]
	if not grant then
		warn("[Monetization] Receipt for unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if key == "StarterPack" and data.StarterPackOwned then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- one-time offer, never re-grant
	end

	local ok, err = (pcall :: any)(grant, player, data)
	if not ok then
		warn("[Monetization] Grant failed for " .. tostring(key) .. ": " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(data.Purchases, purchaseId)
	while #data.Purchases > 100 do
		table.remove(data.Purchases, 1)
	end
	ctx.Data.MarkDirty(player)
	ctx.Analytics.LogCustom(player, "ProductPurchased_" .. tostring(key))
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init(serviceCtx: any)
	ctx = serviceCtx
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, def in Monetization.Gamepasses :: any do
			if def.Id == passId then
				local cached = passCache[player]
				if cached then
					cached[key] = true
				end
				local data = ctx.Data.Get(player)
				if data then
					data.OwnedPasses[key] = true
					ctx.Data.MarkDirty(player)
				end
				Remotes.Event("Notify"):FireClient(player, { Text = def.Title .. " unlocked!", Color = Color3.fromRGB(120, 255, 200) })
				ctx.Analytics.LogCustom(player, "PassPurchased_" .. key)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		passCache[player] = nil
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Packages</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">PolicyGuard</string>
          <string name="Source"><![CDATA[--!strict
-- PolicyService gating for paid-random-item surfaces (May 2026 rules).
-- Fails CLOSED: if policy can't be fetched, the player is treated as restricted.

local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")

local PolicyGuard = {}

local cache: { [Player]: { ArePaidRandomItemsRestricted: boolean } } = {}

local function fetch(player: Player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if ok and typeof(info) == "table" then
		cache[player] = {
			ArePaidRandomItemsRestricted = info.ArePaidRandomItemsRestricted == true,
		}
	else
		cache[player] = { ArePaidRandomItemsRestricted = true }
	end
end

function PolicyGuard.ArePaidRandomItemsRestricted(player: Player): boolean
	local entry = cache[player]
	if not entry then
		fetch(player)
		entry = cache[player]
	end
	return entry.ArePaidRandomItemsRestricted
end

function PolicyGuard.Init(_serviceCtx: any)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(fetch, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(fetch, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
	end)
end

return PolicyGuard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">RackService</string>
          <string name="Source"><![CDATA[--!strict
-- Growth racks: socketed crystals produce coins and grow in size over time,
-- INCLUDING while offline (accrual = time since LastTick, capped). This is the
-- daily-return hook: the cap makes checking in daily strictly better than AFK.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)

local RackService = {}

local ctx: any = nil

local function offlineCap(player: Player): number
	if ctx.Monetization.OwnsPass(player, "OvernightMiner") then
		return Balance.OfflineCapSecondsVip
	end
	return Balance.OfflineCapSeconds
end

local function accrualSeconds(player: Player, rack: { CrystalId: string, LastTick: number }): number
	return math.min(os.time() - rack.LastTick, offlineCap(player))
end

function RackService.PendingCoins(player: Player, data: any, rack: { CrystalId: string, LastTick: number }): number
	local crystal = data.Crystals[rack.CrystalId]
	if not crystal then
		return 0
	end
	local elapsed = accrualSeconds(player, rack)
	local rate = ctx.Data.CrystalValue(data, crystal) * Balance.RackCoinsPerValuePerSecond
	if elapsed > 1800 and ctx.Monetization.OwnsPass(player, "OvernightMiner") then
		rate *= Balance.OfflineRateVip
	end
	return math.floor(rate * elapsed)
end

local function settleRack(player: Player, data: any, rack: { CrystalId: string, LastTick: number }): number
	local crystal = data.Crystals[rack.CrystalId]
	if not crystal then
		return 0
	end
	local coins = RackService.PendingCoins(player, data, rack)
	local elapsed = accrualSeconds(player, rack)
	crystal.Size = math.min(crystal.Size + Balance.RackGrowthPerSecond * elapsed, Balance.MaxCrystalSize)
	rack.LastTick = os.time()
	return coins
end

function RackService.Socket(player: Player, crystalId: string): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	if not data.Crystals[crystalId] then
		return false, "Fish not found."
	end
	for _, rack in data.Racks do
		if rack.CrystalId == crystalId then
			return false, "Already socketed."
		end
	end
	for slot = 1, data.RackSlots do
		local key = tostring(slot)
		if not data.Racks[key] then
			data.Racks[key] = { CrystalId = crystalId, LastTick = os.time() }
			ctx.Data.MarkDirty(player)
			ctx.Analytics.FunnelStep(player, data, 4, "FirstSocket")
			return true, nil
		end
	end
	return false, "All rack slots are full."
end

function RackService.Unsocket(player: Player, slotIndex: number): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	local key = tostring(slotIndex)
	local rack = data.Racks[key]
	if not rack then
		return false, "Empty slot."
	end
	local coins = settleRack(player, data, rack)
	if coins > 0 then
		ctx.Data.AddCoins(player, coins, true)
	end
	data.Racks[key] = nil
	ctx.Data.MarkDirty(player)
	return true, nil
end

function RackService.CollectAll(player: Player): number
	local data = ctx.Data.Get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, rack in data.Racks do
		total += settleRack(player, data, rack)
	end
	if total > 0 then
		ctx.Data.AddCoins(player, total, true)
	end
	ctx.Data.MarkDirty(player)
	return total
end

-- Time Warp dev product: grant 8 hours of production+growth instantly.
function RackService.ApplyTimeWarp(player: Player)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	local total = 0
	for _, rack in data.Racks do
		local crystal = data.Crystals[rack.CrystalId]
		if crystal then
			local rate = ctx.Data.CrystalValue(data, crystal) * Balance.RackCoinsPerValuePerSecond
			total += math.floor(rate * Balance.TimeWarpSeconds)
			crystal.Size = math.min(crystal.Size + Balance.RackGrowthPerSecond * Balance.TimeWarpSeconds, Balance.MaxCrystalSize)
		end
	end
	if total > 0 then
		ctx.Data.AddCoins(player, total, true)
		Remotes.Event("Notify"):FireClient(player, { Text = "Time Warp! +" .. total .. " coins of growth.", Color = Color3.fromRGB(120, 255, 200) })
	else
		Remotes.Event("Notify"):FireClient(player, { Text = "Time Warp had nothing to grow — display a fish first!", Color = Color3.fromRGB(255, 200, 90) })
	end
	ctx.Data.MarkDirty(player)
end

-- Called on join: summarize what accrued while away (the welcome-back moment).
function RackService.OfflineSummary(player: Player, data: any): { OfflineSeconds: number, PendingCoins: number }
	local pending = 0
	for _, rack in data.Racks do
		pending += RackService.PendingCoins(player, data, rack)
	end
	local away = 0
	if data.LastSeen > 0 then
		away = math.min(os.time() - data.LastSeen, offlineCap(player))
	end
	return { OfflineSeconds = away, PendingCoins = pending }
end

function RackService.Init(serviceCtx: any)
	ctx = serviceCtx
	Remotes.Function("SocketCrystal").OnServerInvoke = function(player, crystalId)
		if typeof(crystalId) ~= "string" then
			return false, "Bad request."
		end
		return RackService.Socket(player, crystalId)
	end
	Remotes.Function("UnsocketCrystal").OnServerInvoke = function(player, slotIndex)
		local index = tonumber(slotIndex)
		if not index then
			return false, "Bad request."
		end
		return RackService.Unsocket(player, index)
	end
	Remotes.Function("CollectRacks").OnServerInvoke = function(player)
		return RackService.CollectAll(player)
	end
end

return RackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[--!strict
-- Set Sail: pay coins, reset run progress, gain a permanent +25% coin
-- multiplier. The infinite ladder is the long-term retention loop — months of
-- goals, zero new content.
--
-- It does NOT touch areas. Areas are content you bought with coins; rebirth is
-- the multiplier engine. Taking water back at the prestige step would make every
-- area purchase a rental, and nobody saves three million coins for a rental.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)
local Spotlight = require(script.Parent.Spotlight)

local REBIRTH_COLOR = Color3.fromRGB(255, 120, 255)

local RebirthService = {}

local ctx: any = nil

function RebirthService.Perform(player: Player, free: boolean): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	local cost = ctx.Data.RebirthCost(data)
	if not free then
		if data.Coins < cost then
			return false, "Need " .. cost .. " coins to Set Sail."
		end
		data.Coins -= cost
	end

	-- Clear the aquarium; the fish themselves stay in inventory (never lost).
	-- `AreaUnlocked` and `AreaCurrent` are deliberately absent from this reset.
	for slot in data.Racks do
		data.Racks[slot] = nil
	end
	data.Coins = if free then data.Coins else 0
	data.Geodes = 0
	data.Pickaxe = 1
	data.Backpack = 1
	data.RackSlots = Balance.BaseRackSlots
	data.Rebirths += 1

	ctx.Data.MarkDirty(player)
	ctx.Analytics.FunnelStep(player, data, 5, "FirstRebirth")
	local layerName = Balance.LayerNames[ctx.Data.Layer(data)]
	local bonus = math.floor(Balance.RebirthCoinBonus * data.Rebirths * 100 + 0.5)

	-- The prestige ritual. Giving up everything you built deserves more than a
	-- toast: the screen goes, the world flashes, and the room is told.
	Remotes.Event("RebirthFx"):FireClient(player, {
		Rebirths = data.Rebirths,
		LayerName = layerName,
		Bonus = bonus,
	})
	Spotlight.Pillar(player, REBIRTH_COLOR)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			Remotes.Event("Notify"):FireClient(other, {
				Text = ("%s just Set Sail! (voyage #%d, +%d%% coins)"):format(player.DisplayName, data.Rebirths, bonus),
				Color = REBIRTH_COLOR,
			})
		end
	end
	return true, nil
end

function RebirthService.Init(serviceCtx: any)
	ctx = serviceCtx
	Remotes.Function("Rebirth").OnServerInvoke = function(player)
		return RebirthService.Perform(player, false)
	end
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">RodVisual</string>
          <string name="Source"><![CDATA[--!strict
-- The held fishing rod: a real Tool (Roblox handles grip + hold pose), tilted
-- forward like a rod at rest. The grip wrap and glowing tip upgrade per rod
-- tier so every upgrade is visible in your hands. Pure cosmetics — casting
-- input goes through the raycast tap path.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)

local RodVisual = {}

local ctx: any = nil

local TOOL_TAG = "HeldRodTool"

local function toolPart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Parent = parent
	return p
end

local function joint(part0: BasePart, part1: BasePart, offset: CFrame)
	local motor = Instance.new("Motor6D")
	motor.Name = part1.Name .. "Joint"
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = offset
	motor.Parent = part0
end

-- A rod, not a stick. Cork grip, a reel with a spool you can see, line guides up
-- a blank that visibly tapers, and a line hanging off the tip to a bobber. The
-- guides and the taper are what read as "fishing rod" at a glance; the hanging
-- line is what makes it feel alive while you walk around with it.
local function buildTool(tier: { [string]: any }): Tool
	local tool = Instance.new("Tool")
	tool.Name = tier.Name
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	-- Tip the rod forward like a rod at the ready
	tool.Grip = CFrame.Angles(math.rad(-35), 0, 0)
	tool:SetAttribute(TOOL_TAG, true)

	local accentColor = tier.Color or Color3.fromRGB(190, 190, 200)
	local accentMaterial = tier.Material or Enum.Material.Metal
	local CORK = Color3.fromRGB(196, 160, 108)
	local BLANK = Color3.fromRGB(58, 48, 44)

	-- The Handle IS the grip, so Roblox puts the cork in the hand and everything
	-- else hangs off it in the right place.
	local handle = toolPart("Handle", Vector3.new(0.34, 1.5, 0.34), CORK, Enum.Material.Wood, tool)

	-- Reel seat + spool, just above the grip on the right, where a reel goes.
	local seat = toolPart("ReelSeat", Vector3.new(0.3, 0.5, 0.3), accentColor, accentMaterial, tool)
	joint(handle, seat, CFrame.new(0, 0.95, 0))
	local spool = toolPart("Spool", Vector3.new(0.7, 0.7, 0.34), accentColor, accentMaterial, tool)
	spool.Shape = Enum.PartType.Cylinder
	joint(handle, spool, CFrame.new(0.3, 0.9, 0) * CFrame.Angles(0, 0, math.rad(90)))
	local knob = toolPart("ReelKnob", Vector3.new(0.14, 0.14, 0.3), Color3.fromRGB(40, 36, 34), Enum.Material.SmoothPlastic, tool)
	joint(handle, knob, CFrame.new(0.52, 1.08, 0))

	-- Blank: three sections that get thinner as they rise. A rod that tapers
	-- reads as a rod; a uniform pole reads as a broom.
	local sections = {
		{ length = 1.9, thick = 0.2, at = 1.75 },
		{ length = 1.9, thick = 0.145, at = 3.6 },
		{ length = 1.7, thick = 0.095, at = 5.35 },
	}
	for i, section in sections do
		local part = toolPart(
			"Blank" .. i,
			Vector3.new(section.thick, section.length, section.thick),
			BLANK:Lerp(accentColor, i * 0.16),
			Enum.Material.SmoothPlastic,
			tool
		)
		joint(handle, part, CFrame.new(0, section.at, 0))
		-- A guide ring near the top of each section, which is where they go.
		local guide = toolPart(
			"Guide" .. i,
			Vector3.new(0.07, 0.3, 0.3),
			accentColor,
			accentMaterial,
			tool
		)
		guide.Shape = Enum.PartType.Cylinder
		joint(handle, guide, CFrame.new(0, section.at + section.length * 0.42, 0.1) * CFrame.Angles(0, math.rad(90), 0))
	end

	local tip = toolPart("Tip", Vector3.new(0.16, 0.16, 0.16), accentColor, Enum.Material.Neon, tool)
	joint(handle, tip, CFrame.new(0, 6.25, 0))

	-- The line: a Beam, not a thin part. Beams sag between their attachments, so
	-- the line hangs the way a line hangs instead of standing out rigid — and it
	-- costs one instance rather than a chain of segments.
	local bobber = toolPart("Bobber", Vector3.new(0.34, 0.34, 0.34), Color3.fromRGB(230, 60, 60), Enum.Material.SmoothPlastic, tool)
	bobber.Shape = Enum.PartType.Ball
	joint(handle, bobber, CFrame.new(0, 4.5, 0.85))
	local bobberBase = toolPart("BobberBase", Vector3.new(0.3, 0.16, 0.3), Color3.fromRGB(248, 248, 250), Enum.Material.SmoothPlastic, tool)
	bobberBase.Shape = Enum.PartType.Ball
	joint(handle, bobberBase, CFrame.new(0, 4.36, 0.85))

	local fromTip = Instance.new("Attachment")
	fromTip.Parent = tip
	local toBobber = Instance.new("Attachment")
	toBobber.Parent = bobber

	local line = Instance.new("Beam")
	line.Name = "Line"
	line.Attachment0 = fromTip
	line.Attachment1 = toBobber
	line.Width0 = 0.035
	line.Width1 = 0.035
	line.FaceCamera = true
	line.Transparency = NumberSequence.new(0.15)
	line.LightInfluence = 1
	line.Color = ColorSequence.new(if tier.Glow then accentColor else Color3.fromRGB(238, 240, 245))
	-- Sag: pull the curve control points down so the slack hangs below the
	-- straight line between tip and bobber.
	line.CurveSize0 = -0.8
	line.CurveSize1 = -0.8
	line.Parent = tip

	if tier.Glow then
		local light = Instance.new("PointLight")
		light.Color = accentColor
		light.Range = 8
		light.Brightness = 1.2
		light.Parent = tip
	end

	return tool
end

--------------------------------------------------------------------------------
-- Casting
--
-- The cast is PURELY cosmetic: the rod swings, a bobber arcs out and lands on
-- the water, and it dips when a fish takes it. The input is still one click,
-- deliberately. A power meter or a hold-and-release swing would be a second
-- skill test stacked on top of the bite-timing one, and for the audience this
-- game is for that trades a lot of players for a little depth. What the animation
-- buys is the FEELING of casting; the click is what makes it playable.
--------------------------------------------------------------------------------

-- Where the bobber's white underside sits relative to its red ball.
local STRIPE_OFFSET = Vector3.new(0, -0.32, 0)

-- Move the bobber and its underside together. Everything that moves a bobber
-- goes through here, so the two halves can never come apart.
local function glideBobber(bobber: BasePart, to: Vector3, seconds: number, style: Enum.EasingStyle, dir: Enum.EasingDirection)
	local info = TweenInfo.new(seconds, style, dir)
	TweenService:Create(bobber, info, { Position = to }):Play()
	local stripe = bobber:FindFirstChild("BobberBase")
	if stripe and stripe:IsA("BasePart") then
		TweenService:Create(stripe, info, { Position = to + STRIPE_OFFSET }):Play()
	end
end

local REST_GRIP = CFrame.Angles(math.rad(-35), 0, 0)
local WIND_UP_GRIP = CFrame.Angles(math.rad(-105), 0, 0)
local RELEASE_GRIP = CFrame.Angles(math.rad(22), 0, 0)

-- One bobber per player at most, so a re-cast or a respawn can always find and
-- clean up the last one.
local castBobbers: { [Player]: BasePart } = {}
-- Bumped on every cast; a swing whose token is stale has been superseded and
-- must stop animating rather than fight the newer one for the same Grip.
local castToken: { [Player]: number } = {}

local function equippedTool(player: Player): Tool?
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	if tool and tool:GetAttribute(TOOL_TAG) then
		return tool
	end
	return nil
end

local function dangle(tool: Tool, visible: boolean)
	for _, name in { "Bobber", "BobberBase" } do
		local part = tool:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Transparency = if visible then 0 else 1
		end
	end
	local tip = tool:FindFirstChild("Tip")
	local line = tip and tip:FindFirstChildOfClass("Beam")
	if line then
		line.Enabled = visible
	end
end

-- Tween, don't step. The first version lerped Tool.Grip by hand at 30 steps a
-- second, and every one of those steps was a property change replicated to every
-- client — about forty-five packets per swing, arriving unevenly. That is what
-- made casting feel clunky: not the timing, the delivery. A tween replicates
-- ONCE and each client interpolates it locally at its own frame rate.
--
-- Tool.Grip is not documented as tweenable, so the tween is guarded and falls
-- back to setting the three poses directly. Three snaps read as a swing; forty
-- five stutters do not.
local function glide(tool: Tool, to: CFrame, seconds: number, style: Enum.EasingStyle)
	local ok = pcall(function()
		TweenService:Create(tool, TweenInfo.new(seconds, style, Enum.EasingDirection.Out), { Grip = to }):Play()
	end)
	if not ok then
		tool.Grip = to
	end
end

local function swing(player: Player, tool: Tool, token: number)
	-- Back over the shoulder, whip forward, settle. The whip is deliberately the
	-- shortest of the three: that snap is the whole read.
	glide(tool, WIND_UP_GRIP, 0.12, Enum.EasingStyle.Quad)
	task.wait(0.12)
	if castToken[player] ~= token or not tool:IsDescendantOf(game) then
		return
	end
	glide(tool, RELEASE_GRIP, 0.08, Enum.EasingStyle.Quint)
	task.wait(0.08)
	if castToken[player] ~= token or not tool:IsDescendantOf(game) then
		return
	end
	glide(tool, REST_GRIP, 0.26, Enum.EasingStyle.Quad)
end

local function clearBobber(player: Player)
	local existing = castBobbers[player]
	if existing then
		existing:Destroy()
		castBobbers[player] = nil
	end
end

-- Swing the rod and land a bobber on the water at `target`.
function RodVisual.Cast(player: Player, target: Vector3)
	local tool = equippedTool(player)
	if not tool then
		return
	end
	clearBobber(player)
	local token = (castToken[player] or 0) + 1
	castToken[player] = token

	local tip = tool:FindFirstChild("Tip")
	if not tip or not tip:IsA("BasePart") then
		return
	end
	dangle(tool, false)
	task.spawn(swing, player, tool, token)

	local bobber = Instance.new("Part")
	bobber.Name = "CastBobber"
	bobber.Shape = Enum.PartType.Ball
	bobber.Size = Vector3.new(1.1, 1.1, 1.1)
	bobber.Color = Color3.fromRGB(230, 60, 60)
	bobber.Material = Enum.Material.SmoothPlastic
	bobber.Anchored = true
	bobber.CanCollide = false
	bobber.CanQuery = false -- a bobber must never swallow the click meant for the buoy
	bobber.CanTouch = false
	bobber.Position = tip.Position
	bobber.Parent = Workspace

	-- The white underside of a classic bobber. Anchored and moved alongside the
	-- ball rather than welded to it: a weld needs one side unanchored, and an
	-- unanchored part in open water picks up a network owner and jitters. Two
	-- tweens per leg of the arc is a rounding error next to that.
	local stripe = Instance.new("Part")
	stripe.Name = "BobberBase"
	stripe.Shape = Enum.PartType.Ball
	stripe.Size = Vector3.new(1, 0.5, 1)
	stripe.Color = Color3.fromRGB(248, 248, 250)
	stripe.Material = Enum.Material.SmoothPlastic
	stripe.Anchored = true
	stripe.CanCollide = false
	stripe.CanQuery = false
	stripe.CanTouch = false
	stripe.Position = bobber.Position + STRIPE_OFFSET
	stripe.Parent = bobber

	-- Line from the rod tip out to the bobber, sagging in the middle.
	local atBobber = Instance.new("Attachment")
	atBobber.Parent = bobber
	local atTip = tip:FindFirstChildOfClass("Attachment")
	if atTip then
		local line = Instance.new("Beam")
		line.Name = "CastLine"
		line.Attachment0 = atTip
		line.Attachment1 = atBobber
		line.Width0 = 0.04
		line.Width1 = 0.04
		line.FaceCamera = true
		line.LightInfluence = 1
		line.Transparency = NumberSequence.new(0.15)
		line.Color = ColorSequence.new(Color3.fromRGB(238, 240, 245))
		line.CurveSize0 = -3
		line.CurveSize1 = -3
		line.Parent = bobber
	end

	castBobbers[player] = bobber

	-- Arc it out: the bobber leaves on the whip, so the swing looks like it threw
	-- the thing rather than the other way round.
	--
	-- Two tweens, not fourteen stepped positions. Up-and-over to the apex, then
	-- down to the water — a rise eased Out and a fall eased In is a parabola as
	-- far as the eye is concerned, and it costs two replicated tweens instead of
	-- fourteen replicated positions arriving whenever the network feels like it.
	task.spawn(function()
		task.wait(0.16)
		if castToken[player] ~= token or not bobber:IsDescendantOf(game) then
			return
		end
		local start = tip.Position
		local peak = math.min((target - start).Magnitude * 0.24, 16)
		local apex = start:Lerp(target, 0.5) + Vector3.new(0, peak, 0)
		glideBobber(bobber, apex, 0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.wait(0.17)
		if castToken[player] ~= token or not bobber:IsDescendantOf(game) then
			return
		end
		glideBobber(bobber, target + Vector3.new(0, 0.2, 0), 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.16)
		if castToken[player] ~= token or not bobber:IsDescendantOf(game) then
			return
		end
		local splash = Instance.new("ParticleEmitter")
		splash.Color = ColorSequence.new(Color3.fromRGB(200, 240, 255))
		splash.Size = NumberSequence.new(0.5, 0)
		splash.Transparency = NumberSequence.new(0.2, 1)
		splash.Lifetime = NumberRange.new(0.3, 0.6)
		splash.Speed = NumberRange.new(5, 11)
		splash.SpreadAngle = Vector2.new(70, 70)
		splash.Acceleration = Vector3.new(0, -30, 0)
		splash.Rate = 0
		splash.Parent = bobber
		splash:Emit(14)
		-- Bob on the SERVER, with a looping tween.
		--
		-- This used to hand the bobber to the client's SpinCrystal driver, which
		-- captures GetPivot() the instant the tag arrives and then pins the part
		-- there forever. The tag was added the moment the landing tween finished
		-- on the server — before that final position had replicated — so clients
		-- captured the arc's APEX and held the bobber up in the sky, line trailing
		-- off the rod into nothing, for the rest of the cast.
		--
		-- A looping tween replicates once and plays out locally, which is the same
		-- cheapness the tag was for without a position race to lose.
		local rest = bobber.Position
		local bobInfo = TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		TweenService:Create(bobber, bobInfo, { Position = rest + Vector3.new(0, 0.35, 0) }):Play()
		local stripe = bobber:FindFirstChild("BobberBase")
		if stripe and stripe:IsA("BasePart") then
			TweenService:Create(stripe, bobInfo, { Position = rest + STRIPE_OFFSET + Vector3.new(0, 0.35, 0) }):Play()
		end
	end)
end

-- A fish has it: yank the bobber under and throw a splash.
function RodVisual.Bite(player: Player)
	local bobber = castBobbers[player]
	if not bobber then
		return
	end
	local splash = Instance.new("ParticleEmitter")
	splash.Color = ColorSequence.new(Color3.fromRGB(220, 250, 255))
	splash.Size = NumberSequence.new(0.7, 0)
	splash.Transparency = NumberSequence.new(0.1, 1)
	splash.Lifetime = NumberRange.new(0.35, 0.7)
	splash.Speed = NumberRange.new(8, 16)
	splash.SpreadAngle = Vector2.new(80, 80)
	splash.Acceleration = Vector3.new(0, -35, 0)
	splash.Rate = 0
	splash.Parent = bobber
	splash:Emit(22)
	glideBobber(bobber, bobber.Position - Vector3.new(0, 1.3, 0), 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
end

-- Clicked before the bite. A click that does nothing at all is indistinguishable
-- from a broken game, so the fish being spooked has to be something you can SEE:
-- the bobber twitches and rings the water.
function RodVisual.Spook(player: Player)
	local bobber = castBobbers[player]
	if not bobber then
		return
	end
	local ripple = Instance.new("ParticleEmitter")
	ripple.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	ripple.Size = NumberSequence.new(0.3, 0)
	ripple.Transparency = NumberSequence.new(0.5, 1)
	ripple.Lifetime = NumberRange.new(0.25, 0.45)
	ripple.Speed = NumberRange.new(3, 6)
	ripple.SpreadAngle = Vector2.new(85, 85)
	ripple.Rate = 0
	ripple.Parent = bobber
	ripple:Emit(6)
	task.delay(1, function()
		ripple:Destroy()
	end)
	local from = bobber.Position
	glideBobber(bobber, from + Vector3.new(0, 0.5, 0), 0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	task.delay(0.09, function()
		if bobber.Parent then
			glideBobber(bobber, from, 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
end

-- Line's in: take the bobber back and give the rod its dangle again.
function RodVisual.Reel(player: Player)
	castToken[player] = (castToken[player] or 0) + 1
	clearBobber(player)
	local tool = equippedTool(player)
	if tool then
		tool.Grip = REST_GRIP
		dangle(tool, true)
	end
end

local function clearOldTools(player: Player)
	local function sweep(container: Instance?)
		if not container then
			return
		end
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute(TOOL_TAG) then
				child:Destroy()
			end
		end
	end
	sweep(player.Character)
	sweep(player:FindFirstChild("Backpack"))
end

function RodVisual.Refresh(player: Player)
	local data = ctx.Data.Get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not character or not humanoid or humanoid.Health <= 0 then
		return
	end
	-- A new rod means any cast in flight belongs to a tool that no longer exists.
	RodVisual.Reel(player)
	clearOldTools(player)
	local tier = Balance.Pickaxe(data.Pickaxe)
	local tool = buildTool(tier)
	tool.Parent = player:FindFirstChild("Backpack") or player
	humanoid:EquipTool(tool)
end

local function onCharacterAdded(player: Player, character: Model)
	for _ = 1, 10 do
		if ctx.Data.Get(player) and character:FindFirstChildOfClass("Humanoid") then
			break
		end
		task.wait(0.5)
	end
	if player.Character == character then
		RodVisual.Refresh(player)
	end
	task.delay(1.5, function()
		if player.Character == character and not (character:FindFirstChildOfClass("Tool") or (player:FindFirstChild("Backpack") and (player.Backpack :: any):FindFirstChildOfClass("Tool"))) then
			RodVisual.Refresh(player)
		end
	end)
end

function RodVisual.Init(serviceCtx: any)
	ctx = serviceCtx
	Players.PlayerRemoving:Connect(function(player)
		clearBobber(player)
		castToken[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(onCharacterAdded, player, character)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function(character)
			task.spawn(onCharacterAdded, player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end
end

return RodVisual
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict
-- Clock-synced shop: stock derives from floor(os.time()/300), so every server
-- shows the same stock and it "restocks" every 5 minutes forever, no live-ops.
-- Compliance: chest offers are random-content items purchasable with a
-- Robux-purchasable currency, so their exact odds ship with the stock payload,
-- and players whose policy restricts paid random items only ever see the
-- deterministic fish offers (PolicyService gating).
--
-- Those odds MUST come from the RELIC pool. A chest contains a relic; quoting
-- the fish table beside it would be a published probability the game does not
-- honour, which is the one thing this file exists to make impossible.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Crystals = require(Shared.Config.Crystals)
local RarityMath = require(Shared.RarityMath)
local Remotes = require(Shared.Remotes)

local ShopService = {}

local ctx: any = nil

local BUY_LIMIT_PER_WINDOW = 3

export type ShopItem = {
	Kind: string, -- "Geode" | "GeodeBundle" | "PremiumGeode" | "Crystal"
	Title: string,
	Cost: number,
	Count: number?,
	Luck: number?,
	Base: string?,
	Mut: string?,
	Value: number?,
	Odds: { RarityMath.OddsEntry }?,
	DailyDeal: boolean?,
}

local function windowSeed(): number
	return os.time() // Balance.ShopRestockSeconds
end

local function dailySeed(): number
	return os.time() // Balance.ShopDailyDealSeconds
end

local function geodeCost(layer: number): number
	return math.floor(Balance.ShopGeodeBaseCost * Balance.LayerValueMult ^ (layer - 1))
end

-- Seed-rolled deterministic crystal offer: everyone sees the same exact crystal
-- this window; contents are fully visible before purchase (policy-safe).
local function rolledCrystalOffer(seedRng: Random, layer: number, priceMult: number): ShopItem
	-- Rare-or-better only. Rolling the full table meant that half the time this
	-- slot offered a Quartz for more coins than a Quartz sells for — an offer
	-- with no reason to exist. The point of a fixed crystal is skipping the
	-- gamble for something you actually want.
	local baseName = RarityMath.RollRarePlus(layer, 2, seedRng, Crystals.FISH)
	local mutName = RarityMath.RollMutation(1, seedRng)
	local size = 1.0 + seedRng:NextNumber() * 0.2
	local value = RarityMath.ComputeValue(baseName, mutName, size, layer)
	return {
		Kind = "Crystal",
		Title = (mutName ~= "Normal" and (mutName .. " ") or "") .. baseName,
		Cost = math.max(math.floor(value * priceMult), 10),
		Base = baseName,
		Mut = mutName,
		Value = value,
	}
end

function ShopService.BuildStock(player: Player, data: any): { RestockAt: number, Items: { ShopItem } }
	local layer = ctx.Data.Layer(data)
	local luck = ctx.Data.LuckMult(player, data)
	local seed = windowSeed() + (data.ShopSalt or 0) * 1e6
	local seedRng = Random.new(seed)
	local restricted = ctx.Policy.ArePaidRandomItemsRestricted(player)

	local items: { ShopItem } = {}
	if not restricted then
		table.insert(items, {
			Kind = "Geode",
			Title = "Chest",
			Cost = geodeCost(layer),
			Count = 1,
			Odds = RarityMath.GetBaseOdds(layer, luck, Crystals.RELIC),
		})
		table.insert(items, {
			Kind = "GeodeBundle",
			Title = "Chest x3",
			Cost = math.floor(geodeCost(layer) * 2.5),
			Count = 3,
			Odds = RarityMath.GetBaseOdds(layer, luck, Crystals.RELIC),
		})
		table.insert(items, {
			Kind = "PremiumGeode",
			Title = "Golden Chest",
			Cost = geodeCost(layer) * Balance.ShopPremiumGeodeCostMult,
			Count = 1,
			Luck = Balance.ShopPremiumGeodeLuck,
			Odds = RarityMath.GetBaseOdds(layer, luck * Balance.ShopPremiumGeodeLuck, Crystals.RELIC),
		})
		table.insert(items, rolledCrystalOffer(seedRng, layer, 1.25))
	else
		-- Deterministic-only storefront for restricted players (free path = mining).
		table.insert(items, rolledCrystalOffer(seedRng, layer, 1.15))
		table.insert(items, rolledCrystalOffer(seedRng, layer, 1.25))
		table.insert(items, rolledCrystalOffer(seedRng, layer, 1.35))
	end

	if ctx.Monetization.OwnsPass(player, "Vip") then
		table.insert(items, rolledCrystalOffer(seedRng, layer, 1.1))
	end

	-- Daily deal: one slot gets 40% off, rotating on a 24h clock.
	local dealIndex = Random.new(dailySeed()):NextInteger(1, #items)
	items[dealIndex].Cost = math.max(math.floor(items[dealIndex].Cost * 0.6), 5)
	items[dealIndex].DailyDeal = true

	-- A bundle must never cost more per geode than buying them one at a time.
	-- The daily deal is applied to a single slot, so when it landed on the plain
	-- geode the x3 next to it read as a 40% markup — correct arithmetic, terrible
	-- offer. Re-derive the bundle from whatever the single ended up costing.
	local single, bundle = nil, nil
	for _, item in items do
		if item.Kind == "Geode" then
			single = item
		elseif item.Kind == "GeodeBundle" then
			bundle = item
		end
	end
	if single and bundle then
		local count = bundle.Count or 3
		bundle.Cost = math.min(bundle.Cost, math.max(math.floor(single.Cost * count * 0.85), 5))
	end

	return {
		RestockAt = (windowSeed() + 1) * Balance.ShopRestockSeconds,
		Items = items,
	}
end

function ShopService.Buy(player: Player, itemIndex: number): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	local stock = ShopService.BuildStock(player, data)
	local item = stock.Items[itemIndex]
	if not item then
		return false, "That offer just rotated out!"
	end

	-- Per-window purchase limits
	local seed = windowSeed()
	if data.ShopWindow.Seed ~= seed then
		data.ShopWindow.Seed = seed
		data.ShopWindow.Bought = {}
	end
	local key = tostring(itemIndex)
	local bought = data.ShopWindow.Bought[key] or 0
	if bought >= BUY_LIMIT_PER_WINDOW then
		return false, "Sold out this restock — wait for the timer!"
	end
	if data.Coins < item.Cost then
		return false, "Not enough coins."
	end

	if item.Kind == "Geode" or item.Kind == "GeodeBundle" then
		-- Against the whole hold, not just the chest count: fish and chests share
		-- one boat, so buying chests has to respect the fish already on it.
		local space = ctx.Data.BackpackCapacity(data) - ctx.Data.HoldCount(data)
		local count = item.Count or 1
		if space < count then
			return false, "Boat full!"
		end
		data.Coins -= item.Cost
		data.Geodes += count
	elseif item.Kind == "PremiumGeode" then
		data.Coins -= item.Cost
		local result = ctx.Crack.RollWithLuck(player, item.Luck or Balance.ShopPremiumGeodeLuck)
		if result then
			Remotes.Event("CrackResult"):FireClient(player, { result }, false)
		end
	elseif item.Kind == "Crystal" then
		data.Coins -= item.Cost
		local id = tostring(data.NextCrystalId)
		data.NextCrystalId += 1
		local layer = ctx.Data.Layer(data)
		data.Crystals[id] = { Base = item.Base :: string, Mut = item.Mut :: string, Size = 1.1, Layer = layer }
		-- This branch grants a crystal outright rather than rolling one, so it has
		-- to record a personal best itself — otherwise a shop-bought Mythic never
		-- becomes the aura, the leaderboard entry, or the rarest-find board name.
		ctx.Crack.RecordRarest(player, data, item.Base :: string, item.Mut :: string, ctx.Data.CrystalValue(data, data.Crystals[id]))
		local indexKey = Crystals.IndexKey(item.Base :: string, item.Mut :: string)
		if not data.Collection[indexKey] then
			data.Collection[indexKey] = true
			data.CollectionCount += 1
		end
	else
		return false, "Unknown offer."
	end

	data.ShopWindow.Bought[key] = bought + 1
	ctx.Data.MarkDirty(player)
	return true, nil
end

-- Instant Restock dev product: personal reroll via the profile's ShopSalt.
function ShopService.PersonalRestock(player: Player)
	local data = ctx.Data.Get(player)
	if not data then
		return
	end
	data.ShopSalt = (data.ShopSalt or 0) + 1
	data.ShopWindow.Bought = {}
	ctx.Data.MarkDirty(player)
	Remotes.Event("Notify"):FireClient(player, { Text = "Shop restocked, just for you!", Color = Color3.fromRGB(120, 170, 255) })
end

function ShopService.Init(serviceCtx: any)
	ctx = serviceCtx
	Remotes.Function("GetShopStock").OnServerInvoke = function(player)
		local data = ctx.Data.Get(player)
		if not data then
			return nil
		end
		return ShopService.BuildStock(player, data)
	end
	Remotes.Function("BuyShopItem").OnServerInvoke = function(player, itemIndex)
		local index = tonumber(itemIndex)
		if not index then
			return false, "Bad request."
		end
		return ShopService.Buy(player, index)
	end
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Spotlight</string>
          <string name="Source"><![CDATA[--!strict
-- A pillar of light dropped on a player, server-wide. Used for the moments
-- worth interrupting everyone else for: a Legendary+ pull, a Recrystallize.
-- Being seen is the reward; the coins are just the receipt.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Spotlight = {}

function Spotlight.Pillar(player: Player, color: Color3)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	local beam = Instance.new("Part")
	beam.Name = "Spotlight"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Shape = Enum.PartType.Cylinder
	beam.Material = Enum.Material.Neon
	beam.Color = color
	beam.Transparency = 0.55
	beam.Size = Vector3.new(70, 7, 7)
	beam.CFrame = CFrame.new(root.Position + Vector3.new(0, 32, 0)) * CFrame.Angles(0, 0, math.rad(90))
	beam.Parent = Workspace

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 34
	light.Brightness = 2
	light.Parent = beam

	local sparks = Instance.new("ParticleEmitter")
	sparks.Color = ColorSequence.new(color)
	sparks.LightEmission = 0.6
	sparks.Size = NumberSequence.new(1.2, 0)
	sparks.Lifetime = NumberRange.new(0.8, 1.8)
	sparks.Speed = NumberRange.new(10, 26)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Rate = 0
	sparks.Parent = beam
	sparks:Emit(60)

	TweenService:Create(beam, TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = Vector3.new(70, 16, 16),
		Transparency = 1,
	}):Play()
	TweenService:Create(light, TweenInfo.new(2.2), { Brightness = 0 }):Play()
	task.delay(2.6, function()
		beam:Destroy()
	end)
end

return Spotlight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">StreakService</string>
          <string name="Source"><![CDATA[--!strict
-- Daily login streaks on a visible 7-day reward cycle, with a 2x bonus for
-- joining the group. Day 7 grants the anchor prize: big coins + a guaranteed
-- Golden Chest roll (free-action randomness — no disclosure surface).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Monetization = require(Shared.Config.Monetization)
local Remotes = require(Shared.Remotes)

local StreakService = {}

local ctx: any = nil

export type StreakReport = {
	Count: number,
	CycleDay: number,
	Reward: number,
	GroupBonus: boolean,
	StreakLost: boolean,
	Premium: boolean,
}

function StreakService.HandleJoin(player: Player, data: any): StreakReport?
	local today = os.time() // 86400
	local streak = data.Streak
	if streak.LastDay == today then
		return nil -- already claimed today
	end

	local lost = false
	if streak.LastDay == 0 then
		streak.Count = 1
	elseif today - streak.LastDay <= 1 + Balance.StreakGraceDays then
		streak.Count += 1
	else
		streak.Count = 1
		lost = true
	end
	streak.LastDay = today
	streak.Best = math.max(streak.Best, streak.Count)

	local cycleDay = ((streak.Count - 1) % #Balance.StreakCycle) + 1
	local cycleReward = Balance.StreakCycle[cycleDay]
	local reward = cycleReward.Coins

	local inGroup = false
	if Monetization.GroupId ~= 0 then
		local ok, result = pcall(function()
			return player:IsInGroupAsync(Monetization.GroupId)
		end)
		inGroup = ok and result == true
	end
	if inGroup then
		reward *= 2
	end

	data.Coins += reward
	data.TotalCoinsEarned += reward

	if cycleReward.PremiumGeode then
		local result = ctx.Crack.RollWithLuck(player, 3)
		if result then
			task.delay(3, function()
				if player.Parent then
					Remotes.Event("CrackResult"):FireClient(player, { result }, true)
				end
			end)
		end
	end

	ctx.Data.MarkDirty(player)
	return {
		Count = streak.Count,
		CycleDay = cycleDay,
		Reward = reward,
		GroupBonus = inGroup,
		StreakLost = lost,
		Premium = cycleReward.PremiumGeode == true,
	}
end

function StreakService.Init(serviceCtx: any)
	ctx = serviceCtx
end

return StreakService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[--!strict
-- Coin-purchased progression: pickaxes, backpacks, rack slots.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)

local UpgradeService = {}

local ctx: any = nil

function UpgradeService.Buy(player: Player, kind: string): (boolean, string?)
	local data = ctx.Data.Get(player)
	if not data then
		return false, "Loading..."
	end
	-- There is no top tier any more: Balance.Pickaxe and Balance.Backpack always
	-- return one, generating past the hand-authored list.
	if kind == "Pickaxe" then
		local nextTier = Balance.Pickaxe(data.Pickaxe + 1)
		if data.Coins < nextTier.Cost then
			return false, "Not enough coins."
		end
		data.Coins -= nextTier.Cost
		data.Pickaxe += 1
		ctx.RodVis.Refresh(player)
		Remotes.Event("Notify"):FireClient(player, { Text = nextTier.Name .. " equipped!", Color = Color3.fromRGB(120, 255, 200) })
	elseif kind == "Backpack" then
		local nextTier = Balance.Backpack(data.Backpack + 1)
		if data.Coins < nextTier.Cost then
			return false, "Not enough coins."
		end
		data.Coins -= nextTier.Cost
		data.Backpack += 1
	elseif kind == "RackSlot" then
		if data.RackSlots >= Balance.MaxRackSlots then
			return false, "All aquarium tanks owned!"
		end
		local cost = Balance.RackSlotCosts[data.RackSlots - Balance.BaseRackSlots + 1]
		if not cost then
			return false, "All aquarium tanks owned!"
		end
		if data.Coins < cost then
			return false, "Not enough coins."
		end
		data.Coins -= cost
		data.RackSlots += 1
	else
		return false, "Unknown upgrade."
	end
	ctx.Data.MarkDirty(player)
	return true, nil
end

function UpgradeService.Init(serviceCtx: any)
	ctx = serviceCtx
	Remotes.Function("BuyUpgrade").OnServerInvoke = function(player, kind)
		if typeof(kind) ~= "string" then
			return false, "Bad request."
		end
		return UpgradeService.Buy(player, kind)
	end
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="36">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Client bootstrap: state replica, HUD, screens, station prompts.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local StarterGui = game:GetService("StarterGui")

-- The pickaxe Tool is permanent cosmetic equipment; hide the default backpack
-- hotbar so it doesn't overlap the HUD button row.
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end)

local State = require(script.State)
local ScreenManager = require(script.ScreenManager)
local FlexAura = require(script.FlexAura)
local WorldFx = require(script.WorldFx)
local AquariumView = require(script.AquariumView)
local ReelMinigame = require(script.ReelMinigame)
local MiningInput = require(script.MiningInput)
local ObjectiveBanner = require(script.ObjectiveBanner)
local RebirthFx = require(script.RebirthFx)
local Toasts = require(script.Toasts)
local Hud = require(script.Hud)
local CrackScreen = require(script.Screens.CrackScreen)
local RacksScreen = require(script.Screens.RacksScreen)
local ShopScreen = require(script.Screens.ShopScreen)
local StoreScreen = require(script.Screens.StoreScreen)
local IndexScreen = require(script.Screens.IndexScreen)
local RebirthScreen = require(script.Screens.RebirthScreen)
local DockScreen = require(script.Screens.DockScreen)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "CrackAGeodeGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10
gui.Parent = playerGui

State.Init()
WorldFx.Init()
AquariumView.Init()
FlexAura.Init()
MiningInput.Init()
ReelMinigame.Init(gui)
Toasts.Init(gui)
RebirthFx.Init(gui)
Hud.Init(gui)
ObjectiveBanner.Init(gui)
CrackScreen.Init(gui)
RacksScreen.Init(gui)
ShopScreen.Init(gui)
StoreScreen.Init(gui)
IndexScreen.Init(gui)
RebirthScreen.Init(gui)
DockScreen.Init(gui)

-- Walking up to a station and triggering its prompt opens the matching screen.
local STATION_SCREENS: { [string]: string } = {
	Crack = "Crack",
	Racks = "Racks",
	Shop = "Shop",
	Rebirth = "Rebirth",
	Dock = "Dock",
}

ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local station = prompt:GetAttribute("Station")
	if typeof(station) == "string" then
		local screenName = STATION_SCREENS[station]
		if screenName then
			ScreenManager.Open(screenName)
		end
	end
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">AquariumView</string>
            <string name="Source"><![CDATA[--!strict
-- The aquarium tank, filled with the fish YOU have on display.
--
-- Racks are per player, so the tank has to be: what you see swimming is your own
-- socketed fish, not a shared decoration and not the player standing next to
-- you. That makes this client-side work by necessity — and by luck, because a
-- tank that costs the server nothing can afford to actually animate.
--
-- The point of it is simple: a number on a screen saying "4 / 8 tanks" is not a
-- reason to socket a fifth fish. Watching the tank get busier is.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crystals = require(Shared.Config.Crystals)
local FishShape = require(Shared.FishShape)
local RelicShape = require(Shared.RelicShape)
local State = require(script.Parent.State)

local AquariumView = {}

type Swimmer = {
	Model: Model,
	Center: Vector3,
	Radius: Vector3, -- how far it may drift on each axis
	Speed: number,
	Phase: number,
	Depth: number,
}

-- Both halves of the collection carry their own model now — 33 fish silhouettes
-- and 11 relics — so the builders take the same Options and the name selects the
-- shape inside each. (This used to bind a module-level `relicName` before every
-- call, back when only relics needed a name.)
local function relicModel(options: FishShape.Options): Model
	return RelicShape.Build({
		Name = options.Name or "",
		Color = options.Color,
		Scale = (options.Scale or 1) * 1.5,
		Seed = options.Seed,
		Sparkle = options.Sparkle,
	})
end

-- The gravel bed is 0.4 studs of sand on the tank floor and the water volume
-- starts a little under the glass, so the surface something actually RESTS on
-- sits half a stud above the bottom of the tagged water part. Tied to the tank
-- MapBuilder builds; if that changes, this does.
local GRAVEL_ABOVE_FLOOR = 0.5

-- Put a model down so its LOWEST POINT touches `floorY`.
--
-- The old code guessed a fixed drop from the tank centre and hoped every relic
-- was the same height. They are not — a Diver's Helmet is squat and a Trident is
-- tall — so anything taller than the guess sank through the gravel and the table
-- underneath it. Measure the model instead of assuming it: GetBoundingBox is in
-- world space and makes no assumption about where the pivot sits inside the
-- model, which matters because these are built by hand and theirs vary.
local function restOnFloor(model: Model, at: Vector3, floorY: number)
	model:PivotTo(CFrame.new(at))
	local box, size = model:GetBoundingBox()
	local lift = floorY - (box.Position.Y - size.Y * 0.5)
	model:PivotTo(model:GetPivot() + Vector3.new(0, lift, 0))
end

local tank: BasePart? = nil
local swimmers: { Swimmer } = {}
-- Relics: parented and placed once, never animated per frame.
local display: { Model } = {}
local container: Folder? = nil
local rng = Random.new()
-- What the tank is currently showing, so an identical state push doesn't rebuild
-- eight models sixty times a second.
local signature = ""

local function clear()
	if container then
		container:Destroy()
		container = nil
	end
	table.clear(swimmers)
	table.clear(display)
end

-- One fish per occupied rack slot, spread across the tank's volume so they do
-- not stack into one spot when several are added at once.
local function rebuild(state: any)
	local water = tank
	if not water then
		return
	end
	clear()

	local folder = Instance.new("Folder")
	folder.Name = "AquariumFish"
	folder.Parent = water
	container = folder

	local slots: { string } = {}
	for slot in state.Racks do
		table.insert(slots, slot)
	end
	table.sort(slots)

	local size = water.Size
	for index, slot in slots do
		local rack = state.Racks[slot]
		local fish = rack and state.Crystals[rack.CrystalId]
		if fish then
			local def = Crystals.GetBase(fish.Base)
			local mutation = Crystals.GetMutation(fish.Mut)
			local isRelic = Crystals.IsRelic(fish.Base)
			-- Typed explicitly: Luau will not call a union of two identically
			-- shaped function types, so the branch has to name what it returns.
			local build: (FishShape.Options) -> Model = if isRelic then relicModel else FishShape.Build
			local model = build({
				-- The species/relic name IS the model now, so this is no longer
				-- decorative: without it every fish falls back to one shape.
				Name = fish.Base,
				-- Aura tints the fish rather than replacing its colour, so a
				-- Gilded trout still looks like a trout.
				Color = if mutation and mutation.Color
					then (def and def.Color or Color3.new(1, 1, 1)):Lerp(mutation.Color, 0.55)
					else (def and def.Color or Color3.fromRGB(200, 200, 200)),
				-- Tank fish are small; the tank is ~9 studs across and has to hold
				-- eight of them without becoming a traffic jam.
				Scale = 0.26 * math.clamp(fish.Size or 1, 0.9, 2.2),
				Seed = index * 13 + #fish.Base,
				Sparkle = fish.Mut ~= "Normal",
			})
			model.Parent = folder

			-- Lanes: each fish gets its own height band and its own orbit, so
			-- eight of them read as a school rather than as one blur.
			--
			-- Relics do not swim. They sit on the gravel and turn slowly, which is
			-- how a display case works and how you can tell at a glance which half
			-- of your collection you have put on show.
			if isRelic then
				local spread = (index - 0.5) / math.max(#slots, 1) - 0.5
				-- Staggered in Z as well as X: a row of relics dead-centre hides
				-- the short ones behind the tall ones from the only angle the
				-- player ever looks at the tank from.
				local back = if index % 2 == 0 then size.Z * 0.18 else -size.Z * 0.16
				restOnFloor(
					model,
					water.Position + Vector3.new(spread * size.X * 0.7, 0, back),
					water.Position.Y - size.Y * 0.5 + GRAVEL_ABOVE_FLOOR
				)
				table.insert(display, model)
			else
				local lane = (index - 0.5) / math.max(#slots, 1)
				table.insert(swimmers, {
					Model = model,
					Center = water.Position + Vector3.new(0, (lane - 0.5) * (size.Y * 0.55), 0),
					Radius = Vector3.new(size.X * 0.3, size.Y * 0.12, size.Z * 0.22),
					Speed = rng:NextNumber(0.35, 0.62),
					Phase = rng:NextNumber(0, math.pi * 2),
					Depth = rng:NextNumber(-0.6, 0.6),
				})
			end
		end
	end
end

-- Cheap identity for "what should be in the tank": rebuild only when the set of
-- displayed fish actually changes, not on every coin tick.
local function signatureOf(state: any): string
	local parts: { string } = {}
	for slot, rack in state.Racks do
		local fish = state.Crystals[rack.CrystalId]
		if fish then
			table.insert(parts, ("%s:%s|%s|%.2f"):format(slot, fish.Base, fish.Mut, fish.Size or 1))
		end
	end
	table.sort(parts)
	return table.concat(parts, ",")
end

function AquariumView.Init()
	local function adopt(instance: Instance)
		if instance:IsA("BasePart") and not tank then
			tank = instance
			signature = ""
			local state = State.Get()
			if state then
				signature = signatureOf(state)
				rebuild(state)
			end
		end
	end
	for _, tagged in CollectionService:GetTagged("AquariumTank") do
		adopt(tagged)
	end
	CollectionService:GetInstanceAddedSignal("AquariumTank"):Connect(adopt)

	State.Changed:Connect(function(state)
		if not tank or not state or not state.Racks or not state.Crystals then
			return
		end
		local next = signatureOf(state)
		if next ~= signature then
			signature = next
			rebuild(state)
		end
	end)

	local clock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if #swimmers == 0 then
			return
		end
		clock += dt
		for _, swimmer in swimmers do
			local t = clock * swimmer.Speed + swimmer.Phase
			-- A flattened figure-of-eight: it turns at the ends of the tank the
			-- way a fish does, instead of orbiting like a carousel horse.
			local x = math.sin(t) * swimmer.Radius.X
			local y = math.sin(t * 2.1) * swimmer.Radius.Y
			local z = math.sin(t * 0.7 + swimmer.Depth) * swimmer.Radius.Z
			-- Face along the path. The nose is +X, and the fish is moving in the
			-- direction the sine is heading, so cos gives the heading directly.
			local heading = if math.cos(t) >= 0 then 0 else math.pi
			swimmer.Model:PivotTo(
				CFrame.new(swimmer.Center + Vector3.new(x, y, z))
					* CFrame.Angles(0, heading, math.sin(t * 2.1) * 0.12)
			)
		end
	end)
end

return AquariumView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">FlexAura</string>
            <string name="Source"><![CDATA[--!strict
-- Renders the rarest-find crystal above every player's head. The server just
-- publishes attributes; the crystal, the spin and the nameplate are all built
-- locally, so this is free at any player count.

local Players = game:GetService("Players")

local Crystals = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Config.Crystals)
local GemView = require(script.Parent.GemView)
local UiKit = require(script.Parent.UiKit)

local FlexAura = {}

local AURA_NAME = "RarestFindAura"
local VISIBLE_RANGE = 110 -- matches the billboard's MaxDistance

-- One shared loop gates every aura, rather than fifteen ViewportFrames each
-- spinning a twenty-part model every frame regardless of whether anyone can see
-- them. GemView skips work while its viewport is hidden, so flipping Visible
-- here is what actually buys the frames back.
local tracked: { [Player]: { Billboard: BillboardGui, Viewport: ViewportFrame, Head: BasePart } } = {}

local function gateVisibility()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = camera.CFrame.Position
	for player, aura in tracked do
		if not aura.Billboard.Parent or not aura.Head.Parent then
			tracked[player] = nil
		else
			local near = (aura.Head.Position - origin).Magnitude <= VISIBLE_RANGE
			aura.Viewport.Visible = near
			aura.Billboard.Enabled = near
		end
	end
end

local function untrack(player: Player)
	tracked[player] = nil
end

local function clear(character: Model)
	local head = character:FindFirstChild("Head")
	local existing = head and head:FindFirstChild(AURA_NAME)
	if existing then
		existing:Destroy()
	end
end

local function build(player: Player, character: Model)
	clear(character)
	untrack(player)
	local base = player:GetAttribute("FlexBase")
	if typeof(base) ~= "string" or base == "" then
		return
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local mutation = player:GetAttribute("FlexMut")
	local tier = player:GetAttribute("FlexTier")
	local color = player:GetAttribute("FlexColor")
	local crystalColor = typeof(color) == "Color3" and color or Color3.fromRGB(255, 210, 90)
	local tierColor = (typeof(tier) == "string" and Crystals.TierColors[tier]) or UiKit.Colors.Accent

	local billboard = Instance.new("BillboardGui")
	billboard.Name = AURA_NAME
	billboard.Size = UDim2.fromScale(4.4, 5)
	billboard.StudsOffset = Vector3.new(0, 3.4, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 110
	billboard.Parent = head

	local gem = GemView.Create({
		Parent = billboard,
		Size = UDim2.fromScale(1, 0.7),
		Position = UDim2.fromScale(0, 0),
		Color = crystalColor,
		Seed = #base * 23 + 5,
		Spin = 0.75,
		ZIndex = 1,
		-- The trophy over your head is whatever your rarest find WAS, and that is
		-- now as likely to be a relic as a fish.
		Name = base,
	})

	tracked[player] = { Billboard = billboard, Viewport = gem, Head = head }

	local prefix = (typeof(mutation) == "string" and mutation ~= "Normal") and (mutation .. " ") or ""
	UiKit.Label({
		Text = prefix .. base,
		Font = Enum.Font.FredokaOne,
		TextColor3 = tierColor,
		TextStrokeTransparency = 0.3,
		Size = UDim2.fromScale(1, 0.26),
		Position = UDim2.fromScale(0, 0.72),
		ZIndex = 2,
		Parent = billboard,
	})
end

local function watch(player: Player)
	local function refresh()
		local character = player.Character
		if character then
			build(player, character)
		end
	end
	player.CharacterAdded:Connect(function(character)
		-- Wait for the Head to exist before parenting the billboard to it
		character:WaitForChild("Head", 10)
		task.wait(0.2)
		build(player, character)
	end)
	player:GetAttributeChangedSignal("FlexBase"):Connect(refresh)
	player:GetAttributeChangedSignal("FlexMut"):Connect(refresh)
	refresh()
end

function FlexAura.Init()
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(untrack)
	-- Twice a second is plenty: this only decides whether a decoration spins.
	task.spawn(function()
		while true do
			task.wait(0.5)
			gateVisibility()
		end
	end)
end

return FlexAura
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">GemView</string>
            <string name="Source"><![CDATA[--!strict
-- A real, swimming 3D fish rendered inside a UI frame. Reveal cards, the Index
-- and the trophy over your head all draw through here, so what you catch and
-- what you see are the same object.
--
-- (Module name stays GemView — it is the engine's "collectible in a viewport"
-- widget, the same way Crystals holds fish and CrackService opens chests.)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crystals = require(Shared.Config.Crystals)
local FishShape = require(Shared.FishShape)
local RelicShape = require(Shared.RelicShape)

local GemView = {}

export type Props = {
	Parent: Instance,
	Size: UDim2,
	Position: UDim2,
	Color: Color3,
	AnchorPoint: Vector2?,
	ZIndex: number?,
	Spin: number?,
	Seed: number?,
	Shards: number?, -- unused; kept so existing call sites keep compiling
	-- The NAME of the thing being drawn. Not a boolean and not a colour: BOTH
	-- halves of the collection have their own models now — 33 fish silhouettes
	-- and 11 relics — so "which one is this" is the only thing that can pick a
	-- shape. A Sunken Crown drawn as a gem and an Anchovy drawn as a generic fish
	-- are the same mistake one level apart.
	Name: string?,
}

function GemView.Create(props: Props): ViewportFrame
	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "Gem"
	viewport.Size = props.Size
	viewport.Position = props.Position
	viewport.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	viewport.BackgroundTransparency = 1
	viewport.ZIndex = props.ZIndex or 2
	-- Partial ambient, not full. The crystals needed full ambient because Neon
	-- renders flat and went muddy without it; a fish is SmoothPlastic and needs
	-- the opposite — enough directional light to separate body from fin from
	-- tail. Blow the ambient out and the silhouette flattens into one shape.
	viewport.Ambient = Color3.fromRGB(150, 158, 175)
	viewport.LightColor = Color3.fromRGB(255, 252, 240)
	viewport.LightDirection = Vector3.new(-0.35, -1, -0.55)

	local name = props.Name
	local model = if name and Crystals.IsRelic(name)
		then RelicShape.Build({
			Name = name,
			Color = props.Color,
			Scale = 1,
			Seed = props.Seed or 11,
		})
		else FishShape.Build({
			Name = name,
			Color = props.Color,
			Scale = 1,
			Seed = props.Seed or 11,
		})
	model.Parent = viewport
	-- Centre it immediately. The spin loop re-centres every frame, but it bails
	-- out while the viewport is hidden, so without this a card that starts
	-- invisible shows the model off-centre the moment it is revealed.
	model:PivotTo(CFrame.new())

	local camera = Instance.new("Camera")
	camera.FieldOfView = 42
	-- FRAME THE SPECIES, don't assume one size. Species are built at their real
	-- relative proportions — an Anchovy is 1.7 studs and a Megalodon is 6 — which
	-- is the point in the tank, but on a card at a fixed camera distance it would
	-- mean a shark cropped to its middle and an anchovy lost as a dot. So pull the
	-- camera back in proportion to the model actually built.
	--
	-- Slightly off the beam and a touch above: dead side-on reads as a sticker,
	-- and dead front-on hides the whole fish behind its own nose.
	local _, extents = model:GetBoundingBox()
	local reach = math.max(extents.X, extents.Y, extents.Z)
	-- 2.05x reach reproduces the old framing for the old 3.4-stud fish, so
	-- everything that already looked right still does.
	local distance = math.max(reach * 2.05, 3.2)
	local eye = Vector3.new(0.23, 0.2, 0.95).Unit * distance
	camera.CFrame = CFrame.lookAt(eye, Vector3.new(0, 0, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	viewport.Parent = props.Parent

	local speed = props.Spin or 1.1
	local clock = 0
	local connection: RBXScriptConnection? = nil
	local function stop()
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
	-- Watch ancestry, not viewport.Parent: when an ANCESTOR is removed the
	-- viewport keeps its own parent, so a Parent check never fires and the swim
	-- would run forever holding the model in memory. Characters get removed that
	-- way, and every player wears one of these.
	viewport.Destroying:Once(stop)
	viewport.AncestryChanged:Connect(function()
		if not viewport:IsDescendantOf(game) then
			stop()
		end
	end)
	connection = RunService.RenderStepped:Connect(function(dt: number)
		-- A fish nobody can see does not need to swim. With fifteen players
		-- wearing one of these over their head, the ones behind you, off screen,
		-- or past the billboard's MaxDistance are the common case.
		if not viewport.Visible or viewport.AbsoluteSize.X < 1 then
			return
		end
		clock += dt * speed
		-- Turning on the spot, but leaning and bobbing with it, so it reads as
		-- swimming rather than as a model on a turntable.
		model:PivotTo(
			CFrame.new(0, math.sin(clock * 1.6) * 0.16, 0)
				* CFrame.Angles(0, clock, math.sin(clock * 2.2) * 0.13)
		)
	end)

	return viewport
end

return GemView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- HUD: coins/geodes pills, screen buttons, event banner, boost + streak
-- indicators, and the one-time starter-pack offer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Monetization = require(Shared.Config.Monetization)
local Purchase = require(script.Parent.Purchase)
local ScreenManager = require(script.Parent.ScreenManager)
local State = require(script.Parent.State)
local UiKit = require(script.Parent.UiKit)

local Hud = {}

local coinsLabel: TextLabel? = nil
local geodesLabel: TextLabel? = nil
local streakLabel: TextLabel? = nil
local eventBanner: TextLabel? = nil
local starterButton: TextButton? = nil
local starterOffer: Frame? = nil
local indexBadge: TextLabel? = nil
local autoCastBadge: TextLabel? = nil

-- Coins roll up to their new value instead of snapping, and the pill punches
-- when they land. A number that visibly climbs is worth more than the same
-- number appearing — it's the slot-machine payout counter, and it costs
-- nothing but a lerp.
local displayedCoins = 0
local targetCoins = 0
local seenFirstSync = false

local function coinGainPopup(anchor: Frame, amount: number)
	local label = UiKit.Label({
		Text = "+" .. Format.Number(amount),
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Good,
		TextStrokeTransparency = 0.4,
		Size = UDim2.fromOffset(150, 30),
		-- Just outside the pill's right edge, rising. Inside the pill it covered
		-- the very number it is annotating; the original rise to -22 ran off the
		-- top of the screen, so -10 is the ceiling (the pill's top edge is y=12).
		Position = UDim2.new(1, 6, 0, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = anchor,
	})
	TweenService:Create(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(1, 6, 0, -10),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	task.delay(1, function()
		label:Destroy()
	end)

	anchor.Size = UDim2.fromOffset(205, 44)
	TweenService:Create(anchor, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(190, 40),
	}):Play()
end

local function pill(parent: Instance, position: UDim2, color: Color3): TextLabel
	local frame = UiKit.Create("Frame", {
		Size = UDim2.fromOffset(190, 40),
		Position = position,
		BackgroundColor3 = UiKit.Colors.Bg,
		BackgroundTransparency = 0.15,
		Parent = parent,
	})
	UiKit.Corner(12).Parent = frame
	UiKit.Stroke(color, 2).Parent = frame
	local label = UiKit.Label({
		Text = "",
		TextColor3 = color,
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	return label :: TextLabel
end

function Hud.Init(gui: ScreenGui)
	coinsLabel = pill(gui, UDim2.fromOffset(12, 12), UiKit.Colors.Accent)
	geodesLabel = pill(gui, UDim2.fromOffset(12, 58), Color3.fromRGB(170, 110, 240))
	streakLabel = pill(gui, UDim2.fromOffset(12, 104), UiKit.Colors.Good)
	local boost = pill(gui, UDim2.fromOffset(12, 150), UiKit.Colors.Robux)
	local boostFrame = boost.Parent :: Frame
	boostFrame.Visible = false

	-- Event banner (top center, under toasts)
	eventBanner = UiKit.Create("TextLabel", {
		Text = "",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = UiKit.Colors.Accent,
		BackgroundColor3 = UiKit.Colors.Bg,
		BackgroundTransparency = 0.2,
		Size = UDim2.fromOffset(420, 40),
		Position = UDim2.new(0.5, -210, 0, 236),
		Visible = false,
		Parent = gui,
	}) :: TextLabel
	UiKit.Corner(12).Parent = eventBanner
	UiKit.Stroke(UiKit.Colors.Accent, 2).Parent = eventBanner

	-- Slam the banner in with an alert sting when an event starts
	State.EventChanged:Connect(function(eventInfo)
		local banner = eventBanner
		if not banner or typeof(eventInfo) ~= "table" or not eventInfo.Name then
			return
		end
		banner.Visible = true
		banner.Size = UDim2.fromOffset(0, 0)
		banner.Position = UDim2.new(0.5, 0, 0, 256)
		TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(420, 40),
			Position = UDim2.new(0.5, -210, 0, 236),
		}):Play()
		for i, pitch in { 0.8, 1.2, 1.6 } do
			task.delay((i - 1) * 0.1, function()
				local sting = Instance.new("Sound")
				sting.SoundId = "rbxasset://sounds/electronicpingshort.wav"
				sting.PlaybackSpeed = pitch
				sting.Volume = 0.6
				sting.Parent = banner
				sting:Play()
				task.delay(2, function()
					if sting.Parent then
						sting:Destroy()
					end
				end)
			end)
		end
	end)

	-- Bottom button row. Seven buttons at 92 + six 8px gaps = 692, so the row is
	-- 700 wide: the layout centres its children and would silently overflow a
	-- frame sized for the old six.
	local row = UiKit.Create("Frame", {
		Size = UDim2.fromOffset(700, 56),
		Position = UDim2.new(0.5, -350, 1, -70),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = row
	local buttons = {
		{ Label = "Open", Screen = "Crack", Color = Color3.fromRGB(255, 170, 40) },
		{ Label = "Aquarium", Screen = "Racks", Color = Color3.fromRGB(120, 255, 200) },
		{ Label = "Shop", Screen = "Shop", Color = Color3.fromRGB(120, 170, 255) },
		{ Label = "Index", Screen = "Index", Color = Color3.fromRGB(190, 90, 255) },
		{ Label = "Areas", Screen = "Dock", Color = Color3.fromRGB(120, 200, 255) },
		{ Label = "Set Sail", Screen = "Rebirth", Color = Color3.fromRGB(255, 120, 255) },
		{ Label = "Store", Screen = "Store", Color = UiKit.Colors.Accent },
	}
	for i, def in buttons do
		local button = UiKit.Create("TextButton", {
			Text = def.Label,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(28, 24, 20),
			BackgroundColor3 = def.Color,
			Size = UDim2.fromOffset(92, 52),
			LayoutOrder = i,
			Parent = row,
		})
		UiKit.Corner(12).Parent = button
		UiKit.Pad(8).Parent = button

		-- The collection counter rides on the Index button rather than taking a
		-- fifth HUD pill. An unfinished set on screen at all times is the quiet
		-- reason to crack one more geode.
		if def.Screen == "Index" then
			local badge = UiKit.Create("TextLabel", {
				Text = "",
				Font = Enum.Font.FredokaOne,
				TextScaled = true,
				TextColor3 = Color3.fromRGB(28, 24, 20),
				BackgroundColor3 = UiKit.Colors.Good,
				Size = UDim2.fromOffset(56, 20),
				Position = UDim2.new(1, -30, 0, -14),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 3,
				Parent = button,
			}) :: TextLabel
			UiKit.Corner(6).Parent = badge
			indexBadge = badge
		end

		local screenName = def.Screen
		button.Activated:Connect(function()
			ScreenManager.Toggle(screenName)
		end)
	end

	-- Auto-Cast badge, for owners only. A label, not a button: the pass has no
	-- setting to change — you hold to fish or you don't — so a toggle would be a
	-- control that does nothing. It exists so the pass is visibly doing
	-- something, which a pure input change otherwise isn't.
	--
	-- Its own band at y = H-192, clear of the starter pack (H-140..H-94) and the
	-- button row (H-70..H-14), so it cannot swallow their taps on a phone.
	local autoCast = UiKit.Create("TextLabel", {
		Text = "🎣 Auto-Cast — hold to fish",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(28, 24, 20),
		BackgroundColor3 = UiKit.Colors.Good,
		Size = UDim2.fromOffset(220, 34),
		Position = UDim2.new(0, 12, 1, -192),
		Visible = false,
		Parent = gui,
	}) :: TextLabel
	UiKit.Corner(10).Parent = autoCast
	UiKit.Pad(6).Parent = autoCast
	autoCastBadge = autoCast

	-- Starter pack offer (hidden once owned / unconfigured)
	local starter = UiKit.Create("TextButton", {
		Text = "Starter Pack  R$" .. Monetization.Products.StarterPack.Price,
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(28, 24, 20),
		BackgroundColor3 = UiKit.Colors.Accent,
		Size = UDim2.fromOffset(200, 46),
		-- Clear of the bottom button row's band (y = H-70 .. H-18). At H-60 this
		-- sat directly over the Store button on any viewport narrower than ~1068
		-- and, drawing later, swallowed the tap — the Robux store was unreachable
		-- on phones until the pack was bought.
		Position = UDim2.new(1, -212, 1, -140),
		Visible = false,
		Parent = gui,
	}) :: TextButton
	starterButton = starter
	UiKit.Corner(12).Parent = starter
	UiKit.Pad(6).Parent = starter

	-- Offer page: show exactly what's inside BEFORE the Roblox purchase prompt.
	local offer = UiKit.Create("Frame", {
		Size = UDim2.fromOffset(360, 320),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UiKit.Colors.Bg,
		Visible = false,
		Parent = gui,
	})
	UiKit.Corner(16).Parent = offer
	UiKit.Stroke(UiKit.Colors.Accent, 3).Parent = offer
	UiKit.Label({
		Text = "STARTER PACK",
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Accent,
		Size = UDim2.new(1, -60, 0, 42),
		Position = UDim2.fromOffset(16, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = offer,
	})
	local offerClose = UiKit.Create("TextButton", {
		Text = "X",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = UiKit.Colors.Text,
		BackgroundColor3 = UiKit.Colors.Bad,
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(1, -46, 0, 10),
		Parent = offer,
	})
	UiKit.Corner(10).Parent = offerClose
	local offerLines = {
		{ Text = "💰  2,500 Coins", Color = UiKit.Colors.Accent },
		{ Text = "🐟  A guaranteed RAINBOW TROUT", Color = Color3.fromRGB(60, 220, 130) },
		{ Text = "⚡  24 hours of 2x Coins", Color = Color3.fromRGB(120, 200, 255) },
		{ Text = "One-time offer — best value in the game!", Color = UiKit.Colors.TextDim },
	}
	for i, line in offerLines do
		UiKit.Label({
			Text = line.Text,
			Font = Enum.Font.GothamBold,
			TextColor3 = line.Color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -32, 0, 34),
			Position = UDim2.fromOffset(16, 56 + (i - 1) * 42),
			Parent = offer,
		})
	end
	local offerBuy = UiKit.Button({
		Text = "Buy  R$" .. Monetization.Products.StarterPack.Price,
		BackgroundColor3 = UiKit.Colors.Robux,
		Size = UDim2.new(1, -32, 0, 52),
		Position = UDim2.new(0, 16, 1, -66),
		Parent = offer,
	})
	offerBuy.Activated:Connect(function()
		Purchase.PromptProduct("StarterPack")
	end)
	offerClose.Activated:Connect(function()
		offer.Visible = false
	end)
	starter.Activated:Connect(function()
		offer.Visible = not offer.Visible
	end)
	starterOffer = offer

	State.Changed:Connect(function(state)
		local gain = state.Coins - targetCoins
		targetCoins = state.Coins
		if not seenFirstSync then
			seenFirstSync = true
			displayedCoins = state.Coins
		elseif gain > 0 and coinsLabel then
			coinGainPopup(coinsLabel.Parent :: Frame, gain)
		elseif gain < 0 then
			displayedCoins = state.Coins -- spending is instant; earning is savoured
		end
		if geodesLabel then
			-- One number for the whole boat: fish you haven't sold plus chests you
			-- haven't opened. Two separate counters would need two upgrade paths.
			local hold = state.Hold or state.Geodes
			geodesLabel.Text = ("Hold: %d / %d  (%d chest%s)"):format(
				hold,
				state.BackpackCapacity,
				state.Geodes,
				state.Geodes == 1 and "" or "s"
			)
		end
		if streakLabel then
			streakLabel.Text = "Streak: Day " .. state.Streak.Count
		end
		local badge = indexBadge
		if badge and state.TotalIndex then
			badge.Text = state.CollectionCount .. "/" .. state.TotalIndex
			-- Goes gold on the home stretch: "almost done" is worth more than a
			-- number, and it is true rather than manufactured.
			local remaining = state.TotalIndex - state.CollectionCount
			badge.BackgroundColor3 = if remaining <= 5 then UiKit.Colors.Accent else UiKit.Colors.Good
		end
		local castBadge = autoCastBadge
		if castBadge then
			castBadge.Visible = (state.Passes and state.Passes.AutoCast) == true
		end
		local packAvailable = not state.StarterPackOwned and Monetization.Products.StarterPack.Id ~= 0
		if starterButton then
			starterButton.Visible = packAvailable
		end
		if starterOffer and not packAvailable then
			starterOffer.Visible = false
		end
	end)

	RunService.Heartbeat:Connect(function(delta: number)
		local state = State.Get()
		if state and coinsLabel then
			if displayedCoins ~= targetCoins then
				local step = math.max(math.abs(targetCoins - displayedCoins) * math.min(delta * 9, 1), 1)
				if math.abs(targetCoins - displayedCoins) <= step then
					displayedCoins = targetCoins
				else
					displayedCoins += (targetCoins > displayedCoins) and step or -step
				end
			end
			coinsLabel.Text = "Coins: "
				.. Format.Number(math.floor(displayedCoins))
				.. "  (x"
				.. string.format("%.2f", state.CoinMult)
				.. ")"
		end
		if state then
			local remaining = (state.Boost2xUntil or 0) - os.time()
			local frame = boostFrame
			if remaining > 0 then
				frame.Visible = true
				boost.Text = "2x Coins: " .. Format.Clock(remaining)
			else
				frame.Visible = false
			end
		end
		local banner = eventBanner
		if banner then
			local event = State.CurrentEvent()
			if event and event.Name then
				banner.Visible = true
				local remaining = (event.EndsAt or 0) - os.time()
				local desc = if (event.LuckMult or 1) > 1 then (event.LuckMult .. "x LUCK") else ((event.MutationMult or 1) .. "x MUTATIONS")
				banner.Text = event.Name .. "!  " .. desc .. "  •  " .. Format.Clock(remaining)
				if event.Color then
					banner.TextColor3 = event.Color
				end
			else
				banner.Visible = false
			end
		end
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">MiningInput</string>
            <string name="Source"><![CDATA[--!strict
-- Cast/strike input: the equipped rod Tool swallows clicks before ClickDetectors
-- fire, so we raycast the tap ourselves and report the spot.
--
-- With the Auto-Cast pass, holding the button down keeps sending that same
-- report while you point at a buoy. Nothing else changes, because nothing else
-- needs to: the server already casts on the first report, ignores reports before
-- the bite, and lands the catch on one inside the window. So holding recasts and
-- strikes for you without a second code path, and — this is the part that
-- matters — without fishing any faster than a person can. The bite delay and the
-- 1.2s window are untouched. It removes the clicking, not the waiting.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)
local ReelMinigame = require(script.Parent.ReelMinigame)
local State = require(script.Parent.State)

local MiningInput = {}

local MAX_TAP_RANGE = 140
local HOLD_INTERVAL = 0.12 -- comfortably inside the 1.2s bite window

local holding: Vector2? = nil
local sinceCast = 0

-- A tap can land on a buoy's own sphere or on the wide invisible hitbox around
-- it. Either way the same spot gets fished — whichever pixel the player actually
-- hit is not something they should have to be precise about.
local function nodeOf(instance: Instance): BasePart?
	if instance:GetAttribute("NodeIndex") ~= nil and instance:IsA("BasePart") then
		return instance
	end
	local parent = instance.Parent
	if parent and parent:IsA("BasePart") and parent:GetAttribute("NodeIndex") ~= nil then
		return parent
	end
	return nil
end

-- For a tap that landed on open water: the buoy the player was POINTING at, not
-- the one they happen to be standing nearest. Aiming at a far buoy and having
-- the rod cast at a different one beside you is worse than the tap doing
-- nothing, because it looks like the game ignored you.
--
-- Measured as perpendicular distance from the tap ray, and still bounded by the
-- cast range the server enforces, so this can only pick a buoy the player could
-- have hit directly.
local AIM_TOLERANCE = 12 -- studs off the ray still counts as aiming at it

local function spotAlongRay(origin: Vector3, direction: Vector3): BasePart?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local best: BasePart? = nil
	local bestOffset = AIM_TOLERANCE
	for _, tagged in CollectionService:GetTagged("FishingSpot") do
		if tagged:IsA("BasePart") and (tagged.Position - root.Position).Magnitude <= Balance.CastRange then
			local toSpot = tagged.Position - origin
			local along = toSpot:Dot(direction)
			if along > 0 then -- in front of the camera, not behind it
				local offset = (toSpot - direction * along).Magnitude
				if offset < bestOffset then
					best = tagged
					bestOffset = offset
				end
			end
		end
	end
	return best
end

local function spotAt(position: Vector2): BasePart?
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local ray = camera:ViewportPointToRay(position.X, position.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- Terrain water is queryable by default, and the buoys float ON it — so
	-- every tap that came in at a shallow angle died in the sea before it
	-- reached the buoy. That is what made casting feel like it needed you to be
	-- standing on top of the thing.
	params.IgnoreWater = true
	local character = Players.LocalPlayer.Character
	params.FilterDescendantsInstances = character and { character } or {}
	local direction = ray.Direction.Unit
	local hit = Workspace:Raycast(ray.Origin, direction * MAX_TAP_RANGE, params)
	if hit then
		local node = nodeOf(hit.Instance)
		if node then
			return node
		end
	end
	-- Either nothing was hit (open sea or sky, now that water is ignored) or the
	-- tap landed on scenery. Fall back to whichever buoy the player was aiming
	-- at, which is what they meant by clicking out over the water.
	return spotAlongRay(ray.Origin, direction)
end

local function tryFish(position: Vector2)
	-- While the reel-in bar is up, clicks belong to it. Without this, holding to
	-- reel would also cast at whatever buoy the cursor happened to be over —
	-- claiming a second spot, and on release abandoning the fish you were
	-- actually fighting.
	if ReelMinigame.Active() then
		return
	end
	local spot = spotAt(position)
	if spot then
		Remotes.Event("MineNode"):FireServer(spot)
	end
end

local function ownsAutoCast(): boolean
	local state = State.Get()
	return state ~= nil and state.Passes ~= nil and state.Passes.AutoCast == true
end

function MiningInput.Init()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local position = Vector2.new(input.Position.X, input.Position.Y)
			tryFish(position)
			holding = position
			sinceCast = 0
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if holding == nil then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			holding = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			holding = nil
		end
	end)
	-- Losing focus (alt-tab, a Roblox prompt) must stop the rod, or it keeps
	-- fishing at a window nobody is looking at.
	UserInputService.WindowFocusReleased:Connect(function()
		holding = nil
	end)

	RunService.Heartbeat:Connect(function(dt: number)
		local position = holding
		if position == nil or not ownsAutoCast() then
			return
		end
		sinceCast += dt
		if sinceCast < HOLD_INTERVAL then
			return
		end
		sinceCast = 0
		tryFish(position)
	end)
end

return MiningInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ObjectiveBanner</string>
            <string name="Source"><![CDATA[--!strict
-- Guided objective banner: shows new players exactly what to do next, driven
-- by the server-side onboarding funnel (each step also pays a coin reward).
-- Disappears forever once the loop is learned (first rebirth).
--
-- It lives bottom-left, tucked above the button row rather than across the
-- middle of the screen, and every step can be dismissed with the X. Dismissing
-- is per-step, so the next objective still gets one chance to be seen — a
-- tutorial you cannot turn off is worse than one nobody reads.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local State = require(script.Parent.State)
local UiKit = require(script.Parent.UiKit)

local _ = Shared

local ObjectiveBanner = {}

local STEPS = {
	{ key = "FirstGeode", text = "🎣 Click a buoy to cast, then HOLD to reel it in!" },
	{ key = "FirstCrack", text = "💥 Open your chest at Treasure Chests!" },
	{ key = "FirstRare", text = "💎 Land a Rare fish!" },
	{ key = "FirstSocket", text = "🔮 Display a fish in your Aquarium!" },
	{ key = "FirstRebirth", text = "✨ Save up coins and Set Sail!" },
}

function ObjectiveBanner.Init(gui: ScreenGui)
	local dismissed: { [string]: boolean } = {}
	local currentKey: string? = nil

	local banner = UiKit.Create("Frame", {
		Name = "ObjectiveBanner",
		BackgroundColor3 = UiKit.Colors.Bg,
		BackgroundTransparency = 0.25,
		Size = UDim2.fromOffset(346, 34),
		Position = UDim2.new(0, 12, 1, -116),
		Visible = false,
		Parent = gui,
	}) :: Frame
	UiKit.Corner(10).Parent = banner
	UiKit.Stroke(UiKit.Colors.Accent, 1).Parent = banner

	local label = UiKit.Label({
		Text = "",
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(255, 240, 180),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -42, 1, -10),
		Position = UDim2.fromOffset(10, 5),
		Parent = banner,
	})

	local close = UiKit.Create("TextButton", {
		Text = "✕",
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = UiKit.Colors.TextDim,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.new(1, -28, 0.5, -12),
		Parent = banner,
	}) :: TextButton
	UiKit.Pad(5).Parent = close
	close.Activated:Connect(function()
		if currentKey then
			dismissed[currentKey] = true
		end
		banner.Visible = false
	end)

	State.Changed:Connect(function(state)
		local funnel = state.Funnel or {}
		for _, step in STEPS do
			if not funnel[step.key] then
				currentKey = step.key
				label.Text = step.text
				banner.Visible = not dismissed[step.key]
				return
			end
		end
		currentKey = nil
		banner.Visible = false
	end)
end

return ObjectiveBanner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Purchase</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side purchase prompts, driven by the Monetization config. Offers with
-- an unconfigured (0) ID show a friendly toast instead of erroring.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Toasts = require(script.Parent.Toasts)

local Purchase = {}

function Purchase.PromptPass(key: string)
	local def = (Monetization.Gamepasses :: any)[key]
	if not def or def.Id == 0 then
		Toasts.Push("This offer isn't set up yet!", Color3.fromRGB(255, 200, 90))
		return
	end
	MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, def.Id)
end

function Purchase.PromptProduct(key: string)
	local def = (Monetization.Products :: any)[key]
	if not def or def.Id == 0 then
		Toasts.Push("This offer isn't set up yet!", Color3.fromRGB(255, 200, 90))
		return
	end
	MarketplaceService:PromptProductPurchase(Players.LocalPlayer, def.Id)
end

return Purchase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">RebirthFx</string>
            <string name="Source"><![CDATA[--!strict
-- The Set Sail ritual.
--
-- Rebirth asks a player to delete everything they spent an hour building. A
-- toast is not payment for that. This is: the cave charges up, the screen goes
-- white, and the number that comes back is permanent and bigger than before.
-- Handing over your progress has to FEEL like an upgrade or nobody does it
-- twice — and the second rebirth is where the long retention curve starts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local RevealFx = require(script.Parent.RevealFx)
local UiKit = require(script.Parent.UiKit)
local WorldFx = require(script.Parent.WorldFx)

local RebirthFx = {}

local PINK = Color3.fromRGB(255, 120, 255)
local gui: ScreenGui? = nil
local busy = false

local function ping(parent: Instance, pitch: number, volume: number)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	sound.PlaybackSpeed = pitch
	sound.Volume = volume
	sound.Parent = parent
	sound:Play()
	task.delay(2.5, function()
		sound:Destroy()
	end)
end

-- Rings racing outward from the middle of the screen, one per beat.
local function ring(overlay: Frame, delay: number)
	task.delay(delay, function()
		if not overlay.Parent then
			return
		end
		local circle = Instance.new("Frame")
		circle.AnchorPoint = Vector2.new(0.5, 0.5)
		circle.Position = UDim2.fromScale(0.5, 0.5)
		circle.Size = UDim2.fromOffset(40, 40)
		circle.BackgroundTransparency = 1
		circle.Parent = overlay
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = circle
		local stroke = Instance.new("UIStroke")
		stroke.Color = PINK
		stroke.Thickness = 6
		stroke.Transparency = 0.1
		stroke.Parent = circle
		TweenService:Create(circle, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(1200, 1200),
		}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.9), { Transparency = 1, Thickness = 1 }):Play()
		task.delay(1, function()
			circle:Destroy()
		end)
	end)
end

local function run(payload: { [string]: any })
	local screen = gui
	if not screen or busy then
		return
	end
	busy = true

	local overlay = UiKit.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.4,
		Active = true,
		ZIndex = 30,
		Parent = screen,
	}) :: Frame

	-- Charge-up: three rings, three rising notes, the shake building under it
	for i = 0, 2 do
		ring(overlay, i * 0.28)
		task.delay(i * 0.28, function()
			if overlay.Parent then
				ping(overlay, 0.7 + i * 0.35, 0.5)
				WorldFx.Shake(0.5 + i * 0.5)
			end
		end)
	end

	task.delay(1.05, function()
		if not overlay.Parent then
			return
		end
		-- White-out
		local flash = UiKit.Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0,
			ZIndex = 31,
			Parent = overlay,
		})
		TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
		WorldFx.Shake(2.2)
		RevealFx.Fanfare(overlay, 6)
		RevealFx.Confetti(overlay, PINK, 44)
		RevealFx.Sunburst(overlay, UDim2.fromScale(0.5, 0.44), PINK)
		task.delay(0.9, function()
			flash:Destroy()
		end)

		local card = UiKit.Create("Frame", {
			Size = UDim2.fromOffset(0, 0),
			Position = UDim2.fromScale(0.5, 0.44),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = UiKit.Colors.Bg,
			ZIndex = 32,
			Parent = overlay,
		})
		UiKit.Corner(18).Parent = card
		UiKit.Stroke(PINK, 4).Parent = card
		TweenService:Create(card, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(460, 250),
		}):Play()

		local lines = {
			{ Text = "SET SAIL", Color = PINK, Font = Enum.Font.FredokaOne, Height = 52 },
			{ Text = "Voyage #" .. tostring(payload.Rebirths or 1), Color = UiKit.Colors.Text, Font = Enum.Font.GothamBold, Height = 30 },
			{ Text = "Now fishing: " .. tostring(payload.LayerName or "the deep"), Color = UiKit.Colors.Good, Font = Enum.Font.GothamBold, Height = 30 },
			{
				Text = ("+%d%% coins — permanently"):format(tonumber(payload.Bonus) or 0),
				Color = UiKit.Colors.Accent,
				Font = Enum.Font.FredokaOne,
				Height = 40,
			},
			{ Text = "Your fish, collection and areas were kept.", Color = UiKit.Colors.TextDim, Font = Enum.Font.Gotham, Height = 26 },
		}
		local y = 14
		for i, line in lines do
			local label = UiKit.Label({
				Text = line.Text,
				Font = line.Font,
				TextColor3 = line.Color,
				Size = UDim2.new(1, -24, 0, line.Height),
				Position = UDim2.fromOffset(12, y),
				TextTransparency = 1,
				ZIndex = 33,
				Parent = card,
			})
			y += line.Height + 4
			task.delay(0.2 + i * 0.11, function()
				if label.Parent then
					TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
					ping(card, 1.1 + i * 0.18, 0.35)
				end
			end)
		end

		task.delay(4.2, function()
			if overlay.Parent then
				local fade = TweenService:Create(overlay, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
				fade:Play()
				fade.Completed:Wait()
				overlay:Destroy()
			end
			busy = false
		end)
	end)
end

function RebirthFx.Init(screenGui: ScreenGui)
	gui = screenGui
	Remotes.Event("RebirthFx").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			run(payload)
		end
	end)
end

return RebirthFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">ReelMinigame</string>
            <string name="Source"><![CDATA[--!strict
-- The reel-in: the bar that appears when a fish is on.
--
-- A fish darts up and down a vertical bar. You steer a bracket by holding the
-- button — hold to rise, release to fall — and the meter fills while the fish is
-- inside it. Fill the meter and the fish is in the boat.
--
-- One input, so it plays identically with a finger and with a mouse. No aiming,
-- no precision tapping, nothing that needs two hands.
--
-- You cannot lose here. The meter drains while you are off the fish, but it can
-- never end the reel — the only two endings are "filled" and "ran out of time",
-- and both land the fish. How well you tracked it decides the bonus. That is the
-- same rule the rest of the game follows: an input always produces something,
-- and skill produces more.
--
-- It runs entirely on the client because a bar that stutters is worse than no
-- bar at all. The server hands over a difficulty, takes back a quality score,
-- and clamps it — see MiningService for what that trusts and what it doesn't.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Remotes = require(Shared.Remotes)
local State = require(script.Parent.State)
local UiKit = require(script.Parent.UiKit)

local ReelMinigame = {}

local gui: ScreenGui? = nil
local running = false

-- Held anywhere on screen, not just on the bar. Asking a player to keep a finger
-- inside a 40-pixel column while watching a fish move is a dexterity test the
-- rest of this design spent a lot of effort removing.
local holding = false

local function onInputBegan(_input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return
	end
	holding = true
end

local function bar(parent: Instance): (Frame, Frame, Frame, Frame, TextLabel)
	-- Right of centre, anchored to its own middle, and only 260 tall. A 340-tall
	-- bar centred vertically runs into the bottom button row on a short phone,
	-- and a control the player is holding cannot afford to share space with six
	-- buttons that swallow the tap.
	local panel = UiKit.Create("Frame", {
		Name = "Reel",
		Size = UDim2.fromOffset(96, 260),
		Position = UDim2.new(1, -24, 0.5, -30),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = UiKit.Colors.Bg,
		BackgroundTransparency = 0.15,
		Parent = parent,
	})
	UiKit.Corner(16).Parent = panel
	UiKit.Stroke(UiKit.Colors.Accent, 2).Parent = panel

	local label = UiKit.Label({
		Text = "REEL IT IN!",
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 6),
		Parent = panel,
	}) :: TextLabel

	-- The water column the fish swims in
	local track = UiKit.Create("Frame", {
		Name = "Track",
		Size = UDim2.fromOffset(44, 190),
		Position = UDim2.fromOffset(12, 38),
		BackgroundColor3 = Color3.fromRGB(24, 48, 78),
		Parent = panel,
	})
	UiKit.Corner(10).Parent = track
	track.ClipsDescendants = true

	-- The bracket you steer
	local zone = UiKit.Create("Frame", {
		Name = "Zone",
		Size = UDim2.new(1, -6, Balance.ReelZoneSize, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UiKit.Colors.Good,
		BackgroundTransparency = 0.45,
		Parent = track,
	})
	UiKit.Corner(8).Parent = zone
	UiKit.Stroke(UiKit.Colors.Good, 2).Parent = zone

	local fish = UiKit.Create("Frame", {
		Name = "Fish",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 210, 90),
		Parent = track,
	})
	UiKit.Corner(14).Parent = fish
	UiKit.Label({
		Text = "🐟",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = fish,
	})

	-- Progress meter, up the right-hand side
	local meterBack = UiKit.Create("Frame", {
		Name = "MeterBack",
		Size = UDim2.fromOffset(20, 190),
		Position = UDim2.fromOffset(64, 38),
		BackgroundColor3 = Color3.fromRGB(30, 30, 40),
		Parent = panel,
	})
	UiKit.Corner(8).Parent = meterBack
	local meter = UiKit.Create("Frame", {
		Name = "Meter",
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = UiKit.Colors.Good,
		Parent = meterBack,
	})
	UiKit.Corner(8).Parent = meter

	-- The control, stated on the control. A player who does not know that holding
	-- raises the bracket has no way to discover it except by accident, and a
	-- mechanic you have to guess at is a mechanic most players never find.
	UiKit.Label({
		Text = "HOLD to raise",
		Font = Enum.Font.GothamBold,
		TextColor3 = UiKit.Colors.TextDim,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -24),
		Parent = panel,
	})

	return panel, zone, fish, meter, label
end

-- `area` sets how hard the fish fights. Returns the quality of the reel (0..1)
-- and whether the PLAYER steered it rather than Auto-Cast.
local function play(area: number, autoPlay: boolean): (number, boolean)
	local screen = gui
	if not screen then
		return 0, false
	end
	local panel, zone, fish, meter, label = bar(screen)

	local rng = Random.new()
	local speed = Balance.ReelFishSpeed(area)
	local turnEvery = Balance.ReelFishTurn(area)

	local fishAt = 0.5
	local fishTarget = rng:NextNumber(0.1, 0.9)
	local sinceTurn = 0
	local zoneAt = 0.5
	local zoneVel = 0
	local progress = 0
	local elapsed = 0
	local onFish = 0
	-- Set the moment the player gives any input, which hands control back from
	-- Auto-Cast and makes the result theirs rather than the pass's.
	local touched = false

	panel.Size = UDim2.fromOffset(0, 0)
	TweenService:Create(panel, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(96, 260),
	}):Play()

	while progress < 1 and elapsed < Balance.ReelTimeout do
		local dt = RunService.RenderStepped:Wait()
		elapsed += dt

		-- Fish: swims toward a target it re-picks every so often. Deeper water
		-- picks new targets sooner and swims to them faster.
		sinceTurn += dt
		if sinceTurn >= turnEvery then
			sinceTurn = 0
			fishTarget = rng:NextNumber(0.08, 0.92)
		end
		local toTarget = fishTarget - fishAt
		local step = math.min(math.abs(toTarget), speed * dt)
		fishAt += (if toTarget >= 0 then step else -step)
		fishAt = math.clamp(fishAt, 0, 1)

		-- Bracket: hold to rise, release to fall, with drag so it settles.
		--
		-- Auto-Cast steers ONLY while the player isn't. Handing a paying player an
		-- autopilot for the best mechanic in the game would sell them less game
		-- than the free version — the pass exists to remove the repetitive part
		-- (casting, and re-casting, and re-casting), not the fun part. Touch the
		-- screen and you take the wheel back mid-reel, and your result counts as
		-- your own.
		if holding then
			touched = true
		end
		local wantUp = if (autoPlay and not touched) then (fishAt > zoneAt) else holding
		zoneVel += (if wantUp then Balance.ReelRise else -Balance.ReelGravity) * dt
		zoneVel -= zoneVel * math.min(Balance.ReelDrag * dt, 1)
		zoneAt += zoneVel * dt
		if zoneAt <= 0 or zoneAt >= 1 then
			zoneAt = math.clamp(zoneAt, 0, 1)
			zoneVel = 0
		end

		local caught = math.abs(fishAt - zoneAt) <= Balance.ReelZoneSize * 0.5
		if caught then
			onFish += dt
			progress = math.min(progress + Balance.ReelFillRate * dt, 1)
		else
			progress = math.max(progress - Balance.ReelDrainRate * dt, 0)
		end

		-- The UI works in "0 at the top" screen space; the sim works in
		-- "0 at the bottom" water space, because up should mean up.
		fish.Position = UDim2.fromScale(0.5, 1 - fishAt)
		zone.Position = UDim2.fromScale(0.5, 1 - zoneAt)
		zone.BackgroundColor3 = if caught then UiKit.Colors.Good else UiKit.Colors.BgLighter
		meter.Size = UDim2.fromScale(1, progress)
		meter.BackgroundColor3 = if progress > 0.8 then UiKit.Colors.Accent else UiKit.Colors.Good
		label.Text = if caught then "REELING!" else "STAY ON IT!"
		label.TextColor3 = if caught then UiKit.Colors.Good else UiKit.Colors.Accent
	end

	TweenService:Create(panel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.fromOffset(0, 0),
	}):Play()
	task.delay(0.2, function()
		panel:Destroy()
	end)

	-- Quality is the share of the reel spent on the fish. Timing out with the
	-- meter half full still lands the catch; it just is not worth a bonus.
	return math.clamp(if elapsed > 0 then onFish / elapsed else 0, 0, 1), touched
end

function ReelMinigame.Init(screenGui: ScreenGui)
	gui = screenGui

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(function()
		holding = false
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		holding = false
	end)

	Remotes.Event("ReelStart").OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" or running then
			return
		end
		local node = payload.Node
		if typeof(node) ~= "Instance" then
			return
		end
		running = true
		holding = false
		local playerState = State.Get()
		local auto = playerState ~= nil
			and playerState.Passes ~= nil
			and playerState.Passes.AutoCast == true
		local quality, playedIt = play(tonumber(payload.Area) or 1, auto)
		if auto and not playedIt then
			-- Auto-Cast reeled it, not the player: capped at an ordinary standard
			-- whatever the simulated bracket happened to manage. The pass buys
			-- away the work, never the reward for doing it well. A player who
			-- grabbed the wheel mid-reel keeps their own score.
			quality = math.min(quality, Balance.ReelAutoQuality)
		end
		running = false
		Remotes.Event("ReelResult"):FireServer({ Node = node, Quality = quality })
	end)
end

function ReelMinigame.Active(): boolean
	return running
end

return ReelMinigame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">RevealFx</string>
            <string name="Source"><![CDATA[--!strict
-- The reveal engine: anticipation (shaking shell, spreading cracks, rising
-- ticks), burst (shard explosion + screen flash), and celebration extras
-- (confetti, rotating sunburst) for high-tier pulls. Suspense scales with the
-- best rarity in the batch — slot-machine timing, the clip moment.

local TweenService = game:GetService("TweenService")

local RevealFx = {}

-- Theme knobs (the fishing re-theme overrides these)
RevealFx.ShellColor = Color3.fromRGB(130, 95, 60)
RevealFx.ShellStroke = Color3.fromRGB(255, 200, 60)
-- How the shell comes apart. A geode cracks down the middle into two
-- hemispheres; a treasure chest hinges its lid up instead.
RevealFx.SplitVertical = true -- chests hinge their lid open
-- What the shell IS. "Geode" is a round rock; "Chest" is a banded wooden box
-- with a lock. Both use the same clipped-halves machinery — only the shape
-- drawn inside each half differs — because that machinery is the part that was
-- hard to get right (see the no-rotation note further down).
RevealFx.ShellStyle = "Chest"
RevealFx.ChestWood = Color3.fromRGB(122, 80, 44)
RevealFx.ChestDarkWood = Color3.fromRGB(88, 56, 30)
RevealFx.ChestBand = Color3.fromRGB(230, 178, 62)

local TICK_SOUND = "rbxasset://sounds/electronicpingshort.wav"
local THUD_SOUND = "rbxasset://sounds/snap.mp3"

local function play(parent: Instance, id: string, pitch: number, volume: number)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	sound.Parent = parent
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(2, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- Tier-scaled hype: built-in sounds pitched into arpeggios. Commons pop,
-- Rares get a rising triad, Legendary/Mythic get a full fanfare with bass —
-- the reveal should SOUND as big as it looks. {delay, sound, pitch, volume}
local FANFARES: { [number]: { { number } } } = {}
FANFARES[1] = { { 0, 1, 1.0, 0.5 } } :: any
FANFARES[2] = { { 0, 1, 1.15, 0.55 } } :: any
FANFARES[3] = { { 0, 0, 1.0, 0.55 }, { 0.09, 0, 1.26, 0.6 }, { 0.18, 0, 1.5, 0.65 } } :: any
FANFARES[4] = { { 0, 1, 0.6, 0.8 }, { 0.05, 0, 1.0, 0.6 }, { 0.14, 0, 1.26, 0.6 }, { 0.23, 0, 1.5, 0.65 }, { 0.32, 0, 2.0, 0.7 } } :: any
FANFARES[5] = { { 0, 1, 0.5, 0.9 }, { 0.08, 0, 1.0, 0.65 }, { 0.16, 0, 1.26, 0.65 }, { 0.24, 0, 1.5, 0.7 }, { 0.32, 0, 1.68, 0.7 }, { 0.4, 0, 2.0, 0.8 }, { 0.55, 1, 1.4, 0.7 } } :: any
FANFARES[6] = { { 0, 1, 0.4, 1 }, { 0.06, 0, 1.0, 0.7 }, { 0.12, 0, 1.26, 0.7 }, { 0.18, 0, 1.5, 0.7 }, { 0.24, 0, 1.68, 0.75 }, { 0.3, 0, 2.0, 0.8 }, { 0.38, 0, 2.52, 0.85 }, { 0.5, 0, 3.0, 0.9 }, { 0.62, 1, 1.6, 0.8 } } :: any

function RevealFx.Fanfare(parent: Instance, tierRank: number)
	local notes = FANFARES[math.clamp(tierRank, 1, 6)]
	for _, note in notes do
		task.delay(note[1], function()
			if parent.Parent then
				play(parent, note[2] == 1 and THUD_SOUND or TICK_SOUND, note[3], note[4])
			end
		end)
	end
end

export type PlayOptions = {
	Color: Color3, -- tier color for glow/burst
	Suspense: number, -- seconds of shake before the burst
	Charged: boolean, -- extra white charge-up before burst (Epic+)
}

local function tick(parent: Instance, pitch: number)
	play(parent, TICK_SOUND, pitch, 0.35)
end

local GEODE_SIZE = 180

-- The wooden slats, iron bands and lock plate that make the shell read as a
-- treasure chest rather than a brown circle. Drawn onto the full-size shape
-- inside a half, so the clip cuts through them exactly like it cuts the box.
-- `isLid` gets the curved top and the keyhole; the base gets the feet.
local function dressAsChest(box: Frame, isLid: boolean)
	box.BackgroundColor3 = RevealFx.ChestWood
	local corner = box:FindFirstChildOfClass("UICorner")
	if corner then
		-- A chest has a rounded lid and a square base. One radius for the whole
		-- box is close enough at this size and keeps it one frame.
		corner.CornerRadius = UDim.new(0, if isLid then 34 else 10)
	end

	-- Plank seams: darker horizontal lines across the wood.
	for i = 1, 3 do
		local plank = Instance.new("Frame")
		plank.AnchorPoint = Vector2.new(0.5, 0.5)
		plank.Position = UDim2.fromScale(0.5, 0.22 + (i - 1) * 0.26)
		plank.Size = UDim2.new(1, 0, 0, 3)
		plank.BackgroundColor3 = RevealFx.ChestDarkWood
		plank.BorderSizePixel = 0
		plank.ZIndex = 3
		plank.Parent = box
	end

	-- Iron bands: two vertical straps holding the box together, which is the
	-- detail that says "chest" fastest at a glance.
	for _, at in { 0.22, 0.78 } do
		local band = Instance.new("Frame")
		band.AnchorPoint = Vector2.new(0.5, 0.5)
		band.Position = UDim2.fromScale(at, 0.5)
		band.Size = UDim2.new(0, 16, 1, 0)
		band.BackgroundColor3 = RevealFx.ChestBand
		band.BorderSizePixel = 0
		band.ZIndex = 4
		band.Parent = box
	end

	-- The lock: a gold plate straddling the seam, with a dark keyhole.
	local plate = Instance.new("Frame")
	plate.AnchorPoint = Vector2.new(0.5, 0.5)
	plate.Position = UDim2.fromScale(0.5, if isLid then 0.94 else 0.06)
	plate.Size = UDim2.fromOffset(40, 34)
	plate.BackgroundColor3 = RevealFx.ChestBand
	plate.BorderSizePixel = 0
	plate.ZIndex = 5
	plate.Parent = box
	local plateCorner = Instance.new("UICorner")
	plateCorner.CornerRadius = UDim.new(0, 6)
	plateCorner.Parent = plate
	if not isLid then
		local keyhole = Instance.new("Frame")
		keyhole.AnchorPoint = Vector2.new(0.5, 0.5)
		keyhole.Position = UDim2.fromScale(0.5, 0.6)
		keyhole.Size = UDim2.fromOffset(9, 13)
		keyhole.BackgroundColor3 = Color3.fromRGB(40, 28, 16)
		keyhole.BorderSizePixel = 0
		keyhole.ZIndex = 6
		keyhole.Parent = plate
		local keyCorner = Instance.new("UICorner")
		keyCorner.CornerRadius = UDim.new(0, 4)
		keyCorner.Parent = keyhole
	end
end

-- One half of the shell: a clipped frame showing exactly half of the shape, so
-- the two of them sit flush as one object until they come apart. `isFirst` is
-- the left half when splitting sideways, the LID when hinging.
local function makeHalf(parent: Frame, isFirst: boolean): Frame
	local vertical = RevealFx.SplitVertical
	local half = Instance.new("Frame")
	half.AnchorPoint = Vector2.new(0.5, 0.5)
	half.Size = if vertical
		then UDim2.fromOffset(GEODE_SIZE, GEODE_SIZE // 2)
		else UDim2.fromOffset(GEODE_SIZE // 2, GEODE_SIZE)
	local shift = if isFirst then -GEODE_SIZE // 4 else GEODE_SIZE // 4
	half.Position = UDim2.fromScale(0.5, 0.5)
		+ (if vertical then UDim2.fromOffset(0, shift) else UDim2.fromOffset(shift, 0))
	half.BackgroundTransparency = 1
	half.ClipsDescendants = true
	half.ZIndex = 3
	half.Parent = parent

	-- The full shape, offset so the clip leaves exactly the wanted half
	local back = if isFirst then 0 else -GEODE_SIZE // 2
	local rock = Instance.new("Frame")
	rock.Name = "Rock"
	rock.Size = UDim2.fromOffset(GEODE_SIZE, GEODE_SIZE)
	rock.Position = if vertical then UDim2.fromOffset(0, back) else UDim2.fromOffset(back, 0)
	rock.BackgroundColor3 = RevealFx.ShellColor
	rock.BorderSizePixel = 0
	rock.ZIndex = 3
	rock.Parent = half
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = rock
	local stroke = Instance.new("UIStroke")
	stroke.Color = RevealFx.ShellStroke
	stroke.Thickness = 5
	stroke.Parent = rock

	if RevealFx.ShellStyle == "Chest" then
		dressAsChest(rock, isFirst)
	end

	return half
end

-- Anticipation, split, reveal. Calls onBurst once the halves are open, then
-- cleans up its own instances (everything is parented to `overlay`, which the
-- caller destroys when the reveal closes).
function RevealFx.Play(overlay: Frame, options: PlayOptions, onBurst: () -> ())
	local center = UDim2.fromScale(0.5, 0.42)

	-- Glow behind the geode, building in tier colour
	local glow = Instance.new("Frame")
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = center
	glow.Size = UDim2.fromOffset(120, 120)
	glow.BackgroundColor3 = options.Color
	glow.BackgroundTransparency = 0.85
	glow.Parent = overlay
	local glowCorner = Instance.new("UICorner")
	glowCorner.CornerRadius = UDim.new(1, 0)
	glowCorner.Parent = glow
	TweenService:Create(
		glow,
		TweenInfo.new(options.Suspense, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Size = UDim2.fromOffset(340, 340), BackgroundTransparency = 0.45 }
	):Play()

	-- The geode: a container holding the crystal interior and two rock halves
	-- that sit flush over it.
	local geode = Instance.new("Frame")
	geode.AnchorPoint = Vector2.new(0.5, 0.5)
	geode.Position = center
	geode.Size = UDim2.fromOffset(0, 0)
	geode.BackgroundTransparency = 1
	geode.Parent = overlay
	TweenService:Create(geode, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(GEODE_SIZE, GEODE_SIZE),
	}):Play()

	-- Crystal-lined interior, hidden under the halves until they open
	local interior = Instance.new("Frame")
	interior.AnchorPoint = Vector2.new(0.5, 0.5)
	interior.Position = UDim2.fromScale(0.5, 0.5)
	interior.Size = UDim2.fromOffset(GEODE_SIZE - 18, GEODE_SIZE - 18)
	interior.BackgroundColor3 = options.Color
	interior.BackgroundTransparency = 0.1
	interior.ZIndex = 2
	interior.Parent = geode
	local interiorCorner = Instance.new("UICorner")
	interiorCorner.CornerRadius = UDim.new(1, 0)
	interiorCorner.Parent = interior

	local fillRng = Random.new(7)
	if RevealFx.ShellStyle == "Chest" then
		interiorCorner.CornerRadius = UDim.new(0, 12)
		-- A chest is full of treasure, not lined with rock. Coins heaped toward
		-- the bottom so the pile has a shape instead of being scattered evenly.
		for i = 1, 22 do
			local coin = Instance.new("Frame")
			coin.AnchorPoint = Vector2.new(0.5, 0.5)
			local size = fillRng:NextInteger(14, 26)
			coin.Position = UDim2.fromScale(
				fillRng:NextNumber(0.14, 0.86),
				fillRng:NextNumber(0.42, 0.9) + fillRng:NextNumber(0, 0.08)
			)
			coin.Size = UDim2.fromOffset(size, size)
			coin.Rotation = fillRng:NextInteger(0, 179)
			coin.BackgroundColor3 = if i % 4 == 0
				then Color3.new(1, 1, 1):Lerp(options.Color, 0.5)
				else RevealFx.ChestBand:Lerp(Color3.new(1, 1, 1), fillRng:NextNumber(0, 0.35))
			coin.BorderSizePixel = 0
			coin.ZIndex = 2
			coin.Parent = interior
			local coinCorner = Instance.new("UICorner")
			coinCorner.CornerRadius = UDim.new(1, 0)
			coinCorner.Parent = coin
		end
	else
		-- Crystal teeth lining the cavity, so the open geode is jagged rather
		-- than a plain coloured disc.
		for i = 1, 14 do
			local angle = (i / 14) * math.pi * 2
			local tooth = Instance.new("Frame")
			tooth.AnchorPoint = Vector2.new(0.5, 0.5)
			tooth.Position = UDim2.new(0.5, math.cos(angle) * 62, 0.5, math.sin(angle) * 62)
			tooth.Size = UDim2.fromOffset(fillRng:NextInteger(10, 18), fillRng:NextInteger(22, 40))
			tooth.Rotation = math.deg(angle) + 90
			tooth.BackgroundColor3 = Color3.new(1, 1, 1):Lerp(options.Color, 0.55)
			tooth.BackgroundTransparency = 0.15
			tooth.BorderSizePixel = 0
			tooth.ZIndex = 2
			tooth.Parent = interior
		end
	end

	local firstHalf = makeHalf(geode, true) -- left, or the lid when hinged
	local secondHalf = makeHalf(geode, false)

	-- The seam the crack runs along before it splits
	local seam = Instance.new("Frame")
	seam.AnchorPoint = Vector2.new(0.5, 0.5)
	seam.Position = UDim2.fromScale(0.5, 0.5)
	seam.Size = if RevealFx.SplitVertical then UDim2.fromOffset(GEODE_SIZE, 0) else UDim2.fromOffset(0, GEODE_SIZE)
	seam.BackgroundColor3 = Color3.new(1, 1, 1)
	seam.BackgroundTransparency = 1
	seam.BorderSizePixel = 0
	seam.ZIndex = 4
	seam.Parent = geode

	task.spawn(function()
		task.wait(0.3)
		local rng = Random.new()
		local elapsed = 0
		local crackCount = 0
		local step = 0.045
		while elapsed < options.Suspense do
			task.wait(step)
			elapsed += step
			local progress = elapsed / options.Suspense
			local amplitude = 2 + progress * 12
			geode.Position = center
				+ UDim2.fromOffset(rng:NextInteger(-amplitude, amplitude), rng:NextInteger(-amplitude, amplitude))
			geode.Rotation = rng:NextNumber(-progress * 8, progress * 8)

			-- The fracture walks down the seam in jagged segments, with rising
			-- ticks — five milestones, so the pacing scales with suspense.
			local wantedCracks = math.floor(progress * 5)
			if wantedCracks > crackCount then
				crackCount = wantedCracks
				local along = (crackCount - 0.5) / 5
				local jitter = rng:NextInteger(-8, 8)
				local crack = Instance.new("Frame")
				crack.AnchorPoint = Vector2.new(0.5, 0.5)
				crack.Position = if RevealFx.SplitVertical
					then UDim2.new(along, 0, 0.5, jitter)
					else UDim2.new(0.5, jitter, along, 0)
				crack.Size = if RevealFx.SplitVertical
					then UDim2.fromOffset(GEODE_SIZE // 5 + 8, rng:NextInteger(3, 6))
					else UDim2.fromOffset(rng:NextInteger(3, 6), GEODE_SIZE // 5 + 8)
				crack.Rotation = rng:NextInteger(-14, 14)
				crack.BackgroundColor3 = Color3.new(1, 1, 1)
				crack.BackgroundTransparency = 0.15
				crack.BorderSizePixel = 0
				crack.ZIndex = 4
				crack.Parent = geode
				tick(overlay, 0.9 + crackCount * 0.12)
			end
		end

		-- Light leaking from the seam just before it gives: the tell that
		-- something bright is inside.
		seam.BackgroundTransparency = 0.2
		local gap = options.Charged and 26 or 12
		TweenService:Create(seam, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = if RevealFx.SplitVertical
				then UDim2.fromOffset(GEODE_SIZE, gap)
				else UDim2.fromOffset(gap, GEODE_SIZE),
		}):Play()
		if options.Charged then
			for _, half in { firstHalf, secondHalf } do
				local rock = half:FindFirstChild("Rock")
				if rock and rock:IsA("Frame") then
					TweenService:Create(rock, TweenInfo.new(0.3), { BackgroundColor3 = Color3.new(1, 1, 1) }):Play()
				end
			end
			task.wait(0.3)
		else
			task.wait(0.12)
		end

		-- SPLIT: the halves crack apart and tumble away, showing the cavity
		geode.Rotation = 0
		geode.Position = center
		play(overlay, THUD_SOUND, 0.75, 0.8)
		tick(overlay, 0.6)

		-- Sideways: both hemispheres fly apart. Hinged: the lid lifts up and back
		-- while the base only settles.
		--
		-- Position only, no spin. Each half is a clipped frame showing one half of
		-- a circle, and Roblox stops clipping any subtree that carries a rotation —
		-- so rotating a half mid-flight turned it back into a whole circle. Waiting
		-- until it had faded to rotate it just made the spin invisible, which is
		-- worse than not having it: the Back-eased fling, the flash and the shards
		-- already sell the break.
		local splitInfo = TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		local firstTarget, secondTarget
		if RevealFx.SplitVertical then
			firstTarget = UDim2.fromOffset(-20, -210)
			secondTarget = UDim2.fromOffset(10, 110)
		else
			firstTarget = UDim2.fromOffset(-260, 90)
			secondTarget = UDim2.fromOffset(260, 70)
		end
		TweenService:Create(firstHalf, splitInfo, {
			Position = UDim2.fromScale(0.5, 0.5) + firstTarget,
		}):Play()
		TweenService:Create(secondHalf, splitInfo, {
			Position = UDim2.fromScale(0.5, 0.5) + secondTarget,
		}):Play()
		for _, half in { firstHalf, secondHalf } do
			local rock = half:FindFirstChild("Rock")
			if rock and rock:IsA("Frame") then
				TweenService:Create(rock, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
				local rockStroke = rock:FindFirstChildOfClass("UIStroke")
				if rockStroke then
					TweenService:Create(rockStroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
			end
		end
		TweenService:Create(seam, TweenInfo.new(0.35), {
			Size = UDim2.fromOffset(GEODE_SIZE, GEODE_SIZE),
			BackgroundTransparency = 1,
		}):Play()

		-- Flash + shards thrown from the break
		local flash = Instance.new("Frame")
		flash.Size = UDim2.fromScale(1, 1)
		flash.BackgroundColor3 = Color3.new(1, 1, 1)
		flash.BackgroundTransparency = 0.25
		flash.BorderSizePixel = 0
		flash.ZIndex = 5
		flash.Parent = overlay
		TweenService:Create(flash, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.delay(0.45, function()
			flash:Destroy()
		end)

		for _ = 1, 14 do
			local shard = Instance.new("Frame")
			shard.AnchorPoint = Vector2.new(0.5, 0.5)
			shard.Position = center
			local size = rng:NextInteger(10, 26)
			shard.Size = UDim2.fromOffset(size, size)
			shard.Rotation = rng:NextInteger(0, 89)
			shard.BackgroundColor3 = if rng:NextNumber() < 0.5 then RevealFx.ShellColor else options.Color
			shard.BorderSizePixel = 0
			shard.Parent = overlay
			local shardCorner = Instance.new("UICorner")
			shardCorner.CornerRadius = UDim.new(0, 4)
			shardCorner.Parent = shard
			local angle = rng:NextNumber(0, math.pi * 2)
			local distance = rng:NextInteger(140, 280)
			TweenService:Create(shard, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = center + UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance - 40),
				Rotation = shard.Rotation + rng:NextInteger(-180, 180),
				BackgroundTransparency = 1,
			}):Play()
			task.delay(0.6, function()
				shard:Destroy()
			end)
		end

		-- The open cavity blooms for a beat, then clears for the cards. Fade
		-- every piece rather than shrinking the container: the teeth and cracks
		-- are sized in offsets, so they would hang around at full size while
		-- their parent collapsed to nothing.
		TweenService:Create(interior, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(GEODE_SIZE + 40, GEODE_SIZE + 40),
		}):Play()
		task.delay(0.3, function()
			for _, descendant in geode:GetDescendants() do
				if descendant:IsA("Frame") then
					TweenService:Create(descendant, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
				end
			end
			task.delay(0.4, function()
				geode:Destroy()
			end)
		end)
		TweenService:Create(glow, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()

		task.wait(0.28)
		onBurst()
	end)
end

-- Falling confetti for Epic+ pulls.
function RevealFx.Confetti(overlay: Frame, tierColor: Color3, count: number)
	local rng = Random.new()
	local palette = { tierColor, Color3.fromRGB(255, 210, 90), Color3.fromRGB(120, 255, 200), Color3.fromRGB(255, 150, 220) }
	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.new(rng:NextNumber(0.1, 0.9), 0, 0, -20)
		piece.Size = UDim2.fromOffset(rng:NextInteger(6, 11), rng:NextInteger(6, 11))
		piece.Rotation = rng:NextInteger(0, 179)
		piece.BackgroundColor3 = palette[rng:NextInteger(1, #palette)]
		piece.BorderSizePixel = 0
		piece.Parent = overlay
		TweenService:Create(piece, TweenInfo.new(rng:NextNumber(1.1, 1.9), Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + rng:NextNumber(-0.08, 0.08), 0, 1.1, 0),
			Rotation = piece.Rotation + rng:NextInteger(-360, 360),
		}):Play()
		task.delay(2, function()
			piece:Destroy()
		end)
	end
end

-- Slowly rotating sunburst rays behind a Legendary/Mythic card.
function RevealFx.Sunburst(overlay: Frame, position: UDim2, color: Color3): Frame
	local container = Instance.new("Frame")
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = position
	container.Size = UDim2.fromOffset(0, 0)
	container.BackgroundTransparency = 1
	container.ZIndex = 0
	container.Parent = overlay
	for i = 1, 8 do
		local ray = Instance.new("Frame")
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.fromOffset(340, 26)
		ray.Rotation = i * 22.5
		ray.BackgroundColor3 = color
		ray.BackgroundTransparency = 0.82
		ray.BorderSizePixel = 0
		ray.ZIndex = 0
		ray.Parent = container
	end
	TweenService:Create(
		container,
		TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
		{ Rotation = 360 }
	):Play()
	return container
end

return RevealFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ScreenManager</string>
            <string name="Source"><![CDATA[--!strict
-- One modal screen open at a time; screens register a panel + optional OnOpen.

local ScreenManager = {}

type Entry = { Panel: Frame, OnOpen: (() -> ())? }

local screens: { [string]: Entry } = {}
local openName: string? = nil

function ScreenManager.Register(name: string, panel: Frame, closeButton: TextButton, onOpen: (() -> ())?)
	screens[name] = { Panel = panel, OnOpen = onOpen }
	closeButton.Activated:Connect(function()
		ScreenManager.Close()
	end)
end

function ScreenManager.Open(name: string)
	local entry = screens[name]
	if not entry then
		return
	end
	for otherName, other in screens do
		other.Panel.Visible = otherName == name
	end
	openName = name
	if entry.OnOpen then
		entry.OnOpen()
	end
end

function ScreenManager.Close()
	for _, entry in screens do
		entry.Panel.Visible = false
	end
	openName = nil
end

function ScreenManager.Toggle(name: string)
	if openName == name then
		ScreenManager.Close()
	else
		ScreenManager.Open(name)
	end
end

function ScreenManager.IsOpen(name: string): boolean
	return openName == name
end

return ScreenManager
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="50">
          <Properties>
            <string name="Name">Screens</string>
          </Properties>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">CrackScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Crack Station: live odds panel (always visible — the compliance surface AND
-- a trust feature) + the multi-phase reveal, the game's engineered clip moment.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crystals = require(Shared.Config.Crystals)
local Format = require(Shared.Format)
local RarityMath = require(Shared.RarityMath)
local Remotes = require(Shared.Remotes)
local GemView = require(script.Parent.Parent.GemView)
local Purchase = require(script.Parent.Parent.Purchase)
local RevealFx = require(script.Parent.Parent.RevealFx)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local Toasts = require(script.Parent.Parent.Toasts)
local UiKit = require(script.Parent.Parent.UiKit)
local WorldFx = require(script.Parent.Parent.WorldFx)

local CrackScreen = {}

local oddsList: ScrollingFrame? = nil
local geodeLabel: TextLabel? = nil
local revealGui: ScreenGui? = nil
local currentOverlay: Frame? = nil
local cracking = false

-- Suspense seconds by best tier in the batch (rarer = longer shake)
local SUSPENSE = {
	Common = 0.7,
	Uncommon = 0.8,
	Rare = 1.1,
	Epic = 1.5,
	Legendary = 2.0,
	Mythic = 2.4,
}

local function tierRank(tier: string): number
	for i, name in Crystals.Tiers do
		if name == tier then
			return i
		end
	end
	return 1
end

-- The flex line. Same numbers as the odds panel, multiplied out: "1 in 12,500"
-- is the thing players screenshot and paste into a group chat. Only shown when
-- the pull was genuinely long odds, so it never becomes wallpaper.
local function oddsBrag(crystal: { [string]: any }): string?
	local state = State.Get()
	if not state then
		return nil
	end
	if crystal.Pity then
		return nil -- the first-session guaranteed Rare+ beat no odds at all
	end
	-- Quote the pool this thing actually came out of. Every card on this screen
	-- came out of a chest, so that is the relic table — telling a player their
	-- Sunken Crown beat the odds on a mackerel would be a made-up number.
	local pool = if Crystals.IsRelic(crystal.Base) then Crystals.RELIC else Crystals.FISH
	local baseChance = 0
	for _, entry in RarityMath.GetBaseOdds(state.Layer, state.LuckMult, pool) do
		if entry.Name == crystal.Base then
			baseChance = entry.Chance
		end
	end
	local mutChance = 100
	for _, entry in RarityMath.GetMutationOdds(state.MutationMult) do
		if entry.Name == crystal.Mut then
			mutChance = entry.Chance
		end
	end
	local probability = (baseChance / 100) * (mutChance / 100)
	if probability <= 0 then
		return nil
	end
	local oneIn = math.floor(1 / probability + 0.5)
	if oneIn < 40 then
		return nil
	end
	return "1 in " .. Format.Number(oneIn)
end

-- Mythic pulls get a colour cycling around the card border. Costs one gradient.
local function rainbowStroke(stroke: UIStroke)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 220, 90)),
		ColorSequenceKeypoint.new(0.7, Color3.fromRGB(120, 255, 200)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 120, 255)),
	})
	gradient.Parent = stroke
	task.spawn(function()
		while gradient.Parent do
			TweenService:Create(gradient, TweenInfo.new(2.4, Enum.EasingStyle.Linear), { Rotation = 360 }):Play()
			task.wait(2.4)
			if gradient.Parent then
				gradient.Rotation = 0
			end
		end
	end)
end

local function renderOdds()
	local state = State.Get()
	if not state or not oddsList then
		return
	end
	UiKit.Clear(oddsList)
	local order = 0
	local function addRow(text: string, color: Color3, bold: boolean?)
		order += 1
		UiKit.Create("TextLabel", {
			Text = text,
			Font = bold and Enum.Font.FredokaOne or Enum.Font.GothamBold,
			TextColor3 = color,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -6, 0, bold and 26 or 22),
			LayoutOrder = order,
			Parent = oddsList,
		})
	end
	-- This is the CHEST station's panel, so it must publish what is in a chest.
	addRow(("Relic odds (Luck x%.2f)"):format(state.LuckMult), UiKit.Colors.Accent, true)
	for _, entry in RarityMath.GetBaseOdds(state.Layer, state.LuckMult, Crystals.RELIC) do
		addRow(entry.Name .. "  —  " .. Format.Percent(entry.Chance), entry.Color)
	end
	addRow("Aura odds", UiKit.Colors.Accent, true)
	for _, entry in RarityMath.GetMutationOdds(state.MutationMult) do
		addRow(entry.Name .. "  —  " .. Format.Percent(entry.Chance), entry.Color)
	end
	local layout = oddsList:FindFirstChildOfClass("UIListLayout")
	if layout then
		oddsList.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 10)
	end
end

local function makeCard(
	overlay: Frame,
	crystal: { [string]: any },
	position: UDim2,
	cardWidth: number,
	handledIds: { [string]: boolean },
	onHandled: () -> (),
	previousBest: number
): Frame
	local tierColor = Crystals.TierColors[crystal.Tier] or UiKit.Colors.Text
	local baseDef = Crystals.GetBase(crystal.Base)
	local rank = tierRank(crystal.Tier)
	local card = UiKit.Create("Frame", {
		Size = UDim2.fromOffset(cardWidth, 292),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UiKit.Colors.Bg,
		ZIndex = 2,
		Parent = overlay,
	})
	UiKit.Corner(16).Parent = card
	local cardStroke = UiKit.Stroke(tierColor, 4)
	cardStroke.Parent = card
	if rank >= 6 then
		rainbowStroke(cardStroke)
	elseif rank >= 5 then
		-- Legendary borders breathe, so the good card is obvious in a row of three
		TweenService:Create(
			cardStroke,
			TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Thickness = 8 }
		):Play()
	end

	-- The rock itself, in 3D, turning
	GemView.Create({
		Parent = card,
		Size = UDim2.fromOffset(112, 104),
		Position = UDim2.new(0.5, -56, 0, 12),
		Color = baseDef and baseDef.Color or tierColor,
		Seed = #crystal.Base * 17 + #crystal.Mut,
		Spin = 0.8 + rank * 0.16,
		ZIndex = 2,
		Name = crystal.Base,
	})

	local mutPrefix = crystal.Mut ~= "Normal" and (crystal.Mut .. " ") or ""
	UiKit.Label({
		Text = mutPrefix .. crystal.Base,
		TextColor3 = UiKit.Colors.Text,
		Font = Enum.Font.FredokaOne,
		Size = UDim2.new(1, -12, 0, 34),
		Position = UDim2.fromOffset(6, 120),
		ZIndex = 2,
		Parent = card,
	})
	UiKit.Label({
		Text = crystal.Tier,
		TextColor3 = tierColor,
		Size = UDim2.new(1, -12, 0, 26),
		Position = UDim2.fromOffset(6, 154),
		ZIndex = 2,
		Parent = card,
	})
	-- Relics have no weight — you do not brag about a heavy doubloon — so the
	-- pounds only appear on things that were actually swimming.
	UiKit.Label({
		Text = if Crystals.IsRelic(crystal.Base)
			then ("Value: %s"):format(Format.Number(crystal.Value))
			else ("Value: %s   •   %.1f lb"):format(Format.Number(crystal.Value), crystal.Weight or 0),
		TextColor3 = UiKit.Colors.Accent,
		Size = UDim2.new(1, -12, 0, 26),
		Position = UDim2.fromOffset(6, 182),
		ZIndex = 2,
		Parent = card,
	})

	-- Two brag lines, both earned rather than decorative: the true odds you beat,
	-- and whether this is the best thing you have ever pulled. `crystal.Best` is
	-- the server's own weight record, so a heaviest-ever bass gets the callout
	-- even when a Mythic elsewhere in your collection is worth more coins.
	local brag = oddsBrag(crystal)
	local isBest = crystal.Best == true or (crystal.Value > previousBest and previousBest > 0)
	UiKit.Label({
		Text = if crystal.Best == true
			then ("★ HEAVIEST %s YET ★"):format(string.upper(crystal.Base))
			elseif isBest then "★ NEW PERSONAL BEST ★"
			else (brag or ""),
		Font = Enum.Font.FredokaOne,
		TextColor3 = isBest and Color3.fromRGB(255, 230, 120) or UiKit.Colors.TextDim,
		Size = UDim2.new(1, -12, 0, 22),
		Position = UDim2.fromOffset(6, 210),
		ZIndex = 2,
		Parent = card,
	})

	-- Per-crystal choice, right on the card: sell it or socket it on a rack.
	local function cardButton(text: string, color: Color3, x: number): TextButton
		local button = UiKit.Create("TextButton", {
			Text = text,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(25, 22, 18),
			BackgroundColor3 = color,
			Size = UDim2.fromOffset(cardWidth // 2 - 14, 30),
			Position = UDim2.fromOffset(x, 250),
			ZIndex = 3,
			Parent = card,
		})
		UiKit.Corner(8).Parent = button
		return button
	end
	local sellButton = cardButton("Sell", UiKit.Colors.Buy, 8)
	local socketButton = cardButton("Display", UiKit.Colors.Good, cardWidth // 2 + 6)
	-- The server call yields, so lock BEFORE invoking — otherwise a fast
	-- double-tap (or tapping both buttons) can double-render the done state.
	local busy = false
	-- Overlap-proof by construction: the Sell button ITSELF becomes the status
	-- text (one instance mutated in place — nothing new is ever added at these
	-- coordinates, so no race can double-render).
	local function markDone(text: string)
		handledIds[crystal.Id] = true
		if socketButton.Parent then
			socketButton:Destroy()
		end
		sellButton.Active = false
		sellButton.AutoButtonColor = false
		sellButton.BackgroundTransparency = 1
		sellButton.Font = Enum.Font.GothamBold
		sellButton.TextColor3 = UiKit.Colors.TextDim
		sellButton.Text = text
		sellButton.Size = UDim2.new(1, -16, 0, 26)
		sellButton.Position = UDim2.fromOffset(8, 252)
		onHandled()
	end
	sellButton.Activated:Connect(function()
		if busy or handledIds[crystal.Id] then
			return
		end
		busy = true
		local ok, err = Remotes.Function("SellCrystal"):InvokeServer(crystal.Id)
		if ok then
			markDone("Sold  (+" .. Format.Number(crystal.Value) .. ")")
		else
			busy = false
			if typeof(err) == "string" then
				Toasts.Push(err, UiKit.Colors.Bad)
			end
		end
	end)
	socketButton.Activated:Connect(function()
		if busy or handledIds[crystal.Id] then
			return
		end
		busy = true
		local ok, err = Remotes.Function("SocketCrystal"):InvokeServer(crystal.Id)
		if ok then
			markDone("Displayed!")
		else
			busy = false
			if typeof(err) == "string" then
				Toasts.Push(err, UiKit.Colors.Bad)
			end
		end
	end)
	-- A new index entry always carries the count with it: an unfinished set is
	-- the strongest reason to crack one more.
	if crystal.New then
		local state = State.Get()
		local caption = "NEW!"
		if state and state.TotalIndex then
			caption = ("NEW!  %d/%d"):format(state.CollectionCount, state.TotalIndex)
		end
		local badge = UiKit.Create("TextLabel", {
			Text = caption,
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(30, 26, 20),
			BackgroundColor3 = UiKit.Colors.Good,
			Rotation = -12,
			Size = UDim2.fromOffset(96, 30),
			-- Inside the top edge, not straddling it: at 375-height the card top
			-- sits at y=11 and half the badge was clipped off screen.
			Position = UDim2.new(1, -56, 0, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 3,
			Parent = card,
		})
		UiKit.Corner(8).Parent = badge
		badge.Size = UDim2.fromOffset(0, 0)
		TweenService:Create(
			badge,
			TweenInfo.new(0.35, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, 0, false, 0.2),
			{ Size = UDim2.fromOffset(96, 30) }
		):Play()
	end

	-- pop in
	card.Size = UDim2.fromOffset(0, 0)
	TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(cardWidth, 292),
	}):Play()
	return card
end

local function showReveal(results: { { [string]: any } }, previousBest: number)
	if not revealGui then
		return
	end
	-- One reveal at a time: close any previous overlay, and make this one
	-- Active so clicks can't pass through to CRACK!/mining behind it —
	-- overlays stacking from through-clicks was the double-render bug.
	if currentOverlay and currentOverlay.Parent then
		currentOverlay:Destroy()
	end
	local overlay = UiKit.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Active = true,
		Parent = revealGui,
	})
	currentOverlay = overlay
	-- Hold any rare-find callout addressed to us until this closes: on a phone
	-- there is no band that clears both the card block and its button row.
	Toasts.SetRevealOpen(true)
	overlay.Destroying:Once(function()
		if currentOverlay == overlay then
			currentOverlay = nil
		end
		Toasts.SetRevealOpen(false)
	end)

	local bestTier = "Common"
	local bestIndex = 1
	for i, crystal in results do
		if tierRank(crystal.Tier) > tierRank(bestTier) then
			bestTier = crystal.Tier
			bestIndex = i
		end
	end
	local bestColor = Crystals.TierColors[bestTier] or UiKit.Colors.Accent
	local bestRank = tierRank(bestTier)

	local cardWidth = 200
	local totalWidth = #results * cardWidth + (#results - 1) * 16
	local handledIds: { [string]: boolean } = {}

	-- Sell All stays live: recomputed from unhandled cards, hidden when empty.
	-- Once every card is handled there is nothing left to decide, so the
	-- reveal closes itself after a beat.
	local sellAllRef: TextButton? = nil
	local function refreshSellAll()
		local remaining = 0
		local unhandled = 0
		for _, crystal in results do
			if not handledIds[crystal.Id] then
				unhandled += 1
				remaining += crystal.Value
			end
		end
		local button = sellAllRef
		if button then
			button.Visible = remaining > 0
			if remaining > 0 then
				button.Text = "Sell All  (+" .. Format.Number(remaining) .. ")"
			end
		end
		if unhandled == 0 then
			task.delay(0.75, function()
				if overlay.Parent then
					overlay:Destroy()
				end
			end)
		end
	end

	RevealFx.Play(overlay, {
		Color = bestColor,
		Suspense = SUSPENSE[bestTier] or 1,
		Charged = bestRank >= 4,
	}, function()
		-- Celebration extras land with the burst
		RevealFx.Fanfare(overlay, bestRank)
		-- The whole screen kicks, scaled to what you pulled
		WorldFx.Shake(0.5 + bestRank * 0.45)
		if bestRank >= 4 then
			RevealFx.Confetti(overlay, bestColor, bestRank >= 5 and 36 or 20)
		end
		-- The server rolls a batch sequentially, so its record climbs as it goes.
		-- Comparing every card against the same pre-crack snapshot let a 300 and
		-- a 500 in one triple crack both claim the personal best.
		local runningBest = previousBest
		for i, crystal in results do
			local position = UDim2.new(0.5, -totalWidth // 2 + (i - 1) * (cardWidth + 16) + cardWidth // 2, 0.42, 0)
			if i == bestIndex and bestRank >= 5 then
				RevealFx.Sunburst(overlay, position, bestColor)
			end
			local bestBefore = runningBest
			runningBest = math.max(runningBest, crystal.Value)
			task.delay((i - 1) * 0.18, function()
				if overlay.Parent then
					makeCard(overlay, crystal, position, cardWidth, handledIds, refreshSellAll, bestBefore)
				end
			end)
		end

		task.delay(#results * 0.18 + 0.3, function()
			if not overlay.Parent then
				return
			end
			-- Below the cards, but never off the bottom of the screen. Cards are
			-- 292 tall centred at 0.42, so 0.42H+162 clears them — except on a
			-- short phone, where that offset falls past the viewport entirely.
			local height = overlay.AbsoluteSize.Y
			local rowY = if height > 0 then math.min(0.42 * height + 162, height - 58) else 0
			local sellAll = UiKit.Button({
				Text = "Sell All",
				BackgroundColor3 = UiKit.Colors.Buy,
				Size = UDim2.fromOffset(220, 48),
				Position = UDim2.new(0.5, -232, 0, rowY),
				Parent = overlay,
			})
			sellAll.ZIndex = 4
			sellAllRef = sellAll
			refreshSellAll()
			local keepAll = UiKit.Button({
				Text = "Keep",
				BackgroundColor3 = UiKit.Colors.BgLighter,
				TextColor3 = UiKit.Colors.Text,
				Size = UDim2.fromOffset(160, 48),
				Position = UDim2.new(0.5, 12, 0, rowY),
				Parent = overlay,
			})
			keepAll.ZIndex = 4
			sellAll.Activated:Connect(function()
				for _, crystal in results do
					if not handledIds[crystal.Id] then
						Remotes.Function("SellCrystal"):InvokeServer(crystal.Id)
					end
				end
				overlay:Destroy()
			end)
			keepAll.Activated:Connect(function()
				overlay:Destroy()
			end)
		end)
	end)
end

local function crack(count: number)
	if cracking then
		return
	end
	cracking = true
	-- Snapshot the record BEFORE the server updates it, or every pull would
	-- claim to be a personal best.
	local state = State.Get()
	local previousBest = (state and state.Stats and state.Stats.RarestValue) or 0
	local results, err = Remotes.Function("CrackGeode"):InvokeServer(count)
	cracking = false
	if not results then
		if err then
			Toasts.Push(err, UiKit.Colors.Bad)
		end
		return
	end
	showReveal(results, previousBest)
end

function CrackScreen.Init(gui: ScreenGui)
	revealGui = UiKit.Create("ScreenGui", {
		Name = "RevealGui",
		ResetOnSpawn = false,
		DisplayOrder = 50,
		IgnoreGuiInset = true,
		Parent = gui.Parent,
	}) :: ScreenGui

	local panel, content, close = UiKit.Panel(gui, "Treasure Chests", UDim2.fromScale(0.66, 0.74))

	local odds = UiKit.Create("ScrollingFrame", {
		Size = UDim2.new(0.46, 0, 1, 0),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.fromOffset(0, 0),
		Parent = content,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = odds
	UiKit.Pad(8).Parent = odds
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = odds
	oddsList = odds

	local right = UiKit.Create("Frame", {
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		BackgroundTransparency = 1,
		Parent = content,
	})
	geodeLabel = UiKit.Label({
		Text = "Chests: 0",
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Text,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = right,
	}) :: TextLabel
	local crackOne = UiKit.Button({
		Text = "OPEN!",
		Size = UDim2.new(0.9, 0, 0, 62),
		Position = UDim2.fromScale(0.05, 0.28),
		Parent = right,
	})
	local crackThree = UiKit.Button({
		Text = "Open x3",
		BackgroundColor3 = UiKit.Colors.Robux,
		Size = UDim2.new(0.9, 0, 0, 50),
		Position = UDim2.fromScale(0.05, 0.52),
		Parent = right,
	})
	-- Pass owners can pause auto-cracking to enjoy the full reveal
	local autoToggle = UiKit.Button({
		Text = "Auto-Open: ON",
		BackgroundColor3 = UiKit.Colors.BgLighter,
		TextColor3 = UiKit.Colors.Text,
		Size = UDim2.new(0.9, 0, 0, 36),
		Position = UDim2.fromScale(0.05, 0.7),
		Visible = false,
		Parent = right,
	})
	autoToggle.Activated:Connect(function()
		Remotes.Function("ToggleAutoCrack"):InvokeServer()
	end)
	UiKit.Label({
		-- Chests are about one catch in eight; saying you fish for them was a
		-- leftover from before fish were the collectible, and it set players up to
		-- think the other seven catches were a miss.
		Text = "Most catches are fish. Now and then a chest comes up — every one is Rare or better.",
		TextColor3 = UiKit.Colors.TextDim,
		Font = Enum.Font.Gotham,
		TextWrapped = true,
		Size = UDim2.new(0.9, 0, 0, 44),
		Position = UDim2.fromScale(0.05, 0.84),
		Parent = right,
	})

	crackOne.Activated:Connect(function()
		crack(1)
	end)
	crackThree.Activated:Connect(function()
		local state = State.Get()
		if state and state.Passes and state.Passes.TripleCrack then
			crack(3)
		else
			Purchase.PromptPass("TripleCrack")
		end
	end)

	State.Changed:Connect(function(state)
		if geodeLabel then
			geodeLabel.Text = ("Chests: %d   •   Hold %d / %d"):format(
				state.Geodes,
				state.Hold or state.Geodes,
				state.BackpackCapacity
			)
		end
		local ownsAuto = state.Passes and state.Passes.AutoCrack == true
		autoToggle.Visible = ownsAuto == true
		if ownsAuto then
			local enabled = state.AutoCrackEnabled ~= false
			autoToggle.Text = enabled and "Auto-Open: ON" or "Auto-Open: OFF"
			autoToggle.BackgroundColor3 = enabled and UiKit.Colors.Good or UiKit.Colors.BgLighter
			autoToggle.TextColor3 = enabled and Color3.fromRGB(25, 22, 18) or UiKit.Colors.Text
		end
		if panel.Visible then
			renderOdds()
		end
	end)
	State.EventChanged:Connect(function()
		if panel.Visible then
			renderOdds()
		end
	end)

	ScreenManager.Register("Crack", panel, close, renderOdds)
end

return CrackScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">DockScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Dock Master: buy new water, and sail to water you already own.
--
-- Every area is listed, including the ones you cannot afford. Seeing the Abyss
-- sitting there at three million coins with "12 species" beside it is the whole
-- point — a goal you can see the price of is worth more than one you unlock by
-- surprise, and unlike a rebirth gate this one can be saved toward directly.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local Toasts = require(script.Parent.Parent.Toasts)
local UiKit = require(script.Parent.Parent.UiKit)

local DockScreen = {}

local list: ScrollingFrame? = nil

local function render()
	local state = State.Get()
	if not state or not list or not state.Areas then
		return
	end
	UiKit.Clear(list)
	for index, area in state.Areas do
		local current = index == state.AreaCurrent
		local card = UiKit.Create("Frame", {
			Size = UDim2.new(1, -6, 0, 74),
			BackgroundColor3 = current and UiKit.Colors.BgLighter or UiKit.Colors.BgLight,
			LayoutOrder = index,
			Parent = list,
		})
		UiKit.Corner(10).Parent = card
		if current then
			UiKit.Stroke(UiKit.Colors.Good, 2).Parent = card
		end

		UiKit.Label({
			Text = ("%d. %s"):format(index, area.Name),
			TextColor3 = area.Unlocked and UiKit.Colors.Text or UiKit.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -150, 0, 28),
			Position = UDim2.fromOffset(10, 6),
			Parent = card,
		})
		-- A per-area species count gives each area its own ending. "37/120
		-- overall" never feels close to anything; "8/12 here" does.
		UiKit.Label({
			Text = if area.Unlocked
				then ("%d / %d species caught here"):format(area.Caught, area.Species)
				else ("%d species live here"):format(area.Species),
			Font = Enum.Font.Gotham,
			TextColor3 = UiKit.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -150, 0, 24),
			Position = UDim2.fromOffset(10, 36),
			Parent = card,
		})

		local action = UiKit.Button({
			Text = "",
			Size = UDim2.fromOffset(130, 46),
			Position = UDim2.new(1, -140, 0, 14),
			Parent = card,
		})
		if current then
			action.Text = "Fishing here"
			action.BackgroundColor3 = UiKit.Colors.BgLighter
			action.TextColor3 = UiKit.Colors.TextDim
			action.Active = false
		elseif area.Unlocked then
			action.Text = "Sail here"
			action.BackgroundColor3 = UiKit.Colors.Good
			action.TextColor3 = Color3.fromRGB(25, 22, 18)
			action.Activated:Connect(function()
				local ok, err = Remotes.Function("TravelArea"):InvokeServer(index)
				if not ok and typeof(err) == "string" then
					Toasts.Push(err, UiKit.Colors.Bad)
				else
					ScreenManager.Close()
				end
			end)
		else
			local affordable = state.Coins >= area.Cost
			action.Text = Format.Number(area.Cost)
			action.BackgroundColor3 = affordable and UiKit.Colors.Accent or UiKit.Colors.BgLighter
			action.TextColor3 = affordable and Color3.fromRGB(28, 24, 20) or UiKit.Colors.TextDim
			action.Activated:Connect(function()
				local ok, err = Remotes.Function("BuyArea"):InvokeServer(index)
				if not ok and typeof(err) == "string" then
					Toasts.Push(err, UiKit.Colors.Bad)
				else
					ScreenManager.Close()
				end
			end)
		end
	end
	local layout = list:FindFirstChildOfClass("UIListLayout")
	if layout then
		list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 10)
	end
end

function DockScreen.Init(gui: ScreenGui)
	local panel, content, close = UiKit.Panel(gui, "Dock Master", UDim2.fromScale(0.56, 0.72))

	UiKit.Label({
		Text = "Areas are yours forever — Set Sail never takes them back.",
		Font = Enum.Font.Gotham,
		TextColor3 = UiKit.Colors.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = content,
	})

	local scroll = UiKit.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -34),
		Position = UDim2.fromOffset(0, 30),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		Parent = content,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = scroll
	UiKit.Pad(6).Parent = scroll
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	list = scroll

	State.Changed:Connect(function()
		if panel.Visible then
			render()
		end
	end)

	ScreenManager.Register("Dock", panel, close, render)
end

return DockScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">IndexScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Collection index: every species x 6 auras. Completion is a core daily-return
-- hook, so undiscovered cells tease with "?".
--
-- Discovered cells also carry the heaviest one you have ever landed. That is the
-- part that never finishes: the grid can be completed, a personal best cannot,
-- and it costs a line of text to give a finished collection somewhere to go.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crystals = require(Shared.Config.Crystals)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local UiKit = require(script.Parent.Parent.UiKit)

local IndexScreen = {}

local grid: ScrollingFrame? = nil
local headerLabel: TextLabel? = nil

local function render()
	local state = State.Get()
	if not state or not grid then
		return
	end
	if headerLabel then
		headerLabel.Text = ("Collection: %d / %d"):format(state.CollectionCount, state.TotalIndex)
	end
	UiKit.Clear(grid)
	local order = 0
	for _, base in Crystals.Bases do
		for _, mutName in Crystals.MutationNames do
			order += 1
			local key = Crystals.IndexKey(base.Name, mutName)
			local discovered = state.Collection[key] == true
			local mutDef = Crystals.GetMutation(mutName)
			local cell = UiKit.Create("Frame", {
				BackgroundColor3 = discovered and UiKit.Colors.BgLighter or UiKit.Colors.Bg,
				LayoutOrder = order,
				Parent = grid,
			})
			UiKit.Corner(8).Parent = cell
			if discovered then
				UiKit.Stroke(base.Color, 2).Parent = cell
				local gem = UiKit.Create("Frame", {
					Size = UDim2.fromScale(0.3, 0.3),
					Position = UDim2.fromScale(0.5, 0.26),
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = mutDef and mutDef.Color or base.Color,
					Rotation = 45,
					Parent = cell,
				})
				UiKit.Corner(6).Parent = gem
				UiKit.Label({
					Text = (mutName ~= "Normal" and (mutName .. " ") or "") .. base.Name,
					Font = Enum.Font.GothamBold,
					TextColor3 = UiKit.Colors.Text,
					TextWrapped = true,
					Size = UDim2.new(1, -6, 0.36, 0),
					Position = UDim2.fromScale(0.5, 0.64),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = cell,
				})
				-- Keyed by species alone, so every aura of a bass shows the same
				-- "biggest bass" — which is the record an angler actually tracks.
				local best = state.BestWeight and state.BestWeight[base.Name]
				UiKit.Label({
					Text = best and ("Best %.1f lb"):format(best) or "",
					Font = Enum.Font.Gotham,
					TextColor3 = UiKit.Colors.Accent,
					Size = UDim2.new(1, -6, 0.2, 0),
					Position = UDim2.fromScale(0.5, 0.89),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = cell,
				})
			else
				UiKit.Label({
					Text = "?",
					Font = Enum.Font.FredokaOne,
					TextColor3 = UiKit.Colors.TextDim,
					Size = UDim2.fromScale(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = cell,
				})
			end
		end
	end
	local layout = grid:FindFirstChildOfClass("UIGridLayout")
	if layout then
		grid.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 10)
	end
end

function IndexScreen.Init(gui: ScreenGui)
	local panel, content, close = UiKit.Panel(gui, "Fish & Relics", UDim2.fromScale(0.68, 0.8))

	headerLabel = UiKit.Label({
		Text = "Collection: 0 / 0",
		TextColor3 = UiKit.Colors.Good,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 28),
		Parent = content,
	}) :: TextLabel

	local scroll = UiKit.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -36),
		Position = UDim2.fromOffset(0, 32),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		Parent = content,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = scroll
	UiKit.Pad(6).Parent = scroll
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(1 / 6, -8, 0, 104)
	layout.CellPadding = UDim2.fromOffset(6, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	grid = scroll

	State.Changed:Connect(function()
		if panel.Visible then
			render()
		end
	end)

	ScreenManager.Register("Index", panel, close, render)
end

return IndexScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">RacksScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Crystal Racks: socket crystals to earn coins over time (incl. offline),
-- manage inventory, sell.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Crystals = require(Shared.Config.Crystals)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Purchase = require(script.Parent.Parent.Purchase)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local Toasts = require(script.Parent.Parent.Toasts)
local UiKit = require(script.Parent.Parent.UiKit)

local RacksScreen = {}

local rackList: ScrollingFrame? = nil
local invList: ScrollingFrame? = nil
local collectButton: TextButton? = nil
local panelRef: Frame? = nil

local function invoke(name: string, ...: any)
	local ok, err = Remotes.Function(name):InvokeServer(...)
	if not ok and typeof(err) == "string" then
		Toasts.Push(err, UiKit.Colors.Bad)
	end
end

local function smallButton(text: string, color: Color3, parent: Instance): TextButton
	local button = UiKit.Create("TextButton", {
		Text = text,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(25, 22, 18),
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(74, 30),
		Parent = parent,
	})
	UiKit.Corner(8).Parent = button
	return button
end

local function crystalTitle(crystal: { [string]: any }): (string, Color3)
	local baseDef = Crystals.GetBase(crystal.Base)
	local mutPrefix = crystal.Mut ~= "Normal" and (crystal.Mut .. " ") or ""
	return mutPrefix .. crystal.Base, baseDef and baseDef.Color or UiKit.Colors.Text
end

local function render()
	local state = State.Get()
	if not state or not rackList or not invList then
		return
	end

	-- Racks
	UiKit.Clear(rackList)
	local pendingTotal = 0
	local socketedIds: { [string]: boolean } = {}
	for slot = 1, state.RackSlots do
		local rack = state.Racks[tostring(slot)]
		local row = UiKit.Create("Frame", {
			Size = UDim2.new(1, -6, 0, 44),
			BackgroundColor3 = UiKit.Colors.BgLighter,
			LayoutOrder = slot,
			Parent = rackList,
		})
		UiKit.Corner(8).Parent = row
		if rack then
			socketedIds[rack.CrystalId] = true
			local crystal = state.Crystals[rack.CrystalId]
			if crystal then
				pendingTotal += rack.Pending
				local title, color = crystalTitle(crystal)
				UiKit.Label({
					Text = title .. ("  (size %.2f)"):format(crystal.Size),
					TextColor3 = color,
					TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.new(1, -170, 0, 22),
					Position = UDim2.fromOffset(8, 2),
					Parent = row,
				})
				UiKit.Label({
					Text = "+" .. Format.Number(rack.Pending) .. " coins ready",
					TextColor3 = UiKit.Colors.Good,
					Font = Enum.Font.Gotham,
					TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.new(1, -170, 0, 18),
					Position = UDim2.fromOffset(8, 24),
					Parent = row,
				})
				local unsocket = smallButton("Remove", UiKit.Colors.Accent, row)
				unsocket.Position = UDim2.new(1, -82, 0.5, -15)
				local slotIndex = slot
				unsocket.Activated:Connect(function()
					invoke("UnsocketCrystal", slotIndex)
				end)
			end
		else
			UiKit.Label({
				Text = "Empty tank — display a fish!",
				TextColor3 = UiKit.Colors.TextDim,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, -16, 1, 0),
				Position = UDim2.fromOffset(8, 0),
				Parent = row,
			})
		end
	end
	if state.NextRackSlotCost then
		local buyRow = UiKit.Create("Frame", {
			Size = UDim2.new(1, -6, 0, 40),
			BackgroundColor3 = UiKit.Colors.BgLight,
			LayoutOrder = 99,
			Parent = rackList,
		})
		UiKit.Corner(8).Parent = buyRow
		local buy = smallButton("Buy Tank", UiKit.Colors.Buy, buyRow)
		buy.Size = UDim2.fromOffset(180, 30)
		buy.Position = UDim2.new(0.5, -90, 0.5, -15)
		buy.Text = "Buy Tank  (" .. Format.Number(state.NextRackSlotCost) .. ")"
		buy.Activated:Connect(function()
			invoke("BuyUpgrade", "RackSlot")
		end)
	end
	local rackLayout = rackList:FindFirstChildOfClass("UIListLayout")
	if rackLayout then
		rackList.CanvasSize = UDim2.fromOffset(0, rackLayout.AbsoluteContentSize.Y + 10)
	end
	if collectButton then
		collectButton.Text = "Collect All  (+" .. Format.Number(pendingTotal) .. ")"
	end

	-- Inventory
	UiKit.Clear(invList)
	local order = 0
	local invCount = 0
	for id, crystal in state.Crystals do
		if socketedIds[id] then
			continue
		end
		invCount += 1
		order += 1
		local row = UiKit.Create("Frame", {
			Size = UDim2.new(1, -6, 0, 44),
			BackgroundColor3 = UiKit.Colors.BgLighter,
			LayoutOrder = order,
			Parent = invList,
		})
		UiKit.Corner(8).Parent = row
		local title, color = crystalTitle(crystal)
		UiKit.Label({
			Text = title,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -180, 0, 22),
			Position = UDim2.fromOffset(8, 2),
			Parent = row,
		})
		UiKit.Label({
			Text = "Value " .. Format.Number(crystal.Value),
			TextColor3 = UiKit.Colors.Accent,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -180, 0, 18),
			Position = UDim2.fromOffset(8, 24),
			Parent = row,
		})
		local crystalId = id
		local socket = smallButton("Display", UiKit.Colors.Good, row)
		socket.Position = UDim2.new(1, -164, 0.5, -15)
		socket.Activated:Connect(function()
			invoke("SocketCrystal", crystalId)
		end)
		local sell = smallButton("Sell", UiKit.Colors.Accent, row)
		sell.Position = UDim2.new(1, -82, 0.5, -15)
		sell.Activated:Connect(function()
			invoke("SellCrystal", crystalId)
		end)
	end
	if invCount == 0 then
		order += 1
		UiKit.Create("TextLabel", {
			Text = "No loose fish — go catch some!",
			Font = Enum.Font.Gotham,
			TextColor3 = UiKit.Colors.TextDim,
			TextScaled = true,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -6, 0, 30),
			LayoutOrder = order,
			Parent = invList,
		})
	end
	local invLayout = invList:FindFirstChildOfClass("UIListLayout")
	if invLayout then
		invList.CanvasSize = UDim2.fromOffset(0, invLayout.AbsoluteContentSize.Y + 10)
	end
end

function RacksScreen.Init(gui: ScreenGui)
	local panel, content, close = UiKit.Panel(gui, "Aquarium", UDim2.fromScale(0.72, 0.78))
	panelRef = panel

	local left = UiKit.Create("Frame", { Size = UDim2.new(0.48, 0, 1, 0), BackgroundTransparency = 1, Parent = content })
	local right = UiKit.Create("Frame", {
		Size = UDim2.new(0.5, 0, 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		BackgroundTransparency = 1,
		Parent = content,
	})

	local collect = UiKit.Button({
		Text = "Collect All",
		BackgroundColor3 = UiKit.Colors.Buy,
		Size = UDim2.new(1, -6, 0, 44),
		Parent = left,
	}) :: TextButton
	collectButton = collect
	collect.Activated:Connect(function()
		local collected = Remotes.Function("CollectRacks"):InvokeServer()
		if typeof(collected) == "number" and collected > 0 then
			Toasts.Push("+" .. Format.Number(collected) .. " coins collected!", UiKit.Colors.Good)
		end
	end)

	local racks = UiKit.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -54),
		Position = UDim2.fromOffset(0, 50),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		Parent = left,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = racks
	UiKit.Pad(6).Parent = racks
	local rackLayout = Instance.new("UIListLayout")
	rackLayout.Padding = UDim.new(0, 4)
	rackLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rackLayout.Parent = racks
	rackList = racks

	local sellAll = UiKit.Button({
		Text = "Sell All Loose Fish",
		BackgroundColor3 = UiKit.Colors.Accent,
		Size = UDim2.new(1, -6, 0, 44),
		Parent = right,
	})
	sellAll.Activated:Connect(function()
		invoke("SellCrystal", "all")
	end)

	local inv = UiKit.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -54),
		Position = UDim2.fromOffset(0, 50),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		Parent = right,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = inv
	UiKit.Pad(6).Parent = inv
	local invLayout = Instance.new("UIListLayout")
	invLayout.Padding = UDim.new(0, 4)
	invLayout.SortOrder = Enum.SortOrder.LayoutOrder
	invLayout.Parent = inv
	invList = inv

	State.Changed:Connect(function()
		if panel.Visible then
			render()
		end
	end)

	ScreenManager.Register("Racks", panel, close, render)
end

-- Time Warp upsell lives here contextually (kept for future use).
function RacksScreen.PromptTimeWarp()
	Purchase.PromptProduct("TimeWarp")
end

local _ = panelRef

return RacksScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">RebirthScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Recrystallize: the infinite prestige ladder.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Purchase = require(script.Parent.Parent.Purchase)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local Toasts = require(script.Parent.Parent.Toasts)
local UiKit = require(script.Parent.Parent.UiKit)

local RebirthScreen = {}

local infoLabel: TextLabel? = nil
local costButton: TextButton? = nil

local function render()
	local state = State.Get()
	if not state or not infoLabel or not costButton then
		return
	end
	local currentBonus = math.floor(Balance.RebirthCoinBonus * state.Rebirths * 100 + 0.5)
	local nextBonus = math.floor(Balance.RebirthCoinBonus * (state.Rebirths + 1) * 100 + 0.5)
	infoLabel.Text = table.concat({
		("Fishing: %s   •   Voyages: %d"):format(state.LayerName, state.Rebirths),
		("Coin bonus: +%d%%  ->  +%d%%"):format(currentBonus, nextBonus),
		"",
		"Resets: coins, rod, boat, aquarium tanks.",
		"Keeps: fish, collection, gamepasses, streak,",
		"and every area you've unlocked.",
	}, "\n")
	local affordable = state.Coins >= state.RebirthCost
	costButton.Text = "Set Sail  (" .. Format.Number(state.RebirthCost) .. " coins)"
	costButton.BackgroundColor3 = affordable and Color3.fromRGB(255, 120, 255) or UiKit.Colors.BgLighter
	costButton.TextColor3 = affordable and Color3.fromRGB(40, 20, 40) or UiKit.Colors.TextDim
end

function RebirthScreen.Init(gui: ScreenGui)
	local panel, content, close = UiKit.Panel(gui, "Set Sail", UDim2.fromScale(0.5, 0.66))

	infoLabel = UiKit.Create("TextLabel", {
		Text = "",
		Font = Enum.Font.GothamBold,
		TextColor3 = UiKit.Colors.Text,
		TextScaled = false,
		TextSize = 20,
		TextWrapped = true,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0.58, 0),
		Parent = content,
	}) :: TextLabel

	local rebirthButton = UiKit.Button({
		Text = "Set Sail",
		BackgroundColor3 = Color3.fromRGB(255, 120, 255),
		Size = UDim2.new(0.9, 0, 0, 54),
		Position = UDim2.fromScale(0.05, 0.64),
		Parent = content,
	}) :: TextButton
	costButton = rebirthButton
	rebirthButton.Activated:Connect(function()
		local ok, err = Remotes.Function("Rebirth"):InvokeServer()
		if not ok and typeof(err) == "string" then
			Toasts.Push(err, UiKit.Colors.Bad)
		end
	end)

	local instant = UiKit.Button({
		Text = "Instant Set Sail (R$)",
		BackgroundColor3 = UiKit.Colors.Robux,
		Size = UDim2.new(0.9, 0, 0, 44),
		Position = UDim2.fromScale(0.05, 0.82),
		Parent = content,
	})
	instant.Activated:Connect(function()
		Purchase.PromptProduct("InstantRebirth")
	end)

	State.Changed:Connect(function()
		if panel.Visible then
			render()
		end
	end)

	ScreenManager.Register("Rebirth", panel, close, render)
end

return RebirthScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">ShopScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Geode Shop: clock-synced stock with restock countdown, per-item odds display
-- for random-content offers (compliance), daily deal, and coin upgrades.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local Purchase = require(script.Parent.Parent.Purchase)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local Toasts = require(script.Parent.Parent.Toasts)
local UiKit = require(script.Parent.Parent.UiKit)

local ShopScreen = {}

local stockList: ScrollingFrame? = nil
local timerLabel: TextLabel? = nil
local panelRef: Frame? = nil
local restockAt = 0
local lastRenderedWindow = -1

local function renderStock()
	if not stockList then
		return
	end
	local stock = Remotes.Function("GetShopStock"):InvokeServer()
	if typeof(stock) ~= "table" then
		return
	end
	restockAt = stock.RestockAt or 0
	UiKit.Clear(stockList)
	local order = 0

	for index, item in stock.Items :: { any } do
		order += 1
		local card = UiKit.Create("Frame", {
			Size = UDim2.new(1, -6, 0, item.Odds and 118 or 64),
			BackgroundColor3 = item.DailyDeal and Color3.fromRGB(66, 52, 24) or UiKit.Colors.BgLighter,
			LayoutOrder = order,
			Parent = stockList,
		})
		UiKit.Corner(10).Parent = card
		if item.DailyDeal then
			UiKit.Stroke(UiKit.Colors.Accent, 2).Parent = card
		end
		UiKit.Label({
			Text = (item.DailyDeal and "DAILY DEAL!  " or "") .. item.Title,
			TextColor3 = item.DailyDeal and UiKit.Colors.Accent or UiKit.Colors.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -140, 0, 26),
			Position = UDim2.fromOffset(10, 4),
			Parent = card,
		})
		local subtitle = ""
		if item.Kind == "Crystal" then
			subtitle = "Exactly this fish, value " .. Format.Number(item.Value or 0)
		elseif item.Kind == "PremiumGeode" then
			subtitle = "Opens instantly with 3x luck"
		elseif item.Kind == "GeodeBundle" then
			subtitle = "Three unopened chests"
		elseif item.Kind == "Geode" then
			subtitle = "One unopened chest"
		end
		UiKit.Label({
			Text = subtitle,
			Font = Enum.Font.Gotham,
			TextColor3 = UiKit.Colors.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -140, 0, 20),
			Position = UDim2.fromOffset(10, 30),
			Parent = card,
		})
		if item.Odds then
			local oddsText = {}
			for _, entry in item.Odds :: { any } do
				table.insert(oddsText, entry.Name .. " " .. Format.Percent(entry.Chance))
			end
			UiKit.Label({
				Text = "Odds: " .. table.concat(oddsText, "  •  "),
				Font = Enum.Font.Gotham,
				TextColor3 = UiKit.Colors.TextDim,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Size = UDim2.new(1, -20, 0, 58),
				Position = UDim2.fromOffset(10, 54),
				Parent = card,
			})
		end
		local buy = UiKit.Create("TextButton", {
			Text = Format.Number(item.Cost) .. " coins",
			Font = Enum.Font.FredokaOne,
			TextScaled = true,
			TextColor3 = Color3.fromRGB(25, 22, 18),
			BackgroundColor3 = UiKit.Colors.Buy,
			Size = UDim2.fromOffset(120, 40),
			Position = UDim2.new(1, -130, 0, 12),
			Parent = card,
		})
		UiKit.Corner(8).Parent = buy
		local itemIndex = index
		buy.Activated:Connect(function()
			local ok, err = Remotes.Function("BuyShopItem"):InvokeServer(itemIndex)
			if ok then
				Toasts.Push("Purchased " .. item.Title .. "!", UiKit.Colors.Good)
				renderStock()
			elseif typeof(err) == "string" then
				Toasts.Push(err, UiKit.Colors.Bad)
			end
		end)
	end

	-- Upgrades (pickaxe/backpack) live at the bottom of the shop.
	local state = State.Get()
	if state then
		local upgrades = {}
		if state.NextPickaxe then
			-- "Damage 8 -> 12" is a leftover from the mining engine this game is
			-- built on, and it tells a fisherman nothing. A rod does exactly two
			-- things a player can feel — bites arrive sooner, and more fish come up
			-- per catch — so the card says those, in seconds and in fish.
			local now, next = state.Pickaxe.Damage, state.NextPickaxe.Damage
			table.insert(upgrades, {
				Title = "Rod: " .. state.NextPickaxe.Name,
				Sub = ("Bite %.1fs -> %.1fs   •   %.1f -> %.1f fish per catch"):format(
					Balance.RodAverageWait(now),
					Balance.RodAverageWait(next),
					Balance.RodFishPerCatch(now),
					Balance.RodFishPerCatch(next)
				),
				Cost = state.NextPickaxe.Cost,
				Kind = "Pickaxe",
			})
		end
		if state.NextBackpack then
			table.insert(upgrades, {
				Title = "Boat: " .. state.NextBackpack.Name,
				Sub = "Capacity " .. state.BackpackCapacity .. " -> " .. state.NextBackpack.Capacity,
				Cost = state.NextBackpack.Cost,
				Kind = "Backpack",
			})
		end
		for _, upgrade in upgrades do
			order += 1
			local card = UiKit.Create("Frame", {
				Size = UDim2.new(1, -6, 0, 64),
				BackgroundColor3 = UiKit.Colors.BgLight,
				LayoutOrder = order,
				Parent = stockList,
			})
			UiKit.Corner(10).Parent = card
			UiKit.Label({
				Text = upgrade.Title,
				TextColor3 = UiKit.Colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, -140, 0, 26),
				Position = UDim2.fromOffset(10, 4),
				Parent = card,
			})
			UiKit.Label({
				Text = upgrade.Sub,
				Font = Enum.Font.Gotham,
				TextColor3 = UiKit.Colors.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, -140, 0, 20),
				Position = UDim2.fromOffset(10, 30),
				Parent = card,
			})
			local buy = UiKit.Create("TextButton", {
				Text = Format.Number(upgrade.Cost) .. " coins",
				Font = Enum.Font.FredokaOne,
				TextScaled = true,
				TextColor3 = Color3.fromRGB(25, 22, 18),
				BackgroundColor3 = UiKit.Colors.Buy,
				Size = UDim2.fromOffset(120, 40),
				Position = UDim2.new(1, -130, 0, 12),
				Parent = card,
			})
			UiKit.Corner(8).Parent = buy
			local kind = upgrade.Kind
			buy.Activated:Connect(function()
				local ok, err = Remotes.Function("BuyUpgrade"):InvokeServer(kind)
				if ok then
					Toasts.Push("Upgraded!", UiKit.Colors.Good)
					renderStock()
				elseif typeof(err) == "string" then
					Toasts.Push(err, UiKit.Colors.Bad)
				end
			end)
		end
	end

	local layout = stockList:FindFirstChildOfClass("UIListLayout")
	if layout then
		stockList.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 10)
	end
end

function ShopScreen.Init(gui: ScreenGui)
	local panel, content, close = UiKit.Panel(gui, "Chest Shop", UDim2.fromScale(0.6, 0.78))
	panelRef = panel

	local timer = UiKit.Label({
		Text = "Restock in --:--",
		TextColor3 = UiKit.Colors.Good,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.6, 0, 0, 30),
		Parent = content,
	}) :: TextLabel
	timerLabel = timer

	local restockNow = UiKit.Button({
		Text = "Restock Now (R$)",
		BackgroundColor3 = UiKit.Colors.Robux,
		Size = UDim2.fromOffset(170, 34),
		Position = UDim2.new(1, -176, 0, 0),
		Parent = content,
	})
	restockNow.Activated:Connect(function()
		Purchase.PromptProduct("InstantRestock")
	end)

	local stock = UiKit.Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -44),
		Position = UDim2.fromOffset(0, 40),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		Parent = content,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = stock
	UiKit.Pad(6).Parent = stock
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = stock
	stockList = stock

	-- Countdown + auto-refresh when the restock window flips.
	RunService.Heartbeat:Connect(function()
		local label = timerLabel
		if not panel.Visible or not label then
			return
		end
		local remaining = restockAt - os.time()
		label.Text = "Restock in " .. Format.Clock(remaining)
		local window = os.time() // 300
		if remaining <= 0 and window ~= lastRenderedWindow then
			lastRenderedWindow = window
			renderStock()
		end
	end)

	ScreenManager.Register("Shop", panel, close, function()
		lastRenderedWindow = os.time() // 300
		renderStock()
	end)
end

local _ = panelRef

return ShopScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">StoreScreen</string>
              <string name="Source"><![CDATA[--!strict
-- Robux store: the 6-pass ladder + repeatable dev products. Offers whose IDs
-- aren't configured yet (0) are hidden.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Purchase = require(script.Parent.Parent.Purchase)
local ScreenManager = require(script.Parent.Parent.ScreenManager)
local State = require(script.Parent.Parent.State)
local UiKit = require(script.Parent.Parent.UiKit)

local StoreScreen = {}

local list: ScrollingFrame? = nil

local PASS_ORDER = { "AutoCast", "AutoCrack", "Coins2x", "Luck2x", "TripleCrack", "OvernightMiner", "Vip" }
local PRODUCT_ORDER = { "StarterPack", "Coins1k", "Coins5k", "Coins12k", "TimeWarp", "InstantRestock", "InstantRebirth" }

local function addCard(order: number, title: string, desc: string, price: number, owned: boolean, onBuy: () -> ()): number
	if not list then
		return order
	end
	order += 1
	local card = UiKit.Create("Frame", {
		Size = UDim2.new(1, -6, 0, 66),
		BackgroundColor3 = UiKit.Colors.BgLighter,
		LayoutOrder = order,
		Parent = list,
	})
	UiKit.Corner(10).Parent = card
	UiKit.Label({
		Text = title,
		TextColor3 = UiKit.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -150, 0, 28),
		Position = UDim2.fromOffset(10, 4),
		Parent = card,
	})
	UiKit.Label({
		Text = desc,
		Font = Enum.Font.Gotham,
		TextColor3 = UiKit.Colors.TextDim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -150, 0, 30),
		Position = UDim2.fromOffset(10, 32),
		Parent = card,
	})
	local buy = UiKit.Create("TextButton", {
		Text = owned and "OWNED" or ("R$ " .. price),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = owned and UiKit.Colors.Good or Color3.fromRGB(25, 22, 18),
		BackgroundColor3 = owned and UiKit.Colors.Bg or UiKit.Colors.Robux,
		AutoButtonColor = not owned,
		Size = UDim2.fromOffset(130, 42),
		Position = UDim2.new(1, -140, 0, 12),
		Parent = card,
	})
	UiKit.Corner(8).Parent = buy
	if not owned then
		buy.Activated:Connect(onBuy)
	end
	return order
end

local function addHeader(order: number, text: string): number
	if not list then
		return order
	end
	order += 1
	UiKit.Create("TextLabel", {
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Accent,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -6, 0, 30),
		LayoutOrder = order,
		Parent = list,
	})
	return order
end

local function render()
	local state = State.Get()
	if not list then
		return
	end
	UiKit.Clear(list)
	local order = 0
	local anyConfigured = false

	order = addHeader(order, "Gamepasses")
	for _, key in PASS_ORDER do
		local def = (Monetization.Gamepasses :: any)[key]
		if def.Id ~= 0 then
			anyConfigured = true
			local owned = state and state.Passes and state.Passes[key] == true
			local passKey = key
			order = addCard(order, def.Title, def.Desc or "", def.Price, owned or false, function()
				Purchase.PromptPass(passKey)
			end)
		end
	end

	order = addHeader(order, "Coins & Boosts")
	for _, key in PRODUCT_ORDER do
		local def = (Monetization.Products :: any)[key]
		if def.Id ~= 0 then
			if key == "StarterPack" and state and state.StarterPackOwned then
				continue
			end
			anyConfigured = true
			local desc = def.Desc or (def.Coins and ("+" .. def.Coins .. " coins") or "")
			local productKey = key
			order = addCard(order, def.Title, desc, def.Price, false, function()
				Purchase.PromptProduct(productKey)
			end)
		end
	end

	if not anyConfigured then
		order += 1
		UiKit.Create("TextLabel", {
			Text = "Store offers appear once gamepass/product IDs are set in Config/Monetization.luau (see SETUP.md).",
			Font = Enum.Font.Gotham,
			TextColor3 = UiKit.Colors.TextDim,
			TextWrapped = true,
			TextScaled = false,
			TextSize = 18,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -6, 0, 60),
			LayoutOrder = order,
			Parent = list,
		})
	end

	local layout = list:FindFirstChildOfClass("UIListLayout")
	if layout then
		list.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 10)
	end
end

function StoreScreen.Init(gui: ScreenGui)
	local panel, content, close = UiKit.Panel(gui, "Store", UDim2.fromScale(0.58, 0.78))

	local scroll = UiKit.Create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UiKit.Colors.BgLight,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		Parent = content,
	}) :: ScrollingFrame
	UiKit.Corner(10).Parent = scroll
	UiKit.Pad(6).Parent = scroll
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	list = scroll

	State.Changed:Connect(function()
		if panel.Visible then
			render()
		end
	end)

	ScreenManager.Register("Store", panel, close, render)
end

return StoreScreen
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client replica of the server snapshot (StateSync) + current server event.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {}

local snapshot: { [string]: any }? = nil
local changed = Instance.new("BindableEvent")
local eventChanged = Instance.new("BindableEvent")
local currentEvent: { [string]: any }? = nil

State.Changed = changed.Event :: RBXScriptSignal
State.EventChanged = eventChanged.Event :: RBXScriptSignal

function State.Get(): { [string]: any }?
	return snapshot
end

function State.CurrentEvent(): { [string]: any }?
	if currentEvent and os.time() >= (currentEvent.EndsAt or 0) then
		currentEvent = nil
	end
	return currentEvent
end

function State.Init()
	Remotes.Event("StateSync").OnClientEvent:Connect(function(newSnapshot)
		snapshot = newSnapshot
		changed:Fire(newSnapshot)
	end)
	Remotes.Event("ServerEvent").OnClientEvent:Connect(function(eventInfo)
		currentEvent = eventInfo
		eventChanged:Fire(eventInfo)
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Toasts</string>
            <string name="Source"><![CDATA[--!strict
-- Toast notifications (Notify), auto-crack result toasts, and the welcome-back
-- popup (streak + offline earnings) — the daily dopamine moment.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Config.Balance)
local Crystals = require(Shared.Config.Crystals)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)
local UiKit = require(script.Parent.UiKit)
local WorldFx = require(script.Parent.WorldFx)

local Toasts = {}

local container: Frame? = nil
local gui: ScreenGui? = nil
-- Rare-find callouts get their own layer. The reveal overlay lives on a
-- DisplayOrder-50 ScreenGui and dims everything under it, so the finder's own
-- "YOU FOUND" banner was arriving at 35% brightness underneath their reveal —
-- and ZIndex means nothing across ScreenGuis.
local announceGui: ScreenGui? = nil
-- A reveal overlay covers the middle of the screen, and on a phone the card
-- block plus its button row leaves no band a banner could occupy. Rather than
-- fight for space, hold the finder's OWN callout until their reveal closes —
-- they are watching the celebration that callout is about. Everyone else, who
-- is the actual audience for social proof, sees it immediately.
local revealOpen = false
local deferred: { { [string]: any } } = {}

local function pushToast(text: string, color: Color3?)
	if not container then
		return
	end
	local toast = UiKit.Create("TextLabel", {
		Text = text,
		Font = Enum.Font.GothamBold,
		TextColor3 = color or UiKit.Colors.Text,
		TextScaled = true,
		BackgroundColor3 = UiKit.Colors.Bg,
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = container,
	})
	UiKit.Corner(8).Parent = toast
	UiKit.Stroke(color or UiKit.Colors.BgLighter, 1).Parent = toast
	UiKit.Pad(6).Parent = toast
	task.delay(3.2, function()
		local tween = TweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)
end

Toasts.Push = pushToast

-- Server-wide rare-find callout. This is the game's status economy: pulling a
-- Mythic in front of 14 other people is worth more than the coins are, and
-- seeing someone else's callout is the most convincing possible proof that the
-- rare stuff is really in there.
local function showRareFind(payload: { [string]: any })
	local layer = announceGui
	if not layer then
		return
	end
	local color = typeof(payload.Color) == "Color3" and payload.Color or UiKit.Colors.Accent
	-- Match on UserId. DisplayNames are not unique, and matching on one meant a
	-- stranger's Mythic could render as "YOU FOUND" on your screen.
	local mine = payload.UserId == Players.LocalPlayer.UserId
	local rank = tonumber(payload.Rank) or 5
	if mine and revealOpen then
		table.insert(deferred, payload)
		return
	end

	local banner = UiKit.Create("Frame", {
		Size = UDim2.fromOffset(0, 62),
		Position = UDim2.new(0.5, 0, 0, 96),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = UiKit.Colors.Bg,
		BackgroundTransparency = 0.08,
		ZIndex = 20,
		Parent = layer,
	})
	UiKit.Corner(14).Parent = banner
	local stroke = UiKit.Stroke(color, 3)
	stroke.Parent = banner
	UiKit.Label({
		Text = mine and "★  YOU REELED IN A " .. string.upper(payload.Label or "") .. "!  ★"
			or ((payload.Player or "Someone") .. " reeled in a " .. (payload.Label or "fish") .. "!"),
		Font = Enum.Font.FredokaOne,
		TextColor3 = color,
		Size = UDim2.new(1, -20, 0, 34),
		Position = UDim2.fromOffset(10, 6),
		ZIndex = 21,
		Parent = banner,
	})
	UiKit.Label({
		Text = (payload.Tier or "Legendary") .. "  •  worth " .. Format.Number(tonumber(payload.Value) or 0),
		Font = Enum.Font.GothamBold,
		TextColor3 = UiKit.Colors.TextDim,
		Size = UDim2.new(1, -20, 0, 18),
		Position = UDim2.fromOffset(10, 38),
		ZIndex = 21,
		Parent = banner,
	})

	TweenService:Create(banner, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(mine and 560 or 480, 62),
	}):Play()
	TweenService:Create(
		stroke,
		TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 6, true),
		{ Thickness = 7 }
	):Play()
	WorldFx.Shake(mine and 1.6 or 0.5)

	for i, pitch in { 0.7, 1.05, 1.4, 1.85 } do
		task.delay((i - 1) * 0.09, function()
			if not banner.Parent then
				return
			end
			local sting = Instance.new("Sound")
			sting.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			sting.PlaybackSpeed = pitch
			sting.Volume = rank >= 6 and 0.8 or 0.55
			sting.Parent = banner
			sting:Play()
		end)
	end

	task.delay(mine and 6 or 4.5, function()
		if not banner.Parent then
			return
		end
		local fade = TweenService:Create(banner, TweenInfo.new(0.35), { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 62) })
		fade:Play()
		fade.Completed:Wait()
		banner:Destroy()
	end)
end

-- CrackScreen tells us when its modal is up so the callout can wait its turn.
function Toasts.SetRevealOpen(open: boolean)
	revealOpen = open
	if open then
		return
	end
	local queued = deferred
	deferred = {}
	for i, payload in queued do
		task.delay(0.35 * i, function()
			showRareFind(payload)
		end)
	end
end

local function showWelcome(report: { [string]: any })
	if not gui then
		return
	end
	local lines = {}
	local streak = report.Streak
	if streak then
		local streakLine = ("Day %d streak! +%s coins"):format(streak.Count, Format.Number(streak.Reward))
		if streak.Premium then
			streakLine ..= "  + a FREE Golden Chest!"
		end
		if streak.GroupBonus then
			streakLine ..= "  (2x group bonus)"
		end
		table.insert(lines, streakLine)
		if streak.StreakLost then
			table.insert(lines, "Your old streak expired — new streak started!")
		end
	end
	local offline = report.Offline
	if offline and offline.PendingCoins > 0 then
		table.insert(
			lines,
			("While you were away (%s): your aquarium earned +%s coins — collect them!"):format(
				Format.Duration(offline.OfflineSeconds),
				Format.Number(offline.PendingCoins)
			)
		)
	end
	if #lines == 0 then
		return
	end

	local calendarHeight = streak and 92 or 0
	local popup = UiKit.Create("Frame", {
		Size = UDim2.fromOffset(470, 96 + #lines * 34 + calendarHeight),
		-- Centred, but never above the top edge: the tallest case (lapsed streak
		-- + offline earnings + calendar) is 290px and used to clip its own title
		-- off screen on a phone in landscape.
		Position = UDim2.new(0.5, 0, 0.34, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UiKit.Colors.Bg,
		Parent = gui,
	})
	UiKit.Corner(14).Parent = popup
	UiKit.Stroke(UiKit.Colors.Accent, 3).Parent = popup
	local popupHeight = 96 + #lines * 34 + calendarHeight
	local viewport = gui.AbsoluteSize.Y
	if viewport > 0 and 0.34 * viewport - popupHeight / 2 < 8 then
		popup.Position = UDim2.fromOffset(0, 0) + UDim2.new(0.5, 0, 0, popupHeight // 2 + 8)
	end
	UiKit.Label({
		Text = "Welcome back!",
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Accent,
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromOffset(0, 8),
		Parent = popup,
	})
	for i, line in lines do
		UiKit.Label({
			Text = line,
			TextColor3 = UiKit.Colors.Text,
			Font = Enum.Font.GothamBold,
			TextWrapped = true,
			Size = UDim2.new(1, -24, 0, 30),
			Position = UDim2.fromOffset(12, 48 + (i - 1) * 34),
			Parent = popup,
		})
	end

	-- The visible 7-day cycle: tomorrow's reward is always on screen.
	if streak then
		local cycleDay = ((streak.Count - 1) % #Balance.StreakCycle) + 1
		local calendar = UiKit.Create("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -20, 0, 78),
			Position = UDim2.fromOffset(10, 48 + #lines * 34 + 6),
			Parent = popup,
		})
		local cellWidth = 60
		for day, reward in Balance.StreakCycle do
			local isToday = day == cycleDay
			local isPast = day < cycleDay
			local cell = UiKit.Create("Frame", {
				Size = UDim2.fromOffset(cellWidth, 74),
				Position = UDim2.fromOffset((day - 1) * (cellWidth + 4), 0),
				BackgroundColor3 = isToday and UiKit.Colors.BgLighter or UiKit.Colors.BgLight,
				BackgroundTransparency = isPast and 0.5 or 0,
				Parent = calendar,
			})
			UiKit.Corner(8).Parent = cell
			if isToday then
				UiKit.Stroke(UiKit.Colors.Accent, 2).Parent = cell
			end
			UiKit.Label({
				Text = "Day " .. day,
				Font = Enum.Font.GothamBold,
				TextColor3 = isToday and UiKit.Colors.Accent or UiKit.Colors.TextDim,
				Size = UDim2.new(1, -4, 0, 20),
				Position = UDim2.fromOffset(2, 4),
				Parent = cell,
			})
			UiKit.Label({
				Text = isPast and "✓" or (reward.PremiumGeode and "💎 OP!" or Format.Number(reward.Coins)),
				Font = Enum.Font.FredokaOne,
				TextColor3 = reward.PremiumGeode and Color3.fromRGB(255, 140, 255) or UiKit.Colors.Text,
				Size = UDim2.new(1, -4, 0, 34),
				Position = UDim2.fromOffset(2, 28),
				Parent = cell,
			})
		end
	end

	local okButton = UiKit.Button({
		Text = "Let's fish!",
		Size = UDim2.fromOffset(160, 38),
		Position = UDim2.new(0.5, -80, 1, -46),
		Parent = popup,
	})
	okButton.Activated:Connect(function()
		popup:Destroy()
	end)
	task.delay(15, function()
		if popup.Parent then
			popup:Destroy()
		end
	end)
end

function Toasts.Init(screenGui: ScreenGui)
	gui = screenGui
	announceGui = UiKit.Create("ScreenGui", {
		Name = "AnnounceGui",
		ResetOnSpawn = false,
		DisplayOrder = 60, -- above the reveal overlay's 50
		IgnoreGuiInset = true,
		Parent = screenGui.Parent,
	}) :: ScreenGui
	container = UiKit.Create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(360, 220),
		Position = UDim2.new(0.5, -180, 0, 8),
		Parent = screenGui,
	}) :: Frame
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = container

	Remotes.Event("Notify").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and typeof(payload.Text) == "string" then
			pushToast(payload.Text, payload.Color)
		end
	end)

	-- Auto-crack results arrive here (quiet toast instead of the full reveal).
	Remotes.Event("CrackResult").OnClientEvent:Connect(function(results, isAuto)
		if typeof(results) ~= "table" then
			return
		end
		for _, crystal in results do
			local tierColor = Crystals.TierColors[crystal.Tier] or UiKit.Colors.Text
			local mutPrefix = crystal.Mut ~= "Normal" and (crystal.Mut .. " ") or ""
			local label = isAuto and "Auto-Open: " or "Caught: "
			pushToast(label .. mutPrefix .. crystal.Base .. " (+" .. Format.Number(crystal.Value) .. ")", tierColor)
		end
	end)

	Remotes.Event("RareFind").OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" then
			showRareFind(payload)
		end
	end)

	Remotes.Event("WelcomeReport").OnClientEvent:Connect(function(report)
		if typeof(report) == "table" then
			showWelcome(report)
		end
	end)
end

return Toasts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">UiKit</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny UI toolkit: dark cave theme, gold accents, mobile-first sizing.

local UiKit = {}

UiKit.Colors = {
	Bg = Color3.fromRGB(24, 22, 38),
	BgLight = Color3.fromRGB(36, 33, 56),
	BgLighter = Color3.fromRGB(48, 44, 74),
	Accent = Color3.fromRGB(255, 210, 90),
	Text = Color3.fromRGB(235, 233, 245),
	TextDim = Color3.fromRGB(160, 156, 185),
	Good = Color3.fromRGB(120, 255, 200),
	Bad = Color3.fromRGB(255, 120, 120),
	Buy = Color3.fromRGB(80, 200, 120),
	Robux = Color3.fromRGB(120, 170, 255),
}

function UiKit.Create(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key == "Parent" then
			continue
		end
		(instance :: any)[key] = value
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UiKit.Corner(radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	return corner
end

function UiKit.Stroke(color: Color3?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or UiKit.Colors.BgLighter
	stroke.Thickness = thickness or 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return stroke
end

function UiKit.Pad(pixels: number): UIPadding
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, pixels)
	padding.PaddingBottom = UDim.new(0, pixels)
	padding.PaddingLeft = UDim.new(0, pixels)
	padding.PaddingRight = UDim.new(0, pixels)
	return padding
end

function UiKit.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = UiKit.Colors.Text,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	}
	for key, value in props do
		defaults[key] = value
	end
	return UiKit.Create("TextLabel", defaults)
end

function UiKit.Button(props: { [string]: any }): TextButton
	local defaults = {
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.fromRGB(30, 26, 20),
		TextScaled = true,
		BackgroundColor3 = UiKit.Colors.Accent,
		AutoButtonColor = true,
		Size = UDim2.fromOffset(140, 44),
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = UiKit.Create("TextButton", defaults)
	UiKit.Corner(10).Parent = button
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = button
	return button
end

-- Standard modal panel with a title bar and close button. Returns panel + content.
function UiKit.Panel(parent: Instance, title: string, size: UDim2): (Frame, Frame, TextButton)
	local panel = UiKit.Create("Frame", {
		Name = title .. "Panel",
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = UiKit.Colors.Bg,
		Visible = false,
		Parent = parent,
	})
	UiKit.Corner(14).Parent = panel
	UiKit.Stroke(UiKit.Colors.BgLighter, 3).Parent = panel

	UiKit.Label({
		Name = "Title",
		Text = title,
		Font = Enum.Font.FredokaOne,
		TextColor3 = UiKit.Colors.Accent,
		Size = UDim2.new(1, -60, 0, 40),
		Position = UDim2.fromOffset(14, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = panel,
	})

	local close = UiKit.Create("TextButton", {
		Name = "Close",
		Text = "X",
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		TextColor3 = UiKit.Colors.Text,
		BackgroundColor3 = UiKit.Colors.Bad,
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(1, -44, 0, 8),
		Parent = panel,
	})
	UiKit.Corner(10).Parent = close

	local content = UiKit.Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 1, -60),
		Position = UDim2.fromOffset(10, 50),
		Parent = panel,
	})
	return panel, content, close
end

function UiKit.Clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

return UiKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side world juice: relics that turn, buoys that ride the swell, and
-- camera shake for the moments that earn it.
--
-- All of it is local. Nothing here replicates, which is why a dozen bobbing
-- buoys and two turning landmark relics cost the server nothing at all.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local WorldFx = {}

local rng = Random.new()
local shake = 0

-- Shake decays fast and is capped, so a lucky streak gives a lively screen
-- rather than an unplayable one.
function WorldFx.Shake(amount: number)
	shake = math.min(shake + amount, 2.2)
end

-- PVInstance, not Model: this drives relic clusters and single buoys alike.
type Spinner = { Object: PVInstance, Base: CFrame, Speed: number, Bob: number, BobSpeed: number, Phase: number }

local spinners: { Spinner } = {}
local spinnerOf: { [PVInstance]: Spinner } = {}

local function trackSpinner(instance: Instance)
	if not instance:IsA("PVInstance") then
		return
	end
	local object = instance :: PVInstance
	if spinnerOf[object] then
		return
	end
	local spinner: Spinner = {
		Object = object,
		Base = object:GetPivot(),
		Speed = (object:GetAttribute("SpinSpeed") :: number?) or 0.4,
		Bob = (object:GetAttribute("BobHeight") :: number?) or 0,
		BobSpeed = (object:GetAttribute("BobSpeed") :: number?) or 0.6,
		Phase = rng:NextNumber(0, math.pi * 2),
	}
	spinnerOf[object] = spinner
	table.insert(spinners, spinner)
end

local function untrackSpinner(instance: Instance)
	if not instance:IsA("PVInstance") then
		return
	end
	local spinner = spinnerOf[instance :: PVInstance]
	if not spinner then
		return
	end
	spinnerOf[instance :: PVInstance] = nil
	local index = table.find(spinners, spinner)
	if index then
		table.remove(spinners, index)
	end
end

function WorldFx.Init()
	for _, tagged in CollectionService:GetTagged("SpinCrystal") do
		trackSpinner(tagged)
	end
	CollectionService:GetInstanceAddedSignal("SpinCrystal"):Connect(trackSpinner)
	CollectionService:GetInstanceRemovedSignal("SpinCrystal"):Connect(untrackSpinner)

	local clock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		clock += dt
		for _, spinner in spinners do
			if spinner.Object.Parent then
				local lift = spinner.Bob > 0
					and math.sin(clock * spinner.BobSpeed + spinner.Phase) * spinner.Bob
					or 0
				spinner.Object:PivotTo(
					spinner.Base * CFrame.new(0, lift, 0) * CFrame.Angles(0, clock * spinner.Speed * math.pi, 0)
				)
			end
		end
	end)

	-- Shake is applied after the camera script has written its CFrame, or it
	-- gets overwritten the same frame.
	RunService:BindToRenderStep("WorldFxShake", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		if shake <= 0.0005 then
			return
		end
		shake = math.max(shake - dt * 6, 0)
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local magnitude = shake * 0.012
		camera.CFrame = camera.CFrame
			* CFrame.Angles(
				rng:NextNumber(-magnitude, magnitude),
				rng:NextNumber(-magnitude, magnitude),
				rng:NextNumber(-magnitude, magnitude)
			)
	end)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>