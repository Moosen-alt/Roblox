        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">Balance</string>
            <string name="Source"><![CDATA[--!strict
-- Every tuning constant in one place. Post-launch "balancing" is editing this file only.

local Balance = {}

-- FILM MODE: set true in Studio to record marketing clips — maxed profile,
-- 36/48 collection, Day 30 streak, 8h of offline earnings waiting, and server
-- events firing every few seconds. It is ignored outside Studio and ships as
-- false, so it can never affect the live game. See src/server/FilmMode.luau.
Balance.FilmMode = false

-- Fishing areas. Internally these are still "layers" — the engine's word for a
-- content tier, and the same name the sibling games use — but the player buys
-- and sails to an AREA. Each is a physically separate stretch of water with its
-- own species, its own lighting and its own dock.
Balance.MaxLayer = 5
Balance.LayerValueMult = 2.5 -- fish value x 2.5 per area
Balance.LayerLuckBonus = 0.15 -- +15% luck per area past the first
Balance.LayerNames = { "Sunny Shallows", "Kelp Forest", "Twilight Reef", "Midnight Trench", "The Abyss" }

-- Coins to unlock each area, paid once and kept forever. Index 1 is free (you
-- start there); index N is the price of sailing to area N.
--
-- Areas are bought with COINS, not Robux, and Set Sail does not take them back.
-- That is what makes them safe to want: a locked dock you can see across the
-- water is a goal, and a goal you can lose is a threat. The coin sink is the
-- point — it gives selling fish a destination beyond the next rod.
Balance.AreaCosts = { 0, 6000, 45000, 350000, 3000000 }
Balance.AreaSpacing = 600 -- studs between area origins on the X axis

-- Fishing
Balance.MineCooldown = 0.22 -- seconds between counted casts (server enforced)
Balance.NodeBaseHealth = 3 -- unused by the fishing loop; kept for shared math
Balance.NodeRespawnTime = 2.5
Balance.NodeCount = 12 -- fishing spots per area
Balance.CastRange = 60 -- studs; how far you can cast from a spot
-- Roughly one catch in eight comes up as a chest instead of a fish. Frequent
-- enough that the opening animation is a regular beat, rare enough that it stays
-- an event — and every chest is a guaranteed Rare+, so it can never disappoint.
Balance.CrateChance = 0.12
Balance.PityForcedRareCrack = 3 -- the Nth lifetime open is guaranteed Rare+ (first-session hook)
-- Auto-Cast is offered once, after this many lifetime catches — late enough that
-- the player has felt the clicking, early enough that they still care.
Balance.AutoCastOfferAfterCatches = 150

-- Rods. `Damage` drives how fast fish bite and the double-hook chance. Index 1
-- is the freebie. The authored run is long, and past it `Balance.Pickaxe(level)`
-- keeps generating tiers forever — an upgrade button that greys out with nothing
-- behind it is the fastest way to end a session.
export type RodTier = {
	Name: string,
	Damage: number,
	Cost: number,
	Color: Color3,
	Material: Enum.Material,
	Glow: boolean,
}

Balance.Pickaxes = {
	{ Name = "Twig Rod", Damage = 1, Cost = 0, Color = Color3.fromRGB(140, 105, 70), Material = Enum.Material.Wood, Glow = false },
	{ Name = "Copper Rod", Damage = 2, Cost = 150, Color = Color3.fromRGB(205, 125, 70), Material = Enum.Material.Metal, Glow = false },
	{ Name = "Iron Rod", Damage = 3, Cost = 600, Color = Color3.fromRGB(190, 190, 200), Material = Enum.Material.Metal, Glow = false },
	{ Name = "Golden Rod", Damage = 5, Cost = 2000, Color = Color3.fromRGB(255, 200, 60), Material = Enum.Material.Metal, Glow = false },
	{ Name = "Coral Rod", Damage = 8, Cost = 8000, Color = Color3.fromRGB(255, 120, 140), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Laser Rod", Damage = 12, Cost = 30000, Color = Color3.fromRGB(255, 60, 80), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Storm Rod", Damage = 20, Cost = 120000, Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Leviathan Rod", Damage = 30, Cost = 500000, Color = Color3.fromRGB(120, 90, 200), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Kraken Rod", Damage = 46, Cost = 1_800_000, Color = Color3.fromRGB(90, 200, 130), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Tidecaller", Damage = 72, Cost = 6_500_000, Color = Color3.fromRGB(90, 210, 220), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Moonlit Rod", Damage = 112, Cost = 24_000_000, Color = Color3.fromRGB(200, 220, 255), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Trench Rod", Damage = 175, Cost = 90_000_000, Color = Color3.fromRGB(80, 70, 120), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Siren's Rod", Damage = 270, Cost = 340_000_000, Color = Color3.fromRGB(255, 150, 220), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Maelstrom Rod", Damage = 420, Cost = 1_300_000_000, Color = Color3.fromRGB(150, 110, 255), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Abyssal Rod", Damage = 650, Cost = 5_000_000_000, Color = Color3.fromRGB(70, 60, 110), Material = Enum.Material.Neon, Glow = true },
	{ Name = "Poseidon's Rod", Damage = 1000, Cost = 19_000_000_000, Color = Color3.fromRGB(120, 255, 255), Material = Enum.Material.Neon, Glow = true },
}

-- What a rod's Damage actually buys. These are curves, not clamps, and that is
-- the point: the old maths was `math.clamp(1 - damage * 0.015, 0.5, 1)` for bite
-- speed and `math.min(damage * 0.02, 0.6)` for the double hook, both of which
-- pinned at around damage 30 — so every rod past the eighth tier bought you
-- literally nothing. Players noticed, correctly, that upgrading stopped working.
--
-- Asymptotes fix it honestly. Bite delay approaches BiteFloor without ever
-- reaching it and extra catches grow with the logarithm of damage, so tier 40 is
-- still a real improvement over tier 39 — small, but never zero, and never a
-- wall you hit without being told.
-- How long a fish takes to find your bait, before the rod's factor is applied.
-- Lives here rather than inside MiningService so the shop can quote a real
-- number of seconds at the player instead of an abstract stat.
-- Shorter than it was (1.5-4.0). The wait used to be the whole gap between
-- catches and had to be long enough to feel like fishing; now the reel-in fills
-- that role with something the player is actually doing, so a long stare at a
-- buoy on top of it is just dead time twice.
Balance.BiteDelayMin = 1.0
Balance.BiteDelayMax = 2.8

-- THE REEL-IN.
--
-- A fish on the line opens a bar with the fish darting up and down it and a
-- bracket you steer by holding the button — hold to rise, release to fall. Keep
-- the fish in the bracket to fill the meter.
--
-- This is the genre standard for a reason. It turns the dead wait into the
-- actual game, it is one input so it plays identically on a phone and a mouse,
-- and it gives skill somewhere to live that is not a reaction test. A reaction
-- window rewards being twelve; tracking a moving target rewards paying
-- attention, which is a skill an eight-year-old can visibly get better at.
--
-- It keeps the rule the reaction window broke: you cannot LOSE a fish here. The
-- meter drains when you are off the fish but the reel always completes — on the
-- timeout if nothing else. How well you tracked decides the bonus, never whether
-- you get anything.
-- Tuned so a reel is a FIGHT, not a formality. Flawless tracking fills the meter
-- in ~3.3s; staying on the fish 70% of the time takes ~6s; a scrappy 40% runs
-- out the clock and lands the fish anyway on about half a meter. Fill much
-- faster than this and the bar is over before the player has read it.
Balance.ReelZoneSize = 0.24 -- bracket height, as a fraction of the bar
Balance.ReelFillRate = 0.3 -- meter per second while the fish is in the bracket
Balance.ReelDrainRate = 0.14 -- meter per second while it is not
-- The bracket must be able to OUTRUN the fish, or tracking becomes luck. Under
-- damping its top speed is acceleration / drag: 0.79 up, 0.57 down. Compare
-- against ReelFishSpeed below, which tops out at 0.66 in the Abyss.
Balance.ReelRise = 2.2 -- bracket acceleration while holding
Balance.ReelGravity = 1.6 -- bracket acceleration while not
Balance.ReelDrag = 2.8 -- damping, so the bracket settles instead of pinballing
-- A player who cannot track well still lands every fish — but they should not
-- spend fifteen seconds doing it, because that halves their catch rate against
-- someone who can, and the gap between a good and a struggling eight-year-old
-- should be a bonus, not a tax.
Balance.ReelTimeout = 10 -- seconds, after which you land it regardless
Balance.ReelMaxBonus = 2 -- extra fish at a flawless reel

-- Deeper fish fight harder: they change direction more often and move faster.
-- Difficulty comes from the AREA rather than the species because the species is
-- not rolled until the fish is in the boat — and because "the Abyss is harder
-- than the Shallows" is a promise the map already makes.
-- Capped below the bracket's 0.79 top speed on purpose: an Abyss fish at 0.66
-- can be caught by a player who commits to the chase, which is hard. One that
-- outruns the bracket outright would just be unfair, and unfair reads as broken.
Balance.ReelFishSpeedBase = 0.42 -- bar-fractions per second in area 1
Balance.ReelFishSpeedPerArea = 0.06
Balance.ReelFishTurnBase = 1.1 -- seconds between direction changes in area 1
Balance.ReelFishTurnPerArea = -0.12

-- Auto-Cast plays the reel for you, at a deliberately ordinary standard. It
-- removes the work; it must not beat a player who is actually trying.
Balance.ReelAutoQuality = 0.62

-- Mashing the button before the bite spooks the fish and pushes it back a
-- moment. That is the counterweight that keeps patience worth something now
-- that missing costs nothing — and unlike losing the catch, it is a delay the
-- player can see happen and understand.
Balance.SpookDelay = 0.6

function Balance.ReelFishSpeed(area: number): number
	return Balance.ReelFishSpeedBase + Balance.ReelFishSpeedPerArea * (math.max(area, 1) - 1)
end

function Balance.ReelFishTurn(area: number): number
	return math.max(Balance.ReelFishTurnBase + Balance.ReelFishTurnPerArea * (math.max(area, 1) - 1), 0.35)
end

Balance.BiteFloor = 0.45 -- fastest possible bite, as a fraction of the base wait
Balance.BiteSharpness = 0.08 -- how quickly early rods approach that floor
Balance.ExtraCatchScale = 0.35 -- catches per landing grow as log(1 + damage) * this
-- Subtracted so the STARTER rod lands on the old 2% double-hook chance exactly.
-- Without it the fix would have quietly buffed the first ten minutes of the game
-- by 10x, which is not what "upgrades stopped working" asked for.
Balance.ExtraCatchBase = 0.22

function Balance.RodBiteFactor(damage: number): number
	return Balance.BiteFloor + (1 - Balance.BiteFloor) / (1 + math.max(damage, 0) * Balance.BiteSharpness)
end

-- Average extra fish on a landing. The whole part is guaranteed, the fraction is
-- the chance of one more — so 1.9 means "always +1, and 90% of the time +2".
function Balance.RodExtraCatch(damage: number): number
	return math.max(math.log(1 + math.max(damage, 0)) * Balance.ExtraCatchScale - Balance.ExtraCatchBase, 0)
end

-- The two numbers a player can actually feel, for the shop to show: how long
-- they wait for a bite, and how many fish come up when they land one.
function Balance.RodAverageWait(damage: number): number
	return (Balance.BiteDelayMin + Balance.BiteDelayMax) * 0.5 * Balance.RodBiteFactor(damage)
end

function Balance.RodFishPerCatch(damage: number): number
	return 1 + Balance.RodExtraCatch(damage)
end

Balance.PickaxeDamageGrowth = 1.55
Balance.PickaxeCostGrowth = 3.85
local ROD_TITLES = { "Ascendant", "Celestial", "Infinite", "Leviathan's", "Sovereign", "Worldtide" }
local ROD_TINTS = {
	Color3.fromRGB(120, 255, 255),
	Color3.fromRGB(150, 255, 245),
	Color3.fromRGB(190, 90, 255),
	Color3.fromRGB(255, 70, 120),
	Color3.fromRGB(120, 255, 190),
}

-- The one way to look up a rod. Always returns a tier: there is no top.
function Balance.Pickaxe(level: number): RodTier
	local authored = Balance.Pickaxes[math.max(math.floor(level), 1)]
	if authored then
		return authored
	end
	local count = #Balance.Pickaxes
	local past = math.floor(level) - count
	local last = Balance.Pickaxes[count]
	local title = ROD_TITLES[(past - 1) % #ROD_TITLES + 1]
	local mark = math.floor((past - 1) / #ROD_TITLES) + 1
	return {
		Name = if mark > 1 then ("%s Rod %d"):format(title, mark) else (title .. " Rod"),
		Damage = math.floor(last.Damage * Balance.PickaxeDamageGrowth ^ past + 0.5),
		Cost = math.floor(last.Cost * Balance.PickaxeCostGrowth ^ past + 0.5),
		Color = ROD_TINTS[(past - 1) % #ROD_TINTS + 1],
		Material = Enum.Material.Neon,
		Glow = true,
	}
end

-- Boats: how much your hold carries (fish + unopened chests together). Endless
-- for the same reason as the rod — a boat that stops growing is just the same
-- wall one step later.
export type BoatTier = { Name: string, Capacity: number, Cost: number }

Balance.Backpacks = {
	{ Name = "Dinghy", Capacity = 6, Cost = 0 },
	{ Name = "Rowboat", Capacity = 12, Cost = 200 },
	{ Name = "Sloop", Capacity = 24, Cost = 900 },
	{ Name = "Trawler", Capacity = 48, Cost = 4000 },
	{ Name = "Galleon", Capacity = 96, Cost = 18000 },
	{ Name = "Clipper", Capacity = 180, Cost = 85_000 },
	{ Name = "Icebreaker", Capacity = 340, Cost = 400_000 },
	{ Name = "Research Vessel", Capacity = 640, Cost = 1_900_000 },
	{ Name = "Submersible", Capacity = 1200, Cost = 9_000_000 },
	{ Name = "Abyssal Ark", Capacity = 2400, Cost = 44_000_000 },
}

Balance.BackpackCapacityGrowth = 1.9
Balance.BackpackCostGrowth = 4.8

function Balance.Backpack(level: number): BoatTier
	local authored = Balance.Backpacks[math.max(math.floor(level), 1)]
	if authored then
		return authored
	end
	local count = #Balance.Backpacks
	local past = math.floor(level) - count
	local last = Balance.Backpacks[count]
	return {
		Name = ("Abyssal Ark %d"):format(past + 1),
		Capacity = math.floor(last.Capacity * Balance.BackpackCapacityGrowth ^ past + 0.5),
		Cost = math.floor(last.Cost * Balance.BackpackCostGrowth ^ past + 0.5),
	}
end

-- Growth racks: socketed crystals produce coins and slowly grow in size (value).
Balance.BaseRackSlots = 2
Balance.MaxRackSlots = 8
Balance.RackSlotCosts = { 500, 2500, 10000, 40000, 150000, 600000 } -- slots 3..8
Balance.RackCoinsPerValuePerSecond = 0.001 -- a 100-value crystal makes 0.1 coins/sec
Balance.RackGrowthPerSecond = 0.0001 -- size units/sec; size starts ~1.0
Balance.MaxCrystalSize = 3.0

-- Offline progress (the daily-return hook). Computed from timestamps on rejoin.
Balance.OfflineCapSeconds = 8 * 3600
Balance.OfflineCapSecondsVip = 24 * 3600 -- with Overnight Miner pass
Balance.OfflineRateVip = 1.5 -- Overnight Miner also boosts offline earnings

-- Rebirth (Recrystallize): pay coins, reset progress, permanent +25% coins each.
Balance.RebirthBaseCost = 10000
Balance.RebirthCostGrowth = 2.5 -- cost = base * growth^rebirths
Balance.RebirthCoinBonus = 0.25 -- +25% coin value per rebirth, forever

-- Shop: clock-synced restock (same stock for everyone in the world, no live-ops).
Balance.ShopRestockSeconds = 300
Balance.ShopDailyDealSeconds = 86400
Balance.ShopGeodeBaseCost = 25 -- coins, scaled by layer
Balance.ShopPremiumGeodeLuck = 3 -- premium shop geode rolls with 3x luck
Balance.ShopPremiumGeodeCostMult = 4

-- Random server events: limited-time feel with zero developer intervention.
Balance.EventCheckInterval = 360 -- consider an event roughly every 6 minutes
Balance.EventChance = 0.45
Balance.EventDuration = 180
Balance.Events = {
	{ Name = "Feeding Frenzy", LuckMult = 10, MutationMult = 1, Color = Color3.fromRGB(255, 170, 40) },
	{ Name = "Moon Tide", LuckMult = 1, MutationMult = 5, Color = Color3.fromRGB(160, 200, 255) },
}

-- Daily streaks: a VISIBLE 7-day reward cycle (repeats forever, 1 grace day).
-- Day 7 anchor: big coins + a guaranteed Golden Chest roll (free-action
-- randomness, no paid-random surface).
Balance.StreakGraceDays = 1
Balance.StreakCycle = {
	{ Coins = 150 },
	{ Coins = 300 },
	{ Coins = 600 },
	{ Coins = 1000 },
	{ Coins = 1500 },
	{ Coins = 2500 },
	{ Coins = 5000, PremiumGeode = true },
}

-- Boosts
Balance.StarterPackCoins = 2500
Balance.StarterPackBoostSeconds = 24 * 3600 -- 24h of 2x coins
Balance.TimeWarpSeconds = 8 * 3600 -- Time Warp dev product: +8h of rack progress, instantly

-- VIP
Balance.VipCoinBonus = 0.25

return Balance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Crystals</string>
            <string name="Source"><![CDATA[--!strict
-- All collectible content lives in these tables. Adding a row here is a full
-- "content update" (new index entries, new drops) with zero other code changes.
-- (Internal module name stays "Crystals" — it's the engine's collectible table.)
--
-- TWO KINDS OF THING, ONE TABLE.
--
--   Kind = "Fish"  — what you pull out of the water. Real species, and each area
--                    stocks the ones that actually live in that water.
--   Kind = "Relic" — what is INSIDE a chest. Sunken treasure: anchors, doubloons,
--                    a captain's spyglass, Poseidon's trident.
--
-- Chests used to contain a better fish, which made them "a fish, but louder" —
-- no reason to feel different from a good cast, and a strange thing to find in a
-- locked box at the bottom of the sea. Relics give the opening its own payoff,
-- its own collection to finish, and they put the game's own title back in it.
--
-- One table rather than two, deliberately: the Index, the value maths, the
-- aquarium, the shop and every test already work on this shape. A parallel
-- system would double all of them to say the same thing.

export type CrystalDef = {
	Name: string,
	Kind: string, -- "Fish" | "Relic"
	Tier: string,
	Weight: number, -- drop weight WITHIN its own kind; each kind sums to ~100
	Value: number,
	Color: Color3,
	MinLayer: number, -- first area this appears in
	MaxLayer: number, -- last area it appears in
	WeightMin: number, -- pounds at the smallest roll (fish only; 0 for relics)
	WeightMax: number,
}

export type MutationDef = {
	Name: string,
	Chance: number, -- base chance out of 100; remainder rolls Normal
	ValueMult: number,
	Color: Color3?,
}

local Crystals = {}

Crystals.Tiers = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

Crystals.TierColors = {
	Common = Color3.fromRGB(190, 190, 190),
	Uncommon = Color3.fromRGB(120, 220, 120),
	Rare = Color3.fromRGB(80, 150, 255),
	Epic = Color3.fromRGB(190, 90, 255),
	Legendary = Color3.fromRGB(255, 170, 40),
	Mythic = Color3.fromRGB(255, 70, 120),
}

-- Luck multipliers (gamepass / events) scale the weights of these tiers and above.
Crystals.LuckyTierThreshold = 3 -- index into Tiers: Rare+

--------------------------------------------------------------------------------
-- FISH — real species, stocked by habitat.
--
-- Every one of these is a fish (or sea creature) a child could look up and find,
-- living in water it actually lives in: reef fish on the reef, kelp species in
-- the kelp, deep-sea species in the trench. That is worth more than invented
-- names for this audience, not less — "I caught a Leopard Shark" is a thing to
-- say at school, and half of them are already known from a nature documentary.
--
-- Species still turn over between areas (MinLayer..MaxLayer is a window, not a
-- floor), so sailing somewhere new means different fish, not a longer list.
--------------------------------------------------------------------------------

Crystals.Bases = {
	-- Area 1: Sunny Shallows — sandy coastal water
	{ Name = "Anchovy", Kind = "Fish", Tier = "Common", Weight = 40, Value = 5, Color = Color3.fromRGB(196, 208, 216), MinLayer = 1, MaxLayer = 1, WeightMin = 0.1, WeightMax = 0.6 },
	{ Name = "Mackerel", Kind = "Fish", Tier = "Common", Weight = 22, Value = 9, Color = Color3.fromRGB(96, 140, 172), MinLayer = 1, MaxLayer = 2, WeightMin = 0.8, WeightMax = 4 },
	{ Name = "Sea Bass", Kind = "Fish", Tier = "Uncommon", Weight = 17, Value = 22, Color = Color3.fromRGB(120, 132, 108), MinLayer = 1, MaxLayer = 2, WeightMin = 2, WeightMax = 14 },
	{ Name = "Flounder", Kind = "Fish", Tier = "Uncommon", Weight = 10, Value = 34, Color = Color3.fromRGB(168, 148, 112), MinLayer = 1, MaxLayer = 2, WeightMin = 1, WeightMax = 9 },
	{ Name = "Red Snapper", Kind = "Fish", Tier = "Rare", Weight = 6, Value = 90, Color = Color3.fromRGB(214, 76, 66), MinLayer = 1, MaxLayer = 2, WeightMin = 3, WeightMax = 20 },
	{ Name = "Seahorse", Kind = "Fish", Tier = "Rare", Weight = 3.2, Value = 140, Color = Color3.fromRGB(240, 190, 92), MinLayer = 1, MaxLayer = 1, WeightMin = 0.05, WeightMax = 0.4 },
	{ Name = "Sailfish", Kind = "Fish", Tier = "Epic", Weight = 1.8, Value = 420, Color = Color3.fromRGB(74, 128, 200), MinLayer = 1, MaxLayer = 1, WeightMin = 60, WeightMax = 190 },

	-- Area 2: Kelp Forest — temperate kelp beds
	{ Name = "Kelp Bass", Kind = "Fish", Tier = "Common", Weight = 44, Value = 45, Color = Color3.fromRGB(126, 142, 94), MinLayer = 2, MaxLayer = 3, WeightMin = 1, WeightMax = 8 },
	{ Name = "Garibaldi", Kind = "Fish", Tier = "Uncommon", Weight = 20, Value = 120, Color = Color3.fromRGB(255, 128, 32), MinLayer = 2, MaxLayer = 3, WeightMin = 0.6, WeightMax = 4 },
	{ Name = "Sheephead", Kind = "Fish", Tier = "Uncommon", Weight = 12, Value = 180, Color = Color3.fromRGB(198, 96, 128), MinLayer = 2, MaxLayer = 2, WeightMin = 4, WeightMax = 26 },
	{ Name = "Moray Eel", Kind = "Fish", Tier = "Rare", Weight = 6, Value = 340, Color = Color3.fromRGB(120, 148, 96), MinLayer = 2, MaxLayer = 3, WeightMin = 6, WeightMax = 32 },
	{ Name = "Leopard Shark", Kind = "Fish", Tier = "Rare", Weight = 4, Value = 520, Color = Color3.fromRGB(176, 172, 156), MinLayer = 2, MaxLayer = 3, WeightMin = 20, WeightMax = 70 },
	{ Name = "Giant Sea Bass", Kind = "Fish", Tier = "Legendary", Weight = 0.6, Value = 3400, Color = Color3.fromRGB(92, 102, 116), MinLayer = 2, MaxLayer = 2, WeightMin = 120, WeightMax = 560 },

	-- Area 3: Twilight Reef — coral reef
	{ Name = "Clownfish", Kind = "Fish", Tier = "Common", Weight = 38, Value = 170, Color = Color3.fromRGB(255, 132, 40), MinLayer = 3, MaxLayer = 4, WeightMin = 0.05, WeightMax = 0.5 },
	{ Name = "Parrotfish", Kind = "Fish", Tier = "Common", Weight = 22, Value = 210, Color = Color3.fromRGB(72, 200, 176), MinLayer = 3, MaxLayer = 4, WeightMin = 2, WeightMax = 12 },
	{ Name = "Blue Tang", Kind = "Fish", Tier = "Uncommon", Weight = 18, Value = 320, Color = Color3.fromRGB(56, 118, 224), MinLayer = 3, MaxLayer = 3, WeightMin = 0.3, WeightMax = 2 },
	{ Name = "Lionfish", Kind = "Fish", Tier = "Uncommon", Weight = 11, Value = 420, Color = Color3.fromRGB(232, 96, 72), MinLayer = 3, MaxLayer = 4, WeightMin = 0.6, WeightMax = 3 },
	{ Name = "Reef Shark", Kind = "Fish", Tier = "Rare", Weight = 6, Value = 900, Color = Color3.fromRGB(140, 156, 172), MinLayer = 3, MaxLayer = 4, WeightMin = 40, WeightMax = 180 },
	{ Name = "Manta Ray", Kind = "Fish", Tier = "Epic", Weight = 2.4, Value = 2800, Color = Color3.fromRGB(60, 72, 96), MinLayer = 3, MaxLayer = 4, WeightMin = 200, WeightMax = 1400 },
	{ Name = "Hammerhead", Kind = "Fish", Tier = "Legendary", Weight = 0.7, Value = 9000, Color = Color3.fromRGB(150, 160, 150), MinLayer = 3, MaxLayer = 3, WeightMin = 150, WeightMax = 700 },

	-- Area 4: Midnight Trench — the deep
	{ Name = "Lanternfish", Kind = "Fish", Tier = "Common", Weight = 40, Value = 750, Color = Color3.fromRGB(120, 200, 255), MinLayer = 4, MaxLayer = 5, WeightMin = 0.02, WeightMax = 0.3 },
	{ Name = "Hatchetfish", Kind = "Fish", Tier = "Common", Weight = 22, Value = 950, Color = Color3.fromRGB(196, 208, 232), MinLayer = 4, MaxLayer = 5, WeightMin = 0.05, WeightMax = 0.4 },
	{ Name = "Viperfish", Kind = "Fish", Tier = "Uncommon", Weight = 16, Value = 1600, Color = Color3.fromRGB(88, 108, 140), MinLayer = 4, MaxLayer = 5, WeightMin = 0.5, WeightMax = 3 },
	{ Name = "Gulper Eel", Kind = "Fish", Tier = "Uncommon", Weight = 10, Value = 2100, Color = Color3.fromRGB(72, 60, 92), MinLayer = 4, MaxLayer = 5, WeightMin = 2, WeightMax = 14 },
	{ Name = "Anglerfish", Kind = "Fish", Tier = "Rare", Weight = 6, Value = 4200, Color = Color3.fromRGB(255, 236, 128), MinLayer = 4, MaxLayer = 5, WeightMin = 1, WeightMax = 8 },
	{ Name = "Barreleye", Kind = "Fish", Tier = "Epic", Weight = 2.2, Value = 12000, Color = Color3.fromRGB(140, 255, 190), MinLayer = 4, MaxLayer = 4, WeightMin = 0.3, WeightMax = 2 },
	{ Name = "Oarfish", Kind = "Fish", Tier = "Legendary", Weight = 0.8, Value = 34000, Color = Color3.fromRGB(206, 210, 226), MinLayer = 4, MaxLayer = 5, WeightMin = 100, WeightMax = 600 },

	-- Area 5: The Abyss — the hadal zone
	{ Name = "Giant Isopod", Kind = "Fish", Tier = "Common", Weight = 34, Value = 5200, Color = Color3.fromRGB(178, 162, 132), MinLayer = 5, MaxLayer = 5, WeightMin = 1, WeightMax = 4 },
	{ Name = "Dumbo Octopus", Kind = "Fish", Tier = "Uncommon", Weight = 20, Value = 9000, Color = Color3.fromRGB(220, 140, 160), MinLayer = 5, MaxLayer = 5, WeightMin = 1, WeightMax = 12 },
	{ Name = "Frilled Shark", Kind = "Fish", Tier = "Rare", Weight = 7, Value = 22000, Color = Color3.fromRGB(96, 88, 78), MinLayer = 5, MaxLayer = 5, WeightMin = 20, WeightMax = 90 },
	{ Name = "Goblin Shark", Kind = "Fish", Tier = "Epic", Weight = 2.6, Value = 60000, Color = Color3.fromRGB(232, 168, 178), MinLayer = 5, MaxLayer = 5, WeightMin = 100, WeightMax = 460 },
	{ Name = "Colossal Squid", Kind = "Fish", Tier = "Legendary", Weight = 0.9, Value = 180000, Color = Color3.fromRGB(190, 90, 255), MinLayer = 5, MaxLayer = 5, WeightMin = 300, WeightMax = 1100 },
	{ Name = "Megalodon", Kind = "Fish", Tier = "Mythic", Weight = 0.1, Value = 900000, Color = Color3.fromRGB(255, 70, 120), MinLayer = 5, MaxLayer = 5, WeightMin = 20000, WeightMax = 100000 },

	--------------------------------------------------------------------------
	-- RELICS — only ever found inside a chest.
	--
	-- Treasure, not habitat: a doubloon is a doubloon wherever you dredge it up,
	-- so these gate on MinLayer alone and deeper water simply offers better
	-- ones. They are worth several times a fish of the same tier, because you
	-- had to land the chest AND carry it home to find out what it was.
	--------------------------------------------------------------------------
	{ Name = "Rusty Anchor", Kind = "Relic", Tier = "Common", Weight = 34, Value = 60, Color = Color3.fromRGB(146, 118, 96), MinLayer = 1, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Message in a Bottle", Kind = "Relic", Tier = "Common", Weight = 22, Value = 95, Color = Color3.fromRGB(168, 216, 200), MinLayer = 1, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Silver Doubloon", Kind = "Relic", Tier = "Uncommon", Weight = 17, Value = 260, Color = Color3.fromRGB(214, 218, 226), MinLayer = 1, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Ship's Compass", Kind = "Relic", Tier = "Uncommon", Weight = 11, Value = 420, Color = Color3.fromRGB(206, 168, 88), MinLayer = 1, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	-- Available from area 1 on purpose: the first-session pity roll guarantees a
	-- Rare+ on the third chest ever opened, and with nothing Rare in the starting
	-- water that promise had nothing to pay out with.
	{ Name = "Diver's Helmet", Kind = "Relic", Tier = "Rare", Weight = 7, Value = 1100, Color = Color3.fromRGB(180, 150, 70), MinLayer = 1, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Pirate Cutlass", Kind = "Relic", Tier = "Rare", Weight = 4.4, Value = 1900, Color = Color3.fromRGB(198, 200, 210), MinLayer = 2, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Captain's Spyglass", Kind = "Relic", Tier = "Epic", Weight = 2.4, Value = 6500, Color = Color3.fromRGB(228, 180, 96), MinLayer = 3, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Golden Astrolabe", Kind = "Relic", Tier = "Epic", Weight = 1.2, Value = 14000, Color = Color3.fromRGB(255, 206, 96), MinLayer = 3, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Mermaid's Mirror", Kind = "Relic", Tier = "Legendary", Weight = 0.6, Value = 60000, Color = Color3.fromRGB(150, 255, 245), MinLayer = 4, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Sunken Crown", Kind = "Relic", Tier = "Legendary", Weight = 0.3, Value = 120000, Color = Color3.fromRGB(255, 200, 60), MinLayer = 4, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
	{ Name = "Poseidon's Trident", Kind = "Relic", Tier = "Mythic", Weight = 0.1, Value = 1500000, Color = Color3.fromRGB(120, 255, 255), MinLayer = 5, MaxLayer = 25, WeightMin = 0, WeightMax = 0 },
} :: { CrystalDef }

-- "Normal" is implicit: whatever chance is left after these rolls fail.
Crystals.Mutations = {
	{ Name = "Gilded", Chance = 8, ValueMult = 2, Color = Color3.fromRGB(255, 220, 120) },
	{ Name = "Frosted", Chance = 4, ValueMult = 3, Color = Color3.fromRGB(160, 220, 255) },
	{ Name = "Storm-Touched", Chance = 2, ValueMult = 5, Color = Color3.fromRGB(255, 240, 120) },
	{ Name = "Abyssal", Chance = 0.8, ValueMult = 10, Color = Color3.fromRGB(90, 60, 160) },
	{ Name = "Moonlit", Chance = 0.2, ValueMult = 25, Color = Color3.fromRGB(200, 220, 255) },
} :: { MutationDef }

Crystals.MutationNames = { "Normal", "Gilded", "Frosted", "Storm-Touched", "Abyssal", "Moonlit" }

Crystals.FISH = "Fish"
Crystals.RELIC = "Relic"

function Crystals.GetBase(name: string): CrystalDef?
	for _, def in Crystals.Bases do
		if def.Name == name then
			return def
		end
	end
	return nil
end

function Crystals.GetMutation(name: string): MutationDef?
	for _, def in Crystals.Mutations do
		if def.Name == name then
			return def
		end
	end
	return nil
end

function Crystals.IsRelic(name: string): boolean
	local def = Crystals.GetBase(name)
	return def ~= nil and def.Kind == Crystals.RELIC
end

function Crystals.IndexKey(baseName: string, mutationName: string): string
	return baseName .. "|" .. mutationName
end

function Crystals.TotalIndexEntries(): number
	return #Crystals.Bases * #Crystals.MutationNames
end

-- Everything of one kind catchable in one area, for the odds panel and the
-- "8 / 12 in Kelp Forest" counter.
function Crystals.BasesInLayer(layer: number, kind: string?): { CrystalDef }
	local list: { CrystalDef } = {}
	for _, def in Crystals.Bases do
		local wantedKind = kind == nil or def.Kind == kind
		if wantedKind and def.MinLayer <= layer and layer <= def.MaxLayer then
			table.insert(list, def)
		end
	end
	return list
end

-- Pounds for a caught fish. `size` is the same 0.9-1.2 roll every catch makes,
-- which the aquarium then grows past 1.2 over real time.
--
-- A wild catch fills the species' stated range exactly — 0.9 lands on WeightMin
-- and 1.2 on WeightMax — so the numbers on the Index cell are the numbers you
-- can actually see. A fish left growing in a tank keeps going past its wild max,
-- but at a quarter rate: a displayed fish should be a trophy, not a way to park
-- one specimen for an hour and retire the record forever.
--
-- Relics have no weight. You do not brag about a heavy doubloon.
function Crystals.WeightOf(baseName: string, size: number): number
	local def = Crystals.GetBase(baseName)
	if not def or def.WeightMax <= 0 then
		return 0
	end
	local span = def.WeightMax - def.WeightMin
	local t = (size - 0.9) / 0.3
	local over = math.max(t - 1, 0)
	return def.WeightMin + span * (math.clamp(t, 0, 1) + over * 0.25)
end

return Crystals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- ═══════════════════════════════════════════════════════════════════════════
--  THE ONLY FILE YOU EDIT BY HAND.
--  After publishing the game, create each gamepass and developer product on
--  the Creator Hub (see SETUP.md step 4) and paste its numeric ID below.
--  An ID of 0 means "not created yet" — the game hides that offer gracefully.
-- ═══════════════════════════════════════════════════════════════════════════

local Monetization = {}

-- Your Roblox group ID (players who join the group get 2x daily streak rewards).
Monetization.GroupId = 346261815

-- Gamepasses: { id, suggested price in Robux }
-- ── FRIENDS & FAMILY COMPS ──────────────────────────────────────────────────
-- UserIds listed here get gamepasses free. `true` comps EVERY pass; a table
-- comps only the listed ones. This is the only way to "gift" store items on
-- Roblox — passes can't be gifted on the platform, but the game decides what
-- ownership means. In-game only, no Robux moves, and it's fully reversible:
-- delete the line and the perks are gone the next time a server starts.
--
-- A friend's UserId is the number in their profile URL:
--   https://www.roblox.com/users/123456789/profile  ->  123456789
Monetization.CompUserIds = {
	-- [123456789] = true, -- everything, free
	-- [123456789] = { TripleCrack = true, Vip = true }, -- just these
} :: { [number]: boolean | { [string]: boolean } }

Monetization.Gamepasses = {
	AutoCrack = { Id = 0, Price = 100, Title = "Auto-Open", Desc = "Chests open themselves the moment you reel them in." },
	Coins2x = { Id = 0, Price = 250, Title = "2x Coins", Desc = "Permanently double every coin you earn." },
	Luck2x = { Id = 0, Price = 350, Title = "2x Luck", Desc = "Double your odds of rare fish, forever." },
	AutoCast = { Id = 0, Price = 450, Title = "Auto-Cast", Desc = "Your rod casts itself, and reels for you when you're not. Grab the line any time to reel it better." },
	TripleCrack = { Id = 0, Price = 450, Title = "Triple Open", Desc = "Open 3 chests at once." },
	OvernightMiner = { Id = 0, Price = 500, Title = "Overnight Aquarium", Desc = "Offline progress: 8h cap -> 24h, +50% offline earnings." },
	Vip = { Id = 0, Price = 1000, Title = "VIP Sea Captain", Desc = "Golden name, exclusive aura, +25% coins, +1 Daily Deal." },
}

-- Developer products (repeatable purchases): { id, suggested price in Robux }
Monetization.Products = {
	StarterPack = { Id = 0, Price = 200, Title = "Starter Pack", Desc = "2,500 coins + a guaranteed Red Snapper + 24h of 2x coins. One time only." },
	Coins1k = { Id = 0, Price = 100, Title = "Coin Pouch", Coins = 1000 },
	Coins5k = { Id = 0, Price = 500, Title = "Coin Chest", Coins = 5500 },
	Coins12k = { Id = 0, Price = 1000, Title = "Coin Vault", Coins = 12000 },
	TimeWarp = { Id = 0, Price = 200, Title = "Time Warp", Desc = "+8 hours of aquarium growth, instantly." },
	InstantRestock = { Id = 0, Price = 79, Title = "Instant Restock", Desc = "Refresh the shop stock right now, just for you." },
	InstantRebirth = { Id = 0, Price = 150, Title = "Instant Set Sail", Desc = "Set Sail now, no coin cost." },
}

function Monetization.PassIdByKey(key: string): number
	local def = (Monetization.Gamepasses :: any)[key]
	return def and def.Id or 0
end

function Monetization.ProductIdByKey(key: string): number
	local def = (Monetization.Products :: any)[key]
	return def and def.Id or 0
end

function Monetization.ProductKeyById(id: number): string?
	if id == 0 then
		return nil
	end
	for key, def in Monetization.Products :: any do
		if def.Id == id then
			return key
		end
	end
	return nil
end

return Monetization
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CrystalShape</string>
          <string name="Source"><![CDATA[--!strict
-- Shared crystal geometry: a cluster of tapered, glowing shards built from
-- primitives (no asset uploads). One builder feeds the cave decoration, the
-- crystal inside every geode, and the spinning 3D gem on reveal cards — so a
-- Sapphire is recognisably the same rock everywhere in the game.

local CrystalShape = {}

export type Options = {
	Color: Color3,
	Scale: number?, -- overall size multiplier (1 ~= 3.5 studs tall)
	Shards: number?, -- spikes in the cluster
	Segments: number?, -- taper detail per spike: 1 = flat spike, 3 = faceted gem
	Seed: number?,
	Glow: number?, -- PointLight range at the cluster centre (nil/0 = no light)
	Sparkle: boolean?, -- drifting glints around the cluster
}

local function facet(parent: Instance, cframe: CFrame, size: Vector3, color: Color3): Part
	local p = Instance.new("Part")
	p.Name = "Facet"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false -- mining raycasts must hit the geode hitbox, not the sparkle
	p.CanTouch = false
	p.Massless = true
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.06
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Parent = parent
	return p
end

-- One spike: stacked blocks that shrink as they rise, each turned 45 degrees so
-- the silhouette reads as a faceted crystal rather than a stick.
local function spike(parent: Instance, base: CFrame, height: number, width: number, color: Color3, segments: number): Part
	local segHeight = height / (segments + 0.5)
	local tallest = nil :: Part?
	for s = 1, segments do
		local t = (s - 1) / segments
		local w = width * (1 - t * 0.5)
		tallest = facet(
			parent,
			base * CFrame.new(0, segHeight * (s - 0.5), 0) * CFrame.Angles(0, math.rad(45), 0),
			Vector3.new(w, segHeight, w),
			color
		)
	end
	-- Chisel tip
	local tip = facet(
		parent,
		base * CFrame.new(0, segments * segHeight + segHeight * 0.28, 0) * CFrame.Angles(0, math.rad(45), 0),
		Vector3.new(width * 0.34, segHeight * 0.6, width * 0.34),
		color
	)
	return tallest or tip
end

function CrystalShape.Build(options: Options): Model
	local model = Instance.new("Model")
	model.Name = "Crystal"

	local scale = options.Scale or 1
	local shards = math.max(options.Shards or 5, 1)
	local segments = math.max(options.Segments or 2, 1)
	local rng = Random.new(options.Seed or 7)
	local center: Part? = nil

	for i = 1, shards do
		local angle = ((i - 1) / shards) * math.pi * 2 + rng:NextNumber(-0.35, 0.35)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local isCenter = i == 1
		local lean = isCenter and rng:NextNumber(0, 0.12) or rng:NextNumber(0.2, 0.55)
		local dist = (isCenter and 0 or rng:NextNumber(0.4, 0.85)) * scale
		local height = (isCenter and rng:NextNumber(3.1, 3.6) or rng:NextNumber(1.5, 2.8)) * scale
		local width = rng:NextNumber(0.5, 0.8) * scale
		-- Tilt away from the cluster centre: rotate about the horizontal axis
		-- perpendicular to the shard's radial direction.
		local tiltAxis = Vector3.new(-dir.Z, 0, dir.X)
		local base = CFrame.new(dir * dist) * CFrame.fromAxisAngle(tiltAxis, -lean)
		local part = spike(model, base, height, width, options.Color, segments)
		if isCenter then
			center = part
		end
	end

	local anchor = center or model:FindFirstChildWhichIsA("BasePart")
	if anchor then
		if options.Glow and options.Glow > 0 then
			local light = Instance.new("PointLight")
			light.Color = options.Color
			light.Range = options.Glow
			light.Brightness = 0.8
			light.Shadows = false
			light.Parent = anchor
		end
		if options.Sparkle then
			local glints = Instance.new("ParticleEmitter")
			glints.Color = ColorSequence.new(options.Color)
			glints.LightEmission = 0.3
			glints.Size = NumberSequence.new(0.35 * scale, 0)
			glints.Transparency = NumberSequence.new(0.1, 1)
			glints.Lifetime = NumberRange.new(0.8, 1.6)
			glints.Rate = 6
			glints.Speed = NumberRange.new(0.6, 1.8)
			glints.SpreadAngle = Vector2.new(60, 60)
			glints.Parent = anchor
		end
	end

	-- Pivot at the base of the cluster so callers can plant it on a surface and
	-- spin it about its own axis.
	model.WorldPivot = CFrame.new()
	return model
end

return CrystalShape
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">FishShape</string>
          <string name="Source"><![CDATA[--!strict
-- Shared fish geometry: REAL SPECIES built from primitives (no asset uploads).
-- One builder feeds the reveal card viewports, the aquarium tank, the trophy
-- over your head and the landmarks above the water — so an Anchovy is the same
-- Anchovy everywhere in the game.
--
-- This replaces CrystalShape for anything that represents a CATCH. A fishing
-- game whose fish render as glowing gems is a re-skin wearing a fishing hat;
-- the silhouette is the single cheapest thing that makes it its own game.
--
-- WHY PER-SPECIES AND NOT ONE FISH IN 33 COLOURS
--
-- The first version was exactly that, and it quietly undercut the whole product.
-- The table is real species on purpose — "I caught a Leopard Shark" is a thing a
-- kid says at school — but a Leopard Shark drawn as a recoloured Anchovy tells
-- them the name is a label, not a thing. Recognition is the asset; the shape has
-- to earn it. So a Hammerhead gets a hammer, a Manta Ray is a flying diamond, a
-- Seahorse stands up, and a Megalodon is not just a big minnow.
--
-- The style stays deliberately Roblox — chunky primitives, flat colours, read at
-- a glance and at thumbnail size. This is not a bid for realism; it is a bid for
-- each species being TELLABLE APART in a 90-stud tank and on a reveal card.
--
-- Most species are the generic fish with different proportions and fittings
-- (PROFILES below). The ones whose skeleton is genuinely a different animal —
-- eels, rays, a seahorse, a squid, an octopus, an isopod, a flatfish — get their
-- own builder, because no amount of stretching an ellipsoid makes a manta ray.

local FishShape = {}

export type Options = {
	-- The species. Optional: the landmark/vista decorations have no species and
	-- fall through to a good-looking generic fish.
	Name: string?,
	Color: Color3,
	Scale: number?, -- overall size multiplier (1 ~= 3 studs nose to tail)
	Seed: number?,
	Glow: number?, -- PointLight range at the body (nil/0 = no light)
	Sparkle: boolean?, -- drifting glints (used for mutated/rare fish)
	Neon: boolean?, -- deep-water species that light themselves
}

type Profile = {
	Family: string?, -- own skeleton; nil = the generic fish below
	Length: number?,
	Height: number?,
	Width: number?,
	Snout: number?, -- snout length, as a fraction of body length
	Tail: string?, -- Fork | Lunate | Round | Shark | Ribbon | Whip | None
	Dorsal: string?, -- Standard | Sail | SharkFin | Ridge | Spiny | None
	Pectoral: string?, -- Standard | Long | None
	Bands: number?,
	BandPale: boolean?, -- white bands (clownfish) rather than dark ones
	Spots: number?,
	Eye: number?, -- eye size multiplier
	Extras: { string }?,
}

--------------------------------------------------------------------------------
-- Primitives
--------------------------------------------------------------------------------

-- Fish must NOT be fullbright. Neon renders flat and unshaded, which is what
-- turned every crystal cluster into one glowing blob — on a fish it would erase
-- the body/fin/tail separation that makes it read as a fish at all. SmoothPlastic
-- takes the light, so the form survives. Neon is opt-in, for the deep-sea
-- species that genuinely light themselves.
local function piece(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false -- a cast must never land on a decoration fish
	p.CanTouch = false
	p.Massless = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

-- Fins and tail are a saturated, darker version of the body so they separate
-- from it without introducing a second unrelated colour.
local function finColor(body: Color3): Color3
	return body:Lerp(Color3.fromRGB(20, 18, 34), 0.42)
end
local function paleOf(body: Color3): Color3
	return body:Lerp(Color3.new(1, 1, 1), 0.55)
end
local function darkOf(body: Color3): Color3
	return body:Lerp(Color3.fromRGB(30, 26, 44), 0.35)
end

local WHITE = Color3.fromRGB(250, 250, 252)
local PUPIL = Color3.fromRGB(18, 16, 26)
local TOOTH = Color3.fromRGB(245, 243, 232)

type Ctx = {
	Model: Model,
	Body: Part?,
	Color: Color3,
	Fin: Color3,
	Material: Enum.Material,
	L: number,
	H: number,
	W: number,
	Scale: number,
	Rng: Random,
}

local function has(list: { string }?, name: string): boolean
	if not list then
		return false
	end
	for _, entry in list do
		if entry == name then
			return true
		end
	end
	return false
end

-- Eyes: the single detail that turns a shape into an animal. One per side.
local function eyes(ctx: Ctx, atX: number, atY: number, size: number, spread: number)
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			CFrame = CFrame.new(atX, atY, side * spread),
			Color = WHITE,
		})
		piece(ctx.Model, {
			Name = "Pupil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size * 0.56, size * 0.56, size * 0.56),
			CFrame = CFrame.new(atX + size * 0.1, atY, side * (spread + size * 0.24)),
			Color = PUPIL,
		})
	end
end

--------------------------------------------------------------------------------
-- Tails
--------------------------------------------------------------------------------

local function tailStalk(ctx: Ctx, atX: number, thickness: number)
	piece(ctx.Model, {
		Name = "TailStalk",
		Size = Vector3.new(ctx.L * 0.24, ctx.H * thickness, ctx.W * 0.42),
		CFrame = CFrame.new(atX, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
end

local function buildTail(ctx: Ctx, kind: string)
	local x = -ctx.L * 0.52
	if kind == "None" then
		return
	elseif kind == "Ribbon" then
		-- A long trailing ribbon, for the oarfish-shaped things.
		tailStalk(ctx, x, 0.24)
		piece(ctx.Model, {
			Name = "TailRibbon",
			Size = Vector3.new(ctx.L * 0.5, ctx.H * 0.5, ctx.W * 0.12),
			CFrame = CFrame.new(x - ctx.L * 0.3, ctx.H * 0.08, 0) * CFrame.Angles(0, 0, 0.25),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
		return
	elseif kind == "Whip" then
		-- Ray tail: a long thin spike, no fin at all.
		piece(ctx.Model, {
			Name = "TailWhip",
			Size = Vector3.new(ctx.L * 1.15, ctx.H * 0.1, ctx.W * 0.08),
			CFrame = CFrame.new(x - ctx.L * 0.5, ctx.H * 0.05, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
		return
	end

	tailStalk(ctx, x, if kind == "Shark" then 0.44 else 0.34)

	if kind == "Round" then
		piece(ctx.Model, {
			Name = "TailFin",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.L * 0.42, ctx.H * 1.02, ctx.W * 0.16),
			CFrame = CFrame.new(x - ctx.L * 0.2, 0, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	elseif kind == "Lunate" then
		-- Crescent: the fast-swimmer tail. Tips swept hard back.
		for _, lean in { 1, -1 } do
			piece(ctx.Model, {
				Name = "TailFin",
				Size = Vector3.new(ctx.L * 0.46, ctx.H * 0.9, ctx.W * 0.13),
				CFrame = CFrame.new(x - ctx.L * 0.2, lean * ctx.H * 0.42, 0)
					* CFrame.Angles(0, 0, lean * 1.05),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
	elseif kind == "Shark" then
		-- Heterocercal: the upper lobe is much longer. This asymmetry is most of
		-- what makes a silhouette read "shark" rather than "big fish".
		piece(ctx.Model, {
			Name = "TailUpper",
			Size = Vector3.new(ctx.L * 0.4, ctx.H * 1.15, ctx.W * 0.14),
			CFrame = CFrame.new(x - ctx.L * 0.22, ctx.H * 0.5, 0) * CFrame.Angles(0, 0, 0.55),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
		piece(ctx.Model, {
			Name = "TailLower",
			Size = Vector3.new(ctx.L * 0.3, ctx.H * 0.6, ctx.W * 0.13),
			CFrame = CFrame.new(x - ctx.L * 0.2, -ctx.H * 0.3, 0) * CFrame.Angles(0, 0, -0.7),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	else -- Fork
		for _, lean in { 1, -1 } do
			piece(ctx.Model, {
				Name = "TailFin",
				Size = Vector3.new(ctx.L * 0.5, ctx.H * 0.62, ctx.W * 0.15),
				CFrame = CFrame.new(x - ctx.L * 0.24, lean * ctx.H * 0.34, 0)
					* CFrame.Angles(0, 0, lean * 0.75),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
	end
end

--------------------------------------------------------------------------------
-- Dorsals and pectorals
--------------------------------------------------------------------------------

local function buildDorsal(ctx: Ctx, kind: string)
	if kind == "None" then
		return
	elseif kind == "Sail" then
		-- The sailfish's whole identity. Oversized on purpose.
		piece(ctx.Model, {
			Name = "Sail",
			Size = Vector3.new(ctx.L * 0.86, ctx.H * 1.5, ctx.W * 0.1),
			CFrame = CFrame.new(ctx.L * 0.02, ctx.H * 1.0, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
		for i = 1, 5 do
			piece(ctx.Model, {
				Name = "SailRay",
				Size = Vector3.new(ctx.L * 0.05, ctx.H * 1.5, ctx.W * 0.13),
				CFrame = CFrame.new(ctx.L * (0.34 - i * 0.14), ctx.H * 1.0, 0),
				Color = darkOf(ctx.Fin),
				Material = ctx.Material,
			})
		end
	elseif kind == "SharkFin" then
		piece(ctx.Model, {
			Name = "Dorsal",
			Size = Vector3.new(ctx.L * 0.3, ctx.H * 0.78, ctx.W * 0.16),
			CFrame = CFrame.new(ctx.L * 0.02, ctx.H * 0.66, 0) * CFrame.Angles(0, 0, -0.42),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
		-- Second, small dorsal near the tail: sharks have two.
		piece(ctx.Model, {
			Name = "Dorsal2",
			Size = Vector3.new(ctx.L * 0.14, ctx.H * 0.3, ctx.W * 0.12),
			CFrame = CFrame.new(-ctx.L * 0.38, ctx.H * 0.44, 0) * CFrame.Angles(0, 0, -0.42),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	elseif kind == "Ridge" then
		-- A long low fin running most of the back (tangs, parrotfish, eels).
		piece(ctx.Model, {
			Name = "Dorsal",
			Size = Vector3.new(ctx.L * 0.78, ctx.H * 0.26, ctx.W * 0.1),
			CFrame = CFrame.new(-ctx.L * 0.04, ctx.H * 0.54, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	elseif kind == "Spiny" then
		-- Spiny first dorsal + soft second: the bass/snapper signature.
		for i = 1, 5 do
			piece(ctx.Model, {
				Name = "Spine",
				Size = Vector3.new(ctx.L * 0.045, ctx.H * (0.5 - i * 0.03), ctx.W * 0.09),
				CFrame = CFrame.new(ctx.L * (0.24 - i * 0.09), ctx.H * (0.56 + (0.5 - i * 0.03) * 0.2), 0)
					* CFrame.Angles(0, 0, -0.18),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
		piece(ctx.Model, {
			Name = "Dorsal",
			Size = Vector3.new(ctx.L * 0.3, ctx.H * 0.34, ctx.W * 0.1),
			CFrame = CFrame.new(-ctx.L * 0.26, ctx.H * 0.58, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	else -- Standard
		piece(ctx.Model, {
			Name = "Dorsal",
			Size = Vector3.new(ctx.L * 0.44, ctx.H * 0.5, ctx.W * 0.14),
			CFrame = CFrame.new(-ctx.L * 0.04, ctx.H * 0.56, 0) * CFrame.Angles(0, 0, -0.35),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
end

local function buildPectoral(ctx: Ctx, kind: string)
	if kind == "None" then
		return
	end
	local long = kind == "Long"
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Pectoral",
			Size = Vector3.new(
				ctx.L * (if long then 0.5 else 0.28),
				ctx.H * 0.13,
				ctx.W * (if long then 0.9 else 0.5)
			),
			CFrame = CFrame.new(ctx.L * 0.1, -ctx.H * 0.2, side * ctx.W * 0.44)
				* CFrame.Angles(side * (if long then 0.25 else 0.5), 0, -0.3),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
end

--------------------------------------------------------------------------------
-- Species fittings
--------------------------------------------------------------------------------

local function addBill(ctx: Ctx)
	piece(ctx.Model, {
		Name = "Bill",
		Size = Vector3.new(ctx.L * 0.5, ctx.H * 0.09, ctx.W * 0.1),
		CFrame = CFrame.new(ctx.L * 0.78, ctx.H * 0.02, 0),
		Color = darkOf(ctx.Color),
		Material = ctx.Material,
	})
end

local function addBeak(ctx: Ctx)
	for _, sign in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Beak",
			Size = Vector3.new(ctx.L * 0.12, ctx.H * 0.13, ctx.W * 0.5),
			CFrame = CFrame.new(ctx.L * 0.55, sign * ctx.H * 0.09, 0),
			Color = paleOf(ctx.Color),
			Material = ctx.Material,
		})
	end
end

local function addFangs(ctx: Ctx, count: number, length: number)
	for i = 1, count do
		local t = (i - 0.5) / count
		for _, sign in { 1, -1 } do
			piece(ctx.Model, {
				Name = "Fang",
				Size = Vector3.new(ctx.L * 0.02, ctx.H * length, ctx.W * 0.05),
				CFrame = CFrame.new(
					ctx.L * (0.5 - t * 0.22),
					sign * ctx.H * (0.02 + length * 0.5),
					(if i % 2 == 0 then 1 else -1) * ctx.W * 0.14
				),
				Color = TOOTH,
			})
		end
	end
end

-- The anglerfish's esca, on its stalk. The one fish silhouette everybody
-- already knows, so it has to be unmistakable.
local function addLure(ctx: Ctx)
	piece(ctx.Model, {
		Name = "LureStalk",
		Size = Vector3.new(ctx.L * 0.06, ctx.H * 0.75, ctx.W * 0.06),
		CFrame = CFrame.new(ctx.L * 0.3, ctx.H * 0.72, 0) * CFrame.Angles(0, 0, -0.4),
		Color = darkOf(ctx.Color),
		Material = ctx.Material,
	})
	local bulb = piece(ctx.Model, {
		Name = "Lure",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.H * 0.3, ctx.H * 0.3, ctx.H * 0.3),
		CFrame = CFrame.new(ctx.L * 0.44, ctx.H * 1.05, 0),
		Color = Color3.fromRGB(190, 255, 225),
		Material = Enum.Material.Neon,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 255, 220)
	light.Range = 7 * ctx.Scale
	light.Brightness = 0.6
	light.Shadows = false
	light.Parent = bulb
end

-- Lionfish: the fan of venomous rays. Radiating, not swept — that is the read.
local function addSpines(ctx: Ctx)
	for i = 1, 9 do
		local angle = -0.9 + (i - 1) * 0.22
		piece(ctx.Model, {
			Name = "Spine",
			Size = Vector3.new(ctx.L * 0.04, ctx.H * 1.5, ctx.W * 0.04),
			CFrame = CFrame.new(ctx.L * (0.2 - i * 0.045), ctx.H * 0.9, 0)
				* CFrame.Angles(0, 0, angle),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	for _, side in { 1, -1 } do
		for i = 1, 4 do
			piece(ctx.Model, {
				Name = "SideSpine",
				Size = Vector3.new(ctx.L * 0.04, ctx.H * 1.1, ctx.W * 0.04),
				CFrame = CFrame.new(ctx.L * (0.1 - i * 0.1), -ctx.H * 0.2, side * ctx.W * 0.4)
					* CFrame.Angles(side * 0.9, 0, -0.5 + i * 0.2),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
	end
end

local function addHammer(ctx: Ctx)
	piece(ctx.Model, {
		Name = "Hammer",
		Size = Vector3.new(ctx.L * 0.16, ctx.H * 0.3, ctx.W * 2.6),
		CFrame = CFrame.new(ctx.L * 0.52, -ctx.H * 0.04, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	-- Eyes go on the ENDS of the hammer, which is the whole joke of the animal.
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.2, ctx.H * 0.2, ctx.H * 0.2),
			CFrame = CFrame.new(ctx.L * 0.52, -ctx.H * 0.04, side * ctx.W * 1.24),
			Color = PUPIL,
		})
	end
end

local function addPhotophores(ctx: Ctx)
	for i = 1, 8 do
		piece(ctx.Model, {
			Name = "Photophore",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.1, ctx.H * 0.1, ctx.H * 0.1),
			CFrame = CFrame.new(ctx.L * (0.34 - i * 0.09), -ctx.H * 0.34, ctx.W * 0.3),
			Color = Color3.fromRGB(150, 230, 255),
			Material = Enum.Material.Neon,
		})
	end
end

-- Barreleye: the transparent dome with the eyes looking up THROUGH it.
local function addDome(ctx: Ctx)
	piece(ctx.Model, {
		Name = "Dome",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.5, ctx.H * 0.8, ctx.W * 0.85),
		CFrame = CFrame.new(ctx.L * 0.3, ctx.H * 0.24, 0),
		Color = Color3.fromRGB(210, 235, 240),
		Material = Enum.Material.Glass,
		Transparency = 0.6,
	})
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "TubeEye",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(ctx.H * 0.34, ctx.H * 0.26, ctx.H * 0.26),
			CFrame = CFrame.new(ctx.L * 0.26, ctx.H * 0.22, side * ctx.W * 0.24)
				* CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(120, 235, 130),
			Material = Enum.Material.Neon,
		})
	end
end

local function addCrest(ctx: Ctx)
	for i = 1, 6 do
		piece(ctx.Model, {
			Name = "Crest",
			Size = Vector3.new(ctx.L * 0.03, ctx.H * (0.9 - i * 0.09), ctx.W * 0.06),
			CFrame = CFrame.new(ctx.L * (0.46 - i * 0.05), ctx.H * (0.5 + (0.9 - i * 0.09) * 0.5), 0),
			Color = Color3.fromRGB(220, 60, 70),
			Material = ctx.Material,
		})
	end
end

local function addFinlets(ctx: Ctx)
	for i = 1, 4 do
		for _, sign in { 1, -1 } do
			piece(ctx.Model, {
				Name = "Finlet",
				Size = Vector3.new(ctx.L * 0.05, ctx.H * 0.08, ctx.W * 0.08),
				CFrame = CFrame.new(-ctx.L * (0.24 + i * 0.07), sign * ctx.H * 0.36, 0),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
	end
end

local function addBump(ctx: Ctx)
	piece(ctx.Model, {
		Name = "HeadBump",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.3, ctx.H * 0.5, ctx.W * 0.6),
		CFrame = CFrame.new(ctx.L * 0.28, ctx.H * 0.44, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
end

-- Goblin shark: the flat blade of a snout with the jaw slung out under it.
local function addGoblinSnout(ctx: Ctx)
	piece(ctx.Model, {
		Name = "Blade",
		Size = Vector3.new(ctx.L * 0.42, ctx.H * 0.1, ctx.W * 0.4),
		CFrame = CFrame.new(ctx.L * 0.74, ctx.H * 0.16, 0),
		Color = paleOf(ctx.Color),
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "Jaw",
		Size = Vector3.new(ctx.L * 0.26, ctx.H * 0.22, ctx.W * 0.45),
		CFrame = CFrame.new(ctx.L * 0.64, -ctx.H * 0.16, 0),
		Color = Color3.fromRGB(232, 168, 178),
		Material = ctx.Material,
	})
end

local function addExtras(ctx: Ctx, extras: { string }?)
	if has(extras, "Bill") then
		addBill(ctx)
	end
	if has(extras, "Beak") then
		addBeak(ctx)
	end
	if has(extras, "Fangs") then
		addFangs(ctx, 5, 0.2)
	end
	if has(extras, "Lure") then
		addLure(ctx)
	end
	if has(extras, "Spines") then
		addSpines(ctx)
	end
	if has(extras, "Hammer") then
		addHammer(ctx)
	end
	if has(extras, "Photophores") then
		addPhotophores(ctx)
	end
	if has(extras, "Dome") then
		addDome(ctx)
	end
	if has(extras, "Crest") then
		addCrest(ctx)
	end
	if has(extras, "Finlets") then
		addFinlets(ctx)
	end
	if has(extras, "Bump") then
		addBump(ctx)
	end
	if has(extras, "GoblinSnout") then
		addGoblinSnout(ctx)
	end
end

--------------------------------------------------------------------------------
-- The generic fish
--------------------------------------------------------------------------------

local function buildGeneric(ctx: Ctx, profile: Profile): Part
	local color, material = ctx.Color, ctx.Material
	local body = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L, ctx.H, ctx.W),
		CFrame = CFrame.new(0, 0, 0),
		Color = color,
		Material = material,
	})

	-- Pale belly. A flattened ellipsoid tucked under the body is the whole
	-- difference between "a fish" and "a coloured blob with fins".
	piece(ctx.Model, {
		Name = "Belly",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.82, ctx.H * 0.52, ctx.W * 0.94),
		CFrame = CFrame.new(-ctx.L * 0.04, -ctx.H * 0.3, 0),
		Color = paleOf(color),
		Material = material,
	})

	-- Snout: the head tapers instead of ending in the same round curve as the
	-- tail. Length is per species — an anchovy is a point, a sheephead is blunt.
	local snout = profile.Snout or 0.42
	piece(ctx.Model, {
		Name = "Snout",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * snout, ctx.H * 0.62, ctx.W * 0.72),
		CFrame = CFrame.new(ctx.L * 0.42, -ctx.H * 0.05, 0),
		Color = color,
		Material = material,
	})

	buildTail(ctx, profile.Tail or "Fork")
	buildDorsal(ctx, profile.Dorsal or "Standard")
	buildPectoral(ctx, profile.Pectoral or "Standard")

	local eyeSize = ctx.H * 0.3 * (profile.Eye or 1)
	eyes(ctx, ctx.L * 0.42, ctx.H * 0.16, eyeSize, ctx.W * 0.3)

	-- Markings. Bands run across the body; spots scatter over the back.
	local bands = profile.Bands or 0
	for i = 1, bands do
		local at = ctx.L * 0.34 - (i - 0.5) * (ctx.L * 0.68 / bands)
		piece(ctx.Model, {
			Name = "Band",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.L * 0.08, ctx.H * 0.98, ctx.W * 1.03),
			CFrame = CFrame.new(at, ctx.H * 0.04, 0),
			Color = if profile.BandPale then WHITE else darkOf(color),
			Material = material,
		})
	end
	for i = 1, profile.Spots or 0 do
		local at = ctx.L * (0.36 - (i % 6) * 0.13)
		piece(ctx.Model, {
			Name = "Spot",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.2, ctx.H * 0.2, ctx.W * 0.3),
			CFrame = CFrame.new(at, ctx.H * (0.1 + (i % 3) * 0.16), ctx.Rng:NextNumber(-1, 1) * ctx.W * 0.34),
			Color = darkOf(color),
			Material = material,
		})
	end

	addExtras(ctx, profile.Extras)
	return body
end

--------------------------------------------------------------------------------
-- Own-skeleton families
--------------------------------------------------------------------------------

-- Eels, oarfish, frilled shark: a chain of shrinking segments on a gentle
-- S-curve, with a fin running the whole back. Length is the entire read here, so
-- these are deliberately much longer than any of the generic fish.
local function buildSerpent(ctx: Ctx, profile: Profile): Part
	local segments = 11
	local head = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.3, ctx.H, ctx.W),
		CFrame = CFrame.new(ctx.L * 0.5, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	for i = 1, segments do
		local t = i / segments
		local taper = 1 - t * 0.72
		local x = ctx.L * (0.5 - t * 1.5)
		local y = math.sin(t * 4.2) * ctx.H * 0.42
		piece(ctx.Model, {
			Name = "Segment",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.L * 0.2, ctx.H * taper, ctx.W * taper),
			CFrame = CFrame.new(x, y, 0),
			Color = ctx.Color:Lerp(darkOf(ctx.Color), t * 0.4),
			Material = ctx.Material,
		})
		-- The fin ridge along the back, following the curve.
		piece(ctx.Model, {
			Name = "Ridge",
			Size = Vector3.new(ctx.L * 0.2, ctx.H * 0.3 * taper, ctx.W * 0.08),
			CFrame = CFrame.new(x, y + ctx.H * 0.55 * taper, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end

	-- Jaw. A gulper's is most of the animal; a moray's is just menacing.
	local gulp = has(profile.Extras, "Gulp")
	piece(ctx.Model, {
		Name = "Jaw",
		Size = Vector3.new(ctx.L * (if gulp then 0.6 else 0.3), ctx.H * (if gulp then 0.7 else 0.22), ctx.W * 0.8),
		CFrame = CFrame.new(ctx.L * (if gulp then 0.66 else 0.6), -ctx.H * (if gulp then 0.34 else 0.22), 0)
			* CFrame.Angles(0, 0, if gulp then 0.22 else 0.1),
		Color = if gulp then darkOf(ctx.Color) else paleOf(ctx.Color),
		Material = ctx.Material,
	})
	eyes(ctx, ctx.L * 0.58, ctx.H * 0.2, ctx.H * 0.24, ctx.W * 0.32)
	addExtras(ctx, profile.Extras)
	return head
end

-- Manta ray: a flat diamond that flies. Nothing about the generic fish survives
-- here, which is exactly why it gets its own builder.
local function buildRay(ctx: Ctx, profile: Profile): Part
	local body = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.9, ctx.H * 0.42, ctx.W * 1.5),
		CFrame = CFrame.new(0, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "Underside",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.8, ctx.H * 0.3, ctx.W * 1.35),
		CFrame = CFrame.new(0, -ctx.H * 0.12, 0),
		Color = paleOf(ctx.Color),
		Material = ctx.Material,
	})
	-- Wings: three tapering panels a side, swept back into a point.
	for _, side in { 1, -1 } do
		for i = 1, 3 do
			local t = i / 3
			piece(ctx.Model, {
				Name = "Wing",
				Size = Vector3.new(ctx.L * (0.8 - t * 0.5), ctx.H * (0.2 - t * 0.12), ctx.W * 0.75),
				CFrame = CFrame.new(-ctx.L * t * 0.16, ctx.H * t * 0.06, side * ctx.W * (0.7 + t * 0.72))
					* CFrame.Angles(side * -t * 0.35, 0, 0),
				Color = ctx.Color:Lerp(ctx.Fin, t * 0.5),
				Material = ctx.Material,
			})
		end
		-- Cephalic lobe: the two little horns at the mouth. Unmistakable.
		piece(ctx.Model, {
			Name = "Lobe",
			Size = Vector3.new(ctx.L * 0.26, ctx.H * 0.14, ctx.W * 0.14),
			CFrame = CFrame.new(ctx.L * 0.5, -ctx.H * 0.06, side * ctx.W * 0.3)
				* CFrame.Angles(0, side * 0.25, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	eyes(ctx, ctx.L * 0.3, 0, ctx.H * 0.22, ctx.W * 0.62)
	buildTail(ctx, "Whip")
	addExtras(ctx, profile.Extras)
	return body
end

-- Seahorse: upright, tube snout, curled tail. The only fish here that does not
-- point +X, and the reason Options carries a name at all.
local function buildSeahorse(ctx: Ctx, profile: Profile): Part
	local body = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.W * 1.1, ctx.L * 0.62, ctx.W),
		CFrame = CFrame.new(0, ctx.L * 0.1, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	-- Head, tipped forward off the top of the body.
	piece(ctx.Model, {
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.W * 0.8, ctx.L * 0.24, ctx.W * 0.8),
		CFrame = CFrame.new(ctx.W * 0.2, ctx.L * 0.5, 0) * CFrame.Angles(0, 0, -0.5),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "Snout",
		Size = Vector3.new(ctx.W * 0.7, ctx.W * 0.24, ctx.W * 0.24),
		CFrame = CFrame.new(ctx.W * 0.72, ctx.L * 0.46, 0) * CFrame.Angles(0, 0, -0.25),
		Color = paleOf(ctx.Color),
		Material = ctx.Material,
	})
	-- Crown spines.
	for i = 1, 3 do
		piece(ctx.Model, {
			Name = "Crown",
			Size = Vector3.new(ctx.W * 0.12, ctx.W * 0.3, ctx.W * 0.12),
			CFrame = CFrame.new(-ctx.W * (0.1 + i * 0.12), ctx.L * (0.6 - i * 0.02), 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	-- Tail: a spiral of shrinking blocks curling forward.
	for i = 1, 8 do
		local t = i / 8
		local angle = t * 3.4
		local radius = ctx.L * 0.2 * (1 - t * 0.55)
		piece(ctx.Model, {
			Name = "Tail",
			Size = Vector3.new(ctx.W * (0.6 - t * 0.35), ctx.W * (0.6 - t * 0.35), ctx.W * (0.6 - t * 0.3)),
			CFrame = CFrame.new(
				math.sin(angle) * radius,
				ctx.L * -0.22 - t * ctx.L * 0.18 + (1 - math.cos(angle)) * radius * 0.3,
				0
			),
			Color = ctx.Color:Lerp(darkOf(ctx.Color), t * 0.5),
			Material = ctx.Material,
		})
	end
	-- Body ridges, the armoured rings.
	for i = 1, 4 do
		piece(ctx.Model, {
			Name = "Ring",
			Size = Vector3.new(ctx.W * 1.16, ctx.W * 0.1, ctx.W * 1.06),
			CFrame = CFrame.new(0, ctx.L * (0.32 - i * 0.11), 0),
			Color = darkOf(ctx.Color),
			Material = ctx.Material,
		})
	end
	piece(ctx.Model, {
		Name = "Dorsal",
		Size = Vector3.new(ctx.W * 0.1, ctx.L * 0.26, ctx.W * 0.7),
		CFrame = CFrame.new(-ctx.W * 0.6, ctx.L * 0.06, 0),
		Color = ctx.Fin,
		Material = ctx.Material,
	})
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.W * 0.26, ctx.W * 0.26, ctx.W * 0.26),
			CFrame = CFrame.new(ctx.W * 0.24, ctx.L * 0.52, side * ctx.W * 0.3),
			Color = PUPIL,
		})
	end
	addExtras(ctx, profile.Extras)
	return body
end

-- Colossal squid: mantle cone, two fins, eight arms and two long tentacles. The
-- eye is deliberately enormous — it is the animal's famous feature.
local function buildSquid(ctx: Ctx, profile: Profile): Part
	local mantle = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 1.1, ctx.H * 0.9, ctx.W * 1.1),
		CFrame = CFrame.new(-ctx.L * 0.3, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "MantleTip",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.6, ctx.H * 0.45, ctx.W * 0.5),
		CFrame = CFrame.new(-ctx.L * 0.95, 0, 0),
		Color = ctx.Color:Lerp(darkOf(ctx.Color), 0.3),
		Material = ctx.Material,
	})
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Fin",
			Size = Vector3.new(ctx.L * 0.5, ctx.H * 0.12, ctx.W * 0.8),
			CFrame = CFrame.new(-ctx.L * 0.8, 0, side * ctx.W * 0.6) * CFrame.Angles(side * 0.2, 0, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	-- Head between mantle and arms.
	piece(ctx.Model, {
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.4, ctx.H * 0.72, ctx.W * 0.85),
		CFrame = CFrame.new(ctx.L * 0.32, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.46, ctx.H * 0.46, ctx.H * 0.46),
			CFrame = CFrame.new(ctx.L * 0.34, ctx.H * 0.1, side * ctx.W * 0.42),
			Color = WHITE,
		})
		piece(ctx.Model, {
			Name = "Pupil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.26, ctx.H * 0.26, ctx.H * 0.26),
			CFrame = CFrame.new(ctx.L * 0.38, ctx.H * 0.1, side * ctx.W * 0.55),
			Color = PUPIL,
		})
	end
	-- Eight arms in a ring, plus two long hunting tentacles.
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		for seg = 1, 3 do
			local t = seg / 3
			piece(ctx.Model, {
				Name = "Arm",
				Size = Vector3.new(ctx.L * 0.26, ctx.H * (0.2 - t * 0.1), ctx.W * (0.2 - t * 0.1)),
				CFrame = CFrame.new(
					ctx.L * (0.56 + seg * 0.2),
					math.cos(angle) * ctx.H * 0.3 * (1 + t * 0.6),
					math.sin(angle) * ctx.W * 0.34 * (1 + t * 0.6)
				),
				Color = ctx.Color:Lerp(ctx.Fin, t * 0.5),
				Material = ctx.Material,
			})
		end
	end
	for _, side in { 1, -1 } do
		for seg = 1, 4 do
			local t = seg / 4
			piece(ctx.Model, {
				Name = "Tentacle",
				Size = Vector3.new(ctx.L * 0.34, ctx.H * 0.11, ctx.W * 0.11),
				CFrame = CFrame.new(
					ctx.L * (0.62 + seg * 0.3),
					-ctx.H * t * 0.2,
					side * ctx.W * (0.16 + t * 0.3)
				),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
		piece(ctx.Model, {
			Name = "Club",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.L * 0.24, ctx.H * 0.2, ctx.W * 0.2),
			CFrame = CFrame.new(ctx.L * 1.94, -ctx.H * 0.24, side * ctx.W * 0.5),
			Color = darkOf(ctx.Color),
			Material = ctx.Material,
		})
	end
	addExtras(ctx, profile.Extras)
	return mantle
end

-- Dumbo octopus: a soft dome with the two ear-fins it is named for.
local function buildOctopus(ctx: Ctx, profile: Profile): Part
	local head = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.9, ctx.H * 1.1, ctx.W * 1.5),
		CFrame = CFrame.new(0, ctx.H * 0.2, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "EarFin",
			Size = Vector3.new(ctx.L * 0.4, ctx.H * 0.12, ctx.W * 0.7),
			CFrame = CFrame.new(-ctx.L * 0.05, ctx.H * 0.62, side * ctx.W * 0.95)
				* CFrame.Angles(side * 0.5, 0, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		for seg = 1, 3 do
			local t = seg / 3
			piece(ctx.Model, {
				Name = "Arm",
				Size = Vector3.new(ctx.L * (0.22 - t * 0.06), ctx.H * 0.22, ctx.W * (0.22 - t * 0.06)),
				CFrame = CFrame.new(
					math.cos(angle) * ctx.L * 0.26 * (1 + t * 0.5),
					-ctx.H * (0.3 + seg * 0.22),
					math.sin(angle) * ctx.W * 0.42 * (1 + t * 0.5)
				),
				Color = ctx.Color:Lerp(ctx.Fin, t * 0.55),
				Material = ctx.Material,
			})
		end
	end
	eyes(ctx, ctx.L * 0.3, ctx.H * 0.3, ctx.H * 0.24, ctx.W * 0.5)
	addExtras(ctx, profile.Extras)
	return head
end

-- Giant isopod: overlapping armour plates, legs down both sides, antennae. A
-- woodlouse the size of a cat, which is the fact that sells it.
local function buildIsopod(ctx: Ctx, profile: Profile): Part
	local head = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.34, ctx.H * 0.7, ctx.W * 1.15),
		CFrame = CFrame.new(ctx.L * 0.42, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	for i = 1, 7 do
		local t = (i - 1) / 7
		local width = 1.25 - t * 0.5
		piece(ctx.Model, {
			Name = "Plate",
			Size = Vector3.new(ctx.L * 0.14, ctx.H * (0.62 - t * 0.2), ctx.W * width),
			CFrame = CFrame.new(ctx.L * (0.26 - i * 0.13), ctx.H * 0.04, 0),
			Color = ctx.Color:Lerp(darkOf(ctx.Color), t * 0.45),
			Material = ctx.Material,
		})
		for _, side in { 1, -1 } do
			piece(ctx.Model, {
				Name = "Leg",
				Size = Vector3.new(ctx.L * 0.05, ctx.H * 0.06, ctx.W * 0.42),
				CFrame = CFrame.new(ctx.L * (0.26 - i * 0.13), -ctx.H * 0.3, side * ctx.W * width * 0.62)
					* CFrame.Angles(side * 0.5, 0, 0),
				Color = ctx.Fin,
				Material = ctx.Material,
			})
		end
	end
	-- Tail fan.
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Uropod",
			Size = Vector3.new(ctx.L * 0.2, ctx.H * 0.1, ctx.W * 0.3),
			CFrame = CFrame.new(-ctx.L * 0.72, 0, side * ctx.W * 0.2) * CFrame.Angles(0, side * 0.35, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	for _, side in { 1, -1 } do
		piece(ctx.Model, {
			Name = "Antenna",
			Size = Vector3.new(ctx.L * 0.42, ctx.H * 0.05, ctx.W * 0.05),
			CFrame = CFrame.new(ctx.L * 0.76, -ctx.H * 0.1, side * ctx.W * 0.3)
				* CFrame.Angles(0, side * 0.4, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	eyes(ctx, ctx.L * 0.5, ctx.H * 0.16, ctx.H * 0.2, ctx.W * 0.46)
	addExtras(ctx, profile.Extras)
	return head
end

-- Flounder: flat, lying on its side, with BOTH eyes on the up-facing flank.
-- That asymmetry is the entire species and it costs two parts.
local function buildFlatfish(ctx: Ctx, profile: Profile): Part
	local body = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L, ctx.H * 0.3, ctx.W * 2.4),
		CFrame = CFrame.new(0, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "Underside",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.92, ctx.H * 0.2, ctx.W * 2.2),
		CFrame = CFrame.new(0, -ctx.H * 0.1, 0),
		Color = paleOf(ctx.Color),
		Material = ctx.Material,
	})
	-- The fin fringe running right around the disc.
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2
		piece(ctx.Model, {
			Name = "Fringe",
			Size = Vector3.new(ctx.L * 0.16, ctx.H * 0.07, ctx.W * 0.3),
			CFrame = CFrame.new(math.cos(angle) * ctx.L * 0.46, 0, math.sin(angle) * ctx.W * 1.15)
				* CFrame.Angles(0, -angle, 0),
			Color = ctx.Fin,
			Material = ctx.Material,
		})
	end
	for i = 1, 7 do
		piece(ctx.Model, {
			Name = "Spot",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.3, ctx.H * 0.12, ctx.H * 0.3),
			CFrame = CFrame.new(
				ctx.Rng:NextNumber(-0.38, 0.3) * ctx.L,
				ctx.H * 0.14,
				ctx.Rng:NextNumber(-0.9, 0.9) * ctx.W
			),
			Color = darkOf(ctx.Color),
			Material = ctx.Material,
		})
	end
	-- Both eyes topside, close together, on stalks.
	for _, offset in { -0.14, 0.14 } do
		piece(ctx.Model, {
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.3, ctx.H * 0.3, ctx.H * 0.3),
			CFrame = CFrame.new(ctx.L * 0.3, ctx.H * 0.2, ctx.W * offset),
			Color = WHITE,
		})
		piece(ctx.Model, {
			Name = "Pupil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(ctx.H * 0.17, ctx.H * 0.17, ctx.H * 0.17),
			CFrame = CFrame.new(ctx.L * 0.32, ctx.H * 0.3, ctx.W * offset),
			Color = PUPIL,
		})
	end
	addExtras(ctx, profile.Extras)
	return body
end

-- Hatchetfish: a deep, paper-thin blade of a body with an upturned mouth.
local function buildHatchet(ctx: Ctx, profile: Profile): Part
	local body = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.8, ctx.H * 1.5, ctx.W * 0.3),
		CFrame = CFrame.new(0, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	-- The hatchet "blade" belly.
	piece(ctx.Model, {
		Name = "Blade",
		Size = Vector3.new(ctx.L * 0.62, ctx.H * 0.8, ctx.W * 0.22),
		CFrame = CFrame.new(-ctx.L * 0.02, -ctx.H * 0.62, 0) * CFrame.Angles(0, 0, 0.2),
		Color = paleOf(ctx.Color),
		Material = ctx.Material,
	})
	buildTail(ctx, "Fork")
	piece(ctx.Model, {
		Name = "Dorsal",
		Size = Vector3.new(ctx.L * 0.2, ctx.H * 0.42, ctx.W * 0.1),
		CFrame = CFrame.new(-ctx.L * 0.12, ctx.H * 0.85, 0),
		Color = ctx.Fin,
		Material = ctx.Material,
	})
	-- Huge upward-staring eyes: the deep-sea tell.
	eyes(ctx, ctx.L * 0.3, ctx.H * 0.34, ctx.H * 0.42, ctx.W * 0.16)
	addPhotophores(ctx)
	addExtras(ctx, profile.Extras)
	return body
end

-- Anglerfish: almost all head, almost all mouth, with the lamp out front.
local function buildAngler(ctx: Ctx, profile: Profile): Part
	local body = piece(ctx.Model, {
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.95, ctx.H * 1.15, ctx.W * 1.15),
		CFrame = CFrame.new(ctx.L * 0.1, 0, 0),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "Tailpiece",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(ctx.L * 0.4, ctx.H * 0.45, ctx.W * 0.45),
		CFrame = CFrame.new(-ctx.L * 0.5, -ctx.H * 0.05, 0),
		Color = ctx.Color:Lerp(darkOf(ctx.Color), 0.35),
		Material = ctx.Material,
	})
	-- The gape: an upper and a lower jaw, hinged wide open.
	piece(ctx.Model, {
		Name = "UpperJaw",
		Size = Vector3.new(ctx.L * 0.5, ctx.H * 0.2, ctx.W * 1.0),
		CFrame = CFrame.new(ctx.L * 0.5, ctx.H * 0.2, 0) * CFrame.Angles(0, 0, -0.25),
		Color = ctx.Color,
		Material = ctx.Material,
	})
	piece(ctx.Model, {
		Name = "LowerJaw",
		Size = Vector3.new(ctx.L * 0.52, ctx.H * 0.22, ctx.W * 1.0),
		CFrame = CFrame.new(ctx.L * 0.48, -ctx.H * 0.32, 0) * CFrame.Angles(0, 0, 0.3),
		Color = paleOf(ctx.Color),
		Material = ctx.Material,
	})
	addFangs(ctx, 6, 0.3)
	buildTail(ctx, "Round")
	eyes(ctx, ctx.L * 0.34, ctx.H * 0.36, ctx.H * 0.22, ctx.W * 0.44)
	addLure(ctx)
	addExtras(ctx, profile.Extras)
	return body
end

--------------------------------------------------------------------------------
-- The species table
--
-- Proportions are multiples of `scale`, so a value of 3 is roughly 3 studs of
-- fish at Scale = 1. Relative size between species is deliberate: an Anchovy is
-- genuinely tiny next to a Megalodon, and seeing that in the tank is the point.
--------------------------------------------------------------------------------

local PROFILES: { [string]: Profile } = {
	-- Area 1: Sunny Shallows
	Anchovy = { Length = 1.7, Height = 0.5, Width = 0.3, Snout = 0.3, Tail = "Fork", Eye = 1.5, Dorsal = "Standard" },
	Mackerel = {
		Length = 2.9,
		Height = 0.85,
